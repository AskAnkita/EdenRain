            "accordion_row_xDxrtF": {
              "type": "_accordion-row",
              "settings": {
                "heading": "How to Choose the Perfect Lab-Grown Diamond Engagement Ring",
                "open_by_default": false,
                "inherit_color_scheme": true,
                "scheme_background": "#ffffff",
