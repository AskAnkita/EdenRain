    "eden_reviews": {
      "type": "eden-reviews",
      "blocks": {
        "review_1": {
          "type": "review",
          "settings": {
            "review": "I came in with a screenshot and a vague idea and left with something better than I had pictured. Seeing the two shapes side by side made the choice obvious.",
            "name": "Hannah M., Bristol",
            "stars": 5
          }
        },
        "review_2": {
          "type": "review",
          "settings": {
            "review": "My partner is impossible to buy for, so the design consultation was a godsend. Seeing carat sizes on a real hand changed what I ordered.",
            "name": "Tom R., London",
            "stars": 5
          }
        },
        "review_3": {
          "type": "review",
          "settings": {
            "review": "Six months of wear, a house move and far too much washing up, and the band still looks like it did on day one. Quietly brilliant.",
            "name": "Priya S., Manchester",
            "stars": 5
          }
        },
        "review_4": {
          "type": "review",
          "settings": {
            "review": "The ring arrived two days ahead of schedule, in packaging I have genuinely kept. A small thing, but it made the proposal feel considered.",
            "name": "Jack W., Leeds",
            "stars": 5
          }
        },
        "review_5": {
          "type": "review",
          "settings": {
            "review": "I asked for the setting a touch lower than the drawing and they redrew it twice, without once making me feel like a nuisance.",
            "name": "Eleanor T., Edinburgh",
            "stars": 5
          }
        },
        "review_6": {
          "type": "review",
          "settings": {
            "review": "Lab-grown was the reason I came; the service is the reason I would recommend them. No pressure to spend more than I had planned.",
            "name": "Daniel O., Cardiff",
            "stars": 5
          }
        },
        "review_7": {
          "type": "review",
          "settings": {
            "review": "Our wedding bands were made as a pair and sit together perfectly - you can tell they were designed to. Worth the wait.",
            "name": "Sophie and Mark, Brighton",
            "stars": 5
          }
        },
        "review_8": {
          "type": "review",
          "settings": {
            "review": "Delivery slipped by a few days, but they phoned rather than emailed and kept me posted until it landed. The ring itself is beautiful.",
            "name": "Rachel B., Glasgow",
            "stars": 4
          }
        }
      },
      "block_order": [
        "review_1",
        "review_2",
        "review_3",
        "review_4",
        "review_5",
        "review_6",
        "review_7",
        "review_8"
      ],
