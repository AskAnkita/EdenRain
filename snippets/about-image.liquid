{%- doc -%}
  One picture on the About page, from either place a merchant can put one.

  A photograph may be uploaded in the theme editor (an image_picker) or already
  sit in Shopify's Content > Files (a file name, which is how the rest of this
  shop seeds its defaults - the pictures live in the shop's media rather than in
  the theme, so they can be swapped in the admin). This renders whichever of the
  two is there, responsively, and marks a file-name picture so the section can
  drop the frame if the file was never uploaded.

  @param {object} [image] - the image_picker setting
  @param {string} [asset] - a file name in Content > Files, used when no image is picked
  @param {string} alt - alternative text
  @param {string} [sizes] - the sizes attribute. Default '100vw'.
  @param {string} [loading] - 'lazy' or 'eager'. Default 'lazy'.
  @param {string} [fetchpriority] - 'high' on the one picture above the fold
  @param {number} [width] - intrinsic width for the asset fallback. Default 1600.
  @param {number} [height] - intrinsic height for the asset fallback. Default 1200.

  Usage:
  {%- render 'about-image', image: stts.hero_image, asset: stts.hero_image_asset, alt: heading -%}
{%- enddoc -%}

{%- liquid
  assign file = asset | default: '' | strip
  assign img_sizes = sizes | default: '100vw'
  assign img_loading = loading | default: 'lazy'
  assign img_width = width | default: 1600
  assign img_height = height | default: 1200
-%}

{%- if image != blank -%}
  {%- if fetchpriority == 'high' -%}
    {{
      image
      | image_url: width: 2400
      | image_tag:
        loading: img_loading,
        fetchpriority: 'high',
        widths: '400, 600, 900, 1200, 1600, 2000, 2400',
        sizes: img_sizes,
        alt: alt
    }}
  {%- else -%}
    {{
      image
      | image_url: width: 2400
      | image_tag:
        loading: img_loading,
        widths: '400, 600, 900, 1200, 1600, 2000, 2400',
        sizes: img_sizes,
        alt: alt
    }}
  {%- endif -%}
{%- elsif file != blank -%}
  {%- comment -%}
    file_url already carries a ?v= cache key, so each width goes on with an ampersand.
  {%- endcomment -%}
  {%- assign file_src = file | file_url -%}
  <img
    src="{{ file_src }}&width=1600"
    srcset="
      {{ file_src }}&width=600 600w,
      {{ file_src }}&width=900 900w,
      {{ file_src }}&width=1600 1600w,
      {{ file_src }}&width=2400 2400w
    "
    sizes="{{ img_sizes }}"
    alt="{{ alt | escape }}"
    width="{{ img_width }}"
    height="{{ img_height }}"
    loading="{{ img_loading }}"
    {% if fetchpriority == 'high' %}fetchpriority="high"{% endif %}
    data-ab-asset
  >
{%- endif -%}
