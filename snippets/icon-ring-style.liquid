      <ellipse cx="12" cy="4.2" rx="2" ry="2.5" transform="rotate(135 12 12)"/>
      <ellipse cx="12" cy="4.2" rx="2" ry="2.5" transform="rotate(180 12 12)"/>
      <ellipse cx="12" cy="4.2" rx="2" ry="2.5" transform="rotate(225 12 12)"/>
      <ellipse cx="12" cy="4.2" rx="2" ry="2.5" transform="rotate(270 12 12)"/>
      <ellipse cx="12" cy="4.2" rx="2" ry="2.5" transform="rotate(315 12 12)"/>
      <path d="M12 5.6L16.5 7.5L18.4 12L16.5 16.5L12 18.4L7.5 16.5L5.6 12L7.5 7.5Z"/>
      <path d="M13.5 8.5L15.5 10.5L15.5 13.5L13.5 15.5L10.5 15.5L8.5 13.5L8.5 10.5L10.5 8.5Z"/>
      <path d="M13.5 8.5L16 2.4M15.5 10.5L21.6 8M15.5 13.5L21.6 16M13.5 15.5L16 21.6M10.5 15.5L8 21.6M8.5 13.5L2.4 16M8.5 10.5L2.4 8M10.5 8.5L8 2.4"/>

    {%- comment -%}
      Two small accents on each shoulder - smaller than three-stone, and more of them.
    {%- endcomment -%}
    {%- when 'side-stone' -%}
      <circle cx="12" cy="12" r="4.8"/>
      <circle cx="12" cy="12" r="3"/>
      <path d="M12.6 10.5L13.5 11.4L13.5 12.6L12.6 13.5L11.4 13.5L10.5 12.6L10.5 11.4L11.4 10.5Z"/>
      <path d="M12.6 10.5L13.1 9.3M13.5 11.4L14.7 10.9M13.5 12.6L14.7 13.1M12.6 13.5L13.1 14.7M11.4 13.5L10.9 14.7M10.5 12.6L9.3 13.1M10.5 11.4L9.3 10.9M11.4 10.5L10.9 9.3"/>
      <path d="M12 9L12 7.2M14.1 9.9L15.4 8.6M15 12L16.8 12M14.1 14.1L15.4 15.4M12 15L12 16.8M9.9 14.1L8.6 15.4M9 12L7.2 12M9.9 9.9L8.6 8.6"/>
      <circle cx="5.1" cy="12" r="1.5"/>
      <circle cx="1.9" cy="12" r="1.5"/>
      <circle cx="18.9" cy="12" r="1.5"/>
      <circle cx="22.1" cy="12" r="1.5"/>

    {%- comment -%}
      The halo drawn as the stones it is made of, a full round of them.
    {%- endcomment -%}
    {%- when 'halo' -%}
      <circle cx="12" cy="12" r="5.6"/>
      <circle cx="12" cy="12" r="3.5"/>
      <path d="M12.7 10.2L13.8 11.3L13.8 12.7L12.7 13.8L11.3 13.8L10.2 12.7L10.2 11.3L11.3 10.2Z"/>
      <path d="M12.7 10.2L13.3 8.8M13.8 11.3L15.2 10.7M13.8 12.7L15.2 13.3M12.7 13.8L13.3 15.2M11.3 13.8L10.7 15.2M10.2 12.7L8.8 13.3M10.2 11.3L8.8 10.7M11.3 10.2L10.7 8.8"/>
      <path d="M12 8.5L12 6.4M14.5 9.5L16 8M15.5 12L17.6 12M14.5 14.5L16 16M12 15.5L12 17.6M9.5 14.5L8 16M8.5 12L6.4 12M9.5 9.5L8 8"/>
      <circle cx="12" cy="4.1" r="1.1"/>
      <circle cx="15" cy="4.7" r="1.1"/>
      <circle cx="17.6" cy="6.4" r="1.1"/>
      <circle cx="19.3" cy="9" r="1.1"/>
      <circle cx="19.9" cy="12" r="1.1"/>
      <circle cx="19.3" cy="15" r="1.1"/>
      <circle cx="17.6" cy="17.6" r="1.1"/>
      <circle cx="15" cy="19.3" r="1.1"/>
      <circle cx="12" cy="19.9" r="1.1"/>
      <circle cx="9" cy="19.3" r="1.1"/>
      <circle cx="6.4" cy="17.6" r="1.1"/>
      <circle cx="4.7" cy="15" r="1.1"/>
      <circle cx="4.1" cy="12" r="1.1"/>
      <circle cx="4.7" cy="9" r="1.1"/>
      <circle cx="6.4" cy="6.4" r="1.1"/>
      <circle cx="9" cy="4.7" r="1.1"/>

    {%- comment -%}
      The only stone in the set drawn from the side, because a halo set beneath the
      centre stone is the one thing you cannot see from above: table, crown, girdle, then the
      hidden row, then the pavilion.
    {%- endcomment -%}
    {%- when 'hidden-halo' -%}
      <path d="M7.6 4.6h8.8"/>
      <path d="M7.6 4.6 3.8 8.6M16.4 4.6l3.8 4"/>
      <path d="M3.8 8.6h16.4"/>
      <path d="M7.6 4.6 6.2 8.6M16.4 4.6l1.4 4M12 4.6 9.9 8.6M12 4.6l2.1 4"/>
      <circle cx="4.6" cy="10" r="1"/>
      <circle cx="7.1" cy="10" r="1"/>
      <circle cx="9.5" cy="10" r="1"/>
      <circle cx="12" cy="10" r="1"/>
      <circle cx="14.5" cy="10" r="1"/>
      <circle cx="16.9" cy="10" r="1"/>
      <circle cx="19.4" cy="10" r="1"/>
      <path d="M4 11.3h16"/>
      <path d="M4 11.3 12 20.6 20 11.3"/>
      <path d="M8 11.3 12 20.6M16 11.3 12 20.6"/>

    {%- comment -%}
      Three faceted stones touching at the girdle, the centre one largest.
    {%- endcomment -%}
    {%- when 'three-stone' -%}
