      <path d="M12.7 10.4L13.2 9.1M13.6 11.3L14.9 10.8M13.6 12.7L14.9 13.2M12.7 13.6L13.2 14.9M11.3 13.6L10.8 14.9M10.4 12.7L9.1 13.2M10.4 11.3L9.1 10.8M11.3 10.4L10.8 9.1"/>
      <path d="M12 8.9L12 7M14.2 9.8L15.5 8.5M15.1 12L17 12M14.2 14.2L15.5 15.5M12 15.1L12 17M9.8 14.2L8.5 15.5M8.9 12L7 12M9.8 9.8L8.5 8.5"/>
      <circle cx="3.6" cy="12" r="3.4"/>
      <circle cx="3.6" cy="12" r="2.1"/>
      <circle cx="3.6" cy="12" r="1.2"/>
      <path d="M3.6 9.9L3.6 8.6M5.1 10.5L6 9.6M5.7 12L7 12M5.1 13.5L6 14.4M3.6 14.1L3.6 15.4M2.1 13.5L1.2 14.4M1.5 12L0.2 12M2.1 10.5L1.2 9.6"/>
      <circle cx="20.4" cy="12" r="3.4"/>
      <circle cx="20.4" cy="12" r="2.1"/>
      <circle cx="20.4" cy="12" r="1.2"/>
      <path d="M20.4 9.9L20.4 8.6M21.9 10.5L22.8 9.6M22.5 12L23.8 12M21.9 13.5L22.8 14.4M20.4 14.1L20.4 15.4M18.9 13.5L18 14.4M18.3 12L17 12M18.9 10.5L18 9.6"/>

    {%- comment -%}
      Two rings: the engagement stone over the diamond band it is worn with.
    {%- endcomment -%}
    {%- when 'bridal-sets' -%}
      <circle cx="12" cy="8" r="4.6"/>
      <circle cx="12" cy="8" r="2.9"/>
      <path d="M12.6 6.6L13.4 7.4L13.4 8.6L12.6 9.4L11.4 9.4L10.6 8.6L10.6 7.4L11.4 6.6Z"/>
      <path d="M12.6 6.6L13.1 5.4M13.4 7.4L14.6 6.9M13.4 8.6L14.6 9.1M12.6 9.4L13.1 10.6M11.4 9.4L10.9 10.6M10.6 8.6L9.4 9.1M10.6 7.4L9.4 6.9M11.4 6.6L10.9 5.4"/>
      <path d="M12 5.1L12 3.4M14 6L15.3 4.7M14.9 8L16.6 8M14 10L15.3 11.3M12 10.9L12 12.6M10 10L8.7 11.3M9.1 8L7.4 8M10 6L8.7 4.7"/>
      <circle cx="3.2" cy="17.6" r="1.4"/>
      <circle cx="6.1" cy="17.6" r="1.4"/>
      <circle cx="9.1" cy="17.6" r="1.4"/>
      <circle cx="12" cy="17.6" r="1.4"/>
      <circle cx="14.9" cy="17.6" r="1.4"/>
      <circle cx="17.9" cy="17.6" r="1.4"/>
      <circle cx="20.8" cy="17.6" r="1.4"/>

    {%- comment -%}
      A square-set ornate bezel with milgrain at its points - ornament around the stone
      rather than more stones, which is what keeps it clear of halo.
    {%- endcomment -%}
    {%- when 'vintage' -%}
      <path d="M12 4.6 19.4 12 12 19.4 4.6 12z"/>
      <path d="M12 7.2 16.8 12 12 16.8 7.2 12z"/>
      <circle cx="12" cy="12" r="3.4"/>
      <circle cx="12" cy="12" r="2.1"/>
      <circle cx="12" cy="12" r="1.2"/>
      <path d="M12 9.9L12 8.6M13.5 10.5L14.4 9.6M14.1 12L15.4 12M13.5 13.5L14.4 14.4M12 14.1L12 15.4M10.5 13.5L9.6 14.4M9.9 12L8.6 12M10.5 10.5L9.6 9.6"/>
      <circle cx="12" cy="3.1" r="0.8"/>
      <circle cx="20.9" cy="12" r="0.8"/>
      <circle cx="12" cy="20.9" r="0.8"/>
      <circle cx="3.1" cy="12" r="0.8"/>

    {%- comment -%}
      Leaves either side of the stone in place of a plain shoulder.
    {%- endcomment -%}
    {%- when 'nature-inspired' -%}
      <circle cx="12" cy="12" r="4"/>
      <circle cx="12" cy="12" r="2.5"/>
      <circle cx="12" cy="12" r="1.4"/>
      <path d="M12 9.5L12 8M13.8 10.2L14.8 9.2M14.5 12L16 12M13.8 13.8L14.8 14.8M12 14.5L12 16M10.2 13.8L9.2 14.8M9.5 12L8 12M10.2 10.2L9.2 9.2"/>
      <path d="M1.4 9.2c3.4-.6 6 1 6.4 3.4-3.4.6-6-1-6.4-3.4z"/>
      <path d="M1.4 9.2 7.8 12.6"/>
      <path d="M22.6 9.2c-3.4-.6-6 1-6.4 3.4 3.4.6 6-1 6.4-3.4z"/>
      <path d="M22.6 9.2 16.2 12.6"/>

    {%- comment -%}
      Two stones of different cuts meeting in the middle, which is the whole idea.
    {%- endcomment -%}
    {%- when 'toi-et-moi' -%}
      <circle cx="8.6" cy="12" r="4"/>
      <circle cx="8.6" cy="12" r="2.5"/>
      <circle cx="8.6" cy="12" r="1.4"/>
      <path d="M8.6 9.5L8.6 8M10.4 10.2L11.4 9.2M11.1 12L12.6 12M10.4 13.8L11.4 14.8M8.6 14.5L8.6 16M6.8 13.8L5.8 14.8M6.1 12L4.6 12M6.8 10.2L5.8 9.2"/>
      <ellipse cx="15.6" cy="12" rx="3.4" ry="4.4"/>
      <ellipse cx="15.6" cy="12" rx="1.5" ry="2"/>

    {%- comment -%}
      A heart cut: the one style in the list that is about the gesture, not the stone.
    {%- endcomment -%}
    {%- when 'promise' -%}
