{%- comment -%}
  One image slot for the Homepage journey section.

  A picked image wins; next a file named by name, which is how the rest of this
  shop seeds its defaults and is resolved by 'image-source' against Content >
  Files and then assets/; then the plain URL field, so the homepage keeps the
  images it was set up with before the picker existed. With none of the three,
  the theme placeholder keeps the layout from collapsing in the editor.

  Accepts: image (image_picker), asset (string, a file name in Content > Files
  or assets/), image_url (string), alt (string), placeholder (string),
  sizes (string), width, height, and - for a caller outside the homepage
  journey - class / placeholder_class to name the element it gets back.
{%- endcomment -%}

{%- liquid
  assign asset_file = asset | strip
  assign image_class = class | default: 'hj-image'
  assign image_placeholder_class = placeholder_class | default: 'hj-placeholder'
  assign placeholder_name = placeholder | default: 'lifestyle-1'
  assign fallback_width = width | default: 1600
  assign fallback_height = height | default: 1200

  comment
    Without `sizes` a browser assumes the picture fills the window and takes the widest
    candidate on offer, which on this page is three times what the slot actually shows.
  endcomment
  assign image_sizes = sizes | default: '(min-width: 990px) 50vw, 100vw'

  comment
    A named file can go through the CDN resizer and carry a srcset; a pasted URL can only be
    printed as it was given. They differ in src and srcset alone, so they share one img.
  endcomment
  assign fallback_src = ''
  assign fallback_srcset = ''
  if asset_file == blank and image_url != blank
    assign fallback_src = image_url | escape
  endif
-%}

{%- comment -%}
  The named file is resolved out here rather than in the block above, because `render` is the
  only thing that reads Content > Files and the `liquid` tag cannot call it.
{%- endcomment -%}
{%- if asset_file != blank -%}
  {%- capture fallback_src -%}
    {%- render 'image-source', file: asset_file, width: 1600 -%}
  {%- endcapture -%}
  {%- capture fallback_srcset -%}
    {%- render 'image-source', file: asset_file, width: 480 %} 480w, {% render 'image-source', file: asset_file, width: 900 %} 900w, {% render 'image-source', file: asset_file, width: 1600 %} 1600w
  {%- endcapture -%}
{%- endif -%}

{%- if image != blank -%}
  {%- assign image_alt = alt | default: image.alt | default: '' -%}
  {{
    image
    | image_url: width: 1800
    | image_tag:
      loading: 'lazy',
      widths: '480, 660, 900, 1200, 1500, 1800',
      sizes: image_sizes,
      alt: image_alt,
      class: image_class
  }}
{%- elsif fallback_src != blank -%}
  <img
    src="{{ fallback_src }}"
    {%- if fallback_srcset != blank %}
    srcset="{{ fallback_srcset }}"
    sizes="{{ image_sizes }}"
    {%- endif %}
    alt="{{ alt | escape }}"
    loading="lazy"
    width="{{ fallback_width }}"
    height="{{ fallback_height }}"
    class="{{ image_class }}"
  >
{%- else -%}
  {{ placeholder_name | placeholder_svg_tag: image_placeholder_class }}
{%- endif -%}
