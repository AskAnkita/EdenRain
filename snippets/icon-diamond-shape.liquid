    {%- when 'asscher' -%}
      <path d="M8.4 3.4h7.2l5 5v7.2l-5 5H8.4l-5-5V8.4z"/>
      <path d="M9.8 6.8h4.4l3 3v4.4l-3 3H9.8l-3-3V9.8z"/>
      <path d="M11 9.4h2l1.6 1.6v2l-1.6 1.6h-2l-1.6-1.6v-2z"/>
    {%- when 'heart' -%}
      <path d="M12 21C7.4 17.4 3.4 14.2 3.4 10.1 3.4 6.8 5.8 4.5 8.6 4.5c1.5 0 2.7.7 3.4 1.8.7-1.1 1.9-1.8 3.4-1.8 2.8 0 5.2 2.3 5.2 5.6 0 4.1-4 7.3-8.6 10.9z"/>
      <path d="M12 17.4c-3-2.4-5.6-4.5-5.6-7.2M12 17.4c3-2.4 5.6-4.5 5.6-7.2"/>
    {%- when 'marquise' -%}
      <path d="M12 2.4c3.6 4 5.4 7.2 5.4 9.6s-1.8 5.6-5.4 9.6C8.4 17.6 6.6 14.4 6.6 12s1.8-5.6 5.4-9.6z"/>
      <path d="M12 6.4c1.9 2.3 2.8 4.1 2.8 5.6s-.9 3.3-2.8 5.6c-1.9-2.3-2.8-4.1-2.8-5.6s.9-3.3 2.8-5.6z"/>
