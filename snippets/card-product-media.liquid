{%- capture sizes -%}
  {% comment %} '(min-width: 750px) 50vw, 100vw' {% endcomment %}
  {%- render 'util-product-media-sizes-attr', block: block, section: section, settings: settings, is_single_column: is_single_column, needs_both_sizes: needs_both_sizes -%}
{%- endcapture -%}

{%- capture f_media_alt -%}
  {{ 'content.product_image_main' | t }}
{%- endcapture -%}
{%- capture media_alt -%}
  {{ 'content.product_image_secondary' | t }}
{%- endcapture -%}

{%- capture default_variant -%}
  {%- render 'card-default-variant', card_product: card_product -%}
{%- endcapture -%}

{%- liquid
  assign f_media = card_product.featured_media

  # Every product is photographed in yellow gold first, so a grid of cards opens as one
  # block of yellow. card-default-variant picks a metal per product and hands back the
  # variant behind it; the card opens on that variant's photo and links to it, so the
  # product page opens on the same ring rather than on Sterling Silver.
  assign metal_override = false
  assign metal_variant_id = ''
  assign default_variant = default_variant | strip
  if default_variant != blank
    assign variant_parts = default_variant | split: '||'
    assign metal_variant_id = variant_parts[0]
    assign metal_index = variant_parts[1] | plus: 0
    assign metal_value = variant_parts[2]

    # Matched as text. A variant id is fourteen digits, and the id only ever travels
    # from here into a URL, so there is nothing to gain by turning it into a number.
    for variant in card_product.variants
      assign variant_id_text = variant.id | append: ''
      if variant_id_text == metal_variant_id
        assign f_media = variant.featured_media
        assign metal_override = true
        break
      endif
    endfor
  endif

  assign f_media_width = f_media.width
  assign media = card_product.media

  # The hover photo has to be a different frame from the one the card opens on. The metal
  # override above can land on media[1], which was the hover image, so taking media[1]
  # blindly leaves those cards swapping a photo for itself and hover looking broken.
  # Only the fallback below uses this now -- products that carry the metal grouping tags
  # are matched by group instead -- but for the rest, another metal's variant shot reads
  # as a different ring, so a detail or lifestyle frame is still preferred.
  assign other_metal_media = '|'
  if metal_override
    for variant in card_product.variants
      if variant.featured_media != blank and variant.options[metal_index] != metal_value
        assign other_metal_media = other_metal_media | append: variant.featured_media.id | append: '|'
      endif
    endfor
  endif

  # Prefer the next view of the metal the card actually opens on. Every render carries
  # Shopify's media-grouping alt text -- one group per metal, "#Jewelry material_Rose gold"
  # and friends -- and the importer uploads a colour's views in sequence, so the next item
  # inside f_media's own group is the next angle of the same ring. Picking by media order
  # instead is what made this wrong: the files land Yellow, then White, then Rose, so the
  # first frame that was not another metal's *variant* photo was still a yellow view, and
  # a white or rose card hovered to yellow. assets/product-metal-media.js reads these same
  # tags on the product page, and the '#' test mirrors its own.
  assign f_group = f_media.alt | strip | downcase
  assign f_group_marker = f_group | slice: 0

  assign hover_media = null
  assign grouped_media = false

  if f_group != blank and f_group_marker == '#'
    assign grouped_media = true
    assign seen_f_media = false
    assign earlier_in_group = null
    for item in media
      assign item_group = item.alt | strip | downcase
      unless item_group == f_group
        continue
      endunless
      if item.id == f_media.id
        assign seen_f_media = true
        continue
      endif
      if seen_f_media
        assign hover_media = item
        break
      endif
      # The card opens on the last view of its metal: wrap back to the first rather
      # than leave the metal.
      unless earlier_in_group
        assign earlier_in_group = item
      endunless
    endfor
    unless hover_media
      assign hover_media = earlier_in_group
    endunless
  endif

  # Products that do not use the grouping convention keep the original behaviour: any
  # frame that is not another metal's variant photo, and failing that any other frame,
  # because for them a swap still beats a hover that does nothing. Grouped products are
  # deliberately left alone here -- changing metal under the cursor is the bug, so a
  # metal with only one view simply does not swap.
  unless grouped_media
    for item in media
      if item.id == f_media.id
        continue
      endif
      assign media_id_key = '|' | append: item.id | append: '|'
      unless other_metal_media contains media_id_key
        assign hover_media = item
        break
      endunless
    endfor

    unless hover_media
      for item in media
        unless item.id == f_media.id
          assign hover_media = item
          break
        endunless
      endfor
    endunless
  endunless

  assign media_width = hover_media.width

  # The grouping alt ("#Jewelry material_Gold") is a machine tag for product-metal-media.js,
  # not a description, so it must never reach a screen reader. Where a frame carries one,
  # the product title is the useful thing to announce instead.
  assign f_alt_source = f_media.alt | default: card_product.title
  assign f_alt_marker = f_media.alt | strip | slice: 0
  if f_alt_marker == '#'
    assign f_alt_source = card_product.title
  endif

  assign hover_alt_source = hover_media.alt | default: card_product.title
  assign hover_alt_marker = hover_media.alt | strip | slice: 0
  if hover_alt_marker == '#'
    assign hover_alt_source = card_product.title
  endif

  assign f_media_alt = f_alt_source | append: ' ' | append: f_media_alt | strip
  assign media_alt = hover_alt_source | append: ' ' | append: media_alt | strip

  assign sizes = sizes

  assign f_widths = widths | default: '240, 352, 650, 832, 1200'
  assign m_widths = widths | default: '240, 352, 650, 832, 1200'

  unless lazy_load == false
    assign loading = "lazy"
  endunless

  if collection and collection.handle
    assign href_product_url = '/collections/' | append: collection.handle | append: '/products/' | append: card_product.handle
  else
    assign href_product_url = card_product.url
  endif

  # The card is showing one particular variant, so say so in the link. Without this the
  # product page falls back to its first variant and a Rose Gold card opens on Silver.
  # card-option-swatches.js rewrites the same parameter when a shopper picks another dot.
  if metal_override
    assign href_product_url = href_product_url | append: '?variant=' | append: metal_variant_id
  endif

  if f_media.presentation.focal_point != blank
    assign focal_point_style = '--image-focal-point: ' | append: f_media.presentation.focal_point | append: ';'
  endif

  if hover_media.presentation.focal_point != blank
    assign secondary_focal_point_style = '--image-focal-point: ' | append: hover_media.presentation.focal_point | append: ';'
  endif
-%}

<card-media class="card__media block{% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ settings.card_color_scheme }}{% endif %}">
  {% comment %} <section-fetcher class="absolute inset-0" data-section-id="{{ section.id }}" data-target-id="{{ secondary_media_id }}" data-activate="inview"></section-fetcher> {% endcomment %}
  {% comment %}
    'is-swatch-selected' is deliberately not set here. It hides the hover photo, and
    card-option-swatches.js adds it once a shopper picks a swatch, because from then on the
    hover frame belongs to the variant they replaced. Emitting it at render time instead
    applied that to every card on first paint and killed hover across the grid.
  {% endcomment %}
  <div class="media media--transparent media--hover-effect" id="CardProductMedia-Content-{{ section.id }}-{{ card_product.id }}">
    {% if f_media %}
      {{ f_media | image_url: width: f_media_width , format: 'webp' | image_tag: sizes: sizes, widths: f_widths, loading: 'lazy', alt: f_media_alt, class: 'motion-reduce', loading: loading, style: focal_point_style }}
    {% else %}
      {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
    {%- if hover_media != null and show_secondary_image -%}
      {%- case hover_media.media_type -%}
        {%- when 'image' -%}
          {{ hover_media | image_url: width: media_width , format: 'webp' | image_tag: sizes: sizes, widths: m_widths, loading: 'lazy', alt: media_alt, class: 'motion-reduce', loading: 'lazy', id: secondary_media_id, style: secondary_focal_point_style }}
        {%- when 'video', 'external_video' -%}
          {%- render 'video',
            video: hover_media,
            widths: widths,
            sizes: sizes,
            loading: loading,
            disable_controls: true,
            video_autoplay: true,
            video_loop: true,
            video_id: hover_media.id,
            section_id: section.id,
            id: secondary_media_id
          -%}
      {%- endcase -%}
    {%- endif -%}
  </div>
  <a href="{{ href_product_url }}" class="full-unstyled-link link-wrap z-2" aria-labelledby="MediaStandardCardNoMediaLink-{{ section_id }}-{{ card_product.id }}" id="MediaStandardCardNoMediaLink-{{ section_id }}-{{ card_product.id }}">
    <span class="visually-hidden">{{ card_product.title | escape }}</span>
  </a>
</card-media>