<side-drawer
  id="Drawer-Account"
  class="drawer drawer__container fixed top-0 left-0 w-screen h-full z-9 flex no-js-hidden"
  data-drawer-direction="right"
>
  <div id="Drawer-Overlay-Account" class="drawer__overlay fixed inset-0 cursor-pointer"></div>
  <div
    class="drawer__inner-wrapper color-{{ section.settings.color_scheme }}"
    data-drawer-content
    style="--drawer-max-width: var(--normal-content-width);"
  >
    <div
      class="drawer__inner cus-scrollbar"
      role="dialog"
      aria-modal="true"
      aria-label="Account Drawer"
      tabindex="-1"
    >
      <div
        class="drawer__header flex justify-between items-center relative"
        style="--gap-x: 1rem;--p: var(--padding-xs) 0;"
      >
        <h2 class="drawer__heading break m-0 h5">
          {%- liquid
            if customer
              echo 'Hi, ' | append: customer.name | default: 'Guest'
            else
              echo 'Sign in'
            endif
          -%}
        </h2>
        <button
          class="drawer__close block t-button bor-none rounded-full cursor-pointer"
          type="button"
          onclick="this.closest('side-drawer').close()"
          aria-label="Close Account Drawer"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>

      <div class="drawer__wrapper relative h-full cus-scrollbar motion-reduce" style="--p: 1.5rem 0 0;">
        <div class="drawer__content">
          <div class="drawer__content-inner">
            {% if customer %}
              <ul class="drawer__list list-unstyled m-0 p-0 flex flex-column" style="--gap-y: 2rem;" role="list">
                <li class="drawer__list-item flex justify-between items-center relative cursor-pointer" role="listItem">
                  <a
                    href="{{ routes.account_url }}"
                    class="link flex justify-between items-center flex-1 underline link--hover-underline paragraph"
                  >
                    <span class="text">{{ 'customer.account.details' | t }}</span>
                  </a>
                </li>

                <li class="drawer__list-item flex justify-between items-center relative cursor-pointer" role="listItem">
                  <a
                    href="{{ routes.account_addresses_url }}"
                    class="link flex justify-between items-center flex-1 underline link--hover-underline paragraph"
                  >
                    <span class="text">{{ 'customer.addresses.title' | t }}</span>
                  </a>
                </li>

                <li class="drawer__list-item flex justify-between items-center relative cursor-pointer" role="listItem">
                  <a
                    href="{{ routes.account_logout_url }}"
                    class="link flex justify-between items-center flex-1 underline link--hover-underline paragraph"
                  >
                    <span class="text">{{ 'customer.log_out' | t }}</span>
                  </a>
                </li>
              </ul>
            {% else %}
              {%- liquid
                assign gw_text = sec_stts.account_drawer_text
                assign gw_benefits = sec_stts.account_drawer_benefits
                assign gw_button = sec_stts.account_drawer_button_label | default: 'Continue to sign in'
                assign gw_note = sec_stts.account_drawer_note
              -%}

              {%- comment -%}
                The store is on new customer accounts, so /account/login leaves the theme
                entirely: Shopify serves sign-in from its own origin and no theme markup
                reaches it. A customer_login form here would post into that redirect and
                never sign anyone in, which is what used to sit in this branch.

                So the drawer stops being a login form and becomes the last screen that is
                ours - brand, type and copy - before one deliberate tap hands the customer
                over. The icon no longer drops them onto Shopify's page unannounced.
              {%- endcomment -%}

              <div class="customer-drawer__signin flex flex-column" style="--gap-y: var(--margin-xl);">
                {%- if gw_text != blank -%}
                  <p class="paragraph m-0">{{ gw_text }}</p>
                {%- endif -%}

                {%- if gw_benefits != blank -%}
                  <ul
                    class="drawer__list list-unstyled m-0 p-0 flex flex-column"
                    style="--gap-y: 1.2rem;"
                    role="list"
                  >
                    {%- assign gw_lines = gw_benefits | newline_to_br | split: '<br />' -%}
                    {%- for gw_line in gw_lines -%}
                      {%- assign gw_line_text = gw_line | strip -%}
                      {%- if gw_line_text != blank -%}
                        <li class="flex items-center paragraph" style="--gap-x: 1rem;" role="listItem">
                          <span class="svg-wrapper shrink-0" aria-hidden="true">
                            {{- 'icon-checkmark.svg' | inline_asset_content -}}
                          </span>
                          <span class="text">{{ gw_line_text }}</span>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <a href="{{ routes.account_login_url }}" class="button w-full">
                  <span
                    class="button-overflow relative overflow-hidden"
                    data-button-text="{{ gw_button | escape }}"
                  >
                    <span class="button-text-main inline-block relative z-1">
                      {{ gw_button }}
                    </span>
                  </span>
                </a>

                {%- if gw_note != blank -%}
                  <p class="paragraph m-0 opacity-70" style="--font-body-size: var(--font-size--xs);">
                    {{ gw_note }}
                  </p>
                {%- endif -%}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</side-drawer>
