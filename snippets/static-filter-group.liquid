{%- doc -%}
  Renders one filter group in the filter drawer from a fixed list of options, so the
  group shows every option whether or not the collection currently has products for it.
  Shopify's own `collection.filters` only return values that exist in the current
  result set, which is why these are needed alongside them.

  Markup mirrors the live (Shopify) list filters in `facets.liquid` so the two are
  indistinguishable in the drawer.

  @param {string} label - Group heading, e.g. "Shape"
  @param {string} values - Comma-separated options. Each is either "Label" or
                           "Label|filter-value"; without the second part the value is
                           the handleized label, optionally prefixed by `value_prefix`.
  @param {string} param_name - The filter query parameter, e.g. "filter.p.tag"
  @param {string} [value_prefix] - Prepended to auto-generated values, e.g. "shape:"
  @param {string} [index] - Suffix for element ids, to keep them unique
  @param {string} [section_id] - Section id, for unique element ids
  @param {string} [heading_label_case]
  @param {string} [heading_label_font_size]
  @param {string} [text_label_case]
  @param {string} [text_label_font_size]
{%- enddoc -%}

{%- liquid
  assign entries = values | split: ','
  assign group_handle = label | handle
-%}

<accordion-custom>
  {%- assign is_shape_group = false -%}
  {%- assign is_metal_group = false -%}
  {%- if group_handle == 'shape' -%}{%- assign is_shape_group = true -%}{%- endif -%}
  {%- if group_handle == 'metal' -%}{%- assign is_metal_group = true -%}{%- endif -%}
  <details
    id="Details-Mobile-static-{{ group_handle }}-{{ section_id }}"
    class="mobile-facets__details js-filter{% if is_shape_group %} mobile-facets__details--shape{% endif %}"
    data-index="mobile-static-{{ index }}"
  >
    <summary class="mobile-facets__summary focus-inset">
      <div
        class="flex items-center justify-between w-full"
        style="
          {%- if heading_label_case == 'uppercase' -%}
            --facet-label-transform: uppercase;
          {%- endif -%}
          --font-size: {{ heading_label_font_size }};
        "
      >
        <span>{{ label | escape }}</span>
        <span class="mobile-facets__arrow svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </div>
    </summary>
    <div
      id="FacetMobile-static-{{ group_handle }}-{{ section_id }}"
      class="mobile-facets__submenu details-content"
    >
      <ul
        class="facets-layout facets-layout-list facets-layout-list--text mobile-facets__list list-unstyled cus-scrollbar{% if is_shape_group %} mobile-facets__list--shape{% endif %}{% if is_metal_group %} mobile-facets__list--metal{% endif %}"
        role="list"
      >
        {%- for entry in entries -%}
          {%- liquid
            assign parts = entry | strip | split: '|'
            assign option_label = parts[0] | strip
            if option_label == blank
              continue
            endif

            assign option_value = parts[1] | strip
            if option_value == blank
              assign option_value = option_label | handle | prepend: value_prefix
            endif

            assign input_id = 'Filter-static-' | append: group_handle | append: '-' | append: forloop.index
            assign shape_icon = option_label | handle
            assign metal_type = blank
            assign metal_code = blank
            if is_metal_group
              assign metal_label = option_label | downcase
              if metal_label contains 'rose'
                assign metal_type = 'rose'
                assign metal_code = 'RG'
              elsif metal_label contains 'yellow'
                assign metal_type = 'yellow'
                assign metal_code = 'YG'
              elsif metal_label contains 'white'
                assign metal_type = 'white'
                assign metal_code = 'WG'
              elsif metal_label contains 'platinum'
                assign metal_type = 'platinum'
                assign metal_code = 'PL'
              elsif metal_label contains 'silver' or metal_label contains 'sterling'
                assign metal_type = 'silver'
                assign metal_code = 'SS'
              elsif metal_label contains 'two-toned'
                assign metal_type = 'two-tone'
                assign metal_code = '2T'
              endif

              assign first_metal_word = option_label | split: ' ' | first
              assign first_metal_word_size = first_metal_word | size
              assign first_metal_word_upper = first_metal_word | upcase
              if first_metal_word_upper contains 'K' and first_metal_word_size < 4
                assign metal_code = first_metal_word_upper
              endif
            endif
          -%}
          <li class="mobile-facets__item list-menu__item{% if is_shape_group %} mobile-facets__item--shape{% endif %}{% if is_metal_group %} mobile-facets__item--metal{% endif %}">
            <label for="{{ input_id }}" class="facets__label mobile-facets__label{% if is_shape_group %} mobile-facets__label--shape{% endif %}{% if is_metal_group %} mobile-facets__label--metal{% endif %}" style="--font-size: {{ text_label_font_size }};">
              <input
                class="mobile-facets__checkbox"
                type="checkbox"
                name="{{ param_name }}"
                value="{{ option_value | escape }}"
                id="{{ input_id }}"
              >

              {%- if is_metal_group and metal_type != blank -%}
                <span class="mobile-facets__shape-image mobile-facets__metal-tile">
                  <span class="mobile-facets__metal-circle mobile-facets__metal-circle--{{ metal_type }}" aria-hidden="true"></span>
                </span>
              {%- elsif is_shape_group -%}
                {%- assign shape_asset = 'diamond-shape-' | append: shape_icon | append: '.png' -%}
                <span class="mobile-facets__shape-image">
                  <img
                    src="{{ shape_asset | asset_url }}"
                    alt="{{ option_label | escape }}"
                    width="200"
                    height="200"
                    loading="lazy"
                  >
                </span>
              {%- else -%}
                <span class="mobile-facets__highlight"></span>
                {{- 'square.svg' | inline_asset_content -}}
                {{- 'icon-checkmark.svg' | inline_asset_content -}}
              {%- endif -%}

              <span class="facet-checkbox__text" aria-hidden="true">
                <span class="facet-checkbox__text-label {{ text_label_case }}">{{- option_label | escape -}}</span>
              </span>
              <span class="visually-hidden">{{ option_label | escape }}</span>
            </label>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </details>
</accordion-custom>
