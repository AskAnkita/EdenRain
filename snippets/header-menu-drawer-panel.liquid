{% comment %}
  Desktop mega menu panel, two columns:
  - a short list of categories, then "Shop all"
  - three featured products

  Categories come from the menu item's sub-links (Online Store > Navigation). A
  collection link without sub-links lists the product types in that collection.
  Featured products are the first three in the collection, so setting that
  collection's sort order to "Best selling" makes them the best sellers.
{% endcomment %}

{%- liquid
  assign source_collection = blank
  if link.type == 'collection_link'
    assign source_collection = link.object
  else
    for child in link.links
      if child.type == 'collection_link' and child.object.products_count > 0
        assign source_collection = child.object
        break
      endif
    endfor
  endif

  assign has_category_links = false
  for child in link.links
    if child.type != 'product_link'
      assign has_category_links = true
      break
    endif
  endfor

  # Some menus (Jewellery) set their own left-hand column rather than following the navigation
  assign static_groups = ''
  capture static_groups_source
    render 'menu-static-groups', parent: link.title
  endcapture
  assign static_groups_source = static_groups_source | strip
  if static_groups_source != ''
    assign static_groups = static_groups_source | split: ','
  endif

  # Three-level menus (Engagement > Shop by Style > Solitaire) show one column per group.
  # A group counts even when Liquid hands it no sub-links, as long as 'menu-static-items'
  # has a static list for it.
  assign has_groups = false
  if static_groups != ''
    assign has_groups = true
  else
    for child in link.links
      if child.links.size > 0
        assign has_groups = true
        break
      endif
      capture static_probe
        render 'menu-static-items', group: child.title, parent: link.title
      endcapture
      assign static_probe = static_probe | strip
      if static_probe != ''
        assign has_groups = true
        break
      endif
    endfor
  endif

  assign has_product_links = false
  for child in link.links
    if child.type == 'product_link'
      assign has_product_links = true
      break
    endif
  endfor

-%}

<div class="menu-drawer-desktop__page menu-drawer-desktop__page--featured menu-drawer-desktop__page--no-campaign{% if has_groups %} menu-drawer-desktop__page--tabs{% endif %}" id="{{ drawer_id }}" data-menu-drawer-page hidden>
  {%- if has_groups -%}
  {%- comment -%} Tabs: groups on the left; pointing at one shows its items as picture tiles {%- endcomment -%}
  <nav class="menu-drawer-desktop__tabs" aria-label="{{ link.title | escape }}">
    <ul role="list">
      {%- if static_groups != '' -%}
        {%- for entry in static_groups -%}
          {%- assign entry_parts = entry | split: '|' -%}
          <li>
            <button
              type="button"
              class="menu-drawer-desktop__tab{% if forloop.first %} is-active{% endif %}"
              data-menu-drawer-category="{{ drawer_id }}-{{ forloop.index }}"
            >
              <span>{{ entry_parts[0] | escape }}</span>
              <span class="menu-drawer-desktop__tab-arrow" aria-hidden="true"></span>
            </button>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for child in link.links -%}
          <li>
            <button
              type="button"
              class="menu-drawer-desktop__tab{% if forloop.first %} is-active{% endif %}"
              data-menu-drawer-category="{{ drawer_id }}-{{ forloop.index }}"
            >
              <span>{{ child.title | escape }}</span>
              <span class="menu-drawer-desktop__tab-arrow" aria-hidden="true"></span>
            </button>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </nav>

  <div class="menu-drawer-desktop__tab-panels">
    {%- if static_groups != '' -%}
      {%- for entry in static_groups -%}
        {%- liquid
          assign entry_parts = entry | split: '|'
          assign tab_title = entry_parts[0]
          assign group_handle = entry_parts[1]
          assign group_source = entry_parts[2]
          assign group_heading = entry_parts[3] | default: tab_title
          assign group_id = drawer_id | append: '-' | append: forloop.index

          assign group_url = ''
          if group_handle != '-'
            assign group_url = group_handle | prepend: '/collections/'
          endif

          # The tiles are looked up under the tab's name, not the heading above them
          assign group_collection = blank
          assign group_sections = ''
          if group_source == 'featured'
            # the cards come from 'menu-featured-cards', not from collections
          elsif group_source == 'products'
            assign group_collection = collections[group_handle]
          else
            capture group_sections_source
              render 'menu-static-items', group: tab_title, parent: link.title
            endcapture
            assign group_sections = group_sections_source | strip
          endif
        -%}
        {%- if group_source == 'featured' -%}
          {%- render 'header-menu-drawer-featured',
            group_id: group_id,
            top_title: link.title,
            active: forloop.first
          -%}
        {%- else -%}
          {%- render 'header-menu-drawer-tiles',
            group_id: group_id,
            group_title: group_heading,
            group_url: group_url,
            tile_collection: group_collection,
            static_sections: group_sections,
            top_title: link.title,
            top_url: link.url,
            active: forloop.first
          -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for child in link.links -%}
        {%- assign group_id = drawer_id | append: '-' | append: forloop.index -%}
        {%- render 'header-menu-drawer-tiles', group_id: group_id, parent: child, top_title: link.title, top_url: link.url, active: forloop.first -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- else -%}
  <nav class="menu-drawer-desktop__nav" aria-label="{{ link.title | escape }}">
    <p class="menu-drawer-desktop__list-heading">{{ link.title | escape }}</p>
    <ul class="menu-drawer-desktop__nav-list" role="list">
      {%- if has_category_links -%}
        {%- for child in link.links -%}
          {%- unless child.type == 'product_link' -%}
            <li><a class="menu-drawer-desktop__nav-link" href="{{ child.url }}">{{ child.title | escape }}</a></li>
          {%- endunless -%}
        {%- endfor -%}
      {%- elsif source_collection != blank -%}
        {%- for type in source_collection.all_types limit: 6 -%}
          {%- if type != blank -%}
            <li><a class="menu-drawer-desktop__nav-link" href="{{ source_collection.url }}?filter.p.product_type={{ type | url_encode }}">{{ type | escape }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
    <a class="menu-drawer-desktop__view-all" href="{{ link.url }}">Shop all {{ link.title | downcase | escape }}</a>
  </nav>

  <div class="menu-drawer-desktop__featured">
    <p class="menu-drawer-desktop__list-heading">Best sellers</p>
    <ul class="menu-drawer-desktop__related-grid" role="list">
      {%- if source_collection != blank -%}
        {%- for product in source_collection.products limit: 3 -%}
          {%- render 'header-menu-drawer-related-card', product: product -%}
        {%- endfor -%}
      {%- elsif has_product_links -%}
        {%- assign shown = 0 -%}
        {%- for child in link.links -%}
          {%- if child.type == 'product_link' -%}
            {%- render 'header-menu-drawer-related-card', product: child.object, title: child.title -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- if shown == 3 -%}{%- break -%}{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for product in collections.all.products limit: 3 -%}
          {%- render 'header-menu-drawer-related-card', product: product -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>

  {%- endif -%}

</div>
