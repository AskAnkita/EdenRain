{%- doc -%}
  The row of diamond-shape icons under a product card: the <ul> alone, so whoever draws
  the card wraps it and lines it up for itself. blocks/_card-product-shapes.liquid is the
  product card's row; sections/favourites-carousel.liquid draws the same row under its
  panels. The rules live here so the two cannot drift apart.

  Values come from the first product option whose name contains "shape", else the
  `custom.diamond_shapes` metafield (a list of single-line text values, or one
  comma-separated value), else the product's "Shape:<cut>" tags, else `default_shapes`.
  The default is what makes the row show across a catalogue that carries no per-product
  shape data yet; pass nothing to show the row only for products that do. Only shapes
  the theme ships an icon for are drawn.

  The cut the row underlines is the cut the card's photo is in, which 'card-default-variant'
  decides. On a page that is about one cut - /collections/radiant-engagement-rings and the
  rest of the mega menu's Shop by Shape column, read by 'shape-context' - that is the cut
  the shopper asked for, so a grid of cards opens already showing it. A card that keeps
  the product's own featured photo instead says so with `own_photo`, and the row then
  underlines the cut that photo is in.

  When shapes come from a real product option and a value maps to a variant with its
  own image, the icon renders as a button; card-option-swatches.js reads its shape key
  and option index, combines them with whatever metal the card's metal row has
  selected, and swaps the card's photo for the variant matching both. Metafield, tag and
  default shapes have no variant behind them, so those stay decorative.

  Outputs nothing at all for a product with no shape to draw.

  @param {object} card_product - Product Liquid object
  @param {string} [default_shapes] - Comma separated cuts for a product that names none
  @param {boolean} [own_photo] - The card shows the product's featured photo, not the
    variant 'card-default-variant' picks

  Usage:
  {%- render 'card-shape-swatches', card_product: product, default_shapes: 'Round, Oval' -%}
{%- enddoc -%}

{%- capture default_variant -%}
  {%- unless own_photo -%}
    {%- render 'card-default-variant', card_product: card_product -%}
  {%- endunless -%}
{%- endcapture -%}

{%- capture page_shape -%}
  {%- render 'shape-context' -%}
{%- endcapture -%}

{%- liquid
  assign icon_shapes = 'round,oval,cushion,emerald,princess,radiant,asscher,heart,marquise,pear' | split: ','

  assign shape_source = ''
  assign shape_index = -1
  for option in card_product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'shape'
      assign shape_source = option.values | join: '||'
      assign shape_index = forloop.index0
      break
    endif
  endfor

  if shape_source == blank
    assign meta_shapes = card_product.metafields.custom.diamond_shapes.value
    if meta_shapes != blank
      assign shape_source = meta_shapes | join: '||'
    endif
  endif

  # Most of the catalogue carries its shape as a tag ("Shape:Round", and some rings
  # carry more than one) rather than as an option. Tag values have no variant behind
  # them, so those icons stay decorative.
  if shape_source == blank
    assign tag_shapes = ''
    for tag in card_product.tags
      assign tag_compare = tag | downcase
      if tag_compare contains 'shape:'
        assign tag_shape = tag | split: ':' | last | strip
        assign tag_shapes = tag_shapes | append: '||' | append: tag_shape
      endif
    endfor
    assign shape_source = tag_shapes | remove_first: '||'
  endif

  if shape_source == blank
    assign shape_source = default_shapes
  endif

  if shape_source contains '||'
    assign shape_values = shape_source | split: '||'
  else
    assign shape_values = shape_source | split: ','
  endif

  # The card's photo belongs to one particular variant, so underline that shape
  # rather than always the first -- the metals row picks its active dot the same way.
  #
  # 'card-default-variant' is the one answer to which variant the card opens on, and it
  # is what moves a card to the cut the page is about, so ask it first; the featured
  # image below only answers for the cards it left alone.
  assign active_shape = ''
  assign default_variant = default_variant | strip
  assign page_shape = page_shape | strip

  if default_variant != blank
    # Index 4, not `last`: a card moved on shape alone has empty metal fields, and
    # `split` drops trailing empties, so `last` can hand back the wrong field.
    assign default_variant_parts = default_variant | split: '||'
    assign chosen_shape_text = default_variant_parts[4] | downcase
    for shape in icon_shapes
      if chosen_shape_text contains shape
        assign active_shape = shape
        break
      endif
    endfor
  endif

  if active_shape == blank and shape_index >= 0 and card_product.featured_image != blank
    for variant in card_product.variants
      if variant.featured_image != blank and variant.featured_image.id == card_product.featured_image.id
        assign active_text = variant.options[shape_index] | downcase
        for shape in icon_shapes
          if active_text contains shape
            assign active_shape = shape
            break
          endif
        endfor
        break
      endif
    endfor
  endif

  # Most of the catalogue carries its cut as a tag or falls back to the default list,
  # and neither has a variant behind it for 'card-default-variant' to move to. The
  # page is still about one cut, so underline it where the row happens to draw it.
  if active_shape == blank and page_shape != blank
    assign shape_source_compare = shape_source | downcase
    if shape_source_compare contains page_shape
      assign active_shape = page_shape
    endif
  endif

  assign srcset_widths = '240,352,650,832,1200' | split: ','
-%}

{%- if shape_values.size > 0 -%}
  <ul class="card-shapes list-unstyled" role="list">
    {%- assign drawn = 0 -%}
    {%- for value in shape_values -%}
      {%- liquid
        assign value_text = value | strip

        # A shape the client has not priced yet sits at 0 across every one of its variants.
        # It comes back the moment a price arrives, so nothing is removed from the product --
        # the icon is simply not drawn while the shape has no price. Only shapes that are a
        # real product option can be checked; tag and metafield shapes have no variant behind
        # them, and only a product holding both a 0 and a real price pays for the lookup.
        if shape_index >= 0 and card_product.price_min == 0 and card_product.price_max > 0
          assign shape_has_price = false
          for priced_variant in card_product.variants
            if priced_variant.price > 0 and priced_variant.options[shape_index] == value_text
              assign shape_has_price = true
              break
            endif
          endfor
          unless shape_has_price
            continue
          endunless
        endif

        assign value_compare = value_text | downcase
        assign matched_shape = ''
        for shape in icon_shapes
          if value_compare contains shape
            assign matched_shape = shape
            break
          endif
        endfor
      -%}
      {%- if matched_shape != blank -%}
        {%- liquid
          assign is_active_shape = false
          if active_shape != blank
            if matched_shape == active_shape
              assign is_active_shape = true
            endif
          elsif drawn == 0
            assign is_active_shape = true
          endif

          assign value_image = null
          assign value_variant_id = ''
          if shape_index >= 0
            for variant in card_product.variants
              if variant.options[shape_index] == value_text and variant.featured_image != blank
                assign value_image = variant.featured_image
                assign value_variant_id = variant.id
                break
              endif
            endfor
          endif
        -%}
        {%- capture icon -%}
          {%- comment -%}
            The same call the mega menu's shape column makes, so a cut is the one drawing
            wherever a shopper meets it: 'shape-outline-<cut>.png' from Content > Files, and
            the drawn 'icon-diamond-shape' outline for any cut with no picture of its own.
          {%- endcomment -%}
          {%- render 'menu-link-icon',
            icons: 'shapes',
            key: matched_shape,
            prefix: 'card-shapes__icon',
            source_width: 64
          -%}
          <span class="visually-hidden">{{ value_text | escape }}</span>
        {%- endcapture -%}
        <li class="card-shapes__item{% if is_active_shape %} is-active{% endif %}">
          {%- if value_image -%}
            {%- capture value_srcset -%}
              {%- for width in srcset_widths -%}
                {%- assign width_number = width | plus: 0 -%}
                {%- if width_number < value_image.width -%}
                  {{ value_image | image_url: width: width_number, format: 'webp' }} {{ width_number }}w,
                {%- endif -%}
              {%- endfor -%}
              {{ value_image | image_url: width: value_image.width, format: 'webp' }} {{ value_image.width }}w
            {%- endcapture -%}
            <button
              type="button"
              class="card-shapes__button card-swatch-button"
              aria-pressed="{% if is_active_shape %}true{% else %}false{% endif %}"
              data-card-swatch
              data-swatch-role="shape"
              data-swatch-key="{{ matched_shape }}"
              data-swatch-option-index="{{ shape_index }}"
              data-swatch-src="{{ value_image | image_url: width: 832, format: 'webp' | escape }}"
              data-swatch-srcset="{{ value_srcset | strip | strip_newlines | escape }}"
              data-swatch-alt="{{ card_product.title | append: ' - ' | append: value_text | escape }}"
              data-swatch-variant="{{ value_variant_id }}"
            >
              {{ icon }}
            </button>
          {%- else -%}
            {{ icon }}
          {%- endif -%}
        </li>
        {%- assign drawn = drawn | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
