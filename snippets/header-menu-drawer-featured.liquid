{% comment %}
  The "Featured" tab of a desktop mega menu: four large cards in one row, each a picture or a
  looping video with one line of copy over it. The other tabs use 'header-menu-drawer-tiles'.

  Accepts:
  - group_id: {String} matches the tab button's data-menu-drawer-category
  - active: {Boolean} shown first
  - top_title: {String} the top-level item's title, used to look up the cards
  - group_title: {String} optional; the tab's own name, passed on so a menu can give cards to
    a tab that isn't called "Featured" - Diamonds does this with its Learn tab

  The cards themselves come from 'menu-featured-cards'. Nothing is output when that snippet
  lists none for this menu, which leaves the tab empty rather than half-built.
{% endcomment %}

{%- liquid
  capture cards_source
    render 'menu-featured-cards', parent: top_title, group: group_title
  endcapture
  assign cards = cards_source | strip
-%}

<div class="menu-drawer-desktop__group" data-menu-drawer-group="{{ group_id }}"{% unless active %} hidden{% endunless %}>
  {%- if cards != '' -%}
    <ul class="menu-drawer-desktop__features" role="list">
      {%- assign card_list = cards | split: '~' -%}
      {%- for card in card_list -%}
        {%- liquid
          assign card_parts = card | split: '|'
          assign card_caption = card_parts[0] | strip
          assign card_url = card_parts[1] | strip
          assign card_image = card_parts[2] | strip
          assign card_video = card_parts[3] | strip

          assign image_setting_prefix = ''
          assign parent_key = top_title | handle
          case parent_key
            when 'engagement'
              assign image_setting_prefix = 'mm_eng_featured'
            when 'wedding'
              assign image_setting_prefix = 'mm_wed_featured'
            when 'jewellery'
              assign image_setting_prefix = 'mm_jwl_featured'
            when 'diamonds'
              assign image_setting_prefix = 'mm_dia_learn'
          endcase
          assign image_setting_key = image_setting_prefix | append: '_' | append: forloop.index
          assign selected_card_image = settings[image_setting_key]
          if selected_card_image != blank
            assign card_image_src = selected_card_image | image_url: width: 800
            capture card_image_srcset
              echo selected_card_image | image_url: width: 500
              echo ' 500w, '
              echo selected_card_image | image_url: width: 800
              echo ' 800w'
            endcapture
          else
            assign card_image_src = card_image | asset_img_url: '800x'
            capture card_image_srcset
              echo card_image | asset_img_url: '500x'
              echo ' 500w, '
              echo card_image | asset_img_url: '800x'
              echo ' 800w'
            endcapture
          endif
        -%}
        <li class="menu-drawer-desktop__feature">
          <a class="menu-drawer-desktop__feature-link" href="{{ card_url }}">
            <span class="menu-drawer-desktop__feature-media">
              {%- if card_video != blank -%}
                {%- comment -%}
                  The video lives in Content > Files, not in the theme. It is left unplayed
                  until its tab is opened (see menu-drawer-desktop.js), so a menu that is
                  never opened costs nothing, and the still stands in if the file is missing.
                {%- endcomment -%}
                <video
                  class="menu-drawer-desktop__feature-video"
                  poster="{{ card_image_src }}"
                  preload="none"
                  muted
                  loop
                  playsinline
                  disablepictureinpicture
                  aria-hidden="true"
                  tabindex="-1"
                >
                  <source src="{{ card_video | file_url }}" type="video/mp4">
                </video>
              {%- else -%}
                <img
                  src="{{ card_image_src }}"
                  srcset="{{ card_image_srcset }}"
                  sizes="20vw"
                  alt="{{ card_caption | escape }}"
                  width="800"
                  height="1020"
                  loading="lazy"
                >
              {%- endif -%}
            </span>
            <span class="menu-drawer-desktop__feature-caption">{{ card_caption | escape }}</span>
          </a>

          {%- if card_video != blank -%}
            <button
              type="button"
              class="menu-drawer-desktop__feature-toggle is-paused"
              data-menu-drawer-video
              aria-label="Play video, {{ card_caption | escape }}"
            >
              <svg class="menu-drawer-desktop__feature-icon-pause" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path d="M3 1.5h2.2v9H3zM6.8 1.5H9v9H6.8z" fill="currentColor"/>
              </svg>
              <svg class="menu-drawer-desktop__feature-icon-play" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                <path d="M3.4 1.6 10 6l-6.6 4.4z" fill="currentColor"/>
              </svg>
            </button>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
