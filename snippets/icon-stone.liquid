{%- doc -%}
  Outline icon for a stone - the material, not the cut - to read at ~28px beside a menu link in
  the Jewellery panel. Companion to 'icon-diamond-shape', which draws the cut: Round there is
  the outline of a round brilliant, Pearl here is what a pearl is made of.

  The faceted stones are drawn with their facets, the cabochons with what marks the surface -
  a glint on a pearl, veining in turquoise, banding in onyx, flecks in an opal - which is what
  tells four round stones apart at this size.

  @param {string} stone - one of cubic-zirconia, lab-grown-diamond, pearl, shell-abalone,
    turquoise, black-onyx, opal, birthstone

  A stone with no drawing here renders an empty box, so every name a menu column puts an icon
  beside has to be listed above.
{%- enddoc -%}

<svg
  class="icon-stone"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="0.9"
  stroke-linejoin="round"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case stone -%}
    {%- comment -%}
      A brilliant seen face-on, cut on six sides rather than round: the simulant the shop sets
      most, and drawn apart from the round cut in 'icon-diamond-shape' on purpose.
    {%- endcomment -%}
    {%- when 'cubic-zirconia' -%}
      <path d="M12 3.4l7.4 4.3v8.6L12 20.6l-7.4-4.3V7.7z"/>
      <path d="M12 7.6l3.8 2.2v4.4L12 16.4l-3.8-2.2V9.8z"/>
      <path d="M12 3.4v4.2M19.4 7.7l-3.6 2.1M19.4 16.3l-3.6-2.1M12 20.6v-4.2M4.6 16.3l3.6-2.1M4.6 7.7l3.6 2.1"/>

    {%- comment -%} A brilliant from the side: table, crown, girdle and the pavilion to its point {%- endcomment -%}
    {%- when 'lab-grown-diamond' -%}
      <path d="M8.2 4.6h7.6l4.4 5.4H3.8z"/>
      <path d="M3.8 10 12 20.4 20.2 10"/>
      <path d="M8.2 4.6 6.6 10 12 20.4 17.4 10 15.8 4.6"/>
      <path d="M9.8 10h4.4"/>

    {%- comment -%} The bead, with the glint that says it is a pearl and not a plain circle {%- endcomment -%}
    {%- when 'pearl' -%}
      <circle cx="12" cy="12" r="7.6"/>
      <path d="M7.6 10a5.8 5.8 0 0 1 3.6-3.4"/>
      <path d="M7 13.4a6 6 0 0 1 .1-1.6"/>

    {%- comment -%} A scallop: the hinge at the foot, the fan opening from it, and its ribs {%- endcomment -%}
    {%- when 'shell-abalone' -%}
      <path d="M12 19.8 4.2 9.8A9.2 9.2 0 0 1 19.8 9.8Z"/>
      <path d="M12 19.8V5.5M12 19.8 7 7M12 19.8 17 7"/>

    {%- comment -%} A nugget rather than a round bead, with the veining through it {%- endcomment -%}
    {%- when 'turquoise' -%}
      <path d="M11.4 4.4c4.7-.9 8.4 2.4 8.4 7.2 0 5-3.6 8.4-8.2 8.4-4.3 0-7.4-3.2-7.4-7.8 0-4.2 2.4-7 7.2-7.8z"/>
      <path d="M6.6 8.2 9.2 11l-1.6 2.4 3 3.4 1.8-1.6 2.8 3.6"/>
      <path d="M14.2 12.2 17 9.2"/>

    {%- comment -%} A flat cabochon with the banding onyx is cut for {%- endcomment -%}
    {%- when 'black-onyx' -%}
      <ellipse cx="12" cy="12" rx="8" ry="5.8"/>
      <path d="M4.8 9.6c4.6 1.9 9.9 1.9 14.4 0"/>
      <path d="M6 14.8c3.8-1.5 8.2-1.5 12 0"/>

    {%- comment -%} A cabochon with the flecks of colour in it {%- endcomment -%}
    {%- when 'opal' -%}
      <circle cx="12" cy="12" r="7.6"/>
      <path d="M9.4 9.4l1.1 1.2-1.1 1.2-1.1-1.2z"/>
      <path d="M14.4 8.8l1 1.1-1 1.1-1-1.1z"/>
      <path d="M11.8 13.4l1.3 1.4-1.3 1.4-1.3-1.4z"/>

    {%- comment -%} Any month's stone: an emerald cut, with a sparkle to say it stands for a set {%- endcomment -%}
    {%- when 'birthstone' -%}
      <path d="M8.8 6.4h6.4l2.4 2.4v6.4l-2.4 2.4H8.8l-2.4-2.4V8.8z"/>
      <path d="M10 8.8h4l1.4 1.4v3.6L14 15.2h-4l-1.4-1.4v-3.6z"/>
      <path d="M19.4 3.2Q19.7 5.3 21.6 5.6 19.7 5.9 19.4 8 19.1 5.9 17.2 5.6 19.1 5.3 19.4 3.2z"/>
  {%- endcase -%}
</svg>
