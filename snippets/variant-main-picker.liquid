{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
{%- enddoc -%}

{%- liquid
  assign bl_stts = block.settings
  assign custom_fields = product.metafields.custom.combined_products_listing
  assign show_combined_products_listing = false
  if custom_fields != blank and settings.enable_combined_products_listing
    assign show_combined_products_listing = true
  endif
  assign show_variant_picker = true
  if product_resource.has_only_default_variant
    assign show_variant_picker = false
  endif
-%}

{% if show_combined_products_listing or show_variant_picker %}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch.css' | asset_url | stylesheet_tag }}

  <variant-selects
    id="variant-selects-{{ block.id }}"
    class="variant-selects spacing-style variant-selects--{{ bl_stts.alignment }}"
    style="{% render 'spacing-style', settings: bl_stts %}"
    data-section="{{ block.id }}"
    data-section-id="{{ block.id }}"
    data-product-id="{{ product_resource.id }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    {% if context %}
      data-context="{{ context }}"
    {% endif %}
    ref="mainVariantSelects"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    {%- if show_combined_products_listing -%}
      <div class="swatch-custom product-form__input">
        <p class="form__label-combined form__label">{{ 'products.product.color' | t }}<span>{{ product.metafields.custom.combined_products_listing_name_color }}</span></p>
        <ul class="list-unstyled flex flex-align-center flex-wrap">
          {%- for referenced_product in custom_fields.value -%}
            {%- liquid
              assign image_custom = referenced_product.metafields.custom.combined_products_listing_image.value
            -%}
            <li class="item-custom{% if referenced_product.id == product.id %} active{% endif %} swatch-item relative">
              <div class="item-custom--image">
                <{% if referenced_product.id == product.id %}span{% else %}a href ="{{shop.url | append: "/products/" | append: referenced_product.handle }}"{% endif %}
                  class="item-custom--inner swatch"
                  style="
                    {%- if image_custom != blank -%}
                      background: url({{ image_custom | img_url: 'medium' }});
                    {%- else -%}
                      background: url({{ referenced_product.featured_image | img_url: 'medium' }});
                    {%- endif -%}
                    background-size: cover;"
                  title="{{referenced_product.title}}"
                >
                </{% if referenced_product.id == product.id %}span{% else %}a{% endif %}>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
    {%- if show_variant_picker -%}
    {%- for product_option in product_resource.options_with_values -%}
      {%- liquid
        assign variant_style = bl_stts.variant_style
        assign show_swatches = bl_stts.show_swatches
        assign swatch_size = bl_stts.swatch_size
        assign product_swatch_option = settings.swatch | downcase
        assign swatch_type = settings.swatch_type
        assign show_variant_media_grouped = settings.show_variant_media_grouped
        assign option_name = product_option.name | downcase
        assign is_color = false
        if show_swatches and product_swatch_option contains option_name
          assign is_color = true
        endif
        # The swatch setting is "Metal Type", so an option called Metal, Metal Type
        # or Finish would fall through to the metaobject swatch renderer and lose
        # the metal circles. Any option whose values are metals takes the pill
        # path instead, so every product picks up the same UI whatever the
        # option happens to be named.
        assign option_values_probe = product_option.values | join: ' ' | downcase
        if option_values_probe contains 'gold' or option_values_probe contains 'platinum' or option_values_probe contains 'silver'
          assign is_color = false
        endif
        assign skip_combined_color_option = false
        if show_combined_products_listing and product_swatch_option contains option_name
          assign skip_combined_color_option = true
        endif

        if is_color
          if bl_stts.variant_style == 'dropdowns'
            assign variant_style = 'dropdowns'
          else
            assign variant_style = 'swatch'
          endif
        endif

        assign is_size = false
        if option_name contains 'size'
          assign is_size = true
          assign variant_style = 'dropdowns'
        endif
      -%}
      {%- unless skip_combined_color_option -%}
      {%- if variant_style == 'pills' or variant_style == 'swatch' -%}
        <fieldset  class="js product-form__input variant-option variant-option--buttons{% if is_color %} product-form__input--swatch variant-option--swatches{% else %} product-form__input--pill variant-option--pill{% endif %}">
          <legend class="form__label">
            {{ product_option.name  | escape }}:
            <span data-selected-value>
              {{- product_option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            option: product_option,
            block: block,
            variant_style: variant_style,
            swatch_type: swatch_type,
            swatch_size: swatch_size,
            is_color: is_color,
            is_size: is_size,
            index: forloop.index0,
            product: product_resource,
            show_variant_media_grouped: show_variant_media_grouped
          %}
        </fieldset>
      {%- elsif variant_style == 'dropdowns' -%}
        {% liquid
          assign property_being_updated = false
          if settings.variant_swatch_width != settings.variant_swatch_height
            assign property_being_updated = true
            assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
          endif
        %}
        <div class="product-form__input product-form__input--dropdown variant-option variant-option--dropdowns{% if is_size %} variant-option--size{% endif %}">
          <label class="form__label" for="Option-{{ block.id }}-{{ forloop.index0 }}">
            <span class="variant-option__label-title">
              {%- if is_size and option_name contains 'ring' -%}
                U.S. Ring Size:
              {%- elsif is_size and option_name == 'size' -%}
                U.S. Ring Size:
              {%- else -%}
                {{ product_option.name  | escape }}:
              {%- endif -%}
            </span>
            {%- if is_size -%}
              <a
                href="#size-chart"
                class="size-guide-link"
                role="button"
                tabindex="0"
                onclick="event.preventDefault(); const opener = document.querySelector('side-drawer-opener.size-chart button, [data-side-drawer*=&quot;size&quot;] button, side-drawer-opener[data-side-drawer*=&quot;Size&quot;] button'); if (opener) { opener.click(); } else { window.open('/pages/er-sizing', '_blank'); }"
              >
                Size Guide
              </a>
            {%- else -%}
              <span data-selected-value>
                {{- product_option.selected_value -}}
              </span>
            {%- endif -%}
          </label>
          <div
            class="select variant-option__select-wrapper"
            style="
              {%- if property_being_updated  -%}
                --variant-selects-swatch-width: clamp(10px,{{ new_width }}px, 50px);
              {%- endif -%}
            "
          >
            {% render 'product-variant-options',
              option: product_option,
              block: block,
              variant_style: variant_style,
              swatch_type: swatch_type,
              swatch_size: swatch_size,
              is_color: is_color,
              is_size: is_size,
              index: forloop.index0,
              product: product_resource,
              show_variant_media_grouped: show_variant_media_grouped
            %}
          </div>
        </div>
      {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}

    {%- liquid
      assign has_size_option = false
      for opt in product_resource.options_with_values
        assign opt_name_check = opt.name | downcase
        if opt_name_check contains 'size'
          assign has_size_option = true
          break
        endif
      endfor
    -%}
    {%- unless has_size_option -%}
      {%- liquid
        assign is_ring = false
        assign p_title_lower = product_resource.title | downcase
        assign p_type_lower = product_resource.type | downcase
        assign p_tags_string = product_resource.tags | join: ' ' | downcase
        if p_title_lower contains 'ring' or p_type_lower contains 'ring' or p_tags_string contains 'ring'
          assign is_ring = true
        endif
      -%}
      {%- if is_ring -%}
        <div class="product-form__input product-form__input--dropdown variant-option variant-option--dropdowns variant-option--size">
          <label class="form__label" for="Option-{{ block.id }}-ring-size">
            <span class="variant-option__label-title">U.S. Ring Size:</span>
            <a
              href="#size-chart"
              class="size-guide-link"
              role="button"
              tabindex="0"
              onclick="event.preventDefault(); const opener = document.querySelector('side-drawer-opener.size-chart button, [data-side-drawer*=&quot;size&quot;] button, side-drawer-opener[data-side-drawer*=&quot;Size&quot;] button'); if (opener) { opener.click(); } else { window.open('/pages/er-sizing', '_blank'); }"
            >
              Size Guide
            </a>
          </label>
          <div class="select variant-option__select-wrapper">
            <select
              id="Option-{{ block.id }}-ring-size"
              class="select__select variant-option__select"
              name="properties[Ring Size]"
              form="{{ 'product-form-' | append: block.id }}"
              required
            >
              <option value="" disabled selected hidden>Select Ring Size</option>
              {%- assign standard_sizes = '3,3.5,4,4.5,5,5.5,6,6.5,7,7.5,8,8.5,9,9.5,10,10.5,11,11.5,12' | split: ',' -%}
              {%- for sz in standard_sizes -%}
                <option value="{{ sz }}">Size {{ sz }}</option>
              {%- endfor -%}
            </select>
            <span class="svg-wrapper">
              <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </span>
          </div>
        </div>
      {%- endif -%}
    {%- endunless -%}

    <script type="application/json" data-selected-variant>
      {{ product_resource.selected_or_first_available_variant | json }}
    </script>
    {%- endif -%}
  </variant-selects>
{% endif %}

<script>
  {% assign selected_variant = product.selected_or_first_available_variant %}
  window.product_inventory_policy_array_{{ product.id }} = {
    '{{ selected_variant.id }}': '{{ selected_variant.inventory_policy }}',
  };
</script>
