{% doc %}
  @prompt
    Generate this 
    
    1. Main Heading
    
    Text: FIND YOUR STYLE
    Typography: Fully controlled by theme settings (font family, weight, size, line height, letter spacing)
    Alignment: Center
    
    2. Layout Settings
    
    Type: Carousel
    Columns: 5 (Desktop)
    Mobile Columns: 2
    Alignment: Center
    Position: Top
    Gap: 20px
    Pagination Type: Dots
    Loop: Enabled
    
    3. Carousel Controls
    
    Navigation: Arrows + Pagination
    Pagination Type: Dots
    Loop: ON
    
    4. Appearance / Colors
    
    Inherit Color Scheme: OFF
    Background: #FFFFFF
    Background Gradient: Optional
    Headings: #000000
    Text: #333333
    Links: #007BFF
    Hover Links: #0056B3
    Borders: #E0E0E0
    Shadow: 0 4px 8px rgba(0,0,0,0.1)
    
    5. Padding
    
    Top: 40px
    Bottom: 40px
    Left: 20px
    Right: 20px
    
    6. Collection Items (12 Items Max)
    
    For each collection (repeat up to 12 items):
    
    Image
    Default Image: Upload primary image
    Hover Image: Upload alternate hover image
    Image Display: Maintain original image aspect ratio (DO NOT force square or fixed size)
    Image Fit: Cover / Contain based on natural image behavior (responsive, no cropping distortion unless required by layout)
    Content Overlay: OFF
    Link
    Paste collection link
    Open link in new tab: ON
    Hide on tablet: OFF
    Hide on mobile: OFF
    Text
    Collection Title displayed below image
    Typography: Controlled by theme settings (size, weight, color, alignment)
    
    ⚠️ Important Rule: Only collections with uploaded images will appear on the frontend. If fewer than 12 collections are added (e.g., 5), only those 5 will display.
    
    7. Responsive / Mobile Settings
    
    Columns: 2
    Gap: 12px
    Alignment: Center
    Position: Top
    
    8. Optional Enhancements
    Hover Animation: Scale up to 1.05x
    Hover Shadow: 0 6px 12px rgba(0,0,0,0.15)
    Auto-play Carousel: Enabled
    Slide Speed: 4 seconds per slide
    Key Fix Applied:
    
    ✔ Removed forced square image constraint
    ✔ Allowed natural image aspect ratio (responsive, no fixed cropping behavior)
    ✔ Ensured images display based on uploaded proportions while staying visually consistent in carousel
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    {% comment %} chaneg padding bottom of find your style  {% endcomment %}
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px 20px {{ block.settings.padding_left }}px;
    {% if block.settings.inherit_color_scheme == false %}
      background: {{ block.settings.background_color }};
      {% if block.settings.background_gradient != blank %}
        background: {{ block.settings.background_gradient }};
      {% endif %}
    {% endif %}
  }

  .ai-collection-carousel-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
  }

  .ai-collection-carousel-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 30px;
    {% if block.settings.inherit_color_scheme == false %}
      color: {{ block.settings.heading_color }};
    {% endif %}
  }

  .ai-collection-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-collection-carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-collection-carousel-item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.columns_desktop | minus: 1 }} * {{ block.settings.gap }}px)) / {{ block.settings.columns_desktop }});
    position: relative;
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-collection-carousel-link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    {% if block.settings.inherit_color_scheme == false %}
      color: {{ block.settings.text_color }};
    {% endif %}
  }

  .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    width: 100%;
    margin-bottom: 15px;
    border-radius: 8px;
    {% if block.settings.show_shadow %}
      box-shadow: {{ block.settings.shadow }};
    {% endif %}
  }

  .ai-collection-carousel-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .ai-collection-carousel-image-hover-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-collection-carousel-link-{{ ai_gen_id }}:hover .ai-collection-carousel-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-collection-carousel-link-{{ ai_gen_id }}:hover .ai-collection-carousel-image-hover-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-collection-carousel-link-{{ ai_gen_id }}:hover .ai-collection-carousel-image-wrapper-{{ ai_gen_id }} {
    {% if block.settings.show_hover_shadow %}
      box-shadow: {{ block.settings.hover_shadow }};
    {% endif %}
  }

  .ai-collection-carousel-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 500;
    margin: 0;
    {% if block.settings.inherit_color_scheme == false %}
      color: {{ block.settings.text_color }};
    {% endif %}
  }

  .ai-collection-carousel-link-{{ ai_gen_id }}:hover .ai-collection-carousel-title-{{ ai_gen_id }} {
    {% if block.settings.inherit_color_scheme == false %}
      color: {{ block.settings.link_hover_color }};
    {% endif %}
  }
  {% comment %} - put title inside image add border effect--- {% endcomment %}
/* Title Base Style */
.ai-collection-carousel-title-{{ ai_gen_id }} {
  position: absolute;
  bottom: 30px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  margin: 0;
  font-family: var(--font-body--family);
  font-size: 16px;
  font-weight: 500;
  
  /* Underline styling */
  background-image: linear-gradient(#000, #000);
  background-repeat: no-repeat;
  background-position: left bottom;
  background-size: 100% 1px;
  padding-bottom: 4px;

  /* Smooth transition for color and underline */
  transition: all 0.3s ease;
  {% if block.settings.inherit_color_scheme == false %}
    color: {{ block.settings.text_color }};
  {% endif %}
}

/* Hover effect: Triggered when the image link is hovered */
.ai-collection-carousel-link-{{ ai_gen_id }}:hover .ai-collection-carousel-title-{{ ai_gen_id }} {
  background-image: linear-gradient(#fff, #fff); /* Underline becomes white */
  color: #fff; /* Optional: Makes the text white as well */
}


  .ai-collection-carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid {{ block.settings.border_color }};
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: background 0.3s ease;
  }

  .ai-collection-carousel-nav-{{ ai_gen_id }}:hover {
    background: rgba(255, 255, 255, 1);
  }

  .ai-collection-carousel-nav-prev-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-collection-carousel-nav-next-{{ ai_gen_id }} {
    right: 10px;
  }

  .ai-collection-carousel-nav-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    fill: #333;
  }

  .ai-collection-carousel-pagination-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 30px;
  }

  .ai-collection-carousel-dot-{{ ai_gen_id }} {
    display:none !important;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: #ccc;
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease;
  }

  .ai-collection-carousel-dot-{{ ai_gen_id }}.active {
    background: #333;
    transform: scale(1.2);
  }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel-item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.columns_mobile | minus: 1 }} * {{ block.settings.gap_mobile }}px)) / {{ block.settings.columns_mobile }});
    }

    .ai-collection-carousel-track-{{ ai_gen_id }} {
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-collection-carousel-nav-prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-collection-carousel-nav-next-{{ ai_gen_id }} {
      right: 10px;
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }} class="ai-collection-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-collection-carousel-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-collection-carousel-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-collection-carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-collection-carousel-track-{{ ai_gen_id }}">
        {% for i in (1..12) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign image_key = 'collection_image_' | append: i
            assign hover_image_key = 'collection_hover_image_' | append: i
            assign link_key = 'collection_link_' | append: i
            assign title_key = 'collection_title_' | append: i
            assign open_new_tab_key = 'collection_open_new_tab_' | append: i
            assign hide_tablet_key = 'collection_hide_tablet_' | append: i
            assign hide_mobile_key = 'collection_hide_mobile_' | append: i

            assign collection_image = block.settings[image_key]
            assign collection_hover_image = block.settings[hover_image_key]
            assign collection_link = block.settings[link_key]
            assign collection_title = block.settings[title_key]
            assign open_new_tab = block.settings[open_new_tab_key]
            assign hide_tablet = block.settings[hide_tablet_key]
            assign hide_mobile = block.settings[hide_mobile_key]
          %}

          {% if collection_image != blank %}
            <div class="ai-collection-carousel-item-{{ ai_gen_id }}" data-hide-tablet="{{ hide_tablet }}" data-hide-mobile="{{ hide_mobile }}">
              <a 
                href="{{ collection_link }}" 
                class="ai-collection-carousel-link-{{ ai_gen_id }}"
                {% if open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
                <div class="ai-collection-carousel-image-wrapper-{{ ai_gen_id }}">
                  <img
                    src="{{ collection_image | image_url: width: 600 }}"
                    alt="{{ collection_image.alt | escape }}"
                    loading="lazy"
                    width="{{ collection_image.width }}"
                    height="{{ collection_image.height }}"
                    class="ai-collection-carousel-image-{{ ai_gen_id }}"
                  >
                  {% if collection_hover_image != blank %}
                    <img
                      src="{{ collection_hover_image | image_url: width: 600 }}"
                      alt="{{ collection_hover_image.alt | escape }}"
                      loading="lazy"
                      width="{{ collection_hover_image.width }}"
                      height="{{ collection_hover_image.height }}"
                      class="ai-collection-carousel-image-hover-{{ ai_gen_id }}"
                    >
                  {% endif %}
                </div>
                {% if collection_title != blank %}
                  <h3 class="ai-collection-carousel-title-{{ ai_gen_id }}">{{ collection_title }}</h3>
                {% endif %}
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if block.settings.show_arrows %}
        <button class="ai-collection-carousel-nav-{{ ai_gen_id }} ai-collection-carousel-nav-prev-{{ ai_gen_id }}" aria-label="Previous">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
          </svg>
        </button>
        <button class="ai-collection-carousel-nav-{{ ai_gen_id }} ai-collection-carousel-nav-next-{{ ai_gen_id }}" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
          </svg>
        </button>
      {% endif %}
    </div>

    {% if block.settings.show_pagination %}
      <div class="ai-collection-carousel-pagination-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class CollectionCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-collection-carousel-track-{{ ai_gen_id }}');
        this.items = Array.from(this.querySelectorAll('.ai-collection-carousel-item-{{ ai_gen_id }}'));
        this.prevBtn = this.querySelector('.ai-collection-carousel-nav-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-collection-carousel-nav-next-{{ ai_gen_id }}');
        this.paginationContainer = this.querySelector('.ai-collection-carousel-pagination-{{ ai_gen_id }}');

        this.itemsPerView = {{ block.settings.columns_desktop }};
        this.gap = {{ block.settings.gap }};
        this.loop = {{ block.settings.enable_loop }};
        this.autoplay = {{ block.settings.enable_autoplay }};
        this.autoplaySpeed = {{ block.settings.autoplay_speed }} * 1000;

        if (window.innerWidth <= 749) {
          this.itemsPerView = {{ block.settings.columns_mobile }};
          this.gap = {{ block.settings.gap_mobile }};
        }

        this.visibleItems = this.items.filter(item => {
          if (window.innerWidth <= 749 && item.dataset.hideMobile === 'true') return false;
          if (window.innerWidth > 749 && window.innerWidth <= 989 && item.dataset.hideTablet === 'true') return false;
          return true;
        });

        this.totalSlides = Math.ceil(this.visibleItems.length / this.itemsPerView);

        this.setupEventListeners();
        this.createPagination();
        this.updateCarousel();

        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      setupEventListeners() {
        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', () => this.prev());
        }
        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', () => this.next());
        }

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => {
          if (this.autoplay) this.startAutoplay();
        });
      }

      createPagination() {
        if (!this.paginationContainer) return;

        this.paginationContainer.innerHTML = '';
        for (let i = 0; i < this.totalSlides; i++) {
          const dot = document.createElement('button');
          dot.classList.add('ai-collection-carousel-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          if (i === 0) dot.classList.add('active');
          dot.addEventListener('click', () => this.goToSlide(i));
          this.paginationContainer.appendChild(dot);
        }
      }

      updateCarousel() {
        const itemWidth = (100 / this.itemsPerView);
        const offset = -this.currentIndex * itemWidth;
        this.track.style.transform = `translateX(${offset}%)`;

        if (this.paginationContainer) {
          const dots = this.paginationContainer.querySelectorAll('.ai-collection-carousel-dot-{{ ai_gen_id }}');
          dots.forEach((dot, index) => {
            dot.classList.toggle('active', index === this.currentIndex);
          });
        }
      }

      next() {
        if (this.loop) {
          this.currentIndex = (this.currentIndex + 1) % this.totalSlides;
        } else {
          this.currentIndex = Math.min(this.currentIndex + 1, this.totalSlides - 1);
        }
        this.updateCarousel();
      }

      prev() {
        if (this.loop) {
          this.currentIndex = (this.currentIndex - 1 + this.totalSlides) % this.totalSlides;
        } else {
          this.currentIndex = Math.max(this.currentIndex - 1, 0);
        }
        this.updateCarousel();
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      startAutoplay() {
        this.stopAutoplay();
        this.autoplayInterval = setInterval(() => this.next(), this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }
    }

    customElements.define('collection-carousel-{{ ai_gen_id }}', CollectionCarousel{{ ai_gen_id }});
  })();
</script>

