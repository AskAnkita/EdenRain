{%- doc -%}
  Diamond-shape icons for a product card.

  The row itself - where the shapes come from, which one is underlined, which icons are
  buttons that swap the card's photo - is 'card-shape-swatches', shared with the
  favourites carousel. This block is the product card's wrapper around it: the row's
  alignment, its padding, and the "Default shapes" a product with no shape data falls
  back to (clear it to show the row only for products that carry their own).
{%- enddoc -%}

{%- capture shape_row -%}
  {%- render 'card-shape-swatches',
    card_product: block.settings.product,
    default_shapes: block.settings.default_shapes
  -%}
{%- endcapture -%}

{%- if shape_row contains '<ul' -%}
  {%- liquid
    assign align = 'flex-start'
    if block.settings.alignment == 'center'
      assign align = 'center'
    elsif block.settings.alignment == 'right'
      assign align = 'flex-end'
    endif
  -%}
  <div
    class="card--block-shapes spacing-style"
    style="--options-align: {{ align }};{%- render 'spacing-style', settings: block.settings -%}"
  >
    {{ shape_row }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product shapes",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "text",
      "id": "default_shapes",
      "label": "Default shapes",
      "info": "Comma separated. Used for products that carry no Shape option or custom.diamond_shapes metafield. Leave blank to hide the row for those products.",
      "default": "Round, Oval, Cushion, Emerald, Princess, Radiant"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "right", "label": "t:options.right" }
      ]
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
