        {% elsif block.settings.mobile_position == 'center' %}
          align-items: center;
        {% elsif block.settings.mobile_position == 'bottom' %}
          align-items: flex-end;
        {% elsif block.settings.mobile_position == 'space-between' %}
          align-items: space-between;
        {% endif %}
        {% if block.settings.mobile_alignment == 'left' %}
          justify-content: flex-start;
        {% elsif block.settings.mobile_alignment == 'center' %}
          justify-content: center;
        {% elsif block.settings.mobile_alignment == 'right' %}
          justify-content: flex-end;
        {% endif %}
      }

      .ai-video-hero-content-wrapper-{{ ai_gen_id }} {
        {% if block.settings.mobile_direction == 'vertical' %}
          flex-direction: column;
        {% else %}
          flex-direction: row;
          flex-wrap: wrap;
        {% endif %}
        {% if block.settings.mobile_alignment == 'left' %}
          text-align: left;
          align-items: flex-start;
        {% elsif block.settings.mobile_alignment == 'center' %}
          text-align: center;
          align-items: center;
        {% elsif block.settings.mobile_alignment == 'right' %}
