{% doc %}
  @prompt
    ✅ Shopify AI Prompt (Video Hero Section with Overlay + Full Settings)
    
    Create a highly customizable, responsive Video Hero Section for a Shopify theme.
    
    The section should replicate a modern luxury landing hero similar to a diamond jewellery brand homepage.
    
    🎬 CORE FEATURE
    Background video support (desktop)
    Separate background video option for mobile
    Video should autoplay, muted, loop, and play inline
    Add optional fallback image if video fails to load
    Video should cover full width and height (object-fit: cover)
    🧩 OVERLAY CONTENT (CENTERED TEXT BLOCK)
    
    Overlay content must sit on top of the video with a dark/light optional overlay layer.
    
    Include:
    
    Heading (H1)
    Description (paragraph text)
    Two CTA Buttons (side-by-side by default)
    
    Example structure:
    
    Button 1: Primary CTA
    Button 2: Secondary CTA
    🎛️ LAYOUT SETTINGS (CUSTOMIZATION PANEL)
    1. Layout Direction
    Option: Vertical | Horizontal
    Controls arrangement of heading, description, and buttons
    2. Mobile Direction
    Option: Vertical | Horizontal
    Separate layout control for mobile only
    3. Alignment Settings
    Desktop Alignment:
    Left
    Center
    Right
    Mobile Alignment:
    Left
    Center
    Right
    4. Position Settings (Vertical Placement)
    Desktop Position:
    Top
    Center
    Bottom
    Space-between
    Mobile Position:
    Top
    Center
    Bottom
    Space-between
    5. Gap Control
    Numeric range slider (0px – 80px)
    Controls spacing between:
    Heading → Description → Buttons
    📱 MOBILE RESPONSIVENESS (IMPORTANT)
    Fully responsive layout
    Text scales properly on small screens
    Buttons stack vertically if needed on mobile (based on setting)
    Mobile video automatically switches to mobile-specific upload
    Ensure no overflow or cropping of overlay text
    Maintain readability with optional dark overlay layer
    🎨 DESIGN REQUIREMENTS
    Full screen hero section (100vh default, adjustable)
    Smooth fade overlay option (black/white gradient)
    Modern luxury aesthetic (like premium jewellery brand)
    Buttons should have hover animation
    Text should be readable on all video backgrounds
    ⚙️ OPTIONAL SETTINGS (BONUS)
    Overlay opacity control (0% – 70%)
    Text color selector (light/dark)
    Button style:
    Solid
    Outline
    Rounded
    Enable/disable autoplay
    Enable/disable sound (default muted)
    🎯 FINAL OUTPUT
    
    A fully editable Shopify section named:
    
    “Video Hero with Overlay Content”
    
    It must be:
    
    Modular
    Theme-friendly
    Performance optimized
    Mobile-first responsive
    Easy to customize via theme editor, Everything Perfect Just add this Select Video Option for Desktop video & Mobile video Not Video pese a Link , Make it Mobile Responsive video hight in Mobile cover 66% Height , I Need Moble Video should be fixt with height and width in Mobile & Desktop both
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
    .ai-video-hero-{{ ai_gen_id }} {
      position: relative;
      width: 100%;
      {% comment %} chanegs the height of hereo section {% endcomment %}
      height: 712px;
      {% comment %}  {% endcomment %}
      overflow: hidden;
      display: block;
    }

    .ai-video-hero-background-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    .ai-video-hero-video-{{ ai_gen_id }} {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      object-fit: cover;
      display: block;
    }

    .ai-video-hero-video-{{ ai_gen_id }}.ai-video-hero-desktop-{{ ai_gen_id }} {
      display: block;
    }

    .ai-video-hero-video-{{ ai_gen_id }}.ai-video-hero-mobile-{{ ai_gen_id }} {
      display: none;
    }

    @media screen and (max-width: 749px) {
      .ai-video-hero-{{ ai_gen_id }} {
        height: 66vh;
      }

      .ai-video-hero-video-{{ ai_gen_id }}.ai-video-hero-desktop-{{ ai_gen_id }} {
        {% if block.settings.video_mobile != blank %}
          display: none;
        {% endif %}
      }

      .ai-video-hero-video-{{ ai_gen_id }}.ai-video-hero-mobile-{{ ai_gen_id }} {
        display: block;
      }
    }

    .ai-video-hero-fallback-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
    }

    .ai-video-hero-fallback-{{ ai_gen_id }}.ai-video-hero-show-fallback-{{ ai_gen_id }} {
      display: block;
    }

    .ai-video-hero-overlay-{{ ai_gen_id }} {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      {% if block.settings.overlay_type == 'solid' %}
        background-color: {{ block.settings.overlay_color }};
        opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
      {% elsif block.settings.overlay_type == 'gradient_top' %}
        background: linear-gradient(to bottom, {{ block.settings.overlay_color }}, transparent);
        opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
      {% elsif block.settings.overlay_type == 'gradient_bottom' %}
        background: linear-gradient(to top, {{ block.settings.overlay_color }}, transparent);
        opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
      {% endif %}
    }

    .ai-video-hero-content-{{ ai_gen_id }} {
      position: relative;
      z-index: 3;
      width: 100%;
      height: 100%;
      display: flex;
      padding: 40px;
      box-sizing: border-box;
      {% if block.settings.desktop_position == 'top' %}
        align-items: flex-start;
      {% elsif block.settings.desktop_position == 'center' %}
        align-items: center;
      {% elsif block.settings.desktop_position == 'bottom' %}
        align-items: flex-end;
      {% elsif block.settings.desktop_position == 'space-between' %}
        align-items: space-between;
      {% endif %}
      {% if block.settings.desktop_alignment == 'left' %}
        justify-content: flex-start;
      {% elsif block.settings.desktop_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.desktop_alignment == 'right' %}
        justify-content: flex-end;
      {% endif %}
    }

    .ai-video-hero-content-wrapper-{{ ai_gen_id }} {
      max-width: {{ block.settings.content_max_width }}px;
      width: 100%;
      display: flex;
      {% if block.settings.layout_direction == 'vertical' %}
        flex-direction: column;
      {% else %}
        flex-direction: row;
        flex-wrap: wrap;
      {% endif %}
      gap: {{ block.settings.content_gap }}px;
      {% if block.settings.desktop_alignment == 'left' %}
        text-align: left;
        align-items: flex-start;
      {% elsif block.settings.desktop_alignment == 'center' %}
        text-align: center;
        align-items: center;
      {% elsif block.settings.desktop_alignment == 'right' %}
        text-align: right;
        align-items: flex-end;
      {% endif %}
    }

    .ai-video-hero-heading-{{ ai_gen_id }} {
      margin: 0;
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.heading_size }}px;
      line-height: 1.2;
      {% comment %} change font size , family and color {% endcomment %}
      font-weight: 600;
      font-family:'Cormorant garamond' , 'sans-serif';
      {% comment %}  {% endcomment %}
      {% if block.settings.layout_direction == 'horizontal' %}
        width: 100%;
      {% endif %}
    }

    .ai-video-hero-description-{{ ai_gen_id }} {
      margin: 0;
      color: {{ block.settings.text_color }};
      font-size: {{ block.settings.description_size }}px;
      line-height: 1.5;
      {% comment %} font changes {% endcomment %}
      font-family: "Source Sans 3", sans-serif;
      {% comment %}  {% endcomment %}
      {% if block.settings.layout_direction == 'horizontal' %}
        width: 100%;
      {% endif %}
    }

    .ai-video-hero-buttons-{{ ai_gen_id }} {
      display: flex;
      gap: {{ block.settings.button_gap }}px;
      {% if block.settings.layout_direction == 'horizontal' %}
        width: 100%;
      {% endif %}
      {% if block.settings.desktop_alignment == 'left' %}
        justify-content: flex-start;
      {% elsif block.settings.desktop_alignment == 'center' %}
        justify-content: center;
      {% elsif block.settings.desktop_alignment == 'right' %}
        justify-content: flex-end;
      {% endif %}
    }

    .ai-video-hero-button-{{ ai_gen_id }} {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      {% comment %} padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px; {% endcomment %}
      font-size: {{ block.settings.button_font_size }}px;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.3s ease;
      border: 2px solid #fff;
      font-weight: 600;
      {% comment %} ---- {% endcomment %}
      height:49px;
      width:auto;
      max-width:100%;
      min-width: 195px;
  padding: 16px 32px !important;
  border-radius: 100px!important;
    text-transform: uppercase;
  

    }
   

    .ai-video-hero-button-primary-{{ ai_gen_id }} {
      {% if block.settings.button_primary_style == 'solid' %}
        background-color: {{ block.settings.button_primary_bg }};
        color: {{ block.settings.button_primary_color }};
        border-radius: {{ block.settings.button_border_radius }}px;
      {% elsif block.settings.button_primary_style == 'outline' %}
        background-color: transparent;
        color: {{ block.settings.button_primary_color }};
        border: 2px solid {{ block.settings.button_primary_color }};
        border-radius: {{ block.settings.button_border_radius }}px;
      {% elsif block.settings.button_primary_style == 'rounded' %}
        background-color: {{ block.settings.button_primary_bg }};
        color: {{ block.settings.button_primary_color }};
        border-radius: 100px;
      {% endif %}
    }

    .ai-video-hero-button-primary-{{ ai_gen_id }}:hover {
      {% if block.settings.button_primary_style == 'solid' %}
        background-color: {{ block.settings.button_primary_hover_bg }};
        color: {{ block.settings.button_primary_hover_color }};
      {% elsif block.settings.button_primary_style == 'outline' %}
        background-color: {{ block.settings.button_primary_color }};
        color: {{ block.settings.button_primary_bg }};
      {% elsif block.settings.button_primary_style == 'rounded' %}
        background-color: {{ block.settings.button_primary_hover_bg }};
        color: {{ block.settings.button_primary_hover_color }};
      {% endif %}
      transform: translateY(-2px);
    }

    .ai-video-hero-button-secondary-{{ ai_gen_id }} {
      {% if block.settings.button_secondary_style == 'solid' %}
        background-color: {{ block.settings.button_secondary_bg }};
        color: {{ block.settings.button_secondary_color }};
        border-radius: {{ block.settings.button_border_radius }}px;
      {% elsif block.settings.button_secondary_style == 'outline' %}
        background-color: transparent;
        color: {{ block.settings.button_secondary_color }};
        border: 2px solid {{ block.settings.button_secondary_color }};
        border-radius: {{ block.settings.button_border_radius }}px;
      {% elsif block.settings.button_secondary_style == 'rounded' %}
        background-color: {{ block.settings.button_secondary_bg }};
        color: {{ block.settings.button_secondary_color }};
        border-radius: 100px;
      {% endif %}
    }

    .ai-video-hero-button-secondary-{{ ai_gen_id }}:hover {
      {% if block.settings.button_secondary_style == 'solid' %}
        background-color: {{ block.settings.button_secondary_hover_bg }};
        color: {{ block.settings.button_secondary_hover_color }};
      {% elsif block.settings.button_secondary_style == 'outline' %}
        background-color: {{ block.settings.button_secondary_color }};
        color: {{ block.settings.button_secondary_bg }};
      {% elsif block.settings.button_secondary_style == 'rounded' %}
