        padding: {{ block.settings.button_padding_vertical_mobile }}px {{ block.settings.button_padding_horizontal_mobile }}px;
        font-size: {{ block.settings.button_font_size_mobile }}px;
      }
    }
{% endstyle %}

<video-hero-{{ ai_gen_id }} class="ai-video-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-hero-background-{{ ai_gen_id }}">
    {% if block.settings.video_desktop != blank %}
      <video
        class="ai-video-hero-video-{{ ai_gen_id }} ai-video-hero-desktop-{{ ai_gen_id }}"
        {% if block.settings.enable_autoplay %}
          autoplay
        {% endif %}
        {% unless block.settings.enable_sound %}
          muted
        {% endunless %}
        loop
        playsinline
        data-video-desktop
      >
        {% for source in block.settings.video_desktop.sources %}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {% endfor %}
      </video>
    {% endif %}

    {% if block.settings.video_mobile != blank %}
      <video
        class="ai-video-hero-video-{{ ai_gen_id }} ai-video-hero-mobile-{{ ai_gen_id }}"
        {% if block.settings.enable_autoplay %}
          autoplay
        {% endif %}
        {% unless block.settings.enable_sound %}
          muted
        {% endunless %}
        loop
        playsinline
        data-video-mobile
      >
        {% for source in block.settings.video_mobile.sources %}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {% endfor %}
      </video>
    {% endif %}

    {% if block.settings.fallback_image != blank %}
      <img
        src="{{ block.settings.fallback_image | image_url: width: 2000 }}"
        alt="{{ block.settings.fallback_image.alt | escape }}"
        class="ai-video-hero-fallback-{{ ai_gen_id }}"
        loading="eager"
        width="{{ block.settings.fallback_image.width }}"
        height="{{ block.settings.fallback_image.height }}"
        data-fallback-image
      >
    {% endif %}
  </div>

  {% if block.settings.overlay_type != 'none' %}
    <div class="ai-video-hero-overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-video-hero-content-{{ ai_gen_id }}">
    <div class="ai-video-hero-content-wrapper-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h1 class="ai-video-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-video-hero-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}

      {% if block.settings.button_primary_label != blank or block.settings.button_secondary_label != blank %}
        <div class="ai-video-hero-buttons-{{ ai_gen_id }}">
          {% if block.settings.button_primary_label != blank %}
            <a
              href="{{ block.settings.button_primary_link }}"
              class="ai-video-hero-button-{{ ai_gen_id }} ai-video-hero-button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_primary_label }}
            </a>
          {% endif %}

          {% if block.settings.button_secondary_label != blank %}
            <a
              href="{{ block.settings.button_secondary_link }}"
              class="ai-video-hero-button-{{ ai_gen_id }} ai-video-hero-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_secondary_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</video-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.videos = this.querySelectorAll('video');
        this.fallbackImage = this.querySelector('[data-fallback-image]');
      }

      connectedCallback() {
        this.setupVideoFallback();
      }

      setupVideoFallback() {
        if (!this.videos.length || !this.fallbackImage) return;

        this.videos.forEach(video => {
          video.addEventListener('error', () => {
            this.showFallback();
          });

          if (video.readyState === 0) {
            video.load();
          }
        });
      }

      showFallback() {
        if (this.fallbackImage) {
          this.fallbackImage.classList.add('ai-video-hero-show-fallback-{{ ai_gen_id }}');
          this.videos.forEach(video => {
            video.style.display = 'none';
          });
        }
      }
    }

    customElements.define('video-hero-{{ ai_gen_id }}', VideoHero{{ ai_gen_id }});
  })();
</script>

