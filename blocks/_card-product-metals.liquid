{%- doc -%}
  Metal swatches for a product card.

  The row itself - where the metals come from, how karats collapse into one dot, which
  dot is underlined, which are buttons that swap the card's photo - is
  'card-metal-swatches', shared with the favourites carousel. This block is the product
  card's wrapper around it: the row's alignment, its padding, and the "Default metals" a
  product with no metal option and no metal tag falls back to.
{%- enddoc -%}

{%- capture metal_row -%}
  {%- render 'card-metal-swatches',
    card_product: block.settings.product,
    default_metals: block.settings.default_metals
  -%}
{%- endcapture -%}

{%- if metal_row contains '<ul' -%}
  {%- liquid
    assign align = 'flex-start'
    if block.settings.alignment == 'center'
      assign align = 'center'
    elsif block.settings.alignment == 'right'
      assign align = 'flex-end'
    endif
  -%}
  <div
    class="card--block-metals spacing-style"
    style="--options-align: {{ align }};{%- render 'spacing-style', settings: block.settings -%}"
  >
    {{ metal_row }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product metals",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "text",
      "id": "default_metals",
      "label": "Default metals",
      "info": "Comma separated. Used for products that carry no metal option and no metal tag. Leave blank to hide the row for those products.",
      "default": "White Gold, Yellow Gold, Rose Gold, Silver"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "right", "label": "t:options.right" }
      ]
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
