{% comment %}
  Five-column footer: logo and tagline, three menus, and a sign-up form, with a credits and
  payment row beneath. Rebuilt natively for this theme from the "Copy of Copy of Eden Raine v1.1"
  footer-classic section, so it carries no dependency on that theme's CSS framework.

  A menu block takes its heading from the menu's own title in Online Store > Navigation.
{% endcomment %}

{%- liquid
  assign footer_id = 'footer-classic-' | append: section.id
  assign stts = section.settings
-%}

{%- style -%}
  #{{ footer_id }} {
    background: {{ stts.background }};
    color: {{ stts.text_color }};
    border-top: 1px solid {{ stts.border_color }};
    font-family: var(--font-body--family);
    font-size: {{ stts.text_size | divided_by: 10.0 }}rem;
    line-height: 1.65;
  }

  #{{ footer_id }} .fc-inner {
    max-width: {{ stts.content_width }}px;
    margin: 0 auto;
    padding: {{ stts.padding_top }}px {{ stts.side_padding }}px {{ stts.padding_bottom }}px;
  }

  #{{ footer_id }} .fc-columns {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size }}, minmax(0, 1fr));
    gap: 4rem;
    align-items: start;
  }

  #{{ footer_id }} .fc-heading {
    margin: 0 0 1.2rem;
    font-family: var(--font-body--family);
    font-size: {{ stts.heading_size | divided_by: 10.0 }}rem;
    font-weight: 500;
    line-height: 1.4;
    color: {{ stts.text_color }};
  }

  #{{ footer_id }} a {
    color: {{ stts.link_color }};
    text-decoration: none;
  }

  #{{ footer_id }} a:hover {
    color: {{ stts.link_hover_color }};
  }

  #{{ footer_id }} .fc-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #{{ footer_id }} .fc-list li + li {
    margin-top: 0.4rem;
  }

  #{{ footer_id }} .fc-logo {
    display: inline-block;
    margin-bottom: 1.6rem;
  }

  #{{ footer_id }} .fc-logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: {{ stts.logo_width }}px;
  }

  #{{ footer_id }} .fc-text p {
    margin: 0 0 1em;
  }

  #{{ footer_id }} .fc-text p:last-child {
    margin-bottom: 0;
  }

  #{{ footer_id }} .fc-social {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 2rem;
  }

  #{{ footer_id }} .fc-social a {
    display: block;
    width: 1.8rem;
    height: 1.8rem;
    color: {{ stts.text_color }};
  }

  #{{ footer_id }} .fc-social svg {
    width: 100%;
    height: 100%;
  }

  #{{ footer_id }} .fc-field-label {
    display: block;
    margin-bottom: 0.8rem;
  }

  #{{ footer_id }} .fc-input {
    width: 100%;
    max-width: 28rem;
    padding: 1rem 1.2rem;
    border: 1px solid {{ stts.border_color }};
    border-radius: 0;
    background: #fff;
    color: {{ stts.text_color }};
    font-family: inherit;
    font-size: inherit;
  }

  #{{ footer_id }} .fc-submit {
    display: block;
    width: 100%;
    max-width: 28rem;
    margin-top: 1.6rem;
    padding: 1.2rem 2rem;
    border: 0;
    background: {{ stts.button_background }};
    color: {{ stts.button_text_color }};
    font-family: inherit;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  #{{ footer_id }} .fc-submit:hover {
    opacity: 0.85;
  }

  #{{ footer_id }} .fc-form-message {
    margin-top: 1rem;
  }

  #{{ footer_id }} .fc-bottom {
    border-top: 1px solid {{ stts.border_color }};
  }

  #{{ footer_id }} .fc-bottom-inner {
    max-width: {{ stts.content_width }}px;
    margin: 0 auto;
    padding: 2.8rem {{ stts.side_padding }}px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
  }

  #{{ footer_id }} .fc-credits p {
    margin: 0;
  }

  #{{ footer_id }} .fc-payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  #{{ footer_id }} .fc-payment svg {
    width: 3.8rem;
    height: auto;
  }

  @media screen and (max-width: 989px) {
    #{{ footer_id }} .fc-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.2rem;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ footer_id }} .fc-columns {
      grid-template-columns: minmax(0, 1fr);
    }

    #{{ footer_id }} .fc-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
{%- endstyle -%}

<footer id="{{ footer_id }}" class="footer-classic">
  <div class="fc-inner">
    <div class="fc-columns">
      {%- for block in section.blocks -%}
        <div class="fc-column fc-column--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'logo' -%}
              <a class="fc-logo" href="{{ shop.url }}" title="{{ shop.name | escape }}">
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: width: 600 | image_tag: loading: 'lazy', alt: shop.name }}
                {%- else -%}
                  <span class="fc-heading">{{ shop.name | escape }}</span>
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}
                <div class="fc-text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                {%- render 'footer-classic-social', text_color: stts.text_color -%}
              {%- endif -%}

            {%- when 'link_list' -%}
              {%- assign fc_menu = block.settings.menu -%}
              {%- if fc_menu != blank -%}
                <p class="fc-heading">{{ fc_menu.title | escape }}</p>
                <ul class="fc-list" role="list">
                  {%- for item in fc_menu.links -%}
                    <li><a href="{{ item.url }}">{{ item.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                {%- render 'footer-classic-social', text_color: stts.text_color -%}
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.title != blank -%}
                <p class="fc-heading">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                <div class="fc-text">{{ block.settings.content }}</div>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                {%- render 'footer-classic-social', text_color: stts.text_color -%}
              {%- endif -%}

            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}
                <p class="fc-heading">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="fc-text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- form 'customer', class: 'fc-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <label class="fc-field-label" for="FooterEmail-{{ block.id }}">
                  {{ block.settings.field_label | default: 'Email*' | escape }}
                </label>
                <input
                  id="FooterEmail-{{ block.id }}"
                  class="fc-input"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  required
                >
                {%- if form.errors -%}
                  <p class="fc-form-message">{{ form.errors.messages['email'] }}</p>
                {%- elsif form.posted_successfully? -%}
                  <p class="fc-form-message">Thanks for subscribing.</p>
                {%- endif -%}
                <button class="fc-submit" type="submit">{{ block.settings.button_label | default: 'Sign up' | escape }}</button>
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="fc-bottom">
    <div class="fc-bottom-inner">
      <div class="fc-credits">
        <p>
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}.
          {% if stts.credit_text != blank %}
            {%- if stts.credit_url != blank %}
              {{ stts.credit_text | escape }} <a href="{{ stts.credit_url }}">{{ stts.credit_name | escape }}</a>.
            {%- else %}
              {{ stts.credit_text | escape }} {{ stts.credit_name | escape }}.
            {%- endif -%}
          {% endif %}
        </p>
        {%- if stts.extra_text != blank -%}
          {{ stts.extra_text }}
        {%- endif -%}
      </div>

      {%- if stts.show_payment_methods and shop.enabled_payment_types.size > 0 -%}
        <div class="fc-payment">
          <span class="visually-hidden">Payment methods</span>
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Classic footer",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#1d1d1b"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Links on hover",
      "default": "#6f6f6f"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Lines",
      "default": "#ededed"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "header",
      "content": "Sign-up button"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Bottom row"
    },
    {
      "type": "checkbox",
      "id": "show_payment_methods",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "credit_text",
      "label": "Credit wording",
      "default": "Website by"
    },
    {
      "type": "text",
      "id": "credit_name",
      "label": "Credit name",
      "default": "Lionsorbet"
    },
    {
      "type": "url",
      "id": "credit_url",
      "label": "Credit link"
    },
    {
      "type": "richtext",
      "id": "extra_text",
      "label": "Extra text"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 800,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Side padding",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo and text",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social icons",
          "default": true
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "The column heading is the menu's own title."
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social icons",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social icons",
          "default": false
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Sign-up form",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Subscribe"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "field_label",
          "label": "Field label",
          "default": "Email*"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Sign up"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Classic footer",
      "blocks": [
        { "type": "logo" },
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "link_list" },
        { "type": "newsletter" }
      ]
    }
  ]
}
{% endschema %}
