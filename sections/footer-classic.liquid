    },
    {
      "type": "text",
      "id": "credit_name",
      "label": "Credit name",
      "default": "Lionsorbet"
    },
    {
      "type": "url",
      "id": "credit_url",
      "label": "Credit link"
    },
    {
      "type": "richtext",
      "id": "extra_text",
      "label": "Extra text"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 800,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Side padding",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Eden Raine for Precious Metal Gemstone Jewellery with Elegance & Style.</p>"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social media icons",
          "default": true
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        },
        {
          "type": "header",
          "content": "Extra link"
        },
        {
          "type": "text",
          "id": "extra_link_label",
          "label": "Label",
          "info": "Added to the bottom of this column, after the menu's own links."
        },
        {
          "type": "url",
          "id": "extra_link_url",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social media icons",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "About us"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text"
