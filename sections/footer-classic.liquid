{% comment %}
  Five-column luxury footer: logo and tagline, three menus (with interactive mobile accordions),
  and a VIP newsletter sign-up form, with a credits and payment row beneath.
  Concept 1: Modern Luxury Accordion (Light / Warm Oyster)
{% endcomment %}

{%- liquid
  assign footer_id = 'footer-classic-' | append: section.id
  assign stts = section.settings
-%}

{%- style -%}
  #{{ footer_id }} {
    background: {{ stts.background }};
    color: {{ stts.text_color }};
    border-top: 1px solid {{ stts.border_color }};
    font-family: var(--font-body--family);
    font-size: {{ stts.text_size | divided_by: 10.0 }}rem;
    line-height: 1.65;
  }

  #{{ footer_id }} .fc-inner {
    max-width: {{ stts.content_width }}px;
    margin: 0 auto;
    padding: {{ stts.padding_top }}px {{ stts.side_padding }}px {{ stts.padding_bottom }}px;
  }

  #{{ footer_id }} .fc-columns {
    display: grid;
    {% if section.blocks.size > 2 %}
      grid-template-columns: 1.3fr repeat({{ section.blocks.size | minus: 2 }}, minmax(0, 1fr)) 1.4fr;
    {% else %}
      grid-template-columns: repeat({{ section.blocks.size }}, minmax(0, 1fr));
    {% endif %}
    gap: 4rem;
    align-items: start;
  }

  #{{ footer_id }} .fc-heading {
    margin: 0 0 1.4rem;
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: {{ stts.heading_size | divided_by: 10.0 }}rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ stts.text_color }};
  }

  #{{ footer_id }} a {
    color: {{ stts.link_color }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #{{ footer_id }} a:hover {
    color: {{ stts.link_hover_color }};
  }

  #{{ footer_id }} .fc-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #{{ footer_id }} .fc-list li + li {
    margin-top: 0.6rem;
  }

  #{{ footer_id }} .fc-logo {
    display: inline-block;
    margin-bottom: 1.6rem;
  }

  #{{ footer_id }} .fc-logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: {{ stts.logo_width }}px;
  }

  #{{ footer_id }} .fc-text {
    color: #555555;
    font-size: {{ stts.text_size | divided_by: 10.0 }}rem;
    line-height: 1.6;
  }

  #{{ footer_id }} .fc-text p {
    margin: 0 0 1em;
  }

  #{{ footer_id }} .fc-text p:last-child {
    margin-bottom: 0;
  }

  #{{ footer_id }} .fc-social {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-top: 2rem;
  }

  #{{ footer_id }} .fc-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    color: {{ stts.text_color }};
    opacity: 0.8;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #{{ footer_id }} .fc-social a:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  #{{ footer_id }} .fc-social svg {
    width: 100%;
    height: 100%;
  }

  /* Newsletter VIP styling */
  #{{ footer_id }} .fc-newsletter-heading {
    margin: 0 0 0.8rem;
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: {{ stts.text_color }};
  }

  #{{ footer_id }} .fc-newsletter-text {
    margin-bottom: 1.4rem;
    color: #666666;
    font-size: 1.3rem;
    line-height: 1.55;
  }

  #{{ footer_id }} .fc-form-fields {
    display: flex;
    gap: 0.8rem;
    align-items: stretch;
    width: 100%;
    max-width: 36rem;
  }

  #{{ footer_id }} .fc-input {
    flex: 1;
    min-width: 0;
    height: 4.4rem;
    padding: 0 1.4rem;
    border: 1px solid {{ stts.border_color }};
    border-radius: 0;
    background: #ffffff;
    color: {{ stts.text_color }};
    font-family: inherit;
    font-size: 1.3rem;
    outline: none;
    transition: border-color 0.2s ease;
  }

  #{{ footer_id }} .fc-input:focus {
    border-color: {{ stts.text_color }};
  }

  #{{ footer_id }} .fc-submit {
    flex-shrink: 0;
    height: 4.4rem;
    margin-top: 0;
    padding: 0 2.2rem;
    border: 0;
    background: {{ stts.button_background }};
    color: {{ stts.button_text_color }};
    font-family: inherit;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.25s ease, background 0.25s ease;
  }

  #{{ footer_id }} .fc-submit:hover {
    opacity: 0.88;
  }

  #{{ footer_id }} .fc-form-message {
    margin-top: 0.8rem;
    font-size: 1.2rem;
  }

  #{{ footer_id }} .fc-form-error {
    color: #ba0000;
  }

  #{{ footer_id }} .fc-form-success {
    color: #0b7a42;
  }

  /* Accordion styles (Desktop = static column; Mobile = interactive accordion) */
  #{{ footer_id }} .fc-accordion-btn {
    all: unset;
    display: block;
    margin: 0 0 1.4rem;
    font-family: var(--font-heading--family, var(--font-body--family));
    font-size: {{ stts.heading_size | divided_by: 10.0 }}rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ stts.text_color }};
    cursor: default;
  }

  #{{ footer_id }} .fc-accordion-icon {
    display: none;
  }

  #{{ footer_id }} .fc-accordion .fc-list {
    display: block;
  }

  /* Bottom Row */
  #{{ footer_id }} .fc-bottom {
    border-top: 1px solid {{ stts.border_color }};
  }

  #{{ footer_id }} .fc-bottom-inner {
    max-width: {{ stts.content_width }}px;
    margin: 0 auto;
    padding: 2.6rem {{ stts.side_padding }}px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
  }

  #{{ footer_id }} .fc-credits p {
    margin: 0;
    font-size: 1.25rem;
    color: #777777;
  }

  #{{ footer_id }} .fc-credits a {
    color: inherit;
    text-decoration: underline;
  }

  #{{ footer_id }} .fc-credits a:hover {
    color: {{ stts.text_color }};
  }

  #{{ footer_id }} .fc-payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
  }

  #{{ footer_id }} .fc-payment svg {
    width: 3.6rem;
    height: auto;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  #{{ footer_id }} .fc-payment svg:hover {
    opacity: 1;
  }

  @media screen and (max-width: 989px) {
    #{{ footer_id }} .fc-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.2rem;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ footer_id }} .fc-inner {
      padding: 3.6rem 2rem 0;
    }

    #{{ footer_id }} .fc-columns {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    /* Mobile order */
    #{{ footer_id }} .fc-column--logo {
      order: 1;
      text-align: center;
      padding-bottom: 2.4rem;
      border-bottom: 1px solid {{ stts.border_color }};
      margin-bottom: 1.2rem;
    }

    #{{ footer_id }} .fc-column--newsletter {
      order: 2;
      text-align: center;
      padding: 1.6rem 0 2.8rem;
      border-bottom: 1px solid {{ stts.border_color }};
      margin-bottom: 0.4rem;
    }

    #{{ footer_id }} .fc-column--link_list {
      order: 3;
      border-bottom: 1px solid {{ stts.border_color }};
    }

    #{{ footer_id }} .fc-column--text {
      order: 4;
      padding: 1.6rem 0;
      border-bottom: 1px solid {{ stts.border_color }};
    }

    /* Logo scaling on mobile */
    #{{ footer_id }} .fc-logo {
      display: inline-block;
      margin: 0 auto 1.4rem;
    }

    #{{ footer_id }} .fc-logo img {
      margin: 0 auto;
      max-width: 72px !important;
      height: auto;
    }

    #{{ footer_id }} .fc-column--logo .fc-text {
      max-width: 320px;
      margin: 0 auto;
      font-size: 1.3rem;
      line-height: 1.6;
    }

    #{{ footer_id }} .fc-column--logo .fc-social {
      justify-content: center;
      margin: 1.6rem auto 0;
      gap: 1.8rem;
    }

    /* Newsletter form on mobile */
    #{{ footer_id }} .fc-column--newsletter .fc-form-fields {
      margin: 1.4rem auto 0;
      max-width: 100%;
    }

    /* Mobile Accordions */
    #{{ footer_id }} .fc-accordion-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      box-sizing: border-box;
      padding: 1.6rem 0.4rem;
      margin: 0;
      font-size: 1.35rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    #{{ footer_id }} .fc-accordion-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      color: {{ stts.text_color }};
      flex-shrink: 0;
    }

    #{{ footer_id }} .fc-accordion-icon svg {
      width: 1.4rem;
      height: 1.4rem;
      display: block;
    }

    #{{ footer_id }} .fc-accordion-icon :is(.horizontal, .vertical) {
      transition: transform var(--animation-speed, 0.3s) var(--animation-easing, ease), opacity var(--animation-speed, 0.3s) var(--animation-easing, ease);
      transform: rotate(0deg);
      transform-origin: 50% 50%;
      opacity: 1;
    }

    #{{ footer_id }} .fc-accordion.is-open .fc-accordion-icon .horizontal {
      transform: rotate(90deg);
    }

    #{{ footer_id }} .fc-accordion.is-open .fc-accordion-icon .vertical {
      transform: rotate(90deg);
      opacity: 0;
    }

    #{{ footer_id }} .fc-accordion:not(.is-open) .fc-list {
      display: none;
    }

    #{{ footer_id }} .fc-accordion.is-open .fc-list {
      display: block;
      padding: 0 0.4rem 1.6rem;
      animation: fcFadeIn 0.22s ease-out;
    }

    #{{ footer_id }} .fc-accordion .fc-list li + li {
      margin-top: 1rem;
    }

    #{{ footer_id }} .fc-accordion .fc-list a {
      display: inline-block;
      padding: 0.2rem 0;
      font-size: 1.35rem;
      color: #555555;
    }

    /* Mobile Bottom Row */
    #{{ footer_id }} .fc-bottom {
      border-top: none;
    }

    #{{ footer_id }} .fc-bottom-inner {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
      gap: 1.6rem;
      padding: 2.2rem 2rem 2.8rem;
    }

    #{{ footer_id }} .fc-payment {
      justify-content: center;
      gap: 0.8rem;
    }

    #{{ footer_id }} .fc-credits p {
      font-size: 1.2rem;
    }
  }

  @keyframes fcFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
{%- endstyle -%}

<footer id="{{ footer_id }}" class="footer-classic">
  <div class="fc-inner">
    <div class="fc-columns">
      {%- for block in section.blocks -%}
        <div class="fc-column fc-column--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'logo' -%}
              <a class="fc-logo" href="{{ shop.url }}" title="{{ shop.name | escape }}">
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: width: 600 | image_tag: loading: 'lazy', alt: shop.name }}
                {%- else -%}
                  <span class="fc-heading">{{ shop.name | escape }}</span>
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}
                <div class="fc-text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                {%- render 'footer-classic-social', text_color: stts.text_color -%}
              {%- endif -%}

            {%- when 'link_list' -%}
              {%- assign fc_menu = block.settings.menu -%}
              {%- if fc_menu != blank -%}
                <div class="fc-accordion">
                  <button type="button" class="fc-heading fc-accordion-btn" aria-expanded="false">
                    <span>{{ fc_menu.title | escape }}</span>
                    <span class="svg-wrapper icon-plus-wrapper fc-accordion-icon" aria-hidden="true">
                      {{- 'icon-plus.svg' | inline_asset_content -}}
                    </span>
                  </button>
                  <ul class="fc-list" role="list">
                    {%- for item in fc_menu.links -%}
                      <li><a href="{{ item.url }}">{{ item.title | escape }}</a></li>
                    {%- endfor -%}
                    {%- comment -%}
                      One extra link per column, set in the theme editor rather than in
                      Shopify navigation. It is here for a page that belongs under an
                      existing heading - "Education & Guides" under Help - without
                      having to rebuild the admin menu around it.
                    {%- endcomment -%}
                    {%- if block.settings.extra_link_label != blank and block.settings.extra_link_url != blank -%}
                      <li>
                        <a href="{{ block.settings.extra_link_url }}">
                          {{- block.settings.extra_link_label | escape -}}
                        </a>
                      </li>
                    {%- endif -%}
                  </ul>
                </div>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                {%- render 'footer-classic-social', text_color: stts.text_color -%}
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.title != blank -%}
                <p class="fc-heading">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.content != blank -%}
                <div class="fc-text">{{ block.settings.content }}</div>
              {%- endif -%}
              {%- if block.settings.show_social -%}
                {%- render 'footer-classic-social', text_color: stts.text_color -%}
              {%- endif -%}

            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}
                <p class="fc-heading fc-newsletter-heading">{{ block.settings.heading | escape }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="fc-text fc-newsletter-text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- form 'customer', class: 'fc-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="fc-form-fields">
                  <input
                    id="FooterEmail-{{ block.id }}"
                    class="fc-input"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    placeholder="{{ block.settings.field_label | default: 'Enter your email' | escape }}"
                    aria-label="{{ block.settings.field_label | default: 'Email' | escape }}"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    required
                  >
                  <button class="fc-submit" type="submit">{{ block.settings.button_label | default: 'Sign up' | escape }}</button>
                </div>
                {%- if form.errors -%}
                  <p class="fc-form-message fc-form-error">{{ form.errors.messages['email'] }}</p>
                {%- elsif form.posted_successfully? -%}
                  <p class="fc-form-message fc-form-success">Thank you for subscribing.</p>
                {%- endif -%}
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="fc-bottom">
    <div class="fc-bottom-inner">
      <div class="fc-credits">
        <p>
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}.
          {% if stts.credit_text != blank %}
            {%- if stts.credit_url != blank %}
              {{ stts.credit_text | escape }} <a href="{{ stts.credit_url }}">{{ stts.credit_name | escape }}</a>.
            {%- else %}
              {{ stts.credit_text | escape }} {{ stts.credit_name | escape }}.
            {%- endif -%}
          {% endif %}
        </p>
        {%- if stts.extra_text != blank -%}
          {{ stts.extra_text }}
        {%- endif -%}
      </div>

      {%- if stts.show_payment_methods and shop.enabled_payment_types.size > 0 -%}
        <div class="fc-payment">
          <span class="visually-hidden">Payment methods</span>
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  (() => {
    const root = document.getElementById('{{ footer_id }}');
    if (!root) return;
    const accordions = root.querySelectorAll('.fc-accordion-btn');
    accordions.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (window.innerWidth > 749) return;
        const accordion = btn.closest('.fc-accordion');
        const isOpen = accordion.classList.contains('is-open');
        accordions.forEach((otherBtn) => {
          const otherAcc = otherBtn.closest('.fc-accordion');
          if (otherAcc !== accordion) {
            otherAcc.classList.remove('is-open');
            otherBtn.setAttribute('aria-expanded', 'false');
          }
        });
        accordion.classList.toggle('is-open', !isOpen);
        btn.setAttribute('aria-expanded', (!isOpen).toString());
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Classic footer",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#faf8f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Links on hover",
      "default": "#8c7d6b"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Lines",
      "default": "#e8e5df"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 110
    },
    {
      "type": "header",
      "content": "Sign-up button"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#051514"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Bottom row"
    },
    {
      "type": "checkbox",
      "id": "show_payment_methods",
      "label": "Show payment icons",
      "default": true
    },
    {
