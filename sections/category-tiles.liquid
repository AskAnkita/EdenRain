{% comment %}
  Category tiles: one tall picture card per menu item, in a row you can scroll sideways.

  Where a tile's picture comes from, in order:
    1. a "Picture for a tile" block in the theme editor, matched to the menu item;
    2. the TILE PICTURES list below, which is the place to set pictures in code;
    3. assets/category-<menu item>.png, e.g. category-rings.png for a link titled Rings.
  A menu item with none of the three is dropped (the script below removes the tile).
{% endcomment %}

{%- liquid
  assign menu = section.settings.menu
  if menu == blank
    assign menu = linklists['category']
  endif
  assign overrides = section.blocks

  # ------------------------------------------------------------------
  # TILE PICTURES - the one place to change a tile's picture in code.
  # One "menu item: file under assets/" pair per tile, comma separated.
  # Swap a file name to swap that tile's picture. A picture chosen in the
  # theme editor always wins over this list, so a tile never ignores it.
  # ------------------------------------------------------------------
  assign tile_pictures = 'Rings: category-rings.png, Earrings: category-earrings.png, Necklaces: category-necklaces.png, Bracelets: category-bracelets.png, Best Sellers: category-best-sellers.png'
  assign tile_picture_pairs = tile_pictures | split: ','
-%}

{%- style -%}
  #category-tiles-{{ section.id }} {
    --ct-arrow-size: 56px;
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  #category-tiles-{{ section.id }} .ct-inner {
    max-width: var(--page-width, 160rem);
    margin: 0 auto;
    padding-inline: max(2.4rem, calc(var(--ct-arrow-size) / 2 + 0.8rem));
  }

  #category-tiles-{{ section.id }} .ct-heading {
    margin: 0 0 3.2rem;
    text-align: center;
    font-family: var(--font-heading--family);
    font-size: clamp(2.6rem, 2.4vw, 3.4rem);
    font-weight: 500;
    line-height: 1.15;
  }

  #category-tiles-{{ section.id }} .ct-viewport {
    position: relative;
  }

  #category-tiles-{{ section.id }} .ct-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - {{ section.settings.per_row | minus: 1 }} * 2rem) / {{ section.settings.per_row }});
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  #category-tiles-{{ section.id }} .ct-track::-webkit-scrollbar {
    display: none;
  }

  #category-tiles-{{ section.id }} .ct-tile {
    scroll-snap-align: start;
  }

  #category-tiles-{{ section.id }} .ct-link {
    position: relative;
    display: block;
    aspect-ratio: {{ section.settings.ratio }};
    overflow: hidden;
    background: #f8f8f8;
    color: #111;
    text-decoration: none;
  }

  #category-tiles-{{ section.id }} .ct-link::after {
    position: absolute;
    inset: 45% 0 0;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.16));
    content: "";
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  #category-tiles-{{ section.id }} .ct-link:focus-visible {
    outline: 3px solid #111;
    outline-offset: 4px;
  }

  #category-tiles-{{ section.id }} .ct-link img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  #category-tiles-{{ section.id }} .ct-link:hover img,
  #category-tiles-{{ section.id }} .ct-link:focus-visible img {
    transform: scale(1.06);
  }

  #category-tiles-{{ section.id }} .ct-link:hover::after,
  #category-tiles-{{ section.id }} .ct-link:focus-visible::after {
    opacity: 1;
  }

  #category-tiles-{{ section.id }} .ct-label {
    position: absolute;
    left: 50%;
    bottom: 2.4rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    transform: translateX(-50%);
    padding: 1rem 1.6rem;
    border: 1px solid rgb(255 255 255 / 0.85);
    background: rgb(255 255 255 / 0.96);
    box-shadow: 0 0.4rem 1.6rem rgb(0 0 0 / 0.12);
    color: #111;
    font-family: var(--font-body--family);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  #category-tiles-{{ section.id }} .ct-link:hover .ct-label,
  #category-tiles-{{ section.id }} .ct-link:focus-visible .ct-label {
    transform: translateX(-50%) translateY(-0.4rem);
    border-color: #111;
    background: #111;
    box-shadow: 0 0.8rem 2.4rem rgb(0 0 0 / 0.24);
    color: #fff;
  }

  #category-tiles-{{ section.id }} .ct-link:active .ct-label {
    transform: translateX(-50%) translateY(-0.1rem) scale(0.97);
  }

  #category-tiles-{{ section.id }} .ct-arrow {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: var(--ct-arrow-size);
    height: var(--ct-arrow-size);
    border: 0;
    border-radius: 50%;
    background: #e4e2df;
    box-shadow: 0 0.4rem 1.6rem rgb(0 0 0 / 0.12);
    color: #1a1a1a;
    cursor: pointer;
    transform: translateY(-50%);
    transition: opacity 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  #category-tiles-{{ section.id }} .ct-arrow:hover,
  #category-tiles-{{ section.id }} .ct-arrow:focus-visible {
    background: #000;
    color: #fff;
  }

  #category-tiles-{{ section.id }} .ct-arrow[disabled] {
    opacity: 0;
    pointer-events: none;
  }

  #category-tiles-{{ section.id }} .ct-arrow--prev { left: calc(var(--ct-arrow-size) * -0.5); }
  #category-tiles-{{ section.id }} .ct-arrow--next { right: calc(var(--ct-arrow-size) * -0.5); }

  #category-tiles-{{ section.id }} .ct-arrow .svg-wrapper {
    width: auto;
    height: auto;
  }

  #category-tiles-{{ section.id }} .ct-arrow .icon {
    width: var(--arrow-icon-size);
  }

  #category-tiles-{{ section.id }} .ct-arrow--prev .icon-caret { transform: rotate(90deg); }
  #category-tiles-{{ section.id }} .ct-arrow--next .icon-caret { transform: rotate(-90deg); }
  #category-tiles-{{ section.id }} .ct-arrow--prev .icon-arrow { transform: rotate(180deg); }

  #category-tiles-{{ section.id }} .ct-progress {
    height: 2px;
    margin-top: 2.8rem;
    background: rgb(0 0 0 / 0.1);
  }

  #category-tiles-{{ section.id }} .ct-progress span {
    display: block;
    height: 100%;
    width: var(--ct-progress, 50%);
    background: #111;
    transition: width 0.2s ease;
  }

  @media screen and (max-width: 1399px) {
    #category-tiles-{{ section.id }} {
      --ct-arrow-size: 40px;
    }

    #category-tiles-{{ section.id }} .ct-arrow .icon {
      width: 1.4rem;
    }
  }

  #category-tiles-{{ section.id }} .ct-empty {
    padding: 4rem 0;
    text-align: center;
    color: rgb(0 0 0 / 0.55);
  }

  @media screen and (max-width: 989px) {
    #category-tiles-{{ section.id }} .ct-track {
      grid-auto-columns: calc((100% - 2rem) / 2.3);
    }
  }

  @media screen and (max-width: 749px) {
    #category-tiles-{{ section.id }} .ct-inner {
      padding-inline: 1.6rem;
    }

    #category-tiles-{{ section.id }} .ct-track {
      grid-auto-columns: 72%;
      gap: 1.2rem;
    }

    #category-tiles-{{ section.id }} .ct-arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #category-tiles-{{ section.id }} .ct-track { scroll-behavior: auto; }
    #category-tiles-{{ section.id }} .ct-link img,
    #category-tiles-{{ section.id }} .ct-link::after,
    #category-tiles-{{ section.id }} .ct-label { transition: none; }
  }
{%- endstyle -%}

<div id="category-tiles-{{ section.id }}" class="category-tiles color-{{ section.settings.color_scheme }}">
  <div class="ct-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ct-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if menu == blank or menu.links.size == 0 -%}
      <p class="ct-empty">Choose a menu for this section in the theme editor.</p>
    {%- else -%}
      <div class="ct-viewport">
        <button type="button" class="ct-arrow ct-arrow--prev" aria-label="Previous" disabled>
          <span class="svg-wrapper">{%- render 'icon-arrow' -%}</span>
        </button>
        <ul class="ct-track" role="list">
          {%- for link in menu.links -%}
            {%- liquid
              assign tile_handle = link.title | handleize

              # A picture set on a block wins over everything else. Titles are compared
              # loosely, so "Best Sellers" and "best sellers" both reach the same tile.
              assign tile_image = blank
              for block in overrides
                if block.settings.image != blank
                  assign override_handle = block.settings.title | handleize
                  if override_handle == tile_handle
                    assign tile_image = block.settings.image
                  endif
                endif
              endfor

              # Otherwise the TILE PICTURES list at the top of this file, and failing that
              # the assets/category-<menu item>.png naming convention. A menu item with no
              # picture of any kind is hidden (the script below drops the tile), rather
              # than falling back to the collection photo.
              assign tile_asset = blank
              if tile_image == blank
                for pair in tile_picture_pairs
                  assign pair_parts = pair | split: ':'
                  assign pair_handle = pair_parts[0] | handleize
                  if pair_handle == tile_handle
                    assign tile_asset = pair_parts[1] | strip
                  endif
                endfor
                if tile_asset == blank
                  assign tile_asset = 'category-' | append: tile_handle | append: '.png'
                endif
              endif
            -%}
            <li class="ct-tile">
              <a class="ct-link" href="{{ link.url }}">
                {%- if tile_asset != blank -%}
                  {%- comment -%} The shipped pictures are 1122x1402; the CDN resizes them here. {%- endcomment -%}
                  <img
                    src="{{ tile_asset | asset_img_url: '900x' }}"
                    srcset="{{ tile_asset | asset_img_url: '450x' }} 450w, {{ tile_asset | asset_img_url: '700x' }} 700w, {{ tile_asset | asset_img_url: '900x' }} 900w, {{ tile_asset | asset_img_url: '1200x' }} 1200w"
                    sizes="(min-width: 990px) 25vw, 72vw"
                    alt="{{ link.title | escape }}"
                    width="1122"
                    height="1402"
                    loading="lazy"
                    data-ct-asset
                  >
                {%- elsif tile_image != blank -%}
                  {{ tile_image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 72vw', alt: link.title }}
                {%- endif -%}
                <span class="ct-label">{{ link.title | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <button type="button" class="ct-arrow ct-arrow--next" aria-label="Next">
          <span class="svg-wrapper">{%- render 'icon-arrow' -%}</span>
        </button>
      </div>
      <div class="ct-progress" aria-hidden="true"><span></span></div>
    {%- endif -%}
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('category-tiles-{{ section.id }}');
    const track = root?.querySelector('.ct-track');
    if (!track) return;
    const prev = root.querySelector('.ct-arrow--prev');
    const next = root.querySelector('.ct-arrow--next');
    const bar = root.querySelector('.ct-progress');

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
      const shown = track.clientWidth / track.scrollWidth;
      const progress = max > 0 ? shown + (1 - shown) * (track.scrollLeft / max) : 1;
      bar.style.setProperty('--ct-progress', `${Math.round(progress * 100)}%`);
      bar.hidden = max <= 0;
    };
    // Scroll by whole tiles, so a click always lands on a tile edge rather than part way
    // through one and letting scroll snapping decide where it ends up.
    const step = () => {
      const tile = track.querySelector('.ct-tile');
      if (!tile) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const tileWidth = tile.getBoundingClientRect().width + gap;
      if (!tileWidth) return track.clientWidth;
      return tileWidth * Math.max(1, Math.floor(track.clientWidth / tileWidth));
    };

    // A tile asks for assets/category-<menu item>.png. Until the shop adds that picture, the
    // whole tile is dropped rather than shown empty; adding the file brings the tile back.
    root.querySelectorAll('.ct-link img[data-ct-asset]').forEach((img) => {
      img.addEventListener('error', () => {
        img.closest('.ct-tile')?.remove();
        update();
      });
      // A tile that is still loading when the row is measured would leave the arrows in the
      // wrong state, so each picture re-checks once it has arrived.
      img.addEventListener('load', update);
    });

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Category tiles",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "One tile per menu item. A tile's picture comes from a \"Picture for a tile\" block below, or from the TILE PICTURES list at the top of sections/category-tiles.liquid, or from assets/category-<menu item>.png."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "per_row",
      "label": "Tiles across on desktop",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Tile shape",
      "options": [
        { "value": "3 / 4", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "2 / 3", "label": "Tall" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "tile_picture",
      "name": "Picture for a tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Menu item title",
          "info": "As in the menu, e.g. Earrings. Capitals and spacing do not have to match."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Picture"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles"
    }
  ]
}
{% endschema %}
