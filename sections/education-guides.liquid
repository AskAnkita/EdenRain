{% comment %}
  Education & Guides - the guides index.

  A contents list, not a shelf of cards: one row per guide, divided by
  hairlines, with the number on the left and a small picture on the right.
  Square throughout, because every radius in the theme's settings is 0.

  Numbering is real information here - a row says where that guide sits in the
  whole set - which is the one reason these rows carry digits and the blog's
  cards do not.

  Where a row's picture comes from, in order:
    1. "Image" on the block, chosen in the theme editor;
    2. "Image file name" on the block, a file under assets/ (the shipped guides
       reuse the mega menu's pictures, e.g. featured-diamonds-education.jpg);
    3. nothing - the frame keeps its tint, and a file name that does not
       resolve drops the picture rather than leaving a broken frame.

  Shape comes from .eg-index in assets/editorial-cards.css, shared with the
  "More guides" list at the foot of every guide page, so the two read alike.
{% endcomment %}

{{ 'editorial-cards.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign stts = section.settings
  assign topics = section.blocks

  assign index_class = 'eg-index'
  unless stts.show_numbers
    assign index_class = index_class | append: ' eg-index--unnumbered'
  endunless
  unless stts.show_images
    assign index_class = index_class | append: ' eg-index--plain'
  endunless
-%}

{%- style -%}
  #education-guides-{{ section.id }} {
    --eg-ink: {{ stts.text_color }};
    --eg-muted: {{ stts.muted_text_color }};
    --eg-accent: {{ stts.accent_color }};
    --eg-radius: {{ stts.panel_radius }}px;
    --eg-heading-size: {{ stts.heading_size | divided_by: 10.0 }}rem;
    --eg-body-size: {{ stts.body_size | divided_by: 10.0 }}rem;
    --eg-card-title-size: {{ stts.card_title_size | divided_by: 10.0 }}rem;
    --eg-card-text-size: {{ stts.card_text_size | divided_by: 10.0 }}rem;
    --eg-ratio: {{ stts.image_ratio }};
    --eg-gap: {{ stts.row_gap | divided_by: 10.0 }}rem;
    --eg-index-rule: {{ stts.card_border_color }};
    --eg-index-number: {{ stts.number_color }};
    --eg-index-tint: {{ stts.hover_color }};
    --eg-index-thumb: {{ stts.thumb_width | divided_by: 10.0 }}rem;
    --eg-index-pad: {{ stts.row_padding | divided_by: 10.0 }}rem;
    --eg-cta-bg: {{ stts.cta_background }};
    --eg-cta-ink: {{ stts.cta_text_color }};
    --eg-btn-bg: {{ stts.cta_button_background }};
    --eg-btn-ink: {{ stts.cta_button_text_color }};
    background: {{ stts.background }};
    color: {{ stts.text_color }};
    padding-block: {{ stts.padding_top }}px {{ stts.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="education-guides-{{ section.id }}"
  class="editorial-cards color-{{ stts.color_scheme }}"
>
  <div class="eg-shell">
    <div class="eg-intro">
      {%- if stts.eyebrow != blank -%}
        <p class="eg-eyebrow">{{ stts.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if stts.heading != blank -%}
        <h1 class="eg-heading">{{ stts.heading | escape }}</h1>
      {%- endif -%}

      {%- if stts.description != blank -%}
        <div class="eg-description rte">{{ stts.description }}</div>
      {%- endif -%}
    </div>

    {%- if topics.size == 0 -%}
      <p class="eg-empty">Add a guide to this section in the theme editor.</p>
    {%- else -%}
      <ol class="{{ index_class }}" role="list">
        {%- for block in topics -%}
          {%- liquid
            assign title = block.settings.title
            if title == blank
              continue
            endif

            assign number = block.settings.badge | strip
            if number == blank
              assign number = forloop.index | prepend: '0' | slice: -2, 2
            endif

            assign picture = block.settings.image
            assign picture_asset = blank
            if picture == blank
              assign picture_asset = block.settings.image_asset | strip
            endif

            assign has_link = false
            if block.settings.link != blank
              assign has_link = true
            endif
          -%}

          <li class="eg-index__item" {{ block.shopify_attributes }}>
            {%- if has_link -%}
              <a class="eg-index__link" href="{{ block.settings.link }}">
            {%- else -%}
              <div class="eg-index__link">
            {%- endif -%}

              {%- if stts.show_numbers -%}
                <span class="eg-index__number" aria-hidden="true">{{ number | escape }}</span>
              {%- endif -%}

              <div class="eg-index__copy">
                <h2 class="eg-index__title">{{ title | escape }}</h2>

                {%- if block.settings.text != blank -%}
                  <p class="eg-index__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}

                {%- if has_link -%}
                  <span class="eg-index__cta">
                    {{- block.settings.link_label | default: 'Read the guide' | escape -}}
                    <span class="eg-index__arrow" aria-hidden="true">&rarr;</span>
                  </span>
                {%- endif -%}
              </div>

              {%- comment -%}
                The picture is decoration here: the title beside it already names
                the guide, so an alt would only be read out twice.
              {%- endcomment -%}
              {%- if stts.show_images -%}
                <div class="eg-index__media">
                  {%- if picture != blank -%}
                    {{
                      picture
                      | image_url: width: 480
                      | image_tag:
                        loading: 'lazy',
                        sizes: '(min-width: 750px) 15rem, 100vw',
                        alt: ''
                    }}
                  {%- elsif picture_asset != blank -%}
                    <img
                      src="{{ picture_asset | asset_img_url: '480x' }}"
                      srcset="
                        {{ picture_asset | asset_img_url: '240x' }} 240w,
                        {{ picture_asset | asset_img_url: '480x' }} 480w
                      "
                      sizes="(min-width: 750px) 15rem, 100vw"
                      alt=""
                      width="480"
                      height="480"
                      loading="lazy"
                      data-eg-asset
                    >
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- if has_link -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if stts.show_cta and stts.cta_heading != blank -%}
      <div class="eg-cta">
        <div class="eg-cta__copy">
          <p class="eg-cta__heading">{{ stts.cta_heading | escape }}</p>
          {%- if stts.cta_text != blank -%}
            <div class="eg-cta__text rte">{{ stts.cta_text }}</div>
          {%- endif -%}
        </div>
        {%- if stts.cta_button_label != blank and stts.cta_button_link != blank -%}
          <a class="eg-cta__button eden-action eden-action--outline" href="{{ stts.cta_button_link }}">
            {{- stts.cta_button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- comment -%}
  A guide can name a file under assets/ the shop has not uploaded. Rather than
  leave a broken frame the picture is dropped and the row carries on as type.
{%- endcomment -%}
<script>
  (() => {
    const root = document.getElementById('education-guides-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('img[data-eg-asset]').forEach((img) => {
      img.addEventListener('error', () => img.closest('.eg-index__media')?.remove());
    });
  })();
</script>

{% schema %}
{
  "name": "Education & guides",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Introduction"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Education & guides"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you need to know, in plain language"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Introduction",
      "default": "<p>There is a lot to take in when you are choosing fine diamond and gemstone jewellery, from an engagement ring to a pair of everyday earrings. Explore the guides below to learn about diamonds and gemstones, caring for your jewellery, finding your ring size and more.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show pictures",
      "default": true
    },
    {
      "type": "range",
      "id": "thumb_width",
      "label": "Picture width",
      "min": 80,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "row_padding",
      "label": "Space above and below each guide",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Space between number, words and picture",
      "min": 8,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Featured image shape",
      "options": [
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "16 / 9", "label": "Wide (16:9)" }
      ],
      "default": "1 / 1",
      "info": "Each guide's thumbnail crops to this shape."
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show guide numbers",
      "default": true,
      "info": "A guide's number says where it sits in the set. Switch this off and the rows read as a plain list."
    },
    {
      "type": "header",
      "content": "Type sizes"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 24,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Introduction size",
      "min": 13,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Guide title size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 21
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "Guide description size",
      "min": 12,
