{% comment %}
  Design studio - the section behind /pages/design-your-own.

  Six bands in one section, each of which can be switched off: hero, the design
  tool, how it works, inspiration, questions and a closing panel. The shape is
  MiaDonna's custom-design page (hero and claims, a three-step process, a wall
  of past commissions, the questions, a closing CTA); the copy and the tool are
  ours.

  The band that does the work is the tool. It renders, in this order:

    1. any app block added to this section - which is where Pencil's builder
       goes once the app is installed (Online Store > Themes > Customise >
       Design studio > Add block > Pencil). Nothing here is Pencil-specific:
       any builder that ships a theme app extension drops into the same slot.
    2. an iframe, if "Builder embed URL" is filled in. For a builder handed to
       us as a URL rather than an app block. Some hosts refuse to be framed
       (X-Frame-Options / frame-ancestors), so check it renders before relying
       on it.
    3. the enquiry card, when neither of the two is there - the shop still takes
       custom work by email and form, so the page is useful before the builder
       is wired up and stays useful if it is ever turned off.

  Looks come from assets/design-studio.css; buttons from assets/eden-actions.css.
  Image slots reuse snippets/homepage-journey-image.liquid - picked image first,
  then a file in assets/, then a pasted URL, then a placeholder.

  Every restylable setting is written onto the section element as a CSS custom
  property, with the stylesheet's own value as the fallback, so a setting left
  at "use the default" (a cleared colour, a size of 0) writes nothing at all.
{% endcomment %}

{{ 'design-studio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'design-studio-progress.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign transparent = 'rgba(0,0,0,0)'

  # A template saved before a setting existed has no value for it, so sizes are
  # coerced with 'plus: 0' and treated as "keep the stylesheet default" at 0.
  # The paddings cannot use that sentinel - 0 is a real padding - and are gated
  # by the custom_padding checkbox instead.
  assign hero_size = section.settings.hero_size | plus: 0
  assign hero_size_mobile = section.settings.hero_size_mobile | plus: 0
  assign heading_size = section.settings.heading_size | plus: 0
  assign eyebrow_size = section.settings.eyebrow_size | plus: 0
  assign text_size = section.settings.text_size | plus: 0
  assign note_size = section.settings.note_size | plus: 0
  assign step_num_size = section.settings.step_num_size | plus: 0
  assign step_heading_size = section.settings.step_heading_size | plus: 0
  assign caption_size = section.settings.caption_size | plus: 0
  assign progress_size = section.settings.progress_size | plus: 0
  assign progress_gap = section.settings.progress_gap | plus: 0
  assign progress_top = section.settings.progress_top | plus: 0
  assign progress_track_height = section.settings.progress_track_height | plus: 0
  assign faq_size = section.settings.faq_size | plus: 0
  assign fallback_height = section.settings.fallback_height | plus: 0
  assign fallback_height_mobile = section.settings.fallback_height_mobile | plus: 0
  assign content_width = section.settings.content_width | plus: 0
  assign band_gap = section.settings.band_gap | plus: 0
  assign pad_inline = section.settings.padding_horizontal | plus: 0
  assign pad_top = section.settings.padding_top | plus: 0
  assign pad_bottom = section.settings.padding_bottom | plus: 0

  assign hero_image_set = false
  if section.settings.hero_image != blank or section.settings.hero_image_asset != blank or section.settings.hero_image_url != blank
    assign hero_image_set = true
  endif

  # Blocks are filtered into their own band rather than rendered in one run, so
  # the builder app block and the step cards can sit in the same section
  # without the editor's block order deciding which band they land in.
  assign app_blocks = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_blocks = app_blocks | plus: 1
    endif
  endfor

  assign notes = section.settings.notes | split: '|'

  # The progress bar is the same list of steps as the "how it works" band, read
  # from the same blocks, so a step added in the editor appears in both. It
  # points at anchors in that band, so it hides itself when the band is off.
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign show_progress = false
  if section.settings.show_progress and section.settings.show_steps and step_blocks.size > 0
    assign show_progress = true
  endif

  # The first button jumps down to the tool when no link is set, so the hero
  # works on a page where the builder is the whole point. Built here rather
  # than with `default:` in the markup: chaining `append` onto `default` would
  # glue the anchor onto a link the merchant did set.
  assign builder_anchor = '#DesignStudioBuilder-' | append: section.id
  assign primary_href = section.settings.primary_link
  if primary_href == blank
    assign primary_href = builder_anchor
  endif
-%}

{%- capture section_styles -%}
  {%- if section.settings.section_background != blank and section.settings.section_background != transparent -%}--ds-section-bg: {{ section.settings.section_background }};{%- endif -%}
  {%- if section.settings.heading_color != blank and section.settings.heading_color != transparent -%}--ds-heading-color: {{ section.settings.heading_color }};{%- endif -%}
  {%- if section.settings.eyebrow_color != blank and section.settings.eyebrow_color != transparent -%}--ds-eyebrow-color: {{ section.settings.eyebrow_color }};{%- endif -%}
  {%- if section.settings.text_color != blank and section.settings.text_color != transparent -%}--ds-text-color: {{ section.settings.text_color }};{%- endif -%}
  {%- if section.settings.note_background != blank and section.settings.note_background != transparent -%}--ds-note-bg: {{ section.settings.note_background }};{%- endif -%}
  {%- if section.settings.note_border != blank and section.settings.note_border != transparent -%}--ds-note-border: {{ section.settings.note_border }};{%- endif -%}
  {%- if section.settings.note_color != blank and section.settings.note_color != transparent -%}--ds-note-ink: {{ section.settings.note_color }};{%- endif -%}
  {%- if section.settings.wash_background != blank and section.settings.wash_background != transparent -%}--ds-wash-bg: {{ section.settings.wash_background }};{%- endif -%}
  {%- if section.settings.frame_background != blank and section.settings.frame_background != transparent -%}--ds-frame-bg: {{ section.settings.frame_background }};{%- endif -%}
  {%- if section.settings.frame_border != blank and section.settings.frame_border != transparent -%}--ds-frame-border: {{ section.settings.frame_border }};{%- endif -%}
  {%- if section.settings.rule_color != blank and section.settings.rule_color != transparent -%}--ds-step-line: {{ section.settings.rule_color }};--ds-faq-line: {{ section.settings.rule_color }};{%- endif -%}
  {%- if section.settings.step_num_color != blank and section.settings.step_num_color != transparent -%}--ds-step-num-color: {{ section.settings.step_num_color }};{%- endif -%}
  {%- if section.settings.progress_background != blank and section.settings.progress_background != transparent -%}--ds-progress-bg: {{ section.settings.progress_background }};{%- endif -%}
  {%- if section.settings.progress_color != blank and section.settings.progress_color != transparent -%}--ds-progress-color: {{ section.settings.progress_color }};{%- endif -%}
  {%- if section.settings.progress_done_color != blank and section.settings.progress_done_color != transparent -%}--ds-progress-done-color: {{ section.settings.progress_done_color }};{%- endif -%}
  {%- if section.settings.progress_current_color != blank and section.settings.progress_current_color != transparent -%}--ds-progress-current-color: {{ section.settings.progress_current_color }};{%- endif -%}
  {%- if section.settings.progress_track_color != blank and section.settings.progress_track_color != transparent -%}--ds-progress-track-color: {{ section.settings.progress_track_color }};{%- endif -%}
  {%- if section.settings.progress_fill_color != blank and section.settings.progress_fill_color != transparent -%}--ds-progress-fill-color: {{ section.settings.progress_fill_color }};{%- endif -%}
  {%- if section.settings.cta_background != blank and section.settings.cta_background != transparent -%}--ds-cta-bg: {{ section.settings.cta_background }};{%- endif -%}
  {%- if section.settings.cta_text_color != blank and section.settings.cta_text_color != transparent -%}--ds-cta-ink: {{ section.settings.cta_text_color }};{%- endif -%}

  {%- if hero_size > 0 -%}--ds-hero-size: {{ hero_size }}px;{%- endif -%}
  {%- if hero_size_mobile > 0 -%}--ds-hero-size-mobile: {{ hero_size_mobile }}px;{%- endif -%}
  {%- if heading_size > 0 -%}--ds-heading-size: {{ heading_size }}px;{%- endif -%}
  {%- if eyebrow_size > 0 -%}--ds-eyebrow-size: {{ eyebrow_size }}px;{%- endif -%}
  {%- if text_size > 0 -%}--ds-text-size: {{ text_size }}px;{%- endif -%}
  {%- if note_size > 0 -%}--ds-note-size: {{ note_size }}px;{%- endif -%}
  {%- if step_num_size > 0 -%}--ds-step-num-size: {{ step_num_size }}px;{%- endif -%}
  {%- if step_heading_size > 0 -%}--ds-step-heading-size: {{ step_heading_size }}px;{%- endif -%}
  {%- if caption_size > 0 -%}--ds-caption-size: {{ caption_size }}px;{%- endif -%}
  {%- if progress_size > 0 -%}--ds-progress-size: {{ progress_size }}px;{%- endif -%}
  {%- if progress_gap > 0 -%}--ds-progress-gap: {{ progress_gap }}px;{%- endif -%}
  {%- if progress_track_height > 0 -%}--ds-progress-track-height: {{ progress_track_height }}px;{%- endif -%}
  {%- if show_progress -%}
    {%- assign scroll_margin = progress_top | plus: 40 -%}
    --ds-progress-top: {{ progress_top }}px;--ds-progress-scroll-margin: {{ scroll_margin }}px;
    {%- if section.settings.progress_alignment == 'left' -%}--ds-progress-justify: flex-start;{%- elsif section.settings.progress_alignment == 'right' -%}--ds-progress-justify: flex-end;{%- endif -%}
  {%- endif -%}
  {%- if faq_size > 0 -%}--ds-faq-size: {{ faq_size }}px;{%- endif -%}
  {%- if fallback_height > 0 -%}--ds-fallback-height: {{ fallback_height }}px;{%- endif -%}
  {%- if fallback_height_mobile > 0 -%}--ds-fallback-height-mobile: {{ fallback_height_mobile }}px;{%- endif -%}

  --ds-hero-ratio: {{ section.settings.hero_ratio }};
  --ds-hero-ratio-mobile: {{ section.settings.hero_ratio_mobile }};
  --ds-frame-height: {{ section.settings.frame_height }}px;
  --ds-frame-height-mobile: {{ section.settings.frame_height_mobile }}px;
  --ds-gallery-columns: {{ section.settings.gallery_columns }};
  --ds-gallery-columns-mobile: {{ section.settings.gallery_columns_mobile }};
  --ds-tile-ratio: {{ section.settings.tile_ratio }};
  {%- unless hero_image_set -%}
    {%- if section.settings.hero_alignment == 'center' -%}--ds-hero-align: center;--ds-hero-justify: center;{%- elsif section.settings.hero_alignment == 'right' -%}--ds-hero-align: right;--ds-hero-justify: end;{%- endif -%}
  {%- endunless -%}

  {%- if section.settings.full_width -%}
    --ds-shell-max: none;
  {%- elsif content_width > 0 -%}
    --ds-shell-max: {{ content_width }}px;
  {%- endif -%}
  {%- if band_gap > 0 -%}--ds-band-gap: {{ band_gap }}px;{%- endif -%}
  {%- if pad_inline > 0 -%}--ds-pad-inline: {{ pad_inline }}px;{%- endif -%}
  {%- if section.settings.custom_padding -%}--ds-pad-top: {{ pad_top }}px;--ds-pad-bottom: {{ pad_bottom }}px;{%- endif -%}
{%- endcapture -%}
{%- assign section_styles = section_styles | strip | strip_newlines -%}

<section
  class="design-studio"
  id="DesignStudio-{{ section.id }}"
  {% if section_styles != blank %}
    style="{{ section_styles }}"
  {% endif %}
>
  {%- if show_progress -%}
    <ds-progress
      class="ds-progress{% if section.settings.progress_sticky %} ds-progress--sticky{% endif %}"
      role="navigation"
      aria-label="{{ section.settings.progress_aria_label | default: 'Design steps' | escape }}"
      {% if section.settings.progress_sticky %}data-sticky{% endif %}
    >
      <div class="ds-shell">
        <ol class="ds-progress__list">
          {%- for block in step_blocks -%}
            {%- liquid
              assign progress_label = block.settings.progress_label
              if progress_label == blank
                assign progress_label = block.settings.heading
              endif
              if progress_label == blank
                assign progress_label = block.settings.label
              endif
              if progress_label == blank
                capture progress_label
                  echo section.settings.step_word | default: 'Step'
                  echo ' '
                  echo forloop.index
                endcapture
              endif
            -%}
            <li class="ds-progress__item">
              <a
                class="ds-progress__link"
                href="#DesignStudioStep-{{ section.id }}-{{ forloop.index }}"
                data-ds-progress-link
              >
                {%- if section.settings.progress_numbers -%}
                  <span class="ds-progress__num">{{ forloop.index }}</span>
                {%- endif -%}
                <span class="ds-progress__label">{{ progress_label | strip | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        </ol>
        <div class="ds-progress__track" aria-hidden="true">
          <span class="ds-progress__fill" data-ds-progress-fill></span>
        </div>
      </div>
    </ds-progress>
  {%- endif -%}

  {%- if section.settings.show_hero -%}
    <div class="ds-shell">
      <div class="ds-hero{% unless hero_image_set %} ds-hero--no-media{% endunless %}">
        <div class="ds-hero__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="ds-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            {%- comment -%}
              h1 only when the page has no other one. The page template drops
              main-page, so this section carries the page's heading.
            {%- endcomment -%}
            {%- if section.settings.heading_is_h1 -%}
              <h1>{{ section.settings.heading | escape }}</h1>
            {%- else -%}
              <h2>{{ section.settings.heading | escape }}</h2>
            {%- endif -%}
          {%- endif -%}

          {%- if section.settings.intro != blank -%}
            <div class="ds-text">{{ section.settings.intro }}</div>
          {%- endif -%}

          {%- if notes.size > 0 -%}
            <ul class="ds-notes">
              {%- for note in notes -%}
                {%- assign note_text = note | strip -%}
                {%- if note_text != blank -%}
                  <li class="ds-note">{{ note_text | escape }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
            <div class="ds-actions">
              {%- if section.settings.primary_label != blank -%}
                <a class="eden-action eden-action--solid" href="{{ primary_href }}">
                  {{- section.settings.primary_label | escape -}}
                </a>
              {%- endif -%}
              {%- if section.settings.secondary_label != blank -%}
                <a class="eden-action eden-action--outline" href="{{ section.settings.secondary_link | default: '#' }}">
                  {{- section.settings.secondary_label | escape -}}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- if hero_image_set -%}
          <div class="ds-hero__media">
            {%- render 'homepage-journey-image',
              image: section.settings.hero_image,
              asset: section.settings.hero_image_asset,
              image_url: section.settings.hero_image_url,
              alt: section.settings.hero_image_alt,
              placeholder: 'product-1',
              sizes: '(min-width: 990px) 48vw, 100vw',
              width: 1400,
              height: 1200
            -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.show_builder -%}
    <div class="ds-shell ds-builder" id="DesignStudioBuilder-{{ section.id }}">
      {%- if section.settings.builder_heading != blank or section.settings.builder_intro != blank -%}
        <div class="ds-band__head">
          {%- if section.settings.builder_heading != blank -%}
            <h2>{{ section.settings.builder_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.builder_intro != blank -%}
            <div class="ds-text">{{ section.settings.builder_intro }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div
        class="ds-builder__frame{% if app_blocks == 0 and section.settings.embed_url == blank %} ds-builder__frame--fallback{% endif %}"
        {% if app_blocks == 0 and section.settings.embed_url == blank %}
          style="--ds-fallback-art: url('{{ 'bespoke-jewelry-atelier-bg.png' | asset_url }}');"
        {% endif %}
      >
        {%- if app_blocks > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <div class="ds-builder__app" {{ block.shopify_attributes }}>{% render block %}</div>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif section.settings.embed_url != blank -%}
          <iframe
            class="ds-builder__iframe"
            src="{{ section.settings.embed_url }}"
            title="{{ section.settings.embed_title | default: 'Design studio' | escape }}"
            loading="lazy"
            allow="fullscreen; clipboard-write; xr-spatial-tracking; accelerometer; gyroscope"
            allowfullscreen
          ></iframe>
        {%- else -%}
          <div class="ds-builder__fallback">
            {%- if section.settings.fallback_heading != blank -%}
              <h3>{{ section.settings.fallback_heading | escape }}</h3>
            {%- endif -%}
            {%- if section.settings.fallback_text != blank -%}
              <div class="ds-text">{{ section.settings.fallback_text }}</div>
            {%- endif -%}
            {%- if section.settings.fallback_label != blank -%}
              <div class="ds-actions">
                <a class="eden-action eden-action--solid" href="{{ section.settings.fallback_link | default: '#' }}">
                  {{- section.settings.fallback_label | escape -}}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.builder_note != blank -%}
        <p class="ds-builder__aside">{{ section.settings.builder_note }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_steps -%}
    {%- assign step_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'step' -%}
        {%- assign step_count = step_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if step_count > 0 -%}
      <div class="ds-band{% if section.settings.steps_wash %} ds-band--wash{% endif %}">
        <div class="ds-shell">
          {%- if section.settings.steps_heading != blank or section.settings.steps_intro != blank -%}
            <div class="ds-band__head">
              {%- if section.settings.steps_heading != blank -%}
                <h2>{{ section.settings.steps_heading | escape }}</h2>
              {%- endif -%}
              {%- if section.settings.steps_intro != blank -%}
                <div class="ds-text">{{ section.settings.steps_intro }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="ds-steps">
            {%- assign step_index = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type != 'step' -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign step_index = step_index | plus: 1 -%}
              {%- assign step_image_set = false -%}
              {%- if block.settings.image != blank
                or block.settings.image_asset != blank
                or block.settings.image_url != blank
              -%}
                {%- assign step_image_set = true -%}
              {%- endif -%}

              <div
                class="ds-step"
                id="DesignStudioStep-{{ section.id }}-{{ step_index }}"
                {{ block.shopify_attributes }}
              >
                {%- if step_image_set -%}
                  <div class="ds-step__media">
                    {%- render 'homepage-journey-image',
                      image: block.settings.image,
                      asset: block.settings.image_asset,
                      image_url: block.settings.image_url,
                      alt: block.settings.image_alt,
                      placeholder: 'product-2',
                      sizes: '(min-width: 990px) 30vw, 100vw',
                      width: 800,
                      height: 620
                    -%}
                  </div>
                {%- endif -%}

                {%- comment -%}
                  A step with no label of its own is numbered from its position,
                  so adding a fourth step does not mean renumbering the first
                  three by hand.
                {%- endcomment -%}
                {%- assign step_label = block.settings.label -%}
                {%- if step_label == blank and section.settings.number_steps -%}
                  {%- capture step_label -%}
                    {{ section.settings.step_word | default: 'Step' }} {{ step_index }}
                  {%- endcapture -%}
                {%- endif -%}
                {%- if step_label != blank -%}
                  <span class="ds-step__num">{{ step_label | strip | escape }}</span>
                {%- endif -%}

                {%- if block.settings.heading != blank -%}
                  <h3>{{ block.settings.heading | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="ds-text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.show_gallery -%}
    {%- assign tile_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'inspiration' -%}
        {%- assign tile_count = tile_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if tile_count > 0 -%}
      <div class="ds-band">
        <div class="ds-shell">
          {%- if section.settings.gallery_heading != blank or section.settings.gallery_intro != blank -%}
            <div class="ds-band__head">
              {%- if section.settings.gallery_heading != blank -%}
                <h2>{{ section.settings.gallery_heading | escape }}</h2>
              {%- endif -%}
              {%- if section.settings.gallery_intro != blank -%}
                <div class="ds-text">{{ section.settings.gallery_intro }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="ds-gallery">
            {%- for block in section.blocks -%}
              {%- if block.type != 'inspiration' -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign tile_tag = 'div' -%}
              {%- if block.settings.link != blank -%}
                {%- assign tile_tag = 'a' -%}
              {%- endif -%}

              <{{ tile_tag }}
                class="ds-tile"
                {% if tile_tag == 'a' %}
                  href="{{ block.settings.link }}"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <div class="ds-tile__media">
                  {%- render 'homepage-journey-image',
                    image: block.settings.image,
                    asset: block.settings.image_asset,
                    image_url: block.settings.image_url,
                    alt: block.settings.image_alt,
                    placeholder: 'product-3',
                    sizes: '(min-width: 990px) 30vw, 50vw',
                    width: 800,
                    height: 800
                  -%}
                </div>
                {%- if block.settings.caption != blank -%}
                  <span class="ds-tile__caption">{{ block.settings.caption | escape }}</span>
                {%- endif -%}
              </{{ tile_tag }}>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.show_faqs -%}
    {%- assign faq_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}
        {%- assign faq_count = faq_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if faq_count > 0 -%}
      <div class="ds-band{% if section.settings.faqs_wash %} ds-band--wash{% endif %}">
        <div class="ds-shell">
          {%- if section.settings.faqs_heading != blank -%}
            <div class="ds-band__head">
              <h2>{{ section.settings.faqs_heading | escape }}</h2>
            </div>
          {%- endif -%}

          <div class="ds-faqs">
            {%- for block in section.blocks -%}
              {%- if block.type != 'faq' -%}
                {%- continue -%}
              {%- endif -%}
              <details
                class="ds-faq"
                {% if block.settings.open %}
                  open
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <summary>{{ block.settings.question | escape }}</summary>
                <div class="ds-faq__answer ds-text">{{ block.settings.answer }}</div>
              </details>
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.show_cta -%}
    <div class="ds-shell">
      <div class="ds-cta">
        {%- if section.settings.cta_heading != blank -%}
          <h2>{{ section.settings.cta_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.cta_text != blank -%}
          <div class="ds-text">{{ section.settings.cta_text }}</div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <div class="ds-actions">
            <a class="eden-action eden-action--outline" href="{{ section.settings.cta_link | default: '#' }}">
              {{- section.settings.cta_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Design studio",
  "tag": "section",
  "class": "section-design-studio",
  "settings": [
    { "type": "header", "content": "Bands", "info": "Switch off a band to hide it. A band with no blocks hides itself." },
    { "type": "checkbox", "id": "show_hero", "label": "Show the hero", "default": true },
    { "type": "checkbox", "id": "show_builder", "label": "Show the design tool", "default": true },
    { "type": "checkbox", "id": "show_steps", "label": "Show how it works", "default": true },
    { "type": "checkbox", "id": "show_progress", "label": "Show the progress bar at the top", "info": "The steps from \"How it works\", at the top of the page. Clicking one scrolls down this page - it never leaves it. Needs \"Show how it works\" on.", "default": true },
    { "type": "checkbox", "id": "show_gallery", "label": "Show the inspiration wall", "default": true },
    { "type": "checkbox", "id": "show_faqs", "label": "Show the questions", "default": true },
    { "type": "checkbox", "id": "show_cta", "label": "Show the closing panel", "default": true },

    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "DESIGN STUDIO" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Design your own" },
    { "type": "checkbox", "id": "heading_is_h1", "label": "Use the heading as the page's H1", "info": "Leave on when this section carries the page title. Switch it off if another section on the page already has an H1.", "default": true },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Start from one of our settings or from a sketch of your own. Build the piece in 3D, watch the price move as you change it, and we will make it for you.</p>" },
    { "type": "text", "id": "notes", "label": "Claims under the intro (separate with |)", "info": "Short and factual - lead time, minimum spend, design fee. Leave empty to hide them.", "default": "No design fee | Free 3D preview | Made to order" },
    { "type": "select", "id": "hero_alignment", "label": "Hero alignment", "info": "Only used when the hero has no photo.", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ], "default": "left" },

    { "type": "header", "content": "Hero buttons" },
    { "type": "text", "id": "primary_label", "label": "First button label", "info": "Leave empty to hide it.", "default": "Start designing" },
    { "type": "url", "id": "primary_link", "label": "First button link", "info": "Leave empty to jump down to the design tool on this page." },
    { "type": "text", "id": "secondary_label", "label": "Second button label", "default": "Talk to a designer" },
    { "type": "url", "id": "secondary_link", "label": "Second button link" },

    { "type": "header", "content": "Hero image", "info": "Leave all three empty for a text-only hero." },
    { "type": "image_picker", "id": "hero_image", "label": "Image" },
    { "type": "text", "id": "hero_image_asset", "label": "Image file name (fallback)", "info": "A file name in Content > Files (or assets/), e.g. featured-engagement-signature.jpg. Only used when no image is picked above." },
    { "type": "text", "id": "hero_image_url", "label": "Image URL (fallback)", "info": "Only used when neither of the two above is set." },
    { "type": "text", "id": "hero_image_alt", "label": "Image alt text", "default": "A bespoke lab-grown diamond ring made in our studio" },
    { "type": "select", "id": "hero_ratio", "label": "Image shape (desktop)", "options": [ { "value": "1.35", "label": "Landscape" }, { "value": "1.1", "label": "Slight landscape" }, { "value": "1", "label": "Square" }, { "value": "0.8", "label": "Portrait" } ], "default": "1.1" },
    { "type": "select", "id": "hero_ratio_mobile", "label": "Image shape (mobile)", "options": [ { "value": "1.35", "label": "Landscape" }, { "value": "1.05", "label": "Slight landscape" }, { "value": "1", "label": "Square" }, { "value": "0.85", "label": "Portrait" } ], "default": "1.05" },

    { "type": "header", "content": "The design tool", "info": "Add the builder's app block to this section (Add block), or paste its embed URL below. With neither, the enquiry card is shown instead." },
    { "type": "text", "id": "builder_heading", "label": "Heading", "default": "Build it in 3D" },
    { "type": "richtext", "id": "builder_intro", "label": "Text under the heading", "default": "<p>Choose a setting, a stone and a metal. Every change is priced as you go, and what you see is what we make.</p>" },
    { "type": "url", "id": "embed_url", "label": "Builder embed URL", "info": "For a builder handed to us as a URL rather than an app block - e.g. the embed URL from iJewel Drive > the file > Embedding, with the file set to public. Used only when no app block has been added. Some hosts refuse to be framed - check it renders." },
    { "type": "text", "id": "embed_title", "label": "Embed title for screen readers", "default": "Design your own jewellery" },
    { "type": "richtext", "id": "builder_note", "label": "Note under the tool", "info": "Leave empty to hide it." },

    { "type": "header", "content": "Enquiry card", "info": "Stands in the tool's frame until a builder is wired up, and after it, if the tool is ever switched off." },
    { "type": "text", "id": "fallback_heading", "label": "Heading", "default": "Designed with you, by hand" },
    { "type": "richtext", "id": "fallback_text", "label": "Text", "default": "<p>Tell us what you have in mind - a stone, a setting, a piece you want remade - and we will come back with a sketch and a price.</p>" },
    { "type": "text", "id": "fallback_label", "label": "Button label", "default": "Start a bespoke enquiry" },
    { "type": "url", "id": "fallback_link", "label": "Button link" },
    { "type": "range", "id": "fallback_height", "label": "Card height (desktop)", "min": 320, "max": 900, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "fallback_height_mobile", "label": "Card height (mobile)", "min": 280, "max": 800, "step": 20, "unit": "px", "default": 440 },

    { "type": "header", "content": "Tool frame" },
    { "type": "range", "id": "frame_height", "label": "Frame height (desktop)", "min": 400, "max": 1400, "step": 20, "unit": "px", "default": 720 },
    { "type": "range", "id": "frame_height_mobile", "label": "Frame height (mobile)", "min": 320, "max": 1200, "step": 20, "unit": "px", "default": 560 },
    { "type": "color", "id": "frame_background", "label": "Frame background", "default": "rgba(0,0,0,0)", "info": "Clear a colour to use the stylesheet default." },
    { "type": "color", "id": "frame_border", "label": "Frame border", "default": "rgba(0,0,0,0)" },

    { "type": "header", "content": "How it works" },
    { "type": "text", "id": "steps_heading", "label": "Heading", "default": "How it works" },
    { "type": "richtext", "id": "steps_intro", "label": "Text under the heading", "default": "<p>Three steps from an idea to a finished piece.</p>" },
    { "type": "checkbox", "id": "number_steps", "label": "Number the steps automatically", "info": "Numbers a step from its position unless the block has a label of its own.", "default": true },
    { "type": "text", "id": "step_word", "label": "Word before the number", "default": "Step" },
    { "type": "checkbox", "id": "steps_wash", "label": "Put this band on a tinted background", "default": true },

    { "type": "header", "content": "Inspiration wall" },
    { "type": "text", "id": "gallery_heading", "label": "Heading", "default": "Made for someone" },
    { "type": "richtext", "id": "gallery_intro", "label": "Text under the heading", "default": "<p>A few of the pieces that started as a conversation.</p>" },
    { "type": "range", "id": "gallery_columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "range", "id": "gallery_columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "select", "id": "tile_ratio", "label": "Tile shape", "options": [ { "value": "1", "label": "Square" }, { "value": "0.8", "label": "Portrait" }, { "value": "1.33", "label": "Landscape" } ], "default": "1" },

    { "type": "header", "content": "Questions" },
    { "type": "text", "id": "faqs_heading", "label": "Heading", "default": "Questions" },
    { "type": "checkbox", "id": "faqs_wash", "label": "Put this band on a tinted background", "default": false },

    { "type": "header", "content": "Closing panel" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Not sure where to start?" },
    { "type": "richtext", "id": "cta_text", "label": "Text", "default": "<p>Book a call with one of our designers. No obligation, no pressure - just an honest view on what is possible.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Book a design call" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color", "id": "cta_background", "label": "Panel background", "default": "rgba(0,0,0,0)", "info": "Clear a colour to use the stylesheet default." },
    { "type": "color", "id": "cta_text_color", "label": "Panel text", "default": "rgba(0,0,0,0)" },

    { "type": "header", "content": "Progress bar", "info": "One link per step block, over a line that fills as the page is read." },
    { "type": "checkbox", "id": "progress_sticky", "label": "Keep it on screen while scrolling", "default": true },
    { "type": "range", "id": "progress_top", "label": "Distance from the top when stuck", "min": 0, "max": 200, "step": 10, "unit": "px", "default": 90, "info": "Clear of the sticky header." },
    { "type": "checkbox", "id": "progress_numbers", "label": "Show the step numbers", "default": true },
    { "type": "select", "id": "progress_alignment", "label": "Alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "text", "id": "progress_aria_label", "label": "Label for screen readers", "default": "Design steps" },
    { "type": "range", "id": "progress_gap", "label": "Space under the bar", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the theme's responsive spacing (24-44px)." },
    { "type": "range", "id": "progress_track_height", "label": "Line thickness", "min": 0, "max": 12, "step": 1, "unit": "px", "default": 0, "info": "0 keeps the default of 2px." },

    { "type": "header", "content": "Colours", "info": "Clear a colour to use the stylesheet default." },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "note_background", "label": "Claim chip background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "note_border", "label": "Claim chip border", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "note_color", "label": "Claim chip text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "wash_background", "label": "Tinted band background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "rule_color", "label": "Hairlines", "info": "The rule above each step and between the questions.", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "step_num_color", "label": "Step number", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "progress_background", "label": "Progress bar background", "info": "Needed when the bar is sticky, so the page does not show through it.", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "progress_color", "label": "Progress bar steps", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "progress_done_color", "label": "Progress bar steps already passed", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "progress_current_color", "label": "Progress bar current step", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "progress_track_color", "label": "Progress line", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "progress_fill_color", "label": "Progress line fill", "default": "rgba(0,0,0,0)" },

    { "type": "header", "content": "Typography", "info": "Set a size to 0 to keep the stylesheet's responsive default." },
    { "type": "range", "id": "hero_size", "label": "Hero heading size (desktop)", "min": 0, "max": 90, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "hero_size_mobile", "label": "Hero heading size (mobile)", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "heading_size", "label": "Band heading size", "min": 0, "max": 72, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_size", "label": "Body text size", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "note_size", "label": "Claim chip size", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "step_num_size", "label": "Step number size", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "step_heading_size", "label": "Step heading size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "caption_size", "label": "Tile caption size", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "progress_size", "label": "Progress bar text size", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "faq_size", "label": "Question size", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "Content width" },
    { "type": "checkbox", "id": "full_width", "label": "Stretch content to the screen edge", "default": false },
    { "type": "range", "id": "content_width", "label": "Maximum content width", "min": 0, "max": 2400, "step": 40, "unit": "px", "default": 0, "info": "0 keeps the default 1560px. Ignored when the box above is ticked." },
    { "type": "range", "id": "padding_horizontal", "label": "Side padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the theme's responsive padding (20-64px)." },
    { "type": "range", "id": "band_gap", "label": "Space between bands", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the theme's responsive spacing (28-60px)." },

    { "type": "header", "content": "Section padding" },
    { "type": "checkbox", "id": "custom_padding", "label": "Use custom section padding", "info": "Off keeps the theme's responsive padding.", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label above the heading", "info": "Leave empty to number the step from its position." },
        { "type": "text", "id": "progress_label", "label": "Short label for the progress bar", "info": "Optional. Leave empty to use the heading." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us the idea" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe the piece, send a photo, or start from one of our settings.</p>" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Leave all three empty for a text-only step." },
        { "type": "text", "id": "image_asset", "label": "Image file name (fallback)", "info": "A file name in Content > Files (or assets/)." },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" }
      ]
    },
    {
      "type": "inspiration",
      "name": "Inspiration tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Image file name (fallback)", "info": "A file name in Content > Files (or assets/)." },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Leave empty to hide it." },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional. Makes the whole tile clickable." }
      ]
    },
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does a bespoke piece take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Most pieces are ready a few weeks after the design is approved. We will give you a date with your quote.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Design studio",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
