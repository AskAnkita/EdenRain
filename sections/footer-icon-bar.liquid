{% comment %}
  The blush band above the footer: a row of short reassurance lines, each with a small icon.
  Rebuilt natively for this theme from the "Copy of Copy of Eden Raine v1.1" footer__icon-bar.
{% endcomment %}

{%- liquid
  assign bar_id = 'footer-icon-bar-' | append: section.id
-%}

{%- if section.settings.show_bar and section.blocks.size > 0 -%}
  {%- style -%}
    #{{ bar_id }} {
      background: {{ section.settings.background }};
      color: {{ section.settings.text_color }};
      padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    }

    #{{ bar_id }} .fib-inner {
      max-width: {{ section.settings.content_width }}px;
      margin: 0 auto;
      padding-inline: {{ section.settings.side_padding }}px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: {{ section.settings.alignment }};
      gap: 1.2rem 4rem;
    }

    #{{ bar_id }} .fib-item {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      color: inherit;
      text-decoration: none;
      font-family: var(--font-body--family);
      font-size: {{ section.settings.text_size | divided_by: 10.0 }}rem;
      line-height: 1.4;
    }

    #{{ bar_id }} a.fib-item:hover {
      opacity: 0.7;
    }

    #{{ bar_id }} .fib-icon {
      display: block;
      width: {{ section.settings.icon_size | divided_by: 10.0 }}rem;
      height: {{ section.settings.icon_size | divided_by: 10.0 }}rem;
      flex: none;
    }

    @media screen and (max-width: 749px) {
      #{{ bar_id }} {
        padding-block: 1.6rem;
      }

      #{{ bar_id }} .fib-inner {
        display: grid;
        grid-template-columns: repeat({{ section.blocks.size | default: 3 }}, minmax(0, 1fr));
        gap: 0;
        padding-inline: 1rem;
      }

      #{{ bar_id }} .fib-item {
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        text-align: center;
        gap: 0.6rem;
        padding: 0 0.4rem;
        font-size: 1.15rem;
        font-weight: 500;
        line-height: 1.25;
      }

      #{{ bar_id }} .fib-item + .fib-item {
        border-left: 1px solid rgba(0, 0, 0, 0.08);
      }

      #{{ bar_id }} .fib-icon {
        width: 1.8rem;
        height: 1.8rem;
      }
    }
  {%- endstyle -%}

  <div id="{{ bar_id }}" class="footer-icon-bar">
    <div class="fib-inner">
      {%- for block in section.blocks -%}
        {%- capture item_body -%}
          <span class="fib-icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'gem' -%}
                <svg viewBox="0 0 24 24" fill="currentColor" width="100%" height="100%"><path d="M6 2h12l4 6-10 14L2 8l4-6Zm.6 2L4.3 7.4h4.2L9.7 4H6.6Zm5.4 0-1.2 3.4h2.4L12 4Zm2.3 0 1.2 3.4h4.2L17.4 4h-3.1ZM4.6 9.4 11 18.3 8.6 9.4H4.6Zm6.1 0L12 14l1.3-4.6h-2.6Zm4.7 0-2.4 8.9 6.4-8.9h-4Z"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="100%" height="100%"><path d="M1 6h13v9H1zM14 9h4l3 3v3h-7z"/><circle cx="5.5" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
              {%- when 'globe' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="100%" height="100%"><circle cx="12" cy="12" r="9.5"/><path d="M2.8 9h18.4M2.8 15h18.4M12 2.5c2.4 2.6 3.6 5.8 3.6 9.5s-1.2 6.9-3.6 9.5c-2.4-2.6-3.6-5.8-3.6-9.5S9.6 5.1 12 2.5Z"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="100%" height="100%"><path d="M4 20c0-8 6-14 16-15 0 10-5 16-13 16H4Z"/><path d="M4 20c4-4 8-7 12-9"/></svg>
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="100%" height="100%"><path d="M12 2.5 20 6v6c0 5-3.4 8.4-8 9.5-4.6-1.1-8-4.5-8-9.5V6l8-3.5Z"/></svg>
              {%- when 'tag' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="100%" height="100%"><path d="M3 3h8l10 10-8 8L3 11V3Z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
            {%- endcase -%}
          </span>
          {%- if block.settings.text != blank -%}
            <span>{{ block.settings.text | escape }}</span>
          {%- endif -%}
        {%- endcapture -%}

        {%- if block.settings.link != blank -%}
          <a class="fib-item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ item_body }}</a>
        {%- else -%}
          <div class="fib-item" {{ block.shopify_attributes }}>{{ item_body }}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Footer icon bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_bar",
      "label": "Show the bar",
      "default": true
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ead9d1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#161616"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "flex-start", "label": "Left" },
        { "value": "space-between", "label": "Spread out" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 11,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content width",
      "min": 800,
      "max": 1920,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "side_padding",
      "label": "Side padding",
      "min": 16,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "gem", "label": "Gem" },
            { "value": "truck", "label": "Delivery" },
            { "value": "globe", "label": "Globe" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "tag", "label": "Tag" }
          ],
          "default": "gem"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ethical choice"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer icon bar",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
