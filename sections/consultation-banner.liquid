{% comment %}
  Consultation banner - the room on one side, the invitation to book time in it on the other.

  The shape is the "meet with our consultant" band: a photograph running edge to edge and full
  height, and beside it a flat panel holding the ways to meet, one heading, a line of copy and
  the booking button. Below 750px the picture goes on top and the panel underneath.

  A way to meet is a block, so the row above the heading is as long as the number of ways this
  shop actually offers. A block with no label still prints its icon, and a block with no icon
  still prints its label.

  The picture goes through 'homepage-journey-image' - picked image first, then a file in
  assets/, then a pasted URL, then a placeholder - so the band never collapses in the editor
  while the photography is still being shot.

  Looks come from assets/consultation-banner.css; buttons from assets/eden-actions.css, whose
  ink is rebound here so they follow this section's own button colours.

  Every restylable setting is written onto the section element as a CSS custom property, with
  the stylesheet's own value as the fallback, so a setting left at "use the default" (a cleared
  colour, a size of 0) writes nothing at all.
{% endcomment %}

{{ 'consultation-banner.css' | asset_url | stylesheet_tag }}
{{ 'eden-actions.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign transparent = 'rgba(0,0,0,0)'

  comment
    A template saved before a setting existed has no value for it, so sizes are coerced with
    'plus: 0' and treated as "keep the stylesheet default" at 0. The paddings cannot use that
    sentinel - 0 is a real padding - and are gated by their own checkbox instead.
  endcomment
  assign heading_size = section.settings.heading_size | plus: 0
  assign heading_size_mobile = section.settings.heading_size_mobile | plus: 0
  assign heading_tracking = section.settings.heading_tracking | plus: 0
  assign mode_size = section.settings.mode_size | plus: 0
  assign text_size = section.settings.text_size | plus: 0
  assign icon_size = section.settings.icon_size | plus: 0
  assign measure = section.settings.text_measure | plus: 0
  assign button_radius = section.settings.button_radius | plus: 0
  assign content_width = section.settings.content_width | plus: 0
  assign media_share = section.settings.media_share | plus: 0
  if media_share <= 0
    assign media_share = 50
  endif
  assign media_height = section.settings.media_height | plus: 0
  assign pad_inline = section.settings.padding_horizontal | plus: 0
  assign pad_block = section.settings.padding_vertical | plus: 0
  assign pad_top = section.settings.padding_top | plus: 0
  assign pad_bottom = section.settings.padding_bottom | plus: 0
  assign pad_top_mobile = section.settings.padding_top_mobile | plus: 0
  assign pad_bottom_mobile = section.settings.padding_bottom_mobile | plus: 0

  assign mode_blocks = section.blocks | where: 'type', 'mode'
-%}

{%- capture section_styles -%}
  {%- if section.settings.section_background != blank and section.settings.section_background != transparent -%}--ecb-section-bg: {{ section.settings.section_background }};{%- endif -%}
  {%- if section.settings.panel_background != blank and section.settings.panel_background != transparent -%}--ecb-panel-bg: {{ section.settings.panel_background }};{%- endif -%}
  {%- if section.settings.heading_color != blank and section.settings.heading_color != transparent -%}--ecb-heading-color: {{ section.settings.heading_color }};{%- endif -%}
  {%- if section.settings.text_color != blank and section.settings.text_color != transparent -%}--ecb-text-color: {{ section.settings.text_color }};{%- endif -%}
  {%- if section.settings.mode_color != blank and section.settings.mode_color != transparent -%}--ecb-mode-color: {{ section.settings.mode_color }};{%- endif -%}
  {%- if section.settings.icon_color != blank and section.settings.icon_color != transparent -%}--ecb-icon-color: {{ section.settings.icon_color }};{%- endif -%}
  {%- if section.settings.divider_color != blank and section.settings.divider_color != transparent -%}--ecb-divider-color: {{ section.settings.divider_color }};{%- endif -%}

  {%- comment -%}
    The buttons take their fill and their text from eden-actions.css, so a button colour is set
    by rebinding that file's two properties here: one pair covers the filled and the outlined
    style alike. The corner is the theme's own button radius, rebound on this section rather
    than a radius of this section's own.
  {%- endcomment -%}
  {%- if section.settings.button_background != blank and section.settings.button_background != transparent -%}--eden-action-ink: {{ section.settings.button_background }};{%- endif -%}
  {%- if section.settings.button_text_color != blank and section.settings.button_text_color != transparent -%}--eden-action-on-ink: {{ section.settings.button_text_color }};{%- endif -%}
  --style-border-radius-buttons-primary: {{ button_radius }}px;

  {%- if heading_size > 0 -%}--ecb-heading-size: {{ heading_size }}px;{%- endif -%}
  {%- if heading_size_mobile > 0 -%}--ecb-heading-size-mobile: {{ heading_size_mobile }}px;{%- endif -%}
  {%- if heading_tracking > 0 -%}--ecb-heading-tracking: {{ heading_tracking | divided_by: 100.0 }}em;{%- endif -%}
  {%- if section.settings.uppercase_heading -%}--ecb-heading-case: uppercase;{%- endif -%}
  {%- if mode_size > 0 -%}--ecb-mode-size: {{ mode_size }}px;{%- endif -%}
  {%- if text_size > 0 -%}--ecb-text-size: {{ text_size }}px;{%- endif -%}
  {%- if icon_size > 0 -%}--ecb-icon-size: {{ icon_size }}px;{%- endif -%}
  {%- if measure > 0 -%}--ecb-measure: {{ measure }}ch;{%- endif -%}

  --ecb-media-share: {{ media_share }}%;
  {%- if media_height > 0 -%}--ecb-media-height: {{ media_height }}px;{%- endif -%}
  --ecb-media-ratio: {{ section.settings.media_ratio | default: '4 / 3' }};

  {%- if section.settings.full_width -%}
    --ecb-shell-max: none;
  {%- elsif content_width > 0 -%}
    --ecb-shell-max: {{ content_width }}px;
  {%- endif -%}
  {%- if pad_inline > 0 -%}--ecb-pad-inline: {{ pad_inline }}px;{%- endif -%}
  {%- if pad_block > 0 -%}--ecb-pad-block: {{ pad_block }}px;{%- endif -%}
  {%- if section.settings.custom_padding -%}--ecb-pad-top: {{ pad_top }}px;--ecb-pad-bottom: {{ pad_bottom }}px;--ecb-pad-top-mobile: {{ pad_top_mobile }}px;--ecb-pad-bottom-mobile: {{ pad_bottom_mobile }}px;{%- endif -%}
{%- endcapture -%}

<section
  class="eden-consult eden-consult--media-{{ section.settings.media_side }}{% if section.settings.centre_text %} eden-consult--centred{% endif %}"
  style="{{ section_styles | strip_newlines | strip }}"
  {{ section.shopify_attributes }}
>
  <div class="ecb-shell">
    <div class="ecb-grid">
      <div class="ecb-media">
        {%- render 'homepage-journey-image',
          image: section.settings.media_image,
          asset: section.settings.media_asset,
          image_url: section.settings.media_image_url,
          alt: section.settings.media_alt,
          placeholder: 'lifestyle-2',
          sizes: '(min-width: 750px) 50vw, 100vw',
          width: 1600,
          height: 1200
        -%}
      </div>

      <div class="ecb-panel">
        {%- if mode_blocks.size > 0 -%}
          <ul class="ecb-modes">
            {%- for block in mode_blocks -%}
              {%- liquid
                assign has_icon_image = false
                if block.settings.icon_image != blank or block.settings.icon_asset != blank
                  assign has_icon_image = true
                endif
              -%}
              <li class="ecb-mode" {{ block.shopify_attributes }}>
                {%- if has_icon_image -%}
                  <span class="ecb-mode__icon">
                    {%- render 'homepage-journey-image',
                      image: block.settings.icon_image,
                      asset: block.settings.icon_asset,
                      alt: '',
                      sizes: '48px',
                      width: 48,
                      height: 48
                    -%}
                  </span>
                {%- elsif block.settings.icon != 'none' -%}
                  <span class="ecb-mode__icon" aria-hidden="true">
                    {%- render 'icon-consultation', icon: block.settings.icon -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.label != blank -%}
                  <span class="ecb-mode__label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="ecb-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="ecb-text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
          <div class="ecb-actions">
            {%- if section.settings.button_label != blank -%}
              <a class="eden-action eden-action--{{ section.settings.button_style }}" href="{{ section.settings.button_link | default: '/pages/contact' }}">
                {{- section.settings.button_label | escape -}}
                {%- if section.settings.show_button_arrow -%}
                  <span class="svg-wrapper">{%- render 'icon-arrow' -%}</span>
                {%- endif -%}
              </a>
            {%- endif -%}
            {%- if section.settings.link_label != blank -%}
              <a class="eden-link" href="{{ section.settings.link_url | default: '/pages/contact' }}">
                {{- section.settings.link_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Consultation banner",
  "tag": "section",
  "class": "section-consultation-banner",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet with our consultant" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Book a personalised consultation with one of our jewellery experts in our showroom, or in a one to one online session.</p>" },
    { "type": "paragraph", "content": "The row of ways to meet above the heading is built from the blocks at the bottom of this panel." },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Book appointment" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Left empty the button goes to \/pages\/contact." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Filled" },
        { "value": "outline", "label": "Outlined" }
      ],
      "default": "solid"
    },
    { "type": "range", "id": "button_radius", "label": "Button corner", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0, "info": "0 keeps the theme's square corner. Raise it for the pill in the reference." },
    { "type": "checkbox", "id": "show_button_arrow", "label": "Arrow after the button label", "default": false },
    { "type": "text", "id": "link_label", "label": "Second link label", "info": "A quieter underlined link beside the button. Leave empty for the button on its own." },
    { "type": "url", "id": "link_url", "label": "Second link" },

    { "type": "header", "content": "The room" },
    { "type": "paragraph", "content": "A picked image wins, then a file in assets\/, then a pasted URL." },
    { "type": "image_picker", "id": "media_image", "label": "Image" },
    { "type": "text", "id": "media_asset", "label": "File in assets\/" },
    { "type": "text", "id": "media_image_url", "label": "Image URL" },
    { "type": "text", "id": "media_alt", "label": "Alt text", "default": "Our consultation showroom" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "section_background", "label": "Band background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "panel_background", "label": "Copy panel background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "mode_color", "label": "Ways to meet", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "icon_color", "label": "Icons", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "divider_color", "label": "Divider between the ways to meet", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_background", "label": "Button fill", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "rgba(0,0,0,0)" },

    { "type": "header", "content": "Type" },
    { "type": "paragraph", "content": "A size of 0 keeps the stylesheet's own value." },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 0, "max": 90, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "heading_tracking", "label": "Heading letter spacing", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 0 },
    { "type": "checkbox", "id": "uppercase_heading", "label": "Heading in capitals", "default": false },
    { "type": "range", "id": "mode_size", "label": "Ways to meet size", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_size", "label": "Body text size", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_measure", "label": "Body text line length", "min": 0, "max": 80, "step": 2, "unit": "ch", "default": 0, "info": "0 keeps the default of 44 characters." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 0 },
    {
      "type": "select",
      "id": "media_side",
      "label": "Picture side",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "media_share", "label": "Width of the picture", "min": 30, "max": 70, "step": 5, "unit": "%", "default": 50, "info": "Its share of the band from 750px up." },
    { "type": "range", "id": "media_height", "label": "Least height of the picture", "min": 0, "max": 900, "step": 20, "unit": "px", "default": 0, "info": "0 keeps the default of 520px. Taller copy still grows the band." },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Picture shape on mobile",
      "options": [
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "4 / 3"
    },
    { "type": "checkbox", "id": "centre_text", "label": "Centre the copy", "default": false },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "range", "id": "content_width", "label": "Maximum content width", "min": 0, "max": 2400, "step": 40, "unit": "px", "default": 0, "info": "Ignored when the box above is ticked." },
    { "type": "range", "id": "padding_horizontal", "label": "Side padding of the copy panel", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the default of 60px." },
    { "type": "range", "id": "padding_vertical", "label": "Top and bottom padding of the copy panel", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the default of 60px." },
    { "type": "checkbox", "id": "custom_padding", "label": "Set the space above and below the band", "default": false },
    { "type": "range", "id": "padding_top", "label": "Space above the band", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Space below the band", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above the band on mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below the band on mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "mode",
      "name": "Way to meet",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "virtual", "label": "Virtual (screen)" },
            { "value": "in-person", "label": "In person (two people)" },
            { "value": "showroom", "label": "Showroom" },
            { "value": "phone", "label": "Telephone" },
            { "value": "calendar", "label": "Calendar" },
            { "value": "none", "label": "None" }
          ],
          "default": "virtual"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Icon image", "info": "Replaces the drawn icon above." },
        { "type": "text", "id": "icon_asset", "label": "Icon file in assets/" },
        { "type": "text", "id": "label", "label": "Label", "default": "Virtual" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Consultation banner",
      "blocks": [
        { "type": "mode", "settings": { "icon": "virtual", "label": "Virtual" } },
        { "type": "mode", "settings": { "icon": "in-person", "label": "In person" } }
      ]
    }
  ]
}
{% endschema %}
