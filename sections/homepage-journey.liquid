{{ 'homepage-journey.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign layout = section.settings.layout_style
  assign transparent = 'rgba(0,0,0,0)'

  # A template saved before these settings existed has no value for them, so the
  # numbers are coerced with 'plus: 0' rather than compared raw: a missing size
  # becomes 0, which means "keep the theme default". The paddings cannot use a
  # sentinel of their own -- a range's span has to divide evenly by its step, so
  # 0 is a real value there -- and are gated by the custom_padding checkbox.
  assign eyebrow_size = section.settings.eyebrow_size | plus: 0
  assign heading_size = section.settings.heading_size | plus: 0
  assign heading_size_mobile = section.settings.heading_size_mobile | plus: 0
  assign text_size = section.settings.text_size | plus: 0
  assign products_heading_size = section.settings.products_heading_size | plus: 0
  assign products_subheading_size = section.settings.products_subheading_size | plus: 0
  assign button_size = section.settings.button_size | plus: 0
  assign pad_top = section.settings.padding_top | plus: 0
  assign pad_bottom = section.settings.padding_bottom | plus: 0
  assign pad_inline = section.settings.padding_horizontal | plus: 0
  assign content_width = section.settings.content_width | plus: 0
-%}

{%- comment -%}
  Everything a merchant can restyle is written onto the section element as a CSS
  custom property, and homepage-journey.css reads each one with the old hard
  coded value as its fallback. A setting left at its "use the layout default"
  value (a cleared colour, or a size of 0) writes nothing, so the section keeps
  looking exactly as it did before anyone opened the panel.

  The dark panel layout still takes its two colours from the theme editor; the
  stylesheet derives the muted text, the divider, the photo placeholder and the
  CTA from them.
{%- endcomment -%}
{%- capture section_styles -%}
  {%- if layout == 'purpose' -%}
    --hj-purpose-bg: {{ section.settings.purpose_background | default: '#17211e' }};
    --hj-purpose-ink: {{ section.settings.purpose_text | default: '#ffffff' }};
  {%- endif -%}

  {%- if section.settings.section_background != blank and section.settings.section_background != transparent -%}
    --hj-section-bg: {{ section.settings.section_background }};
  {%- endif -%}
  {%- if section.settings.eyebrow_color != blank and section.settings.eyebrow_color != transparent -%}
    --hj-eyebrow-color: {{ section.settings.eyebrow_color }};
  {%- endif -%}
  {%- if section.settings.heading_color != blank and section.settings.heading_color != transparent -%}
    --hj-heading-color: {{ section.settings.heading_color }};
  {%- endif -%}
  {%- if section.settings.text_color != blank and section.settings.text_color != transparent -%}
    --hj-text-color: {{ section.settings.text_color }};
  {%- endif -%}
  {%- if section.settings.note_background != blank and section.settings.note_background != transparent -%}
    --hj-note-bg: {{ section.settings.note_background }};
  {%- endif -%}
  {%- if section.settings.note_color != blank and section.settings.note_color != transparent -%}
    --hj-note-ink: {{ section.settings.note_color }};
  {%- endif -%}

  {%- if eyebrow_size > 0 -%}--hj-eyebrow-size: {{ eyebrow_size }}px;{%- endif -%}
  {%- if heading_size > 0 -%}--hj-heading-size: {{ heading_size }}px;{%- endif -%}
  {%- if heading_size_mobile > 0 -%}--hj-heading-size-mobile: {{ heading_size_mobile }}px;{%- endif -%}
  {%- if text_size > 0 -%}--hj-text-size: {{ text_size }}px;{%- endif -%}
  {%- if products_heading_size > 0 -%}--hj-products-heading-size: {{ products_heading_size }}px;{%- endif -%}
  {%- if products_subheading_size > 0 -%}--hj-products-subheading-size: {{ products_subheading_size }}px;{%- endif -%}

  {%- if section.settings.button_background != blank and section.settings.button_background != transparent -%}
    --hj-btn-bg: {{ section.settings.button_background }};
    --hj-btn-border: {{ section.settings.button_background }};
  {%- endif -%}
  {%- if section.settings.button_border != blank and section.settings.button_border != transparent -%}
    --hj-btn-border: {{ section.settings.button_border }};
  {%- endif -%}
  {%- if section.settings.button_text_color != blank and section.settings.button_text_color != transparent -%}
    --hj-btn-ink: {{ section.settings.button_text_color }};
  {%- endif -%}
  {%- if section.settings.button_hover_background != blank and section.settings.button_hover_background != transparent -%}
    --hj-btn-hover-bg: {{ section.settings.button_hover_background }};
    --hj-btn-hover-border: {{ section.settings.button_hover_background }};
  {%- endif -%}
  {%- if section.settings.button_hover_text_color != blank and section.settings.button_hover_text_color != transparent -%}
    --hj-btn-hover-ink: {{ section.settings.button_hover_text_color }};
  {%- endif -%}
  {%- if button_size > 0 -%}--hj-btn-size: {{ button_size }}px;{%- endif -%}

  {%- if section.settings.custom_padding -%}
    --hj-pad-top: {{ pad_top }}px;
    --hj-pad-bottom: {{ pad_bottom }}px;
  {%- endif -%}

  {%- comment -%}
    Full width wins over the number: a merchant who ticked the box meant "edge to
    edge", and a width left over from before the tick should not quietly cap it.
  {%- endcomment -%}
  {%- if section.settings.full_width -%}
    --hj-shell-max: none;
  {%- elsif content_width > 0 -%}
    --hj-shell-max: {{ content_width }}px;
  {%- endif -%}
  {%- if pad_inline > 0 -%}--hj-pad-inline: {{ pad_inline }}px;{%- endif -%}
{%- endcapture -%}
{%- assign section_styles = section_styles | strip | strip_newlines -%}

<section class="homepage-journey homepage-journey--{{ layout }}" id="HomepageJourney-{{ section.id }}"{% if section_styles != blank %} style="{{ section_styles }}"{% endif %}>
  {% if layout == 'discover' %}
    <div class="hj-shell">
      <div class="hj-discover">
        <div class="hj-discover__media">
          {% render 'homepage-journey-image',
            image: section.settings.image,
            asset: section.settings.image_asset,
            image_url: section.settings.image_url,
            alt: section.settings.image_alt,
            placeholder: 'product-1',
            width: 1600,
            height: 1200
          %}
          {% if section.settings.image_note != blank %}
            <span class="hj-image-note">{{ section.settings.image_note | escape }}</span>
          {% endif %}
        </div>
        <div class="hj-discover__copy">
          <p class="hj-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h2>{{ section.settings.heading | escape }}</h2>
          <div class="hj-description">{{ section.settings.description }}</div>
          {% if section.settings.primary_label != blank %}
            <a class="eden-action eden-action--solid hj-cta" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a>
          {% endif %}
          <p class="hj-signature-note">{{ section.settings.supporting_note | escape }}</p>
        </div>
      </div>
      {% if section.settings.collection != blank %}
        <div class="hj-products">
          <div class="hj-products__heading">
            <h3>{{ section.settings.products_heading | escape }}</h3>
            {% if section.settings.products_subheading != blank %}
              <div class="hj-products__subheading">{{ section.settings.products_subheading }}</div>
            {% endif %}
          </div>
          <swiper-component
            class="hj-products__carousel"
            data-space-between="20"
            data-pagination-type="progressbar"
            data-slides-per-view="1.15"
            data-watch-slides-progress="true"
            data-breakpoints='{"681":{"slidesPerView":2},"900":{"slidesPerView":3},"1200":{"slidesPerView":4}}'
          >
            <div class="swiper">
              <ul class="hj-products__grid swiper-wrapper list-unstyled" role="list">
            {% for product in section.settings.collection.products limit: 8 %}
                {%- liquid
                  # Every product's featured image is the yellow gold shot, so the row reads as
                  # one metal. Rotate the metal across the cards instead: card 1 keeps yellow,
                  # card 2 shows white, card 3 rose, and so on. The rotation is positional, not
                  # random, so the row is stable between page loads and for every visitor.
                  assign card_image = product.featured_image

                  if section.settings.vary_metals
                    assign metal_rotation = section.settings.metal_rotation | split: ','
                    assign rotation_index = forloop.index0 | modulo: metal_rotation.size
                    assign wanted_metal = metal_rotation[rotation_index] | strip | downcase

                    for variant in product.variants
                      if variant.featured_image == blank
                        continue
                      endif
                      assign variant_text = variant.title | downcase
                      assign is_match = false
                      if wanted_metal == 'rose'
                        if variant_text contains 'rose' or variant_text contains 'pink'
                          assign is_match = true
                        endif
                      elsif variant_text contains wanted_metal
                        assign is_match = true
                      endif
                      if is_match
                        # Keep the product's own photo when no variant carries that metal.
                        assign card_image = variant.featured_image
                        break
                      endif
                    endfor
                  endif

                  # Hover photo: the next view of the SAME metal the card opens on.
                  # Every render carries Shopify's media-grouping alt text -- one group per
                  # metal, "#Jewelry material_Rose gold" and friends -- and the importer
                  # uploads the views of a colour in sequence, so the next image inside the
                  # card image's own group is the next angle of that same ring.
                  # assets/product-metal-media.js reads these same tags on the product page;
                  # the '#' test mirrors its own, so a product that does not follow the
                  # convention is left alone rather than guessed at.
                  assign card_group = card_image.alt | strip | downcase
                  assign card_group_marker = card_group | slice: 0

                  assign hover_image = null
                  if card_group != blank and card_group_marker == '#'
                    assign seen_card_image = false
                    assign earlier_in_group = null
                    for image in product.images
                      assign image_group = image.alt | strip | downcase
                      unless image_group == card_group
                        continue
                      endunless
                      if image.id == card_image.id
                        assign seen_card_image = true
                        continue
                      endif
                      if seen_card_image
                        assign hover_image = image
                        break
                      endif
                      # The card opens on the last view of its metal: wrap back to the
                      # first rather than leave the metal.
                      unless earlier_in_group
                        assign earlier_in_group = image
                      endunless
                    endfor
                    unless hover_image
                      assign hover_image = earlier_in_group
                    endunless
                  endif
                -%}
                <li class="hj-product swiper-slide">
                  <a href="{{ product.url }}">
                    <div class="hj-product__media">
                      {% if card_image %}
                        {% comment %}
                          The alt on these renders is the metal grouping tag, not a
                          description, so it must not reach a screen reader. The product
                          title is the useful thing to announce.
                        {% endcomment %}
                        {% assign product_image_alt = card_image.alt | default: product.title %}
                        {% if card_group_marker == '#' %}{% assign product_image_alt = product.title %}{% endif %}
                        {% assign product_image_alt = product_image_alt | escape %}
                        {{ card_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', alt: product_image_alt }}
                        {% if hover_image %}
                          {% assign hover_image_alt = product.title | escape %}
                          {{ hover_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', alt: hover_image_alt, class: 'hj-product__media-hover' }}
                        {% endif %}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'hj-placeholder' }}
                      {% endif %}
                    </div>
                    <span class="hj-product__title">{{ product.title | escape }}</span>
                    <span class="hj-product__price">{% if product.price_varies %}{{ 'products.facets.from' | t }} {% endif %}{{ product.price_min | money }}</span>
                  </a>
                </li>
            {% endfor %}
              </ul>
              <div class="swiper-pagination"></div>
              <div class="hj-products__controls swiper-btns-wrap swiper-btns-wrap--inside small-hide">
                {% render 'swiper-button' %}
              </div>
            </div>
          </swiper-component>
        </div>
      {% endif %}
    </div>
  {% elsif layout == 'purpose' %}
    <div class="hj-purpose">
      <div class="hj-purpose__image">
        {% render 'homepage-journey-image',
          image: section.settings.image,
          asset: section.settings.image_asset,
          image_url: section.settings.image_url,
          alt: section.settings.image_alt,
          placeholder: 'lifestyle-1',
          width: 1600,
          height: 1200
        %}
      </div>
      <div class="hj-purpose__content">
        <p class="hj-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="hj-description">{{ section.settings.description }}</div>
        {% if section.settings.primary_label != blank %}
          <a class="eden-action eden-action--light hj-cta" href="{{ section.settings.primary_link | default: routes.root_url }}">{{ section.settings.primary_label | escape }}</a>
        {% endif %}
        <div class="hj-proof-points">
          {% assign proof_items = section.settings.proof_points | split: '|' %}
          {% for proof in proof_items %}
            {% assign proof_label = proof | strip %}
            {% if proof_label != blank %}<span>{{ proof_label | escape }}</span>{% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="hj-shell hj-experience-shell">
      <div class="hj-section-intro">
        <p class="hj-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="hj-description">{{ section.settings.description }}</div>
      </div>
      <div class="hj-experience-grid">
        <article class="hj-experience-card">
          <div class="hj-experience-card__image">
            {% render 'homepage-journey-image',
              image: section.settings.image,
              asset: section.settings.image_asset,
              image_url: section.settings.image_url,
              alt: section.settings.image_alt,
              placeholder: 'lifestyle-1',
              sizes: '(min-width: 990px) 25vw, 100vw',
              width: 1200,
              height: 800
            %}
          </div>
          <div class="hj-experience-card__copy">
            <p class="hj-eyebrow">{{ section.settings.card_one_eyebrow | escape }}</p>
            <h3>{{ section.settings.card_one_heading | escape }}</h3>
            <p>{{ section.settings.card_one_text | escape }}</p>
            <a class="eden-link" href="{{ section.settings.card_one_link | default: routes.account_register_url }}">{{ section.settings.card_one_label | escape }}</a>
          </div>
        </article>
        <article class="hj-experience-card">
          <div class="hj-experience-card__image">
            {% render 'homepage-journey-image',
              image: section.settings.second_image,
              asset: section.settings.second_image_asset,
              image_url: section.settings.second_image_url,
              alt: section.settings.second_image_alt,
              placeholder: 'lifestyle-2',
              sizes: '(min-width: 990px) 25vw, 100vw',
              width: 1200,
              height: 800
            %}
          </div>
          <div class="hj-experience-card__copy">
            <p class="hj-eyebrow">{{ section.settings.card_two_eyebrow | escape }}</p>
            <h3>{{ section.settings.card_two_heading | escape }}</h3>
            <p>{{ section.settings.card_two_text | escape }}</p>
            <a class="eden-link" href="{{ section.settings.card_two_link | default: routes.root_url }}">{{ section.settings.card_two_label | escape }}</a>
          </div>
        </article>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Homepage journey",
  "tag": "section",
  "class": "section-homepage-journey",
  "settings": [
    { "type": "select", "id": "layout_style", "label": "Layout", "options": [ { "value": "discover", "label": "Discover and shop" }, { "value": "purpose", "label": "The Eden difference" }, { "value": "experience", "label": "Rewards and boutique" } ], "default": "discover" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE EDEN EDIT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Iconic style, conscious luxury" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover beautifully crafted lab-grown diamond jewellery, made to be worn and loved.</p>" },
    { "type": "text", "id": "supporting_note", "label": "Supporting note", "default": "Exceptional detail. Considered value. Made to last." },
    { "type": "text", "id": "proof_points", "label": "Proof points (separate with |)", "info": "'The Eden difference' layout only.", "default": "Lab-grown diamonds | Thoughtful materials | Designed in London" },

    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image", "label": "Primary image", "info": "Used by all three layouts. In 'Rewards and boutique' this is the first card's photo. Overrides the URL below." },
    { "type": "text", "id": "image_asset", "label": "Primary image file name (fallback)", "info": "A file already in the theme's assets folder, e.g. featured-diamonds-education.jpg. Only used when no image is picked above." },
    { "type": "text", "id": "image_url", "label": "Primary image URL (fallback)", "info": "Only used when neither of the two above is set." },
    { "type": "text", "id": "image_alt", "label": "Primary image alt text", "default": "Lab-grown diamond jewellery" },
    { "type": "text", "id": "image_note", "label": "Image note", "info": "Caption chip over the photo. Leave empty to hide it.", "default": "THE SIGNATURE VALUE EDIT" },
    { "type": "image_picker", "id": "second_image", "label": "Second image", "info": "'Rewards and boutique' layout only - the second card's photo. Overrides the URL below." },
    { "type": "text", "id": "second_image_asset", "label": "Second image file name (fallback)", "info": "A file already in the theme's assets folder. Only used when no second image is picked above." },
    { "type": "text", "id": "second_image_url", "label": "Second image URL (fallback)", "info": "Only used when neither of the two above is set." },
    { "type": "text", "id": "second_image_alt", "label": "Second image alt text", "default": "A close-up of a three stone lab-grown diamond ring" },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "primary_label", "label": "Button label", "info": "Leave empty to hide the button.", "default": "Discover the look" },
    { "type": "url", "id": "primary_link", "label": "Button link" },
    { "type": "color", "id": "button_background", "label": "Button background", "default": "rgba(0,0,0,0)", "info": "Clear a colour to use the theme default." },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_border", "label": "Button border", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_hover_background", "label": "Button background on hover", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_hover_text_color", "label": "Button text on hover", "default": "rgba(0,0,0,0)" },
    { "type": "range", "id": "button_size", "label": "Button text size", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 0, "info": "0 keeps the theme default." },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "rgba(0,0,0,0)", "info": "Clear a colour to use the layout default." },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "note_background", "label": "Image note background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "note_color", "label": "Image note text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "purpose_background", "label": "Dark panel background", "info": "'The Eden difference' layout only.", "default": "#17211e" },
    { "type": "color", "id": "purpose_text", "label": "Dark panel text", "default": "#ffffff" },

    { "type": "header", "content": "Typography", "info": "Set a size to 0 to keep the theme's responsive default." },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 0, "max": 90, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_size", "label": "Body text size", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "products_heading_size", "label": "Product row heading size", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 0 },

    { "type": "header", "content": "Product row", "info": "'Discover and shop' layout only." },
    { "type": "collection", "id": "collection", "label": "Featured products collection" },
    { "type": "text", "id": "products_heading", "label": "Products heading", "default": "The pieces to know" },
    { "type": "richtext", "id": "products_subheading", "label": "Text under the products heading", "info": "Leave empty to hide it." },
    { "type": "range", "id": "products_subheading_size", "label": "Text under the products heading - size", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 0, "info": "0 keeps the stylesheet default." },
    { "type": "checkbox", "id": "vary_metals", "label": "Vary metal colour across the cards", "info": "Shows a different metal on each card instead of every product's default photo.", "default": true },
    { "type": "text", "id": "metal_rotation", "label": "Metal rotation order", "info": "Comma separated, repeated across the row. Use yellow, white, rose, platinum or silver.", "default": "yellow, white, rose" },

    { "type": "header", "content": "Cards", "info": "'Rewards and boutique' layout only." },
    { "type": "text", "id": "card_one_eyebrow", "label": "First card eyebrow", "default": "REWARDS" },
    { "type": "text", "id": "card_one_heading", "label": "First card heading", "default": "A little more, every time" },
    { "type": "text", "id": "card_one_text", "label": "First card text", "default": "Join our rewards programme and collect points toward timeless jewellery." },
    { "type": "text", "id": "card_one_label", "label": "First card link label", "default": "Explore rewards" },
    { "type": "url", "id": "card_one_link", "label": "First card link" },
    { "type": "text", "id": "card_two_eyebrow", "label": "Second card eyebrow", "default": "GUIDANCE" },
    { "type": "text", "id": "card_two_heading", "label": "Second card heading", "default": "Choose with confidence" },
    { "type": "text", "id": "card_two_text", "label": "Second card text", "default": "Short, practical guides to the 4 C's, settings and sizing, so you know exactly what you are buying." },
    { "type": "text", "id": "card_two_label", "label": "Second card link label", "default": "Explore the guides" },
    { "type": "url", "id": "card_two_link", "label": "Second card link" },

    { "type": "header", "content": "Content width" },
    { "type": "checkbox", "id": "full_width", "label": "Stretch content to the screen edge", "info": "Use this to line the section up with a full-width carousel above or below it.", "default": false },
    { "type": "range", "id": "content_width", "label": "Maximum content width", "min": 0, "max": 2400, "step": 40, "unit": "px", "default": 0, "info": "0 keeps the default 1560px. Ignored when the box above is ticked." },
    { "type": "range", "id": "padding_horizontal", "label": "Side padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the theme's responsive padding (20-64px)." },

    { "type": "header", "content": "Section padding" },
    { "type": "checkbox", "id": "custom_padding", "label": "Use custom section padding", "info": "Off keeps the theme's responsive padding.", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 2, "unit": "px", "default": 60 },
