{{ 'homepage-journey.css' | asset_url | stylesheet_tag }}

{% assign layout = section.settings.layout_style %}

{%- comment -%}
  The dark panel layout takes its colour from the theme editor. Only the two
  values go on the element; homepage-journey.css derives the muted text, the
  divider, the photo placeholder and the CTA from them.
{%- endcomment -%}
{%- capture purpose_colours -%}
  {%- if layout == 'purpose' -%}
    --hj-purpose-bg: {{ section.settings.purpose_background | default: '#17211e' }};
    --hj-purpose-ink: {{ section.settings.purpose_text | default: '#ffffff' }};
  {%- endif -%}
{%- endcapture -%}
{%- assign purpose_colours = purpose_colours | strip | strip_newlines -%}

<section class="homepage-journey homepage-journey--{{ layout }}" id="HomepageJourney-{{ section.id }}"{% if purpose_colours != blank %} style="{{ purpose_colours }}"{% endif %}>
  {% if layout == 'discover' %}
    <div class="hj-shell">
      <div class="hj-discover">
        <div class="hj-discover__media">
          {% if section.settings.image_url != blank %}
            <img src="{{ section.settings.image_url | escape }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1600" height="1200">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'hj-placeholder' }}
          {% endif %}
          <span class="hj-image-note">{{ section.settings.image_note | escape }}</span>
        </div>
        <div class="hj-discover__copy">
          <p class="hj-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h2>{{ section.settings.heading | escape }}</h2>
          <div class="hj-description">{{ section.settings.description }}</div>
          {% if section.settings.primary_label != blank %}
            <a class="eden-action eden-action--solid hj-cta" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a>
          {% endif %}
          <p class="hj-signature-note">{{ section.settings.supporting_note | escape }}</p>
        </div>
      </div>
      {% if section.settings.collection != blank %}
        <div class="hj-products">
          <div class="hj-products__heading">
            <h3>{{ section.settings.products_heading | escape }}</h3>
          </div>
          <swiper-component
            class="hj-products__carousel"
            data-space-between="20"
            data-pagination-type="progressbar"
            data-slides-per-view="1.15"
            data-watch-slides-progress="true"
            data-breakpoints='{"681":{"slidesPerView":2},"900":{"slidesPerView":3},"1200":{"slidesPerView":4}}'
          >
            <div class="swiper">
              <ul class="hj-products__grid swiper-wrapper list-unstyled" role="list">
            {% for product in section.settings.collection.products limit: 8 %}
                {%- liquid
                  # Every product's featured image is the yellow gold shot, so the row reads as
                  # one metal. Rotate the metal across the cards instead: card 1 keeps yellow,
                  # card 2 shows white, card 3 rose, and so on. The rotation is positional, not
                  # random, so the row is stable between page loads and for every visitor.
                  assign card_image = product.featured_image

                  if section.settings.vary_metals
                    assign metal_rotation = section.settings.metal_rotation | split: ','
                    assign rotation_index = forloop.index0 | modulo: metal_rotation.size
                    assign wanted_metal = metal_rotation[rotation_index] | strip | downcase

                    for variant in product.variants
                      if variant.featured_image == blank
                        continue
                      endif
                      assign variant_text = variant.title | downcase
                      assign is_match = false
                      if wanted_metal == 'rose'
                        if variant_text contains 'rose' or variant_text contains 'pink'
                          assign is_match = true
                        endif
                      elsif variant_text contains wanted_metal
                        assign is_match = true
                      endif
                      if is_match
                        # Keep the product's own photo when no variant carries that metal.
                        assign card_image = variant.featured_image
                        break
                      endif
                    endfor
                  endif
                -%}
                <li class="hj-product swiper-slide">
                  <a href="{{ product.url }}">
                    <div class="hj-product__media">
                      {% if card_image %}
                        {% assign product_image_alt = card_image.alt | default: product.title | escape %}
                        {{ card_image | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320, 480, 640', alt: product_image_alt }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'hj-placeholder' }}
                      {% endif %}
                    </div>
                    <span class="hj-product__title">{{ product.title | escape }}</span>
                    <span class="hj-product__price">{% if product.price_varies %}{{ 'products.facets.from' | t }} {% endif %}{{ product.price_min | money }}</span>
                  </a>
                </li>
            {% endfor %}
              </ul>
              <div class="swiper-pagination"></div>
              <div class="hj-products__controls swiper-btns-wrap swiper-btns-wrap--inside small-hide">
                {% render 'swiper-button' %}
              </div>
            </div>
          </swiper-component>
        </div>
      {% endif %}
    </div>
  {% elsif layout == 'purpose' %}
    <div class="hj-purpose">
      <div class="hj-purpose__image">
        {% if section.settings.image_url != blank %}
          <img src="{{ section.settings.image_url | escape }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1600" height="1200">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'hj-placeholder' }}
        {% endif %}
      </div>
      <div class="hj-purpose__content">
        <p class="hj-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="hj-description">{{ section.settings.description }}</div>
        {% if section.settings.primary_label != blank %}
          <a class="eden-action eden-action--light hj-cta" href="{{ section.settings.primary_link | default: routes.root_url }}">{{ section.settings.primary_label | escape }}</a>
        {% endif %}
        <div class="hj-proof-points">
          {% assign proof_items = section.settings.proof_points | split: '|' %}
          {% for proof in proof_items %}
            {% assign proof_label = proof | strip %}
            {% if proof_label != blank %}<span>{{ proof_label | escape }}</span>{% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="hj-shell hj-experience-shell">
      <div class="hj-section-intro">
        <p class="hj-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
        <div class="hj-description">{{ section.settings.description }}</div>
      </div>
      <div class="hj-experience-grid">
        <article class="hj-experience-card">
          <div class="hj-experience-card__image">
            {% if section.settings.image_url != blank %}
              <img src="{{ section.settings.image_url | escape }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1200" height="800">
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'hj-placeholder' }}
            {% endif %}
          </div>
          <div class="hj-experience-card__copy">
            <p class="hj-eyebrow">{{ section.settings.card_one_eyebrow | escape }}</p>
            <h3>{{ section.settings.card_one_heading | escape }}</h3>
            <p>{{ section.settings.card_one_text | escape }}</p>
            <a class="eden-link" href="{{ section.settings.card_one_link | default: routes.account_register_url }}">{{ section.settings.card_one_label | escape }}</a>
          </div>
        </article>
        <article class="hj-experience-card">
          <div class="hj-experience-card__image">
            {% if section.settings.second_image_url != blank %}
              <img src="{{ section.settings.second_image_url | escape }}" alt="{{ section.settings.second_image_alt | escape }}" loading="lazy" width="1200" height="800">
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'hj-placeholder' }}
            {% endif %}
          </div>
          <div class="hj-experience-card__copy">
            <p class="hj-eyebrow">{{ section.settings.card_two_eyebrow | escape }}</p>
            <h3>{{ section.settings.card_two_heading | escape }}</h3>
            <p>{{ section.settings.card_two_text | escape }}</p>
            <a class="eden-link" href="{{ section.settings.card_two_link | default: routes.root_url }}">{{ section.settings.card_two_label | escape }}</a>
          </div>
        </article>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Homepage journey",
  "tag": "section",
  "class": "section-homepage-journey",
  "settings": [
    { "type": "select", "id": "layout_style", "label": "Layout", "options": [ { "value": "discover", "label": "Discover and shop" }, { "value": "purpose", "label": "The Eden difference" }, { "value": "experience", "label": "Rewards and boutique" } ], "default": "discover" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE EDEN EDIT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Iconic style, conscious luxury" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover beautifully crafted lab-grown diamond jewellery, made to be worn and loved.</p>" },
    { "type": "text", "id": "image_url", "label": "Primary image URL" },
    { "type": "text", "id": "image_alt", "label": "Primary image alt text", "default": "Lab-grown diamond jewellery" },
    { "type": "text", "id": "image_note", "label": "Image note", "default": "THE SIGNATURE VALUE EDIT" },
    { "type": "header", "content": "Panel colour", "info": "Applies to the 'The Eden difference' layout only." },
    { "type": "color", "id": "purpose_background", "label": "Panel background", "default": "#17211e" },
    { "type": "color", "id": "purpose_text", "label": "Panel text", "default": "#ffffff" },
    { "type": "text", "id": "primary_label", "label": "Primary link label", "default": "Discover the look" },
    { "type": "url", "id": "primary_link", "label": "Primary link" },
    { "type": "text", "id": "supporting_note", "label": "Supporting note", "default": "Exceptional detail. Considered value. Made to last." },
    { "type": "collection", "id": "collection", "label": "Featured products collection" },
    { "type": "text", "id": "products_heading", "label": "Products heading", "default": "The pieces to know" },
    { "type": "checkbox", "id": "vary_metals", "label": "Vary metal colour across the cards", "info": "Shows a different metal on each card instead of every product's default photo.", "default": true },
    { "type": "text", "id": "metal_rotation", "label": "Metal rotation order", "info": "Comma separated, repeated across the row. Use yellow, white, rose, platinum or silver.", "default": "yellow, white, rose" },
    { "type": "text", "id": "proof_points", "label": "Proof points (separate with |)", "default": "Lab-grown diamonds | Thoughtful materials | Designed in London" },
    { "type": "text", "id": "second_image_url", "label": "Second image URL" },
    { "type": "text", "id": "second_image_alt", "label": "Second image alt text", "default": "Visit our jewellery boutique" },
    { "type": "text", "id": "card_one_eyebrow", "label": "First card eyebrow", "default": "REWARDS" },
    { "type": "text", "id": "card_one_heading", "label": "First card heading", "default": "A little more, every time" },
    { "type": "text", "id": "card_one_text", "label": "First card text", "default": "Join our rewards programme and collect points toward timeless jewellery." },
    { "type": "text", "id": "card_one_label", "label": "First card link label", "default": "Explore rewards" },
    { "type": "url", "id": "card_one_link", "label": "First card link" },
    { "type": "text", "id": "card_two_eyebrow", "label": "Second card eyebrow", "default": "IN PERSON" },
    { "type": "text", "id": "card_two_heading", "label": "Second card heading", "default": "Step into our world" },
    { "type": "text", "id": "card_two_text", "label": "Second card text", "default": "Discover considered design and personal service in our boutique." },
    { "type": "text", "id": "card_two_label", "label": "Second card link label", "default": "Plan your visit" },
    { "type": "url", "id": "card_two_link", "label": "Second card link" }
  ],
  "presets": [ { "name": "Homepage journey" } ]
}
{% endschema %}
