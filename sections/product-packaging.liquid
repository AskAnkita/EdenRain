<section class="product-packaging page-width">
  <div class="product-packaging__grid{% if section.settings.image_position == 'right' %} product-packaging__grid--image-right{% endif %}">
    <div class="product-packaging__media">
      {% if section.settings.image != blank %}
        {% assign packaging_alt = section.settings.image.alt | default: section.settings.heading %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'product-packaging__image', loading: 'lazy', alt: packaging_alt }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'product-packaging__placeholder' }}
      {% endif %}
    </div>
    <div class="product-packaging__copy">
      {% if section.settings.heading != blank %}
        <h2 class="product-packaging__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="product-packaging__text">{{ section.settings.text }}</div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .product-packaging { padding-block: clamp(32px, 4.2vw, 72px); }
  #shopify-section-{{ section.id }} .product-packaging__grid {
    align-items: center;
    display: grid;
    gap: clamp(32px, 4vw, 72px);
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
  }
  #shopify-section-{{ section.id }} .product-packaging__grid--image-right .product-packaging__media { grid-column: 2; grid-row: 1; }
  #shopify-section-{{ section.id }} .product-packaging__grid--image-right .product-packaging__copy { grid-column: 1; grid-row: 1; }
  #shopify-section-{{ section.id }} .product-packaging__image,
  #shopify-section-{{ section.id }} .product-packaging__placeholder { display: block; height: auto; width: 100%; }
  #shopify-section-{{ section.id }} .product-packaging__placeholder { background: #f4f1ef; }
  #shopify-section-{{ section.id }} .product-packaging__heading {
    color: inherit;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(2.4rem, 2.3vw, 3.4rem);
    font-weight: 400;
    letter-spacing: .055em;
    line-height: 1.25;
    margin: 0 0 24px;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .product-packaging__text { font-size: clamp(1.6rem, 1.35vw, 2rem); line-height: 1.55; }
  #shopify-section-{{ section.id }} .product-packaging__text p { margin: 0 0 1em; }
  #shopify-section-{{ section.id }} .product-packaging__text p:last-child { margin-bottom: 0; }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .product-packaging { padding-block: 32px; }
    #shopify-section-{{ section.id }} .product-packaging__grid { gap: 24px; grid-template-columns: minmax(0, 1fr); }
    #shopify-section-{{ section.id }} .product-packaging__grid--image-right .product-packaging__media,
    #shopify-section-{{ section.id }} .product-packaging__grid--image-right .product-packaging__copy { grid-column: 1; }
    #shopify-section-{{ section.id }} .product-packaging__grid--image-right .product-packaging__media { grid-row: 1; }
    #shopify-section-{{ section.id }} .product-packaging__grid--image-right .product-packaging__copy { grid-row: 2; }
    #shopify-section-{{ section.id }} .product-packaging__heading { margin-bottom: 14px; }
  }
</style>

{% schema %}
{
  "name": "Product packaging",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Packaging image" },
    { "type": "select", "id": "image_position", "label": "Image position", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Beautifully packaged" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We want you to be delighted with your jewellery purchase. Enjoy the big reveal as you unwrap the layers of our stylish packaging. Each item is presented in a luxurious velvet case which in turn is protected by an outer case. Our online shopping experience is wrapped and delivered with love.</p>" }
  ],
  "presets": [{ "name": "Product packaging" }]
}
{% endschema %}
