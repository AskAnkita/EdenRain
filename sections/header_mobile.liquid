{% if settings.enable_multi_tab_layout_mobile %}

  <link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
  {{ 'menu-drawer-mobile.css' | asset_url | stylesheet_tag }}

  {%- liquid
    if localization.available_countries.size > 1 and section.settings.show_country or section.settings.show_language and localization.available_languages.size > 1
      assign localization_forms = true
    endif

    assign section_fetch = false
    if section.index == nil
      assign section_fetch = true
    endif
  -%}

  <side-drawer
    class="drawer__container drawer drawer--menu drawer--menu-multi-tab fixed top-0 left-0 w-screen h-full z-9 flex no-js-hidden"
    id="Drawer-Menu"
    data-drawer-direction="left"
  >
    <div id="Drawer-Overlay-Menu" class="drawer__overlay fixed inset-0 cursor-pointer"></div>
    <div class="side-drawer" data-drawer-content data-breakpoint="tablet">
      <div
        class="drawer__inner d-flex flex-column h-full"
        role="dialog"
        aria-modal="true"
        aria-label="{{ 'accessibility.menu' | t }}"
        tabindex="-1"
      >
        <div class="drawer__header mnav__header flex justify-between items-center relative">
          <a class="mnav__logo" href="{{ routes.root_url }}">
            {%- if settings.logo != blank -%}
              {{ settings.logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy' }}
            {%- else -%}
              <img src="{{ 'eden-raine-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1188" height="158" loading="lazy">
            {%- endif -%}
          </a>
          <button
            class="drawer__close mnav__close block t-button bor-none cursor-pointer"
            type="button"
            onclick="this.closest('side-drawer').close()"
            aria-label="{{ 'accessibility.close_dialog' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
        <div class="drawer__wrapper menu-drawer relative h-full motion-reduce color-{{ section.settings.menu_color_scheme }}">
          <div class="header-mobile mobile--multi-tab">
            <section-fetcher
              data-section-id="{{ section.id }}"
              data-target-id="SiteNavMobile-Content-{{ section.id }}"
              data-activate="interaction"
            ></section-fetcher>
            {%- unless section_fetch -%}
              <div class="section-resource-list" id="SiteNavMobile-Content-{{ section.id }}">
              </div>
            {%- else -%}
              <div class="section-resource-list" id="SiteNavMobile-Content-{{ section.id }}">
                {%- comment -%}
                  Same items as the desktop nav (main-menu). Items with sub-links open to
                  show them; a collection link without sub-links opens to show the product
                  types in that collection and three of its products, like the desktop panel.
                {%- endcomment -%}
                {%- assign mobile_menu = linklists['main-menu'] -%}
                <nav class="mnav" aria-label="{{ 'accessibility.menu' | t }}">
                  <ul class="mnav__list" role="list">
                    {%- for link in mobile_menu.links -%}
                      {%- liquid
                        assign link_collection = blank
                        if link.type == 'collection_link' and link.object.products_count > 0
                          assign link_collection = link.object
                        endif
                      -%}
                      <li class="mnav__item">
                        {%- if link.links != blank or link_collection != blank -%}
                          <details class="mnav__group">
                            <summary class="mnav__top">
                              <span>{{ link.title | escape }}</span>
                              <span class="mnav__icon" aria-hidden="true"></span>
                            </summary>
                            <div class="mnav__panel">
                              {%- if link.links != blank -%}
                                <ul class="mnav__sub" role="list">
                                {%- assign has_grandchild_links = false -%}
                                {%- for child in link.links -%}
                                  {%- capture static_probe -%}
                                    {%- render 'menu-static-items', group: child.title, parent: link.title -%}
                                  {%- endcapture -%}
                                  {%- assign static_probe = static_probe | strip -%}
                                  {%- if child.links != blank or static_probe != '' -%}
                                    {%- assign has_grandchild_links = true -%}
                                    {%- break -%}
                                  {%- endif -%}
                                {%- endfor -%}

                                {%- if has_grandchild_links -%}
                                  {%- for child in link.links -%}
                                    <li>
                                      <a href="{{ child.url }}">{{ child.title | escape }}</a>
                                    {%- liquid
                                      capture static_items
                                        render 'menu-static-items', group: child.title, parent: link.title
                                      endcapture
                                      assign static_items = static_items | strip

                                      assign all_link = blank
                                      for grandchild in child.links
                                        assign grandchild_title_lower = grandchild.title | downcase
                                        if grandchild_title_lower contains 'all ' or grandchild_title_lower == 'all'
                                          assign all_link = grandchild
                                          break
                                        endif
                                      endfor
                                    -%}
                                    <div class="mnav__section">
                                      <div class="mnav__section-head">
                                        <span class="mnav__section-title">{{ child.title | escape }}</span>
                                        {%- if all_link != blank -%}
                                          <a href="{{ all_link.url }}" class="mnav__section-all">{{ all_link.title | escape }} &rarr;</a>
                                        {%- elsif child.url != blank and child.url != '#' -%}
                                          <a href="{{ child.url }}" class="mnav__section-all">Shop all &rarr;</a>
                                        {%- endif -%}
                                      </div>

                                      {%- if child.links != blank -%}
                                        <ul class="mnav__sub mnav__sub--nested" role="list">
                                        <ul class="mnav__tiles" role="list">
                                          {%- for grandchild in child.links -%}
                                            <li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                                            {%- liquid
                                              if all_link != blank and grandchild == all_link
                                                continue
                                              endif

                                              assign item_handle = grandchild.object.handle
                                              if item_handle == blank
                                                assign item_handle = grandchild.title | handleize
                                              endif

                                              assign item_image = blank
                                              if grandchild.type == 'collection_link' and grandchild.object.featured_image != blank
                                                assign item_image = grandchild.object.featured_image
                                              elsif grandchild.type == 'product_link' and grandchild.object.featured_image != blank
                                                assign item_image = grandchild.object.featured_image
                                              endif

                                              assign placeholder_asset = blank
                                              capture placeholder_capture
                                                render 'menu-tile-placeholder', handle: item_handle
                                              endcapture
                                              assign placeholder_asset = placeholder_capture | strip
                                            -%}
                                            <li class="mnav__tile-item">
                                              <a class="mnav__tile" href="{{ grandchild.url }}">
                                                <span class="mnav__tile-media">
                                                  {%- if item_image != blank -%}
                                                    {{ item_image | image_url: width: 300 | image_tag: loading: 'lazy', sizes: '28vw', class: 'mnav__tile-cover', alt: grandchild.title }}
                                                  {%- elsif placeholder_asset != blank and placeholder_asset != '' -%}
                                                    <img
                                                      src="{{ placeholder_asset | asset_img_url: '300x' }}"
                                                      alt="{{ grandchild.title | escape }}"
                                                      loading="lazy"
                                                      width="300"
                                                      height="300"
                                                    >
                                                  {%- else -%}
                                                    {%- render 'menu-tile-fallback', title: grandchild.title -%}
                                                  {%- endif -%}
                                                </span>
                                                <span class="mnav__tile-title">{{ grandchild.title | escape }}</span>
                                              </a>
                                            </li>
                                          {%- endfor -%}
                                        </ul>
                                      {%- elsif static_items != '' -%}
                                        {%- assign tile_sections = static_items | split: ';;' -%}
                                        {%- for section_raw in tile_sections -%}
                                          {%- liquid
                                            assign section_parts = section_raw | split: '::'
                                            assign section_subhead = ''
                                            assign section_items = section_parts[0]
                                            if section_parts.size > 1
                                              assign section_subhead = section_parts[0]
                                              assign section_items = section_parts[1]
                                            endif
                                            assign section_tiles = section_items | split: '~'
                                          -%}
                                          {%- if section_subhead != '' -%}
                                            <p class="mnav__section-subhead">{{ section_subhead | escape }}</p>
                                          {%- endif -%}
                                          <ul class="mnav__tiles" role="list">
                                            {%- for tile_item in section_tiles -%}
                                              {%- liquid
                                                assign parts = tile_item | split: '|'
                                                assign item_title = parts[0]
                                                assign item_handle = parts[1]
                                                assign item_url = item_handle
                                                assign item_collection = blank
                                                unless item_handle contains '/'
                                                  assign item_collection = collections[item_handle]
                                                  assign item_url = item_handle | prepend: '/collections/'
                                                endunless

                                                assign placeholder_asset = blank
                                                capture placeholder_capture
                                                  render 'menu-tile-placeholder', handle: item_handle
                                                endcapture
                                                assign placeholder_asset = placeholder_capture | strip
                                              -%}
                                              <li class="mnav__tile-item">
                                                <a class="mnav__tile" href="{{ item_url }}">
                                                  <span class="mnav__tile-media">
                                                    {%- if item_collection.featured_image != blank -%}
                                                      {{ item_collection.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', sizes: '28vw', class: 'mnav__tile-cover', alt: item_title }}
                                                    {%- elsif placeholder_asset != blank and placeholder_asset != '' -%}
                                                      <img
                                                        src="{{ placeholder_asset | asset_img_url: '300x' }}"
                                                        alt="{{ item_title | escape }}"
                                                        loading="lazy"
                                                        width="300"
                                                        height="300"
                                                      >
                                                    {%- else -%}
                                                      {%- render 'menu-tile-fallback', title: item_title -%}
                                                    {%- endif -%}
                                                  </span>
                                                  <span class="mnav__tile-title">{{ item_title | escape }}</span>
                                                </a>
                                              </li>
                                            {%- endfor -%}
                                          </ul>
                                        {%- endfor -%}
                                      {%- endif -%}
                                    </li>
                                    </div>
                                  {%- endfor -%}
                                </ul>
                                {%- else -%}
                                  <ul class="mnav__tiles" role="list">
                                    {%- for child in link.links -%}
                                      {%- liquid
                                        assign item_handle = child.object.handle
                                        if item_handle == blank
                                          assign item_handle = child.title | handleize
                                        endif

                                        assign item_image = blank
                                        if child.type == 'collection_link' and child.object.featured_image != blank
                                          assign item_image = child.object.featured_image
                                        elsif child.type == 'product_link' and child.object.featured_image != blank
                                          assign item_image = child.object.featured_image
                                        endif

                                        assign placeholder_asset = blank
                                        capture placeholder_capture
                                          render 'menu-tile-placeholder', handle: item_handle
                                        endcapture
                                        assign placeholder_asset = placeholder_capture | strip
                                      -%}
                                      <li class="mnav__tile-item">
                                        <a class="mnav__tile" href="{{ child.url }}">
                                          <span class="mnav__tile-media">
                                            {%- if item_image != blank -%}
                                              {{ item_image | image_url: width: 300 | image_tag: loading: 'lazy', sizes: '28vw', class: 'mnav__tile-cover', alt: child.title }}
                                            {%- elsif placeholder_asset != blank and placeholder_asset != '' -%}
                                              <img
                                                src="{{ placeholder_asset | asset_img_url: '300x' }}"
                                                alt="{{ child.title | escape }}"
                                                loading="lazy"
                                                width="300"
                                                height="300"
                                              >
                                            {%- else -%}
                                              {%- render 'menu-tile-fallback', title: child.title -%}
                                            {%- endif -%}
                                          </span>
                                          <span class="mnav__tile-title">{{ child.title | escape }}</span>
                                        </a>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}
                              {%- else -%}
                                <ul class="mnav__sub" role="list">
                                  {%- for type in link_collection.all_types limit: 6 -%}
                                    {%- if type != blank -%}
                                      <li><a href="{{ link_collection.url }}?filter.p.product_type={{ type | url_encode }}">{{ type | escape }}</a></li>
                                    {%- endif -%}
                                  {%- endfor -%}
                                </ul>
                                <ul class="mnav__products" role="list">
                                  {%- for product in link_collection.products limit: 3 -%}
                                    <li>
                                      <a href="{{ product.url }}">
                                        <span class="mnav__product-media">
                                          {%- if product.featured_image != blank -%}
                                            {{ product.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', sizes: '30vw', alt: product.title }}
                                          {%- endif -%}
                                        </span>
                                        <span class="mnav__product-title">{{ product.title | escape }}</span>
                                        <span class="mnav__product-price">{{ product.price | money }}</span>
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              {%- endif -%}
                              <a class="mnav__all" href="{{ link.url }}">Shop all {{ link.title | downcase | escape }}</a>
                            </div>
                          </details>
                        {%- else -%}
                          <a class="mnav__top" href="{{ link.url }}">
                            <span>{{ link.title | escape }}</span>
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </nav>
                <div class="mnav__utility">
                  {%- render 'menu-drawer-utility', sec_settings: section.settings -%}
                </div>
              </div>
            {%- endunless -%}
          </div>
        </div>
      </div>
    </div>
  </side-drawer>
{% endif %}

{% schema %}
{
  "name": "t:names.header_mobile_multi_tab",
  "enabled_on": {
    "groups": ["header"]
  },
  "blocks": [
    {
      "type": "_menu_tab_headings"
    },
    {
      "type": "_menu_tab_contents"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.media_level_1"
    },
    {
      "type": "checkbox",
      "id": "show_image_level_1",
      "label": "t:settings.show_icons_beside_menu_items",
      "default": true
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "rectangle",
          "label": "t:options.rectangle"
        }
      ],
      "default": "circle",
      "visible_if": "{{ section.settings.show_image_level_1 == true }}"
    },
    {
      "type": "range",
      "id": "media_width",
      "min": 20,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "t:settings.width",
      "default": 24,
      "visible_if": "{{ section.settings.show_image_level_1 == true }}"
    },
    {
      "type": "header",
      "content": "t:content.media_sub_menu_items"
    },
    {
      "type": "checkbox",
      "id": "show_image_sub_menu",
      "label": "t:settings.show_images_below_sub_menu_items",
      "default": true
    },
    {
      "type": "select",
      "id": "sub_media_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "circle",
          "label": "t:options.circle"
        },
        {
          "value": "rectangle",
          "label": "t:options.rectangle"
        }
      ],
      "default": "rectangle",
      "visible_if": "{{ section.settings.show_image_sub_menu == true }}"
    },
    {
      "type": "range",
      "id": "media_width_sub_menu",
      "min": 20,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.width",
      "default": 50,
      "visible_if": "{{ section.settings.show_image_sub_menu == true }}"
    },
    {
      "type": "header",
      "content": "t:content.localization"
    },
    {
      "type": "checkbox",
      "id": "show_country",
      "label": "t:settings.country_region",
      "info": "t:info.manage_countries_regions",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "country_selector_style",
      "label": "t:settings.flag",
      "default": true,
      "visible_if": "{{ section.settings.show_country }}"
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "t:settings.language_selector",
      "info": "t:info.manage_languages",
      "default": true
    },
    {
      "type": "select",
      "id": "localization_font",
      "label": "t:settings.font",
      "options": [
        {
          "value": "heading",
          "label": "t:options.heading"
        },
        {
          "value": "subheading",
          "label": "t:options.subheading"
        },
        {
          "value": "body",
          "label": "t:options.body"
        }
      ],
      "default": "heading",
      "visible_if": "{{ section.settings.show_country or section.settings.show_language }}"
    },
    {
      "type": "select",
      "id": "localization_font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "1rem",
          "label": "10px"
        },
        {
          "value": "1.2rem",
          "label": "12px"
        },
        {
          "value": "1.4rem",
          "label": "14px"
        },
        {
          "value": "1.6rem",
          "label": "16px"
        },
        {
          "value": "1.8rem",
          "label": "18px"
        }
      ],
      "default": "1rem"
    }
  ],
  "presets": [
    {
      "name": "t:names.header_mobile_multi_tab"
    }
  ]
}
{% endschema %}
