{% comment %}
  Ethical choice - the grey band at the foot of the product page that answers where the
  stones come from, before the shopper reaches the footer.

  One flat panel: a heading in capitals, a short piece of copy, and one outlined button
  through to the longer story. The second link beside it is optional and stays unprinted
  when its label is empty, as does the heading, the copy and the button itself, so the
  same section can be cut back to copy alone.

  The panel's background picture is optional and is a background image rather than an
  <img>, because it is decoration behind the copy, not content: a picked image wins, then
  a file name resolved through 'image-source' (Content > Files first, assets/ second).
  The overlay only exists when a picture has been set.

  Looks come from assets/ethical-choice.css; buttons from assets/eden-actions.css, whose
  ink is rebound here so they follow this section's own button colours.

  Every restylable setting is written onto the section element as a CSS custom property,
  with the stylesheet's own value as the fallback, so a setting left at "use the default"
  (a cleared colour, a size of 0) writes nothing at all.
{% endcomment %}

{{ 'ethical-choice.css' | asset_url | stylesheet_tag }}
{{ 'eden-actions.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign transparent = 'rgba(0,0,0,0)'

  comment
    A template saved before a setting existed has no value for it, so sizes are coerced
    with 'plus: 0' and treated as "keep the stylesheet default" at 0. The paddings cannot
    use that sentinel - 0 is a real padding - and are gated by their own checkbox instead.
  endcomment
  assign heading_size = section.settings.heading_size | plus: 0
  assign heading_size_mobile = section.settings.heading_size_mobile | plus: 0
  assign heading_tracking = section.settings.heading_tracking | plus: 0
  assign text_size = section.settings.text_size | plus: 0
  assign text_size_mobile = section.settings.text_size_mobile | plus: 0
  assign measure = section.settings.text_measure | plus: 0
  assign button_radius = section.settings.button_radius | plus: 0
  assign content_width = section.settings.content_width | plus: 0
  assign pad_inline = section.settings.padding_horizontal | plus: 0
  assign pad_block = section.settings.padding_vertical | plus: 0
  assign pad_top = section.settings.padding_top | plus: 0
  assign pad_bottom = section.settings.padding_bottom | plus: 0
  assign pad_top_mobile = section.settings.padding_top_mobile | plus: 0
  assign pad_bottom_mobile = section.settings.padding_bottom_mobile | plus: 0

  assign background_src = ''
  if section.settings.background_image != blank
    assign background_src = section.settings.background_image | image_url: width: 2400
  elsif section.settings.background_file != blank
    capture background_src
      render 'image-source', file: section.settings.background_file, width: 2400
    endcapture
    assign background_src = background_src | strip
  endif
-%}

{%- capture section_styles -%}
  {%- if section.settings.section_background != blank and section.settings.section_background != transparent -%}--eec-section-bg: {{ section.settings.section_background }};{%- endif -%}
  {%- if section.settings.panel_background != blank and section.settings.panel_background != transparent -%}--eec-panel-bg: {{ section.settings.panel_background }};{%- endif -%}
  {%- if section.settings.panel_border_color != blank and section.settings.panel_border_color != transparent -%}--eec-panel-border: {{ section.settings.panel_border_color }};{%- endif -%}
  {%- if section.settings.heading_color != blank and section.settings.heading_color != transparent -%}--eec-heading-color: {{ section.settings.heading_color }};{%- endif -%}
  {%- if section.settings.text_color != blank and section.settings.text_color != transparent -%}--eec-text-color: {{ section.settings.text_color }};{%- endif -%}
  {%- if section.settings.overlay_color != blank and section.settings.overlay_color != transparent -%}--eec-overlay: {{ section.settings.overlay_color }};{%- endif -%}

  {%- comment -%}
    The buttons take their fill and their text from eden-actions.css, so a button colour
    is set by rebinding that file's two properties here: one pair covers the filled and
    the outlined style alike.
  {%- endcomment -%}
  {%- if section.settings.button_background != blank and section.settings.button_background != transparent -%}--eden-action-ink: {{ section.settings.button_background }};{%- endif -%}
  {%- if section.settings.button_text_color != blank and section.settings.button_text_color != transparent -%}--eden-action-on-ink: {{ section.settings.button_text_color }};{%- endif -%}
  --style-border-radius-buttons-primary: {{ button_radius }}px;

  {%- if heading_size > 0 -%}--eec-heading-size: {{ heading_size }}px;{%- endif -%}
  {%- if heading_size_mobile > 0 -%}--eec-heading-size-mobile: {{ heading_size_mobile }}px;{%- endif -%}
  {%- if heading_tracking > 0 -%}--eec-heading-tracking: {{ heading_tracking | divided_by: 100.0 }}em;{%- endif -%}
  {%- unless section.settings.uppercase_heading -%}--eec-heading-case: none;{%- endunless -%}
  {%- if text_size > 0 -%}--eec-text-size: {{ text_size }}px;{%- endif -%}
  {%- if text_size_mobile > 0 -%}--eec-text-size-mobile: {{ text_size_mobile }}px;{%- endif -%}
  {%- if measure > 0 -%}--eec-measure: {{ measure }}ch;{%- endif -%}
  --eec-text-align: {{ section.settings.text_alignment }};

  {%- comment -%}
    Full width is the band running the whole viewport, so the shell loses both its
    ceiling and the gutter that holds it off the screen edge; the panel's own side
    padding is what keeps the copy off the edge from there.
  {%- endcomment -%}
  {%- if section.settings.full_width -%}
    --eec-shell-max: none;--eec-shell-pad: 0px;
  {%- elsif content_width > 0 -%}
    --eec-shell-max: {{ content_width }}px;
  {%- endif -%}
  {%- if pad_inline > 0 -%}--eec-pad-inline: {{ pad_inline }}px;{%- endif -%}
  {%- if pad_block > 0 -%}--eec-pad-block: {{ pad_block }}px;{%- endif -%}
  {%- if section.settings.custom_padding -%}--eec-pad-top: {{ pad_top }}px;--eec-pad-bottom: {{ pad_bottom }}px;--eec-pad-top-mobile: {{ pad_top_mobile }}px;--eec-pad-bottom-mobile: {{ pad_bottom_mobile }}px;{%- endif -%}
{%- endcapture -%}

<section class="eden-ethical" style="{{ section_styles | strip_newlines | strip }}" {{ section.shopify_attributes }}>
  <div class="eec-shell">
    <div
      class="eec-panel{% if background_src != blank %} eec-panel--image{% endif %}"
      {% if background_src != blank %}style="background-image: url({{ background_src }});"{% endif %}
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="eec-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="eec-text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
        <div class="eec-actions">
          {%- if section.settings.button_label != blank -%}
            <a class="eden-action eden-action--{{ section.settings.button_style }}" href="{{ section.settings.button_link | default: '/pages/gemstones' }}">
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.link_label != blank -%}
            <a class="eden-link" href="{{ section.settings.link_url | default: '/pages/gemstones' }}">
              {{- section.settings.link_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ethical choice",
  "tag": "section",
  "class": "section-ethical-choice",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The ethical choice" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>In recent times, attention has been turned to where our jewels come from. The diamond industry has in the past been associated with conflict, slavery and exploitation, but this isn't something you need to worry about when shopping with Eden Raine.</p><p>The semi-precious gemstones we use in our jewellery are sustainable, eco-friendly and are 100% conflict free. To the naked human eye, it is impossible to differentiate between Cubic Zirconia and a diamond, and you will see it featured in engagement rings, earrings, pendants and bracelets to name just a few. Unlike a diamond, Cubic Zirconia stones are optically flawless, and they have the sparkle to match.</p>" },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read more" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Left empty the button goes to \/pages\/gemstones." },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "outline", "label": "Outlined" },
        { "value": "solid", "label": "Filled" }
      ],
      "default": "outline"
    },
    { "type": "range", "id": "button_radius", "label": "Button corner", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0, "info": "0 keeps the theme's square corner." },
    { "type": "text", "id": "link_label", "label": "Second link label", "info": "A quieter underlined link beside the button. Leave empty for the button on its own." },
    { "type": "url", "id": "link_url", "label": "Second link" },

    { "type": "header", "content": "Background picture" },
    { "type": "paragraph", "content": "Optional. A picked image wins, then a file name from Content > Files or assets\/. Leave both empty for the flat colour below." },
    { "type": "image_picker", "id": "background_image", "label": "Image" },
    { "type": "text", "id": "background_file", "label": "File name", "info": "For example ethical-choice.jpg" },
    { "type": "color", "id": "overlay_color", "label": "Tint over the picture", "default": "rgba(0,0,0,0)" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "section_background", "label": "Page background behind the band", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "panel_background", "label": "Panel background", "default": "#f4f3f2" },
    { "type": "color", "id": "panel_border_color", "label": "Panel border", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_background", "label": "Button fill", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "rgba(0,0,0,0)" },

    { "type": "header", "content": "Type" },
    { "type": "paragraph", "content": "A size of 0 keeps the stylesheet's own value." },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 0, "max": 60, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on mobile", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "heading_tracking", "label": "Heading letter spacing", "min": 0, "max": 40, "step": 1, "unit": "%", "default": 0 },
    { "type": "checkbox", "id": "uppercase_heading", "label": "Heading in capitals", "default": true },
    { "type": "range", "id": "text_size", "label": "Body text size", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_size_mobile", "label": "Body text size on mobile", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_measure", "label": "Body text line length", "min": 0, "max": 120, "step": 2, "unit": "ch", "default": 0, "info": "0 lets the copy run the full width of the panel." },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Body text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "left"
    },

    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "range", "id": "content_width", "label": "Maximum content width", "min": 0, "max": 2400, "step": 40, "unit": "px", "default": 0, "info": "0 keeps the default of 1570px. Ignored when the box above is ticked." },
    { "type": "range", "id": "padding_horizontal", "label": "Side padding of the panel", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the default of 60px." },
    { "type": "range", "id": "padding_vertical", "label": "Top and bottom padding of the panel", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the default of 50px." },
    { "type": "checkbox", "id": "custom_padding", "label": "Set the space above and below the band", "default": false },
    { "type": "range", "id": "padding_top", "label": "Space above the band", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Space below the band", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above the band on mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Space below the band on mobile", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "Ethical choice" }]
}
{% endschema %}
