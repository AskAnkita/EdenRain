<section
  class="brand-benefits"
  style="
    --benefits-background: {{ section.settings.background_color }};
    --benefits-foreground: {{ section.settings.text_color }};
    --benefits-icon-size: {{ section.settings.icon_size }}px;
  "
>
  <div class="brand-benefits__inner">
    <header class="brand-benefits__header">
      {% if section.settings.heading != blank %}
        <h2 class="brand-benefits__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="brand-benefits__description">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    <div class="brand-benefits__grid">
      {% for block in section.blocks %}
        <div class="brand-benefits__item" {{ block.shopify_attributes }}>
          <div class="brand-benefits__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'diamond' %}
                <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M21 35.5 33 22h30l12 13.5L48 75 21 35.5Z"/>
                  <path d="m21 35.5 27 12 27-12M33 22l15 25.5L63 22M48 47.5 36 35.5 33 22M48 47.5l12-12L63 22M48 12v-7M27 16l-5-6M69 16l5-6"/>
                </svg>
              {% when 'shipping' %}
                <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M12 27h43v36H12V27ZM55 39h15l12 13v11H55V39Z"/>
                  <path d="M27 72a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM69 72a9 9 0 1 0 0-18 9 9 0 0 0 0 18ZM20 18h31M12 18h2"/>
                </svg>
              {% when 'returns' %}
                <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M30 34h36v32H30V34ZM27 34h42l-5-11H32l-5 11Z"/>
                  <path d="M48 34v11l-6-3-6 3V34M76 29A34 34 0 0 0 18 19M18 19v13M18 19h13M20 67a34 34 0 0 0 58 10M78 77V64M78 77H65"/>
                </svg>
              {% when 'crafted' %}
                <svg viewBox="0 0 96 96" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M30 34 39 23h18l9 11-18 25-18-25Z"/>
                  <path d="m30 34 18 8 18-8M39 23l9 19 9-19M27 63c-8 4-12 11-12 21 10 0 18-4 23-12M69 63c8 4 12 11 12 21-10 0-18-4-23-12M48 59v25M19 43h-8M85 43h-8M24 18l-6-6M72 18l6-6"/>
                </svg>
            {% endcase %}
          </div>
          {% if block.settings.title != blank %}
            <h3 class="brand-benefits__title">{{ block.settings.title }}</h3>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .brand-benefits {
    width: 100%;
    color: var(--benefits-foreground);
    background: var(--benefits-background);
  }

  .brand-benefits__inner {
    width: min(100%, 1440px);
    margin: 0 auto;
    padding: 88px 80px 96px;
  }

  .brand-benefits__header {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .brand-benefits__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(26px, 2.3vw, 36px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .brand-benefits__description {
    max-width: 620px;
    margin: 24px auto 0;
    font-family: var(--font-body--family);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.8;
    letter-spacing: 0.02em;
  }

  .brand-benefits__description p {
    margin: 0;
  }

  .brand-benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 40px;
    margin-top: 80px;
  }

  .brand-benefits__item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
  }

  .brand-benefits__icon {
    width: var(--benefits-icon-size);
    height: var(--benefits-icon-size);
  }

  .brand-benefits__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .brand-benefits__title {
    margin: 40px 0 0;
    font-family: var(--font-body--family);
    font-size: clamp(13px, 1.1vw, 16px);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    .brand-benefits__inner {
      padding: 68px 32px 64px;
    }

    .brand-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 56px;
      margin-top: 60px;
    }
  }

  @media screen and (max-width: 749px) {
    .brand-benefits__inner {
      padding: 56px 20px 60px;
    }

    .brand-benefits__description {
      margin-top: 20px;
      line-height: 1.55;
    }

    .brand-benefits__grid {
      gap: 44px 16px;
      margin-top: 48px;
    }

    .brand-benefits__icon {
      width: min(var(--benefits-icon-size), 64px);
      height: min(var(--benefits-icon-size), 64px);
    }

    .brand-benefits__title {
      margin-top: 20px;
      font-size: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand benefits",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for your story"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Elegant engagement rings and fine jewellery set with high-quality lab-grown diamonds. Beautiful statements made to last.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f4f4f0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 56,
      "max": 112,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "diamond", "label": "Diamond" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "crafted", "label": "Crafted" }
          ],
          "default": "diamond"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lifetime guarantee"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "diamond", "title": "Lifetime guarantee" } },
        { "type": "benefit", "settings": { "icon": "shipping", "title": "Complimentary shipping" } },
        { "type": "benefit", "settings": { "icon": "returns", "title": "60-day returns" } },
        { "type": "benefit", "settings": { "icon": "crafted", "title": "Consciously crafted" } }
      ]
    }
  ]
}
{% endschema %}
