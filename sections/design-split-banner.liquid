{% comment %}
  Design split banner - the two routes into the Design Studio, either side of one tall ring.

  The shape is MiaDonna's "start your design" band: a column of copy on the left, the piece in
  the middle with its stone lifted off the setting, a column on the right, and one quiet line
  underneath for the shopper who cannot choose between them.

  A route is a block, so the band is as wide as the number of routes we can actually build;
  two is what it is drawn for and what it caps at. A block with no heading, text or button
  still prints its icon, so an icon-only column is possible.

  The middle image is the open ring setting. A separate 3D stone layer floats above it and
  changes cut on each jump. The setting goes through 'homepage-journey-image' - picked image
  first, then a file in assets/, then a pasted URL, then a placeholder - which keeps the band
  from collapsing while the products are still unpublished.

  Looks come from assets/design-split-banner.css; buttons from assets/eden-actions.css, whose
  ink is rebound here so the buttons follow this section's own button colours.

  Every restylable setting is written onto the section element as a CSS custom property, with
  the stylesheet's own value as the fallback, so a setting left at "use the default" (a cleared
  colour, a size of 0) writes nothing at all.
{% endcomment %}

{{ 'design-split-banner.css' | asset_url | stylesheet_tag }}
{{ 'eden-actions.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign transparent = 'rgba(0,0,0,0)'

  # A template saved before a setting existed has no value for it, so sizes are coerced with
  # 'plus: 0' and treated as "keep the stylesheet default" at 0. The paddings cannot use that
  # sentinel - 0 is a real padding - and are gated by the custom_padding checkbox instead.
  assign heading_size = section.settings.heading_size | plus: 0
  assign heading_size_mobile = section.settings.heading_size_mobile | plus: 0
  assign heading_tracking = section.settings.heading_tracking | plus: 0
  assign eyebrow_size = section.settings.eyebrow_size | plus: 0
  assign text_size = section.settings.text_size | plus: 0
  assign footnote_size = section.settings.footnote_size | plus: 0
  assign icon_size = section.settings.icon_size | plus: 0
  assign media_width = section.settings.media_width | plus: 0
  assign media_gap = section.settings.media_gap | plus: 0
  assign media_stone_gap = section.settings.media_stone_gap | plus: 0
  assign measure = section.settings.text_measure | plus: 0
  assign button_radius = section.settings.button_radius | plus: 0
  assign content_width = section.settings.content_width | plus: 0
  assign pad_inline = section.settings.padding_horizontal | plus: 0
  assign pad_top = section.settings.padding_top | plus: 0
  assign pad_bottom = section.settings.padding_bottom | plus: 0

  assign column_blocks = section.blocks | where: 'type', 'column'

  # The band heading, where there is one, is the h2; without it the routes are the headings
  # rather than sitting under one that was never printed.
  assign column_tag = 'h2'
  if section.settings.heading != blank
    assign column_tag = 'h3'
  endif
-%}

{%- capture section_styles -%}
  {%- if section.settings.section_background != blank and section.settings.section_background != transparent -%}--dsp-section-bg: {{ section.settings.section_background }};{%- endif -%}
  {%- if section.settings.heading_color != blank and section.settings.heading_color != transparent -%}--dsp-heading-color: {{ section.settings.heading_color }};{%- endif -%}
  {%- if section.settings.text_color != blank and section.settings.text_color != transparent -%}--dsp-text-color: {{ section.settings.text_color }};{%- endif -%}
  {%- if section.settings.icon_color != blank and section.settings.icon_color != transparent -%}--dsp-icon-color: {{ section.settings.icon_color }};{%- endif -%}
  {%- if section.settings.footnote_color != blank and section.settings.footnote_color != transparent -%}--dsp-footnote-color: {{ section.settings.footnote_color }};{%- endif -%}

  {%- comment -%}
    The buttons take their fill and their text from eden-actions.css, so a button colour is set
    by rebinding that file's two properties here: one pair covers the filled and the outlined
    style alike. The corner is the theme's own button radius, rebound on this section rather
    than a radius of this section's own.
  {%- endcomment -%}
  {%- if section.settings.button_background != blank and section.settings.button_background != transparent -%}--eden-action-ink: {{ section.settings.button_background }};{%- endif -%}
  {%- if section.settings.button_text_color != blank and section.settings.button_text_color != transparent -%}--eden-action-on-ink: {{ section.settings.button_text_color }};{%- endif -%}
  --style-border-radius-buttons-primary: {{ button_radius }}px;

  {%- if heading_size > 0 -%}--dsp-heading-size: {{ heading_size }}px;{%- endif -%}
  {%- if heading_size_mobile > 0 -%}--dsp-heading-size-mobile: {{ heading_size_mobile }}px;{%- endif -%}
  {%- if heading_tracking > 0 -%}--dsp-heading-tracking: {{ heading_tracking | divided_by: 100.0 }}em;{%- endif -%}
  {%- if eyebrow_size > 0 -%}--dsp-eyebrow-size: {{ eyebrow_size }}px;{%- endif -%}
  {%- if text_size > 0 -%}--dsp-text-size: {{ text_size }}px;{%- endif -%}
  {%- if footnote_size > 0 -%}--dsp-footnote-size: {{ footnote_size }}px;{%- endif -%}
  {%- if icon_size > 0 -%}--dsp-icon-size: {{ icon_size }}px;{%- endif -%}
  {%- unless section.settings.uppercase_headings -%}--dsp-heading-case: none;{%- endunless -%}

  {%- if media_width > 0 -%}--dsp-media-width: {{ media_width }}px;{%- endif -%}
  {%- if media_gap > 0 -%}--dsp-media-gap: {{ media_gap }}px;{%- endif -%}
  {%- if media_stone_gap > 0 -%}--dsp-media-stone-gap: {{ media_stone_gap }}px;{%- endif -%}
  {%- if measure > 0 -%}--dsp-measure: {{ measure }}ch;{%- endif -%}

  {%- if section.settings.full_width -%}
    --dsp-shell-max: none;
  {%- elsif content_width > 0 -%}
    --dsp-shell-max: {{ content_width }}px;
  {%- endif -%}
  {%- if pad_inline > 0 -%}--dsp-pad-inline: {{ pad_inline }}px;{%- endif -%}
  {%- if section.settings.custom_padding -%}--dsp-pad-top: {{ pad_top }}px;--dsp-pad-bottom: {{ pad_bottom }}px;{%- endif -%}
{%- endcapture -%}

{%- comment -%}
  The picture is captured before the columns so it can be printed between the first and the
  second of them without the column markup being written out twice.
{%- endcomment -%}
{%- capture media_html -%}
  <div class="dsp-media">
    {%- render 'homepage-journey-image',
      image: section.settings.media_image,
      asset: section.settings.media_asset,
      image_url: section.settings.media_image_url,
      alt: section.settings.media_alt,
      sizes: '(min-width: 990px) 420px, 72vw',
      width: 800,
      height: 1020
    -%}
    {%- if section.settings.animate_stones -%}
      {%- comment -%}
        The stone renders live in Content > Files, so each URL goes through 'image-source' and
        is captured before `json` sees it - `json` takes a string, not a tag.
      {%- endcomment -%}
      {%- capture stone_round %}{% render 'image-source', file: 'design-stone-round-3d.webp', width: 512 %}{% endcapture -%}
      {%- capture stone_oval %}{% render 'image-source', file: 'design-stone-oval-3d.webp', width: 512 %}{% endcapture -%}
      {%- capture stone_emerald %}{% render 'image-source', file: 'design-stone-emerald-3d.webp', width: 512 %}{% endcapture -%}
      {%- capture stone_pear %}{% render 'image-source', file: 'design-stone-pear-3d.webp', width: 512 %}{% endcapture -%}
      {%- capture stone_marquise %}{% render 'image-source', file: 'design-stone-marquise-3d.webp', width: 512 %}{% endcapture -%}
      <div
        class="dsp-media__stone"
        data-stone-sources='[{{ stone_round | strip | json }},{{ stone_oval | strip | json }},{{ stone_emerald | strip | json }},{{ stone_pear | strip | json }},{{ stone_marquise | strip | json }}]'
        aria-hidden="true"
      >
        <img src="{{ stone_round | strip }}" alt="" loading="eager" width="512" height="512">
      </div>
    {%- endif -%}
  </div>
{%- endcapture -%}

<section
  class="ds-split{% if section.settings.blend_media %} ds-split--blend{% endif %}{% if column_blocks.size == 1 %} ds-split--single{% endif %}"
  style="{{ section_styles | strip_newlines | strip }}"
  {{ section.shopify_attributes }}
>
  <div class="dsp-shell">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="dsp-head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dsp-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dsp-head__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="dsp-grid">
      {%- for block in column_blocks limit: 2 -%}
        {%- if forloop.index == 2 -%}{{ media_html }}{%- endif -%}

        <div class="dsp-col" {{ block.shopify_attributes }}>
          {%- liquid
            assign has_icon_image = false
            if block.settings.icon_image != blank or block.settings.icon_asset != blank
              assign has_icon_image = true
            endif
          -%}
          {%- if has_icon_image -%}
            <span class="dsp-col__icon">
              {%- render 'homepage-journey-image',
                image: block.settings.icon_image,
                asset: block.settings.icon_asset,
                alt: '',
                sizes: '64px',
                width: 64,
                height: 64
              -%}
            </span>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="dsp-col__icon" aria-hidden="true">
              {%- render 'icon-design-route', icon: block.settings.icon -%}
            </span>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <{{ column_tag }} class="dsp-col__heading">{{ block.settings.heading | escape }}</{{ column_tag }}>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <div class="dsp-col__text">{{ block.settings.text }}</div>
          {%- endif -%}

          {%- if block.settings.button_label != blank -%}
            <a class="eden-action eden-action--{{ block.settings.button_style }}" href="{{ block.settings.button_link | default: '#' }}">
              {{- block.settings.button_label | escape -}}
              {%- if section.settings.show_button_arrow -%}
                <span class="svg-wrapper">{%- render 'icon-arrow' -%}</span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- comment -%}
        One route, or none at all in a section just added in the editor: the picture still
        prints, so the band never comes out empty.
      {%- endcomment -%}
      {%- if column_blocks.size < 2 -%}{{ media_html }}{%- endif -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <div class="dsp-footnote">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.animate_stones -%}
  <script>
    (() => {
      const sectionRoot = document.getElementById('shopify-section-{{ section.id }}');
      const stone = sectionRoot?.querySelector('.dsp-media__stone');
      const image = stone?.querySelector('img');
      if (!stone || !image || stone.dataset.ready === 'true') return;

      let sources;
      try {
        sources = JSON.parse(stone.dataset.stoneSources || '[]');
      } catch (error) {
        return;
      }
      if (sources.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let current = 0;
      stone.dataset.ready = 'true';
      stone.addEventListener('animationiteration', () => {
        current = (current + 1) % sources.length;
        image.src = sources[current];
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Design split banner",
  "tag": "section",
  "class": "section-design-split",
  "max_blocks": 2,
  "settings": [
    { "type": "header", "content": "Band heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Small line above the heading. Leave both empty for the band in the reference, which leads straight with the two routes." },
    { "type": "text", "id": "heading", "label": "Heading", "info": "With a heading here the routes below drop to h3, so the band keeps one heading order." },

    { "type": "header", "content": "The piece" },
    { "type": "paragraph", "content": "The setting image sits below a separate 3D stone that floats and changes cut on every jump. A picked image wins, then a file in assets\/, then a pasted URL." },
    { "type": "image_picker", "id": "media_image", "label": "Image or GIF" },
    { "type": "text", "id": "media_asset", "label": "File in assets\/", "default": "design-split-ring-setting.webp" },
    { "type": "text", "id": "media_image_url", "label": "Image URL" },
    { "type": "text", "id": "media_alt", "label": "Alt text", "default": "An open white-gold solitaire ring setting" },
    { "type": "checkbox", "id": "animate_stones", "label": "Float and change stone cuts", "default": true },
    { "type": "checkbox", "id": "blend_media", "label": "Blend the pictures into the band", "info": "For shots photographed on white: the white drops away instead of sitting as a box on the background. Turn off for a picture with its own background.", "default": true },

    { "type": "header", "content": "Footnote" },
    { "type": "richtext", "id": "footnote", "label": "Line under the band", "default": "<p>Can't decide? Talk to one of our designers and we will help you find it.</p>" },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "section_background", "label": "Background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "icon_color", "label": "Icons", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "footnote_color", "label": "Footnote", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_background", "label": "Button fill", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "rgba(0,0,0,0)" },

    { "type": "header", "content": "Type" },
    { "type": "paragraph", "content": "A size of 0 keeps the stylesheet's own value." },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 0, "max": 90, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "heading_tracking", "label": "Heading letter spacing", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 0 },
    { "type": "checkbox", "id": "uppercase_headings", "label": "Headings in capitals", "default": true },
    { "type": "range", "id": "eyebrow_size", "label": "Eyebrow size", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_size", "label": "Body text size", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "footnote_size", "label": "Footnote size", "min": 0, "max": 26, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_measure", "label": "Body text line length", "min": 0, "max": 70, "step": 2, "unit": "ch", "default": 0, "info": "0 keeps the default of 38 characters." },

    { "type": "header", "content": "Buttons" },
    { "type": "range", "id": "button_radius", "label": "Button corner", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0, "info": "0 keeps the theme's square corner. Raise it for the pill in the reference." },
    { "type": "checkbox", "id": "show_button_arrow", "label": "Arrow after the button label", "default": true },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "media_width", "label": "Width of the piece", "min": 0, "max": 900, "step": 20, "unit": "px", "default": 0, "info": "0 keeps the default of 420px." },
    { "type": "range", "id": "media_gap", "label": "Gap either side of the piece", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "media_stone_gap", "label": "Gap between the stone and the setting", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 28, "info": "Drops the setting image down the band so the floating stone sits clear of it instead of resting on the prongs." },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false },
    { "type": "range", "id": "content_width", "label": "Maximum content width", "min": 0, "max": 2400, "step": 40, "unit": "px", "default": 0, "info": "0 keeps the default of 1480px. Ignored when the box above is ticked." },
    { "type": "range", "id": "padding_horizontal", "label": "Side padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0, "info": "0 keeps the stylesheet's responsive padding." },
    { "type": "checkbox", "id": "custom_padding", "label": "Set the top and bottom padding", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Route",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "ring", "label": "Ring setting" },
            { "value": "stone", "label": "Diamond" },
            { "value": "chat", "label": "Diamond in a speech bubble" },
            { "value": "none", "label": "None" }
          ],
          "default": "ring"
        },
        { "type": "image_picker", "id": "icon_image", "label": "Icon image", "info": "Replaces the drawn icon above." },
        { "type": "text", "id": "icon_asset", "label": "Icon file in assets/" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Ring setting" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Start with a setting and we will bring the stone to it.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Start with a setting" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "outline", "label": "Outlined" },
            { "value": "solid", "label": "Filled" }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Design split banner",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon": "ring",
            "heading": "Ring setting",
            "text": "<p>Begin with the setting. Choose the shape of the shoulders and the metal, and we will bring the stone to it.</p>",
            "button_label": "Start with a setting",
            "button_link": "/pages/design-studio-builder"
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "stone",
            "heading": "Centre stone",
            "text": "<p>Begin with the diamond. Pick the cut, the carat and the clarity, then choose the setting it goes into.</p>",
            "button_label": "Start with a stone",
            "button_link": "/collections/lab-grown-diamonds"
          }
        }
      ]
    }
  ]
}
{% endschema %}
