{% comment %}
  Centre-stone carat size guide.

  One tile per product page, showing the chosen carat on a hand so the size reads as a size
  rather than a number. One block per diamond shape; each block carries a hand photo and up
  to three anchor renders (1 ct, 3 ct, 5 ct is the usual set). carat-size-guide.js scales
  the nearest anchor by the cube root of the carat ratio for the steps in between, which is
  how a stone's width actually grows with its weight, so three renders cover the whole track.

  The library is shared: the setting in the picture is explicitly "for reference only", so
  the same ten shapes serve every ring in the catalogue and no product needs its own guide.
{% endcomment %}

{%- liquid
  assign transparent = 'rgba(0,0,0,0)'
  assign root_class = 'carat-guide-' | append: section.id

  assign step_labels = section.settings.carat_steps | split: ','

  # A "carat selected first" that matches no step would otherwise leave the track with
  # nothing lit and the caption naming a carat the customer cannot press, until the JS
  # corrects it. Fall back to the first step so the server-rendered state is already right.
  assign initial_carat = ''
  for label in step_labels
    assign step_label = label | strip
    if step_label == section.settings.default_carat
      assign initial_carat = step_label
      break
    endif
  endfor
  if initial_carat == blank
    assign initial_carat = step_labels.first | strip
  endif

  # Which option on this product names the stone shape, so the tile can follow the
  # swatches the customer presses. -1 when the product has no such option, which is most
  # of the catalogue -- those fall back to the Shape: tag.
  assign shape_option_index = -1
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'shape' or option_name contains 'cut'
      assign shape_option_index = forloop.index0
      assign selected_shape_text = option.selected_value | downcase
      break
    endif
  endfor

  if selected_shape_text == blank
    for tag in product.tags
      assign tag_compare = tag | downcase
      if tag_compare contains 'shape:'
        assign selected_shape_text = tag | split: ':' | last | strip | downcase
        break
      endif
    endfor
  endif
-%}

{%- comment -%}
  Resolve each block to a shape key first, so the default shape can be matched against the
  blocks that actually exist rather than against the ten the icon set ships.
{%- endcomment -%}
{%- assign default_shape = '' -%}
{%- for block in section.blocks -%}
  {%- if selected_shape_text contains block.settings.shape and default_shape == blank -%}
    {%- assign default_shape = block.settings.shape -%}
  {%- endif -%}
{%- endfor -%}
{%- if default_shape == blank and section.blocks.size > 0 -%}
  {%- assign default_shape = section.blocks.first.settings.shape -%}
{%- endif -%}

{% style %}
  .{{ root_class }} {
    --carat-ratio: {{ section.settings.aspect_ratio }};
    --carat-radius: {{ section.settings.tile_radius }}px;
    --carat-scrim: {{ section.settings.scrim | divided_by: 100.0 }};
    --carat-heading-size: {{ section.settings.heading_size }}px;
    --carat-heading-tracking: {{ section.settings.heading_tracking | divided_by: 100.0 }}em;
    --carat-heading-weight: {{ section.settings.heading_weight }};
    --carat-subheading-size: {{ section.settings.subheading_size }}px;
    --carat-readout-size: {{ section.settings.readout_size }}px;
    --carat-step-size: {{ section.settings.step_size }}px;
    --carat-step-gap: {{ section.settings.step_gap }}px;
    --carat-track-radius: {{ section.settings.track_radius }}px;
    --carat-track-inset: {{ section.settings.track_inset }}px;
    --carat-page-padding: {{ section.settings.page_padding }}px;
    --carat-padding-top: {{ section.settings.padding_top }}px;
    --carat-padding-bottom: {{ section.settings.padding_bottom }}px;
    {% if section.settings.heading_color != blank and section.settings.heading_color != transparent %}--carat-heading-color: {{ section.settings.heading_color }};{% endif %}
    {% if section.settings.subheading_color != blank and section.settings.subheading_color != transparent %}--carat-subheading-color: {{ section.settings.subheading_color }};{% endif %}
    {% if section.settings.readout_color != blank and section.settings.readout_color != transparent %}--carat-readout-color: {{ section.settings.readout_color }};{% endif %}
    {% if section.settings.track_background != blank and section.settings.track_background != transparent %}--carat-track-bg: {{ section.settings.track_background }};{% endif %}
    {% if section.settings.step_color != blank and section.settings.step_color != transparent %}--carat-step-color: {{ section.settings.step_color }};{% endif %}
    {% if section.settings.step_active_background != blank and section.settings.step_active_background != transparent %}--carat-step-active-bg: {{ section.settings.step_active_background }};{% endif %}
    {% if section.settings.step_active_color != blank and section.settings.step_active_color != transparent %}--carat-step-active-color: {{ section.settings.step_active_color }};{% endif %}
    {% if section.settings.tile_background != blank and section.settings.tile_background != transparent %}--carat-tile-bg: {{ section.settings.tile_background }};{% endif %}
    {% if section.settings.section_background != blank and section.settings.section_background != transparent %}--carat-section-bg: {{ section.settings.section_background }};{% endif %}

    background: var(--carat-section-bg, transparent);
    padding: var(--carat-padding-top) var(--carat-page-padding) var(--carat-padding-bottom);
  }

  .{{ root_class }} .carat-guide__inner {
    {% if section.settings.width == 'page' %}max-width: var(--page-width, 1440px);{% endif %}
    margin-inline: auto;
  }

  .{{ root_class }} .carat-guide__tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--carat-ratio);
    border-radius: var(--carat-radius);
    background: var(--carat-tile-bg, #efeae6);
  }

  .{{ root_class }} .carat-guide__base,
  .{{ root_class }} .carat-guide__ring {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
  }

  /* The ring is its own layer pinned to the stone's centre on the hand, so scaling it
     changes the stone and leaves the hand where it is. */
  .{{ root_class }}:not(.carat-guide--flat) .carat-guide__ring {
    inset: auto;
    height: auto;
    object-fit: contain;
    transform-origin: center;
    transition: transform .28s cubic-bezier(.22,.61,.36,1), opacity .2s linear;
    will-change: transform;
  }

  .{{ root_class }}.carat-guide--flat .carat-guide__base {
    display: none;
  }

  .{{ root_class }} .carat-guide__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to bottom,
      rgba(0,0,0,calc(var(--carat-scrim) * 0.9)) 0%,
      rgba(0,0,0,0) 38%,
      rgba(0,0,0,0) 58%,
      rgba(0,0,0,calc(var(--carat-scrim) * 0.75)) 100%);
  }

  .{{ root_class }} .carat-guide__overlay {
    position: absolute;
    inset-inline: 0;
    {% if section.settings.overlay_position == 'bottom' %}bottom: calc(var(--carat-track-inset) * 3);{% elsif section.settings.overlay_position == 'center' %}top: 50%; transform: translateY(-50%);{% else %}top: var(--carat-track-inset);{% endif %}
    padding-inline: var(--carat-track-inset);
    text-align: {{ section.settings.overlay_alignment }};
    pointer-events: none;
  }

  .{{ root_class }} .carat-guide__heading {
    margin: 0;
    font-size: var(--carat-heading-size);
    font-weight: var(--carat-heading-weight);
    letter-spacing: var(--carat-heading-tracking);
    line-height: 1.15;
    {% if section.settings.heading_transform != 'theme' %}text-transform: {{ section.settings.heading_transform }};{% endif %}
    color: var(--carat-heading-color, #fff);
  }

  .{{ root_class }} .carat-guide__subheading {
    margin: .4em 0 0;
    font-size: var(--carat-subheading-size);
    font-style: {{ section.settings.subheading_style }};
    line-height: 1.35;
    color: var(--carat-subheading-color, rgba(255,255,255,.86));
  }

  .{{ root_class }} .carat-guide__track {
    position: absolute;
    left: var(--carat-track-inset);
    right: var(--carat-track-inset);
    bottom: var(--carat-track-inset);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--carat-step-gap);
    padding: calc(var(--carat-step-gap) / 2);
    border-radius: var(--carat-track-radius);
    background: var(--carat-track-bg, rgba(255,255,255,.82));
    backdrop-filter: blur(6px);
  }

  .{{ root_class }} .carat-guide__step {
    flex: 0 0 auto;
    min-width: calc(var(--carat-step-size) * 2.1);
    height: calc(var(--carat-step-size) * 2.1);
    padding-inline: calc(var(--carat-step-size) / 2);
    border: 0;
    border-radius: var(--carat-track-radius);
    background: transparent;
    font: inherit;
    font-size: var(--carat-step-size);
    line-height: 1;
    letter-spacing: .02em;
    color: var(--carat-step-color, #1c1c1c);
    cursor: pointer;
    transition: background-color .18s ease, color .18s ease;
  }

  .{{ root_class }} .carat-guide__step:hover {
    background: rgba(0,0,0,.06);
  }

  .{{ root_class }} .carat-guide__step.is-active {
    background: var(--carat-step-active-bg, #1c1c1c);
    color: var(--carat-step-active-color, #fff);
  }

  .{{ root_class }} .carat-guide__step:focus-visible {
    outline: 2px solid var(--carat-step-active-bg, #1c1c1c);
    outline-offset: 2px;
  }

  .{{ root_class }} .carat-guide__readout {
    position: absolute;
    left: var(--carat-track-inset);
    right: var(--carat-track-inset);
    bottom: calc(var(--carat-track-inset) + var(--carat-step-size) * 2.1 + var(--carat-step-gap) * 1.6);
    margin: 0;
    text-align: center;
    font-size: var(--carat-readout-size);
    letter-spacing: .06em;
    color: var(--carat-readout-color, #fff);
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .{{ root_class }} {
      --carat-heading-size: {{ section.settings.heading_size | times: 0.72 | round }}px;
      --carat-step-size: {{ section.settings.step_size | times: 0.86 | round }}px;
      --carat-step-gap: {{ section.settings.step_gap | times: 0.6 | round }}px;
      --carat-track-inset: {{ section.settings.track_inset | times: 0.6 | round }}px;
    }
    .{{ root_class }} .carat-guide__track {
      overflow-x: auto;
      justify-content: flex-start;
      scrollbar-width: none;
    }
    .{{ root_class }} .carat-guide__track::-webkit-scrollbar { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .{{ root_class }} .carat-guide__ring { transition: none; }
  }
{% endstyle %}

{%- if section.blocks.size > 0 -%}
  {%- comment -%} Fall back through picker, assets folder, then a plain URL: most of the
    catalogue's imagery is wired by URL because the products are not published to the
    Online Store, so a picker alone would leave the tile empty. {%- endcomment -%}
  {%- capture section_base_url -%}
    {%- if section.settings.base_image != blank -%}
      {{ section.settings.base_image | image_url: width: 1600 }}
    {%- elsif section.settings.base_image_asset != blank -%}
      {{ section.settings.base_image_asset | asset_url }}
    {%- else -%}
      {{ section.settings.base_image_url }}
    {%- endif -%}
  {%- endcapture -%}
  {%- assign section_base_url = section_base_url | strip -%}

  <div
    class="carat-guide {{ root_class }}"
    data-carat-guide
    data-default-shape="{{ default_shape }}"
    data-shape-option-index="{{ shape_option_index }}"
    data-carat-caption="{{ section.settings.readout_text | escape }}"
    {{ section.shopify_attributes }}
  >
    <div class="carat-guide__inner">
      <figure class="carat-guide__tile">
        <img class="carat-guide__base" data-carat-base src="{% if section_base_url != blank %}{{ section_base_url }}{% else %}data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7{% endif %}" alt="" loading="lazy" decoding="async" width="1600" height="1600">
        <img class="carat-guide__ring" data-carat-ring src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" alt="" loading="lazy" decoding="async" width="1400" height="1400">
        {%- if section.settings.scrim > 0 -%}<div class="carat-guide__scrim"></div>{%- endif -%}

        <div class="carat-guide__overlay">
          {%- if section.settings.heading != blank -%}
            <h2 class="carat-guide__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="carat-guide__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.readout_text != blank -%}
          <figcaption class="carat-guide__readout" data-carat-readout>
            {{- section.settings.readout_text | replace: '[ct]', initial_carat | escape -}}
          </figcaption>
        {%- endif -%}

        <div class="carat-guide__track" role="radiogroup" aria-label="{{ section.settings.track_label | escape }}">
          {%- for label in step_labels -%}
            {%- assign step_label = label | strip -%}
            {%- if step_label == blank -%}{%- continue -%}{%- endif -%}
            {%- assign is_active = false -%}
            {%- if step_label == initial_carat -%}{%- assign is_active = true -%}{%- endif -%}
            <button
              type="button"
              class="carat-guide__step{% if is_active %} is-active{% endif %}"
              role="radio"
              aria-checked="{% if is_active %}true{% else %}false{% endif %}"
              tabindex="{% if is_active %}0{% else %}-1{% endif %}"
              data-carat-step
              data-carat-value="{{ step_label | times: 1.0 }}"
              data-carat-label="{{ step_label | escape }}"
            >
              {{- step_label | escape -}}
            </button>
          {%- endfor -%}
        </div>
      </figure>
    </div>

    <script type="application/json" data-carat-shapes>
      {
      {%- for block in section.blocks -%}
        {%- capture block_base_url -%}
          {%- if block.settings.base_image != blank -%}
            {{ block.settings.base_image | image_url: width: 1600 }}
          {%- elsif block.settings.base_image_asset != blank -%}
            {{ block.settings.base_image_asset | asset_url }}
          {%- elsif block.settings.base_image_url != blank -%}
            {{ block.settings.base_image_url }}
          {%- else -%}
            {{ section_base_url }}
          {%- endif -%}
        {%- endcapture -%}
        {%- assign block_base_url = block_base_url | strip -%}

        {{ block.settings.shape | json }}: {
          "base": {{ block_base_url | json }},
          "originX": {{ block.settings.origin_x }},
          "originY": {{ block.settings.origin_y }},
          "width": {{ block.settings.ring_width }},
          "alt": {{ block.settings.alt_text | json }},
          "anchors": [
          {%- assign anchor_keys = '1,2,3' | split: ',' -%}
          {%- assign written = 0 -%}
          {%- for key in anchor_keys -%}
            {%- liquid
              case key
                when '1'
                  assign anchor_image = block.settings.anchor_1_image
                  assign anchor_asset = block.settings.anchor_1_asset
                  assign anchor_url = block.settings.anchor_1_url
                  assign anchor_carat = block.settings.anchor_1_carat
                when '2'
                  assign anchor_image = block.settings.anchor_2_image
                  assign anchor_asset = block.settings.anchor_2_asset
                  assign anchor_url = block.settings.anchor_2_url
                  assign anchor_carat = block.settings.anchor_2_carat
                else
                  assign anchor_image = block.settings.anchor_3_image
                  assign anchor_asset = block.settings.anchor_3_asset
                  assign anchor_url = block.settings.anchor_3_url
                  assign anchor_carat = block.settings.anchor_3_carat
              endcase
            -%}
            {%- capture anchor_src -%}
              {%- if anchor_image != blank -%}
                {{ anchor_image | image_url: width: 1400 }}
              {%- elsif anchor_asset != blank -%}
                {{ anchor_asset | asset_url }}
              {%- else -%}
                {{ anchor_url }}
              {%- endif -%}
            {%- endcapture -%}
            {%- assign anchor_src = anchor_src | strip -%}
            {%- if anchor_src != blank and anchor_carat > 0 -%}
              {%- if written > 0 -%},{%- endif -%}
              {"ct": {{ anchor_carat }}, "src": {{ anchor_src | json }}}
              {%- assign written = written | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
          ]
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
      }
    </script>
  </div>

  <script src="{{ 'carat-size-guide.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Carat size guide",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Centre Stone Carat Size Guide" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "*The setting in the image is for reference only" },
    { "type": "text", "id": "readout_text", "label": "Caption under the heading", "default": "Shown with [ct] ct", "info": "[ct] is replaced with the carat the customer has pressed. Leave blank to hide it." },
    { "type": "text", "id": "track_label", "label": "Carat track label for screen readers", "default": "Centre stone carat weight" },
    { "type": "select", "id": "overlay_position", "label": "Text position", "default": "top", "options": [ { "value": "top", "label": "Top" }, { "value": "center", "label": "Centre" }, { "value": "bottom", "label": "Bottom" } ] },
    { "type": "select", "id": "overlay_alignment", "label": "Text alignment", "default": "center", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ] },

    { "type": "header", "content": "Typography" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "rgba(0,0,0,0)", "info": "Clear a colour to use the theme default." },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 12, "max": 64, "step": 1, "unit": "px", "default": 28 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "600", "options": [ { "value": "inherit", "label": "Theme default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" } ] },
    { "type": "range", "id": "heading_tracking", "label": "Heading letter spacing", "min": 0, "max": 24, "step": 1, "unit": "%", "default": 0 },
    { "type": "select", "id": "heading_transform", "label": "Heading case", "default": "theme", "options": [ { "value": "theme", "label": "Theme default" }, { "value": "uppercase", "label": "UPPERCASE" }, { "value": "none", "label": "As typed" }, { "value": "capitalize", "label": "Title Case" } ] },
    { "type": "color", "id": "subheading_color", "label": "Subheading colour", "default": "rgba(0,0,0,0)" },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 8, "max": 28, "step": 1, "unit": "px", "default": 13 },
    { "type": "select", "id": "subheading_style", "label": "Subheading style", "default": "normal", "options": [ { "value": "normal", "label": "Upright" }, { "value": "italic", "label": "Italic" } ] },
    { "type": "color", "id": "readout_color", "label": "Caption colour", "default": "rgba(0,0,0,0)" },
    { "type": "range", "id": "readout_size", "label": "Caption size", "min": 8, "max": 28, "step": 1, "unit": "px", "default": 13 },

    { "type": "header", "content": "Carat track" },
    { "type": "text", "id": "carat_steps", "label": "Carat steps", "default": "1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0", "info": "Comma separated, written exactly as they should appear on the track." },
    { "type": "text", "id": "default_carat", "label": "Carat selected first", "default": "1.0", "info": "Must match one of the steps above character for character." },
    { "type": "color", "id": "track_background", "label": "Track background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "step_color", "label": "Step text colour", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "step_active_background", "label": "Selected step background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "step_active_color", "label": "Selected step text colour", "default": "rgba(0,0,0,0)" },
    { "type": "range", "id": "step_size", "label": "Step text size", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "step_gap", "label": "Space between steps", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "track_radius", "label": "Track corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0, "info": "The theme is square-cornered, so this starts at 0. Raise it for the pill look." },
    { "type": "range", "id": "track_inset", "label": "Track inset from the tile edge", "min": 4, "max": 60, "step": 2, "unit": "px", "default": 20 },

    { "type": "header", "content": "Tile" },
    { "type": "select", "id": "aspect_ratio", "label": "Tile shape", "default": "1/1", "options": [ { "value": "1/1", "label": "Square" }, { "value": "4/5", "label": "Portrait (4:5)" }, { "value": "3/4", "label": "Tall (3:4)" }, { "value": "5/4", "label": "Landscape (5:4)" }, { "value": "16/9", "label": "Wide (16:9)" } ] },
    { "type": "color", "id": "tile_background", "label": "Tile background", "default": "rgba(0,0,0,0)", "info": "Shows behind the photo while it loads." },
    { "type": "range", "id": "tile_radius", "label": "Tile corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "scrim", "label": "Darkening behind the text", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35, "info": "Keeps white text legible over a pale hand shot. 0 removes it." },
    { "type": "select", "id": "image_fit", "label": "Hand photo fit", "default": "cover", "options": [ { "value": "cover", "label": "Fill the tile" }, { "value": "contain", "label": "Fit inside the tile" } ] },
    { "type": "select", "id": "image_position", "label": "Hand photo focus", "default": "center", "options": [ { "value": "center", "label": "Centre" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },

    { "type": "header", "content": "Fallback hand photo", "info": "Used by any shape block that has no hand photo of its own. One pose serves every shape." },
    { "type": "image_picker", "id": "base_image", "label": "Hand photo" },
    { "type": "text", "id": "base_image_asset", "label": "Hand photo file name (fallback)", "info": "A file already in the theme's assets folder, e.g. carat-guide-hand.webp." },
    { "type": "text", "id": "base_image_url", "label": "Hand photo URL (fallback)", "info": "Only used when neither of the two above is set." },

    { "type": "header", "content": "Section layout" },
