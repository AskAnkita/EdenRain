{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: image
  assign image_alt = section.settings.image_alt | default: image.alt | default: section.settings.heading
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
-%}

<section
  class="editorial-image-cta editorial-image-cta--{{ section.id }} color-{{ section.settings.color_scheme }}"
  style="
    --editorial-background: {{ section.settings.background_color }};
    --editorial-text: {{ section.settings.text_color }};
    --editorial-max-width: {{ section.settings.max_width }}px;
    --editorial-gap: {{ section.settings.column_gap }}px;
    --editorial-image-radius: {{ section.settings.image_radius }}px;
    --editorial-padding-top: {{ section.settings.padding_top }}px;
    --editorial-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="editorial-image-cta__inner{% if section.settings.image_position == 'right' %} editorial-image-cta__inner--reverse{% endif %}">
    <div class="editorial-image-cta__media">
      {%- if image != blank -%}
        <picture>
          {%- if mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 750 }} 750w,
                {{ mobile_image | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{
            image
            | image_url: width: 1800
            | image_tag:
              loading: 'lazy',
              widths: '750, 990, 1200, 1500, 1800, 2200',
              sizes: '(min-width: 1200px) 58vw, (min-width: 750px) 56vw, 100vw',
              alt: image_alt,
              class: 'editorial-image-cta__image'
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'editorial-image-cta__placeholder' }}
      {%- endif -%}
    </div>

    <div class="editorial-image-cta__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="editorial-image-cta__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="editorial-image-cta__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if button_label != blank -%}
        <a
          class="editorial-image-cta__button"
          {% if button_link != blank %}
            href="{{ button_link }}"
          {% else %}
            role="link" aria-disabled="true"
          {% endif %}
        >
          {{ button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .editorial-image-cta {
    width: 100%;
    background: var(--editorial-background);
    color: var(--editorial-text);
  }

  .editorial-image-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(320px, 0.82fr);
    gap: var(--editorial-gap);
    align-items: center;
    width: min(100%, var(--editorial-max-width));
    margin: 0 auto;
    padding: var(--editorial-padding-top) 56px var(--editorial-padding-bottom);
  }

  .editorial-image-cta__inner--reverse {
    grid-template-columns: minmax(320px, 0.82fr) minmax(0, 1.18fr);
  }

  .editorial-image-cta__inner--reverse .editorial-image-cta__media {
    order: 2;
  }

  .editorial-image-cta__media {
    min-width: 0;
  }

  .editorial-image-cta__media picture {
    display: block;
    overflow: hidden;
    aspect-ratio: 1.19 / 1;
    border-radius: var(--editorial-image-radius);
  }

  .editorial-image-cta__image,
  .editorial-image-cta__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--editorial-image-radius);
    object-fit: cover;
  }

  .editorial-image-cta__placeholder {
    background: rgba(0, 0, 0, 0.04);
  }

  .editorial-image-cta__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 32px 16px;
  }

  .editorial-image-cta__heading {
    max-width: 620px;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(28px, 2.35vw, 48px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .editorial-image-cta__text {
    max-width: 680px;
    margin-top: 34px;
    font-family: var(--font-body--family);
    font-size: clamp(15px, 1vw, 20px);
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.04em;
  }

  .editorial-image-cta__text p {
    margin: 0;
  }

  .editorial-image-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 250px;
    min-height: 64px;
    margin-top: 54px;
    padding: 16px 36px;
    border: 2px solid currentColor;
    border-radius: 999px;
    color: inherit;
    font-family: var(--font-body--family);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .editorial-image-cta__button:hover {
    background: var(--editorial-text);
    color: var(--editorial-background);
    transform: translateY(-1px);
  }

  @media screen and (max-width: 989px) {
    .editorial-image-cta__inner {
      grid-template-columns: 1fr;
      gap: 38px;
      padding-inline: 28px;
    }

    .editorial-image-cta__inner--reverse {
      grid-template-columns: 1fr;
    }

    .editorial-image-cta__inner--reverse .editorial-image-cta__media {
      order: 0;
    }

    .editorial-image-cta__content {
      padding: 0 10px;
    }

    .editorial-image-cta__text {
      margin-top: 22px;
    }

    .editorial-image-cta__button {
      margin-top: 34px;
    }
  }

  @media screen and (max-width: 749px) {
    .editorial-image-cta__inner {
      padding-right: 16px;
      padding-left: 16px;
    }

    .editorial-image-cta__media picture,
    .editorial-image-cta__placeholder {
      aspect-ratio: 4 / 5;
    }

    .editorial-image-cta__heading {
      font-size: clamp(24px, 8vw, 34px);
      line-height: 1.22;
    }

    .editorial-image-cta__button {
      width: min(100%, 280px);
      min-width: 0;
      min-height: 56px;
      padding: 14px 26px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial image CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stella McCartney in MiaDonna"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>See Stella McCartney shining in MiaDonna Lab-Grown Diamonds.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See the look"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#213431"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 1000,
      "max": 2200,
      "step": 20,
      "unit": "px",
      "default": 1920
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 24,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Editorial image CTA"
    }
  ]
}
{% endschema %}
