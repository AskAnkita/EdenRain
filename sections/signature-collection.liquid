{% comment %}
  Signature collection: an editorial campaign grid.
  Each tile is a full-bleed image with overlaid text - a display line, an italic line,
  an optional outlined word, a small call to action and four corner captions.
{% endcomment %}

{%- liquid
  assign transparent = 'rgba(0,0,0,0)'
  assign root_class = 'signature-editorial-' | append: section.id
-%}

{%- capture root_style -%}
  --sig-gap: {{ section.settings.gap }}px;
  --sig-ratio-w: {{ section.settings.aspect_ratio | split: '/' | first }};
  --sig-ratio-h: {{ section.settings.aspect_ratio | split: '/' | last }};
  --sig-pad: {{ section.settings.tile_padding }}px;
  --sig-columns: {{ section.settings.columns_desktop }};
  --sig-columns-tablet: {{ section.settings.columns_tablet }};
  --sig-columns-mobile: {{ section.settings.columns_mobile }};
  --sig-display-size: {{ section.settings.display_size }}px;
  --sig-subtitle-size: {{ section.settings.subtitle_size }}px;
  --sig-script-size: {{ section.settings.script_size }}px;
  --sig-caption-size: {{ section.settings.caption_size | default: 14 }}px;
  --sig-meta-size: {{ section.settings.meta_size }}px;
  --sig-button-size: {{ section.settings.button_size }}px;
  --sig-boxed-size: {{ section.settings.boxed_size }}px;
  {% if section.settings.section_background != blank and section.settings.section_background != transparent %}--sig-section-bg: {{ section.settings.section_background }};{% endif %}
  {% if section.settings.heading_color != blank and section.settings.heading_color != transparent %}--sig-heading-color: {{ section.settings.heading_color }};{% endif %}
  {% if section.settings.description_color != blank and section.settings.description_color != transparent %}--sig-description-color: {{ section.settings.description_color }};{% endif %}
  --sig-padding-top: {{ section.settings.padding_top }}px;
  --sig-padding-bottom: {{ section.settings.padding_bottom }}px;
  --sig-page-padding: {{ section.settings.page_padding }}px;
  --sig-ratio-stacked: {{ section.settings.stacked_ratio }};
  --sig-intro-gap: {{ section.settings.intro_gap }}px;
  --sig-description-width: {{ section.settings.description_width }}%;
  --sig-viewport-height: {{ section.settings.viewport_height }}svh;
  --sig-radius: {{ section.settings.tile_radius }}px;
  --sig-bento-height: {{ section.settings.bento_height }}px;
  --sig-bento-center: {{ section.settings.bento_center_ratio | divided_by: 100.0 }}fr;
  --sig-bento-right: {{ section.settings.bento_right_ratio | divided_by: 100.0 }}fr;
{%- endcapture -%}

{% style %}
  .{{ root_class }} {
    padding: var(--sig-padding-top) var(--sig-page-padding) var(--sig-padding-bottom);
    background: var(--sig-section-bg, transparent);
  }

  .{{ root_class }} .signature-editorial__intro {
    max-width: 72rem;
    margin: 0 auto 3.2rem;
    text-align: {{ section.settings.heading_alignment }};
  }

  .{{ root_class }} .signature-editorial__eyebrow {
    margin: 0 0 1rem;
    font-size: var(--sig-meta-size);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sig-description-color, inherit);
  }

  {%- comment -%}
    The intro keeps the theme's own h2 and rte typography unless a setting overrides it:
    "Theme default" case and 0% tracking emit nothing, so --font-h2--case/-letter-spacing
    still win and the heading matches every other section heading on the page.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__heading {
    margin: 0;
    color: var(--sig-heading-color, inherit);
    {% if section.settings.heading_transform != 'theme' %}text-transform: {{ section.settings.heading_transform }};{% endif %}
    {% if section.settings.heading_tracking > 0 %}letter-spacing: {{ section.settings.heading_tracking | divided_by: 100.0 }}em;{% endif %}
    {% if section.settings.heading_weight != 'inherit' %}font-weight: {{ section.settings.heading_weight }};{% endif %}
    {% if section.settings.heading_line_height > 0 %}line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};{% endif %}
    {% if section.settings.heading_size > 0 %}font-size: clamp(1.4rem, 4vw, {{ section.settings.heading_size }}px);{% endif %}
  }

  .{{ root_class }} .signature-editorial__description {
    margin: var(--sig-intro-gap) auto 0;
    max-width: var(--sig-description-width);
    color: var(--sig-description-color, inherit);
    {% if section.settings.description_tracking > 0 %}letter-spacing: {{ section.settings.description_tracking | divided_by: 100.0 }}em;{% endif %}
    {% if section.settings.description_line_height > 0 %}line-height: {{ section.settings.description_line_height | divided_by: 100.0 }};{% endif %}
    {% if section.settings.description_size > 0 %}font-size: {{ section.settings.description_size }}px;{% endif %}
  }

  .{{ root_class }} .signature-editorial__grid {
    display: grid;
    grid-template-columns: repeat(var(--sig-columns), minmax(0, 1fr));
    gap: var(--sig-gap);
  }

  {%- comment -%}
    "One screen" mode: the grid itself is given the screen height and its rows split it
    equally, so the tiles stop taking their height from an aspect ratio. Anything above the
    grid (an intro, the section's own padding) adds to that, which is why this pairs with
    zero padding when the grid is meant to be exactly one screen. Phones keep the aspect
    ratios - six tiles squeezed into one screen would be unreadable - so this starts at the
    desktop breakpoint - a two-column tablet grid would have five rows to fit into one
    screen, which leaves every tile a letterbox.
  {%- endcomment -%}
  @media screen and (min-width: 990px) {
    .{{ root_class }}.signature-editorial--viewport .signature-editorial__grid {
      min-height: var(--sig-viewport-height);
      grid-auto-rows: minmax(0, 1fr);
    }

    .{{ root_class }}.signature-editorial--viewport .signature-editorial__tile {
      aspect-ratio: auto;
      height: 100%;
      min-height: 0;
    }
  }

  {%- comment -%}
    The theme is square-cornered everywhere, so this starts at 0 and only rounds when
    the setting is turned up - the corner stays a decision in the editor, not a default.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__tile {
    position: relative;
    display: block;
    aspect-ratio: var(--sig-ratio-w) / var(--sig-ratio-h);
    border-radius: var(--sig-radius, 0);
    overflow: hidden;
    background: var(--sig-tile-bg, #e9e5e0);
    color: var(--sig-text, #ffffff);
    isolation: isolate;
  }

  .{{ root_class }} .signature-editorial__tile--product {
    display: flex;
    flex-direction: column;
    align-self: start;
    aspect-ratio: auto;
    background: #ffffff;
    color: #1a1a1a;
  }

  .{{ root_class }} .signature-editorial__product-image-link {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f7f7f6;
  }

  .{{ root_class }} .signature-editorial__product-image {
    display: block;
    width: 100%;
    height: 100%;
    padding: 8%;
    box-sizing: border-box;
    object-fit: contain;
    transition: transform 0.45s ease;
  }

  .{{ root_class }} .signature-editorial__tile--product:hover .signature-editorial__product-image {
    transform: scale(1.04);
  }

  .{{ root_class }} .signature-editorial__product-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
    padding: 1.6rem 1.8rem 1.8rem;
  }

  .{{ root_class }} .signature-editorial__product-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1.45rem, 1.5vw, 1.8rem);
    line-height: 1.35;
    font-weight: var(--font-heading--weight, 400);
  }

  .{{ root_class }} .signature-editorial__product-title a {
    color: inherit;
    text-decoration: none;
  }

  .{{ root_class }} .signature-editorial__product-title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .{{ root_class }} .signature-editorial__product-price {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.4;
  }

  .{{ root_class }} .signature-editorial__product-action {
    display: inline-block;
    margin-top: 0.25rem;
    color: inherit;
    font-size: 1.1rem;
    letter-spacing: 0.1em;
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-transform: uppercase;
  }

  {%- comment -%}
    A tile holding one cell drops to the section's smaller tile text, so six of them don't all
    shout at once; a tile that spans keeps full size. Which is to say: "is this tile small?" is
    the span class, so CSS answers it and the markup doesn't work a number out per tile.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__tile {
    --sig-text-scale: {{ section.settings.small_text_scale | divided_by: 100.0 }};
  }

  .{{ root_class }} .signature-editorial__tile--span {
    --sig-text-scale: 1;
  }

  {%- comment -%}
    Mosaic: a tile can take two columns, two rows or both. A spanning tile drops its own
    aspect ratio and takes its height from the rows the plain 1-up tiles have already set,
    so a 2x2 hero next to two stacked squares lines up exactly.
  {%- endcomment -%}
  {%- if section.settings.columns_desktop > 1 %}
  .{{ root_class }} .signature-editorial__tile--wide,
  .{{ root_class }} .signature-editorial__tile--feature {
    grid-column: span 2;
  }

  .{{ root_class }} .signature-editorial__tile--tall,
  .{{ root_class }} .signature-editorial__tile--feature {
    grid-row: span 2;
  }

  {%- comment -%}
    A spanning tile states its own shape rather than leaning on its neighbours: a row holding
    nothing but the hero (which is what happens at tablet width) would otherwise collapse.
    Two columns and two rows keep the base shape; wide and tall double one side of it.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__tile--wide {
    aspect-ratio: calc(var(--sig-ratio-w) * 2) / var(--sig-ratio-h);
  }

  .{{ root_class }} .signature-editorial__tile--tall {
    aspect-ratio: var(--sig-ratio-w) / calc(var(--sig-ratio-h) * 2);
  }
  {%- endif %}

  .{{ root_class }} .signature-editorial__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--sig-object-position, center);
    z-index: 0;
    transform: scale(var(--sig-image-scale, 1));
    transform-origin: var(--sig-object-position, center);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .{{ root_class }} .signature-editorial__video {
    display: block;
    border: 0;
    background: var(--sig-tile-bg, transparent);
  }

  {%- if section.settings.hover_zoom -%}
  .{{ root_class }} .signature-editorial__tile:hover .signature-editorial__image,
  .{{ root_class }} .signature-editorial__tile:focus-within .signature-editorial__image {
    transform: scale(calc(var(--sig-image-scale, 1) * 1.05));
  }
  {%- endif -%}

  .{{ root_class }} .signature-editorial__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--sig-scrim, #000000);
    opacity: var(--sig-overlay-opacity, 0);
    pointer-events: none;
  }

  .{{ root_class }} .signature-editorial__link {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
    text-indent: -9999px;
    overflow: hidden;
  }

  .{{ root_class }} .signature-editorial__meta {
    position: absolute;
    z-index: 3;
    margin: 0;
    max-width: 50%;
    font-size: var(--sig-tile-meta-size, var(--sig-meta-size));
    letter-spacing: 0.04em;
    line-height: 1.3;
    color: var(--sig-meta-color, var(--sig-text, #ffffff));
    pointer-events: none;
  }

  {%- if section.settings.caption_rule -%}
  {%- comment -%}
    A hairline trailing the caption, as in "01 / CURATED ---". Inline-block so it sits on
    the text's own baseline box rather than needing the caption to become a flex row.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__meta--tl::after {
    content: "";
    display: inline-block;
    width: 18px;
    height: 1px;
    margin-left: 10px;
    background: currentColor;
    opacity: 0.6;
    vertical-align: middle;
  }
  {%- endif -%}

  {%- comment -%}
    A ringed top right caption, for a single glyph rather than words - the box is sized in
    em so the ring grows with whatever caption size the tile is set to.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__meta--ring {
    display: grid;
    place-items: center;
    width: 2.4em;
    height: 2.4em;
    max-width: none;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.55;
    text-align: center;
    line-height: 1;
  }

  .{{ root_class }} .signature-editorial__meta--tl { top: var(--sig-pad); left: var(--sig-pad); }
  .{{ root_class }} .signature-editorial__meta--tr { top: var(--sig-pad); right: var(--sig-pad); text-align: right; }
  .{{ root_class }} .signature-editorial__meta--bl { bottom: var(--sig-pad); left: var(--sig-pad); }
  .{{ root_class }} .signature-editorial__meta--br { bottom: var(--sig-pad); right: var(--sig-pad); text-align: right; }

  .{{ root_class }} .signature-editorial__content {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    padding: calc(var(--sig-pad) * 2.2) var(--sig-pad);
    box-sizing: border-box;
    pointer-events: none;
  }

  .{{ root_class }} .signature-editorial__content > div {
    width: var(--sig-content-width, 74%);
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  {%- comment -%}
    The words and the call to action are two groups rather than one list, so a style can
    space them or align them apart from each other without the markup changing per tile.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__text {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    min-width: 0;
  }

  .{{ root_class }} .signature-editorial__actions {
    display: flex;
    align-items: center;
    gap: clamp(12px, 2.1vw, 25px);
    flex-wrap: wrap;
  }

  {%- comment -%}
    The rule under the second link is drawn rather than underlined, which is what lets it
    be animated: it sits there in full, as two halves, and closes into the centre while the
    link is hovered - the same underline as every other link in the theme.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__link-2 {
    position: relative;
    display: inline-block;
    color: inherit;
    font-size: var(--sig-tile-button-size, var(--sig-button-size));
    text-decoration: none;
    white-space: nowrap;
  }

  .{{ root_class }} .signature-editorial__link-2::before,
  .{{ root_class }} .signature-editorial__link-2::after {
    content: "";
    position: absolute;
    bottom: -0.2em;
    width: 50%;
    height: 1px;
    background: currentColor;
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .{{ root_class }} .signature-editorial__link-2::before {
    left: 0;
    transform-origin: right center;
  }

  .{{ root_class }} .signature-editorial__link-2::after {
    right: 0;
    transform-origin: left center;
  }

  .{{ root_class }} .signature-editorial__link-2:hover::before,
  .{{ root_class }} .signature-editorial__link-2:focus-visible::before,
  .{{ root_class }} .signature-editorial__link-2:hover::after,
  .{{ root_class }} .signature-editorial__link-2:focus-visible::after {
    transform: scaleX(0);
  }

  .{{ root_class }} .signature-editorial__content a {
    pointer-events: auto;
  }

  .{{ root_class }} .signature-editorial__content.is-top > div { align-self: start; }
  .{{ root_class }} .signature-editorial__content.is-middle > div { align-self: center; }
  .{{ root_class }} .signature-editorial__content.is-bottom > div { align-self: end; }
  .{{ root_class }} .signature-editorial__content.is-left > div { justify-self: start; align-items: flex-start; text-align: left; }
  .{{ root_class }} .signature-editorial__content.is-center > div { justify-self: center; align-items: center; text-align: center; }
  .{{ root_class }} .signature-editorial__content.is-right > div { justify-self: end; align-items: flex-end; text-align: right; }

  .{{ root_class }} .signature-editorial__display {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight, 400);
    font-size: clamp(1.6rem, 4.2vw, calc(var(--sig-tile-display-size, var(--sig-display-size)) * var(--sig-text-scale, 1)));
    line-height: 1.05;
    letter-spacing: var(--sig-display-tracking, 0.06em);
    text-transform: var(--sig-display-transform, uppercase);
  }

  {%- comment -%}
    The subtitle normally tucks under the display line. "Above" turns it into an eyebrow
    instead - one flex order away, since the two already share a column.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__display em {
    font-style: italic;
    font-weight: inherit;
  }

  .{{ root_class }} .signature-editorial__subtitle {
    order: var(--sig-subtitle-order, 0);
    margin: var(--sig-subtitle-margin, -0.6rem) 0 0;
    font-family: var(--font-heading--family);
    font-size: clamp(1rem, 1.8vw, calc(var(--sig-tile-subtitle-size, var(--sig-subtitle-size)) * var(--sig-text-scale, 1)));
    line-height: 1.3;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  {%- comment -%}
    The theme's own pairing is a display serif for headings and a sans for body copy, so a
    standfirst under a serif heading wants the body face - this line can take either.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__script {
    margin: 0;
    font-family: var(--sig-script-family, var(--font-heading--family));
    font-style: var(--sig-script-style, italic);
    font-size: clamp(1.1rem, 2.4vw, calc(var(--sig-tile-script-size, var(--sig-script-size)) * var(--sig-text-scale, 1)));
    line-height: var(--sig-script-leading, 1.35);
    letter-spacing: 0.01em;
    color: var(--sig-muted, inherit);
  }

  .{{ root_class }} .signature-editorial__subtitle {
    color: var(--sig-muted, inherit);
  }

  {%- comment -%}
    "Label" caption: the house tile caption, the same uppercase sans the category tiles use,
    so a photo tile here reads like a photo tile there. Only the picture tiles take it - the
    text card's line is a standfirst sentence, which would be unreadable set in capitals.
  {%- endcomment -%}
  .{{ root_class }}.signature-editorial--caption-label .signature-editorial__tile:not(.signature-editorial__tile--text) .signature-editorial__script {
    font-family: var(--sig-script-family, var(--font-body--family));
    font-style: normal;
    font-weight: 600;
    {%- comment -%}
      One size for every label, deliberately: it ignores both the tile's own script size and
      the smaller-tile scale, because a caption that changes size tile to tile stops reading
      as a set. "Caption size" in the schema moves all of them together.
    {%- endcomment -%}
    font-size: var(--sig-caption-size, 14px);
    letter-spacing: 0.16em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  {%- comment -%}
    The caption carries the theme's underline: two halves meeting in the middle, drawn in
    into the centre while the tile is hovered. Inline-block so the rule tracks the words
    rather than the column, and a wrapping caption keeps the rule under its last line.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__script {
    position: relative;
    display: inline-block;
    padding-bottom: 0.45em;
  }

  .{{ root_class }} .signature-editorial__tile--text .signature-editorial__script {
    display: block;
    padding-bottom: 0;
  }

  .{{ root_class }} .signature-editorial__tile:not(.signature-editorial__tile--text) .signature-editorial__script::before,
  .{{ root_class }} .signature-editorial__tile:not(.signature-editorial__tile--text) .signature-editorial__script::after {
    position: absolute;
    bottom: 0;
    width: 50%;
    height: 1px;
    background: currentColor;
    content: "";
    transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .{{ root_class }} .signature-editorial__tile:not(.signature-editorial__tile--text) .signature-editorial__script::before {
    left: 0;
    transform-origin: right center;
  }

  .{{ root_class }} .signature-editorial__tile:not(.signature-editorial__tile--text) .signature-editorial__script::after {
    right: 0;
    transform-origin: left center;
  }

  .{{ root_class }} .signature-editorial__tile:not(.signature-editorial__tile--text):hover .signature-editorial__script::before,
  .{{ root_class }} .signature-editorial__tile:not(.signature-editorial__tile--text):focus-within .signature-editorial__script::before,
  .{{ root_class }} .signature-editorial__tile:not(.signature-editorial__tile--text):hover .signature-editorial__script::after,
  .{{ root_class }} .signature-editorial__tile:not(.signature-editorial__tile--text):focus-within .signature-editorial__script::after {
    transform: scaleX(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .{{ root_class }} .signature-editorial__script::before,
    .{{ root_class }} .signature-editorial__script::after {
      transition: none;
    }
  }

  .{{ root_class }} .signature-editorial__boxed {
    display: inline-block;
    padding: 0.35em 0.75em;
    border: 1px solid var(--sig-box-border, currentColor);
    background: var(--sig-box-background, transparent);
    color: var(--sig-box-color, inherit);
    font-family: var(--font-heading--family);
    font-size: clamp(1rem, 2.2vw, calc(var(--sig-tile-boxed-size, var(--sig-boxed-size)) * var(--sig-text-scale, 1)));
    line-height: 1.2;
    letter-spacing: 0.02em;
  }

  .{{ root_class }} .signature-editorial__button {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
    text-decoration: none;
    font-size: var(--sig-tile-button-size, var(--sig-button-size));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1;
    transition: opacity 0.25s ease;
  }

  .{{ root_class }} .signature-editorial__button:hover {
    opacity: 0.82;
  }

  .{{ root_class }} .signature-editorial__button-label {
    padding: 0.85em 1.4em;
    background: var(--sig-button-bg, #ffffff);
    color: var(--sig-button-text, #1a1a1a);
    white-space: nowrap;
  }

  .{{ root_class }} .signature-editorial__button-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 2.9em;
    padding: 0 0.6em;
    background: var(--sig-button-icon-bg, #1a1a1a);
    color: var(--sig-button-icon-text, #ffffff);
  }

  .{{ root_class }} .signature-editorial__button-icon svg {
    width: 1.1em;
    height: 1.1em;
  }

  {%- comment -%}
    The third call to action: none at all. A photograph tile carries no written button and
    no ring - the whole tile is already the link, so the caption alone does the asking, set
    across the middle of the tile with its rule under it. The button is left out of the
    markup rather than hidden here, so there is nothing to style for a picture tile.
  {%- endcomment -%}
  .{{ root_class }}.signature-editorial--cta-circle .signature-editorial__content {
    padding: calc(var(--sig-pad) * 2.2) var(--sig-pad) var(--sig-pad);
  }

  .{{ root_class }}.signature-editorial--cta-circle .signature-editorial__tile:not(.signature-editorial__tile--text) .signature-editorial__content > div {
    width: 100%;
    justify-self: center;
    align-items: center;
    text-align: center;
    gap: 1.2rem;
  }

  .{{ root_class }}.signature-editorial--cta-circle .signature-editorial__tile:not(.signature-editorial__tile--text) .signature-editorial__text {
    width: 100%;
    align-items: center;
    text-align: center;
  }

  {%- comment -%}
    A text card is the exception: it has no photograph behind it, so it keeps its written
    button and its left-aligned stack even while the picture tiles are running caption only.
  {%- endcomment -%}
  .{{ root_class }}.signature-editorial--cta-circle .signature-editorial__tile--text .signature-editorial__content > div {
    flex-direction: column;
    align-items: flex-start;
  }

  .{{ root_class }}.signature-editorial--cta-circle .signature-editorial__tile--text .signature-editorial__button {
    width: auto;
    height: auto;
    display: inline-block;
    border: 0;
    border-radius: 0;
    text-align: center;
  }

  {%- comment -%}
    One solid block of colour with the words centred in it - no arrow and no second tone, so
    the padding is what gives the button its size.
  {%- endcomment -%}
  .{{ root_class }}.signature-editorial--cta-circle .signature-editorial__tile--text .signature-editorial__button-label {
    display: block;
    position: static;
    width: auto;
    height: auto;
    padding: 1.55em 2.8em;
    overflow: visible;
    clip-path: none;
    background: var(--sig-button-bg, #000000);
    color: var(--sig-button-text, #ffffff);
    {%- comment -%}
      The outline is an inset shadow rather than a border so it is already there, under the
      fill, and hovering only empties the block - the button never changes size.
    {%- endcomment -%}
    box-shadow: inset 0 0 0 1px var(--sig-button-bg, #000000);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .{{ root_class }}.signature-editorial--cta-circle .signature-editorial__tile--text .signature-editorial__button-icon {
    display: none;
  }

  .{{ root_class }}.signature-editorial--cta-circle .signature-editorial__tile--text .signature-editorial__button:hover {
    opacity: 1;
    transform: none;
    background: transparent;
  }

  .{{ root_class }}.signature-editorial--cta-circle .signature-editorial__tile--text .signature-editorial__button:hover .signature-editorial__button-label {
    background-color: transparent;
    color: var(--sig-button-bg, #000000);
  }

  {%- comment -%}
    The plain alternative to the two-tone button: the label alone, underlined, in the tile's
    own text colour. The arrow and both blocks of colour go, so the tile reads as one line of
    text and one link.
  {%- endcomment -%}
  .{{ root_class }}.signature-editorial--cta-link .signature-editorial__button {
    display: inline-block;
    color: inherit;
  }

  .{{ root_class }}.signature-editorial--cta-link .signature-editorial__button-label {
    display: inline-block;
    padding: 0;
    background: none;
    color: inherit;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.3em;
  }

  .{{ root_class }}.signature-editorial--cta-link .signature-editorial__button-icon {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .{{ root_class }} .signature-editorial__grid {
      grid-template-columns: repeat(var(--sig-columns-tablet), minmax(0, 1fr));
    }

    .{{ root_class }} .signature-editorial__tile {
      --sig-pad: 16px;
    }

    {%- if section.settings.columns_tablet < 2 %}
    .{{ root_class }} .signature-editorial__tile--span {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: var(--sig-ratio-stacked);
      height: auto;
    }
    {%- endif %}
  }

  @media screen and (max-width: 749px) {
    .{{ root_class }} {
      padding-inline: min(var(--sig-page-padding), 16px);
    }

    .{{ root_class }} .signature-editorial__grid {
      grid-template-columns: repeat(var(--sig-columns-mobile), minmax(0, 1fr));
      gap: max(8px, calc(var(--sig-gap) / 2));
    }

    .{{ root_class }} .signature-editorial__content > div {
      width: min(100%, calc(var(--sig-content-width, 74%) + 18%));
      gap: 0.9rem;
    }

    .{{ root_class }} .signature-editorial__meta {
      font-size: max(9px, calc(var(--sig-tile-meta-size, var(--sig-meta-size)) * 0.85));
    }

    .{{ root_class }} .signature-editorial__button {
      font-size: max(9px, calc(var(--sig-tile-button-size, var(--sig-button-size)) * 0.9));
    }

    .{{ root_class }} .signature-editorial__product-info {
      padding: 1.2rem;
    }

    .{{ root_class }} .signature-editorial__product-title {
      font-size: 1.35rem;
    }

    {%- comment -%}
      One column on a phone, so the mosaic flattens: every tile takes the stacked shape and
      the text goes back to full size - nothing is "small" when it fills the screen.
    {%- endcomment -%}
    {%- if section.settings.columns_mobile < 2 %}
    .{{ root_class }} .signature-editorial__tile--span {
      grid-column: auto;
      grid-row: auto;
      aspect-ratio: var(--sig-ratio-stacked);
      height: auto;
    }

    .{{ root_class }} .signature-editorial__tile {
      --sig-text-scale: 1;
    }
    {%- endif %}
  }

  @media (prefers-reduced-motion: reduce) {
    .{{ root_class }} .signature-editorial__image {
      transition: none;
    }

    .{{ root_class }} .signature-editorial__link-2::before,
    .{{ root_class }} .signature-editorial__link-2::after {
      transition: none;
    }
  }

  {%- comment -%}
    Bento: instead of a flow of equal tiles, five named areas on a 3 x 12 grid - a full
    height tile on the left, a short text card over a tall media tile in the middle, and
    two unequal tiles on the right. The row counts are settings, so the two splits (where
    the text card ends, where the right column divides) are moved in the editor; both are
    written out as plain line numbers here rather than calc() on a custom property, which
    grid-row does not take everywhere.
  {%- endcomment -%}
  {%- if section.settings.layout_mode == 'bento' -%}
    {%- liquid
      assign bento_text_rows = section.settings.bento_text_rows
      assign bento_text_next = bento_text_rows | plus: 1
      assign bento_right_split = section.settings.bento_right_split
      assign bento_right_next = bento_right_split | plus: 1
    -%}

  {%- comment -%}
    A text card has no photograph to sit on, so its content comes out of the absolute
    overlay and back into flow: that is what lets the card keep its height once the grid
    flattens on a phone. Relative, not static, so it still stacks over the tile link.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__tile--text {
    background: var(--sig-tile-bg, #ece7e1);
  }

  {%- comment -%}
    "Smaller tile text" exists to stop six equal tiles all shouting at once. The bento has
    no equal tiles - the three big areas carry the headlines - so those keep full size and
    only the two right-hand tiles step down.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__tile--bento-left,
  .{{ root_class }} .signature-editorial__tile--bento-center-top,
  .{{ root_class }} .signature-editorial__tile--bento-center-bottom {
    --sig-text-scale: 1;
  }

  .{{ root_class }} .signature-editorial__tile--text .signature-editorial__content {
    position: relative;
    inset: auto;
    z-index: 3;
    height: 100%;
    padding: calc(var(--sig-pad) * 1.3) var(--sig-pad);
  }

  .{{ root_class }} .signature-editorial__tile--text .signature-editorial__content > div {
    gap: 0.9rem;
    height: 100%;
  }

  {%- comment -%}
    On a text card the button is the last thing in the column, so "margin-top: auto" is all
    it takes to drop it to the foot of the card and leave the heading at the top.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__tile--text .signature-editorial__actions {
    margin-top: auto;
  }

  {%- comment -%}
    The flourish: one outlined circle bleeding off the top right corner. Decoration only,
    so it is drawn behind the words and takes no clicks.
  {%- endcomment -%}
  .{{ root_class }} .signature-editorial__tile--flourish::before {
    content: "";
    position: absolute;
    top: -140px;
    right: -95px;
    width: 230px;
    height: 230px;
    border: 1px solid currentColor;
    border-radius: 50%;
    opacity: 0.12;
    pointer-events: none;
    z-index: 1;
  }

  @media screen and (min-width: 990px) {
    .{{ root_class }}.signature-editorial--bento .signature-editorial__grid {
      grid-template-columns: 1fr var(--sig-bento-center) var(--sig-bento-right);
      grid-template-rows: repeat(12, minmax(0, 1fr));
      grid-auto-rows: minmax(0, calc(var(--sig-bento-height) / 3));
      min-height: var(--sig-bento-height);
    }

    .{{ root_class }}.signature-editorial--bento .signature-editorial__tile {
      aspect-ratio: auto;
      height: 100%;
      min-height: 0;
    }

    {%- comment -%}
      "One screen" is written after the bento's own height and with a class more, so the
      two height settings cannot fight: pick one screen and the bento fills it instead.
    {%- endcomment -%}
    .{{ root_class }}.signature-editorial--bento.signature-editorial--viewport .signature-editorial__grid {
      min-height: var(--sig-viewport-height);
    }

    .{{ root_class }} .signature-editorial__tile--bento-left {
      grid-column: 1;
      grid-row: 1 / -1;
    }

    .{{ root_class }} .signature-editorial__tile--bento-center-top {
      grid-column: 2;
      grid-row: 1 / {{ bento_text_next }};
    }

    .{{ root_class }} .signature-editorial__tile--bento-center-bottom {
      grid-column: 2;
      grid-row: {{ bento_text_next }} / -1;
    }

    .{{ root_class }} .signature-editorial__tile--bento-right-top {
      grid-column: 3;
      grid-row: 1 / {{ bento_right_next }};
    }

    .{{ root_class }} .signature-editorial__tile--bento-right-bottom {
      grid-column: 3;
      grid-row: {{ bento_right_next }} / -1;
    }

    {%- comment -%}
      A sixth tile and beyond has no area of its own, so it drops into an implicit row
      under the five - a third of the bento's height each - rather than disappearing.
    {%- endcomment -%}
    .{{ root_class }} .signature-editorial__tile--bento-extra {
      grid-column: auto;
      grid-row: auto;
    }
  }

  {%- comment -%}
    Tablet: three columns of different widths will not fit, so the bento folds to two -
    the left tile keeps its full height beside the middle pair, and the right pair takes
    the row underneath.
  {%- endcomment -%}
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .{{ root_class }}.signature-editorial--bento .signature-editorial__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .{{ root_class }}.signature-editorial--bento .signature-editorial__tile--bento-left {
      grid-column: 1;
      grid-row: span 2;
      aspect-ratio: var(--sig-ratio-w) / calc(var(--sig-ratio-h) * 2);
    }

    .{{ root_class }}.signature-editorial--bento .signature-editorial__tile--bento-center-top,
    .{{ root_class }}.signature-editorial--bento .signature-editorial__tile--bento-center-bottom {
      grid-column: 2;
    }
  }

  @media screen and (max-width: 749px) {
    .{{ root_class }}.signature-editorial--bento .signature-editorial__tile {
      aspect-ratio: var(--sig-ratio-stacked);
    }
  }

  {%- comment -%}
    The text card is the one tile with nothing to hold a shape open, so it takes its
    height from its own words at every width below the desktop grid.
  {%- endcomment -%}
  @media screen and (max-width: 989px) {
    .{{ root_class }}.signature-editorial--bento .signature-editorial__tile--text {
      aspect-ratio: auto;
      height: auto;
      grid-row: auto;
    }
  }
  {%- endif -%}
{% endstyle %}

{%- comment -%}
  The theme lays every section out on a three-column grid - margin, page width, margin -
  and drops the section's content in the middle column. "force-full-width" is the theme's
  own hook for spanning all three (assets/base.css), so "Full width" runs the grid to the
  edges of the screen and only "Side padding" holds it off them.
{%- endcomment -%}
<div class="{{ root_class }} signature-editorial color-{{ section.settings.color_scheme }}{% if section.settings.layout_mode == 'bento' %} signature-editorial--bento{% endif %}{% if section.settings.height_mode == 'viewport' %} signature-editorial--viewport{% endif %}{% unless section.settings.cta_style == 'button' %} signature-editorial--cta-{{ section.settings.cta_style }}{% endunless %}{% unless section.settings.caption_style == 'editorial' %} signature-editorial--caption-{{ section.settings.caption_style }}{% endunless %}{% if section.settings.width == 'full' %} force-full-width{% endif %}" style="{{ root_style | strip_newlines }}">
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank -%}
    <div class="signature-editorial__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="signature-editorial__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="signature-editorial__heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="signature-editorial__description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="signature-editorial__grid">
    {%- for block in section.blocks -%}
      {%- liquid
        comment
          Bento mode places every tile by name. "Auto" takes the name from the block's own
          position, so the five areas fill in the order the blocks are listed and nothing
          has to be set by hand; a tile past the fifth drops into the overflow row.
        endcomment
        assign is_bento = false
        if section.settings.layout_mode == 'bento'
          assign is_bento = true
        endif
        assign bento_area = block.settings.bento_area
        if is_bento and bento_area == 'auto'
          case forloop.index
            when 1
              assign bento_area = 'left'
            when 2
              assign bento_area = 'center-top'
            when 3
              assign bento_area = 'center-bottom'
            when 4
              assign bento_area = 'right-top'
            when 5
              assign bento_area = 'right-bottom'
            else
              assign bento_area = 'extra'
          endcase
        endif
        if is_bento and bento_area == 'hidden'
          continue
        endif

        comment
          A text card is the bento's one tile with no picture: a flat panel of colour
          carrying the eyebrow, the heading and a link. It is a choice per tile rather
          than a block type of its own, so the same tile can go back to being a photo.
        endcomment
        assign is_text_card = block.settings.text_card
        comment
          A text card puts its content in the flow rather than under the full tile link,
          so when it has a button of its own the full tile link is dropped: two overlapping
          links to the same place is one tab stop too many.
        endcomment
        assign text_card_linked = false
        if is_text_card and block.settings.button_label != blank
          assign text_card_linked = true
        endif

        assign tile_product = block.settings.product
        assign tile_image = block.settings.image
        if tile_image == blank and tile_product != blank
          assign tile_image = tile_product.featured_image
        endif
        comment
          A file name under assets/ is kept apart from a pasted URL: the first can go through
          the CDN resizer and carry a srcset, the second can only be printed as it was given.
        endcomment
        assign tile_image_url = block.settings.image_url
        assign tile_asset = ''
        if tile_image == blank and block.settings.image_asset != blank
          assign tile_asset = block.settings.image_asset | strip
        endif
        if tile_image == blank and tile_asset == blank and tile_image_url == blank
          assign tile_image = section.settings.default_image
          if tile_image == blank and section.settings.default_image_asset != blank
            assign tile_asset = section.settings.default_image_asset | strip
          endif
        endif

        comment
          A video stands in for the image rather than beside it, so the image settings above
          are still read: whichever one resolves becomes the poster frame.
        endcomment
        assign tile_video = block.settings.video
        assign tile_video_url = block.settings.video_url | strip
        assign tile_has_video = false
        if tile_video != blank or tile_video_url != blank
          assign tile_has_video = true
        endif
        assign tile_poster = ''
        if tile_has_video
          if tile_image != blank
            assign tile_poster = tile_image | image_url: width: 1400
          elsif tile_asset != blank
            assign tile_poster = tile_asset | asset_img_url: '1400x'
          elsif tile_image_url != blank
            assign tile_poster = tile_image_url
          elsif tile_video != blank
            assign tile_poster = tile_video.preview_image | image_url: width: 1400
          endif
        endif
        assign tile_video_autoplay = block.settings.video_autoplay
        assign tile_video_muted = block.settings.video_muted
        if tile_video_autoplay
          assign tile_video_muted = true
        endif

        assign tile_link = block.settings.link
        if tile_link == blank and tile_product != blank
          assign tile_link = tile_product.url
        endif

        assign tile_alt = block.settings.image_alt
        if tile_alt == blank
          assign tile_alt = block.settings.display_text | default: block.settings.script_text
        endif

        assign meta_tl = block.settings.meta_top_left
        assign meta_tr = block.settings.meta_top_right
        if block.settings.use_section_meta
          assign meta_tl = meta_tl | default: section.settings.default_meta_left
          assign meta_tr = meta_tr | default: section.settings.default_meta_right
        endif

        assign text_color = block.settings.text_color
        if text_color == blank or text_color == transparent
          if block.settings.text_theme == 'dark'
            assign text_color = '#1a1a1a'
          else
            assign text_color = '#ffffff'
          endif
        endif

        comment
          The circle call to action fills with the tile's ink on hover, so the arrow has to
          flip to whatever reads against that ink - white on a dark tile, near black on a
          light one. Working it out here keeps the arrow visible whichever text colour the
          tile was given.
        endcomment
        assign text_brightness = text_color | color_brightness
        if text_brightness > 150
          assign button_contrast = '#1a1a1a'
        else
          assign button_contrast = '#ffffff'
        endif

        comment
          Only the tiles that take extra room keep the full type size; the 1-up tiles step
          down to the section's "smaller tile text" so six tiles don't all shout at once.
        endcomment
        comment
          A picked product fills the tile's picture and link. Showing it as a card instead -
          cropped image, title, price, "View product" - is a choice per tile, because a card
          cannot carry the overlaid headline or take a mosaic tile's extra columns.
        endcomment
        assign show_product_card = false
        if tile_product != blank and block.settings.product_card
          assign show_product_card = true
        endif

        assign tile_size = block.settings.tile_size

        comment
          The scrim is one paint: either a flat wash of the overlay colour or a gradient that
          only darkens (or lightens) the edge the text sits on, so the photograph stays clean
          everywhere else. Liquid already knows which was chosen, so it writes one property.
        endcomment
        assign scrim_opacity = block.settings.overlay_opacity
        assign scrim_paint = block.settings.overlay_color
        if scrim_paint == transparent
          assign scrim_paint = ''
        endif
        if block.settings.scrim_style == 'none'
          assign scrim_opacity = 0
        elsif block.settings.scrim_style == 'gradient'
          assign scrim_opacity = scrim_opacity | times: 24 | divided_by: 10 | at_most: 85
          comment
            The gradient fades in from the edge the text sits on. The vertical position names
            that edge, except when the text is centred vertically, when the horizontal one does.
          endcomment
          assign scrim_edge = block.settings.position_vertical
          if scrim_edge == 'middle'
            assign scrim_edge = block.settings.position_horizontal
          endif
          case scrim_edge
            when 'top'
              assign scrim_direction = 'to bottom'
            when 'left'
              assign scrim_direction = 'to right'
            when 'right'
              assign scrim_direction = 'to left'
            else
              assign scrim_direction = 'to top'
          endcase
          assign scrim_paint = 'linear-gradient(' | append: scrim_direction | append: ', ' | append: block.settings.overlay_color | append: ' 0%, ' | append: block.settings.overlay_color | append: ' 22%, transparent 72%)'
        elsif block.settings.scrim_style == 'ends'
          comment
            Both ends at once: the photograph is shaded lightly where the corner caption sits
            and harder where the title sits, and left completely alone through the middle.
            The top is the same colour at a third of the strength, which is one colour_modify
            rather than a second picker to keep in step with the first.
          endcomment
          assign scrim_opacity = scrim_opacity | times: 24 | divided_by: 10 | at_most: 95
          assign scrim_top = block.settings.overlay_color | color_modify: 'alpha', 0.38
          assign scrim_paint = 'linear-gradient(180deg, ' | append: scrim_top | append: ' 0%, transparent 29%, transparent 52%, ' | append: block.settings.overlay_color | append: ' 100%)'
        endif
      -%}

      {%- capture tile_style -%}
        --sig-text: {{ text_color }};
        --sig-button-contrast: {{ button_contrast }};
        --sig-object-position: {{ block.settings.object_position }};
        --sig-image-scale: {{ block.settings.image_scale | divided_by: 100.0 }};
        --sig-content-width: {{ block.settings.content_width }}%;
        --sig-display-transform: {{ block.settings.display_transform }};
        --sig-display-tracking: {{ block.settings.display_tracking | divided_by: 100.0 }}em;
        --sig-script-style: {{ block.settings.script_style }};
        {% if block.settings.subtitle_position == 'above' %}--sig-subtitle-order: -1; --sig-subtitle-margin: 0;{% endif %}
        {% if block.settings.script_font == 'body' %}--sig-script-family: var(--font-body--family);{% endif %}
        {% if block.settings.script_line_height > 0 %}--sig-script-leading: {{ block.settings.script_line_height | divided_by: 100.0 }};{% endif %}
        {% if block.settings.muted_color != blank and block.settings.muted_color != transparent %}--sig-muted: {{ block.settings.muted_color }};{% endif %}
        {% if block.settings.meta_color != blank and block.settings.meta_color != transparent %}--sig-meta-color: {{ block.settings.meta_color }};{% endif %}
        {% if block.settings.tile_background != blank and block.settings.tile_background != transparent %}--sig-tile-bg: {{ block.settings.tile_background }};{% endif %}
        --sig-overlay-opacity: {{ scrim_opacity | divided_by: 100.0 }};
        {% if scrim_paint != blank %}--sig-scrim: {{ scrim_paint }};{% endif %}
        {% if block.settings.display_size > 0 %}--sig-tile-display-size: {{ block.settings.display_size }}px;{% endif %}
        {% if block.settings.subtitle_size > 0 %}--sig-tile-subtitle-size: {{ block.settings.subtitle_size }}px;{% endif %}
        {% if block.settings.script_size > 0 %}--sig-tile-script-size: {{ block.settings.script_size }}px;{% endif %}
        {% if block.settings.boxed_size > 0 %}--sig-tile-boxed-size: {{ block.settings.boxed_size }}px;{% endif %}
        {% if block.settings.meta_size > 0 %}--sig-tile-meta-size: {{ block.settings.meta_size }}px;{% endif %}
        {% if block.settings.button_size > 0 %}--sig-tile-button-size: {{ block.settings.button_size }}px;{% endif %}
        {% if block.settings.box_border_color != blank and block.settings.box_border_color != transparent %}--sig-box-border: {{ block.settings.box_border_color }};{% endif %}
        {% if block.settings.box_background != blank and block.settings.box_background != transparent %}--sig-box-background: {{ block.settings.box_background }};{% endif %}
        {% if block.settings.box_text_color != blank and block.settings.box_text_color != transparent %}--sig-box-color: {{ block.settings.box_text_color }};{% endif %}
        {% if block.settings.button_background != blank and block.settings.button_background != transparent %}--sig-button-bg: {{ block.settings.button_background }};{% endif %}
        {% if block.settings.button_text_color != blank and block.settings.button_text_color != transparent %}--sig-button-text: {{ block.settings.button_text_color }};{% endif %}
        {% if block.settings.button_icon_background != blank and block.settings.button_icon_background != transparent %}--sig-button-icon-bg: {{ block.settings.button_icon_background }};{% endif %}
        {% if block.settings.button_icon_color != blank and block.settings.button_icon_color != transparent %}--sig-button-icon-text: {{ block.settings.button_icon_color }};{% endif %}
      {%- endcapture -%}

      <article class="signature-editorial__tile{% if is_text_card %} signature-editorial__tile--text{% if block.settings.text_card_flourish %} signature-editorial__tile--flourish{% endif %}{% endif %}{% if is_bento %} signature-editorial__tile--bento-{{ bento_area }}{% endif %}{% if show_product_card %} signature-editorial__tile--product{% elsif is_bento == false %}{% unless tile_size == 'normal' %} signature-editorial__tile--span signature-editorial__tile--{{ tile_size }}{% endunless %}{% endif %}" style="{{ tile_style | strip_newlines }}" {{ block.shopify_attributes }}>
        {%- if show_product_card -%}
          <a class="signature-editorial__product-image-link" href="{{ tile_product.url }}" aria-label="View {{ tile_product.title | escape }}">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'signature-editorial__product-image',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                  widths: '400, 600, 800, 1000, 1200',
                  alt: tile_product.title
              }}
            {%- endif -%}
          </a>
          <div class="signature-editorial__product-info">
            <h3 class="signature-editorial__product-title"><a href="{{ tile_product.url }}">{{ tile_product.title | escape }}</a></h3>
            {%- if tile_product.price_min > 0 -%}
              <p class="signature-editorial__product-price">From {{ tile_product.price_min | money }}</p>
            {%- endif -%}
            <a class="signature-editorial__product-action" href="{{ tile_product.url }}">View product</a>
          </div>
        {%- else -%}
        {%- unless is_text_card -%}
        {%- if tile_has_video -%}
          <video
            class="signature-editorial__image signature-editorial__video"
            {% if tile_poster != blank %}poster="{{ tile_poster }}"{% endif %}
            {% if tile_video_autoplay %}autoplay{% endif %}
            {% if tile_video_muted %}muted{% endif %}
            {% if block.settings.video_loop %}loop{% endif %}
            {% if block.settings.video_controls %}controls{% endif %}
            playsinline
            preload="{% if tile_video_autoplay %}auto{% else %}metadata{% endif %}"
            width="1200"
            height="1200"
            aria-label="{{ tile_alt | escape }}"
          >
            {%- if tile_video != blank -%}
              {%- comment -%} mp4 is put first: it is the one source every browser here can play. {%- endcomment -%}
              {%- for source in tile_video.sources -%}
                {%- if source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endif -%}
              {%- endfor -%}
              {%- for source in tile_video.sources -%}
                {%- unless source.format == 'mp4' -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endunless -%}
              {%- endfor -%}
            {%- else -%}
              <source src="{{ tile_video_url }}" type="video/mp4">
            {%- endif -%}
          </video>
        {%- elsif tile_image != blank -%}
          {{
            tile_image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              class: 'signature-editorial__image',
              sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
              widths: '400, 600, 800, 1000, 1400',
              alt: tile_alt
          }}
        {%- elsif tile_asset != blank -%}
          {%- comment -%} A tile fills a third of a row at most, so the original is never what gets served. {%- endcomment -%}
          <img
            class="signature-editorial__image"
            src="{{ tile_asset | asset_img_url: '900x' }}"
            srcset="{{ tile_asset | asset_img_url: '400x' }} 400w, {{ tile_asset | asset_img_url: '600x' }} 600w, {{ tile_asset | asset_img_url: '900x' }} 900w, {{ tile_asset | asset_img_url: '1400x' }} 1400w"
            sizes="(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw"
            alt="{{ tile_alt | escape }}"
            width="1200"
            height="1200"
            loading="lazy"
          >
        {%- elsif tile_image_url != blank -%}
          <img
            class="signature-editorial__image"
            src="{{ tile_image_url }}"
            alt="{{ tile_alt | escape }}"
            width="1200"
            height="1200"
            loading="lazy"
          >
        {%- endif -%}

        <span class="signature-editorial__scrim"></span>
        {%- endunless -%}

        {%- if tile_link != blank and text_card_linked == false -%}
          <a class="signature-editorial__link" href="{{ tile_link }}">{{ tile_alt | default: 'View' | escape }}</a>
        {%- endif -%}

        {%- if meta_tl != blank -%}<p class="signature-editorial__meta signature-editorial__meta--tl">{{ meta_tl | escape }}</p>{%- endif -%}
        {%- if meta_tr != blank -%}<p class="signature-editorial__meta signature-editorial__meta--tr{% if block.settings.meta_right_ring %} signature-editorial__meta--ring{% endif %}">{{ meta_tr | escape }}</p>{%- endif -%}
        {%- if block.settings.meta_bottom_left != blank -%}<p class="signature-editorial__meta signature-editorial__meta--bl">{{ block.settings.meta_bottom_left | escape }}</p>{%- endif -%}
        {%- if block.settings.meta_bottom_right != blank -%}<p class="signature-editorial__meta signature-editorial__meta--br">{{ block.settings.meta_bottom_right | escape }}</p>{%- endif -%}

        <div class="signature-editorial__content is-{{ block.settings.position_vertical }} is-{{ block.settings.position_horizontal }}">
          <div>
            <div class="signature-editorial__text">
              {%- if block.settings.display_text != blank -%}
                <p class="signature-editorial__display">
                  {{- block.settings.display_text | escape -}}
                  {%- comment -%} The italic line is a second line of the same heading, not a line of its own. {%- endcomment -%}
                  {%- if block.settings.display_italic != blank -%}
                    <br><em>{{ block.settings.display_italic | escape }}</em>
                  {%- endif -%}
                </p>
              {%- endif -%}
              {%- if block.settings.subtitle_text != blank -%}
                <p class="signature-editorial__subtitle">{{ block.settings.subtitle_text | escape }}</p>
              {%- endif -%}
              {%- if block.settings.script_text != blank -%}
                <p class="signature-editorial__script">{{ block.settings.script_text | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if block.settings.boxed_text != blank -%}
                <span class="signature-editorial__boxed">{{ block.settings.boxed_text | escape }}</span>
              {%- endif -%}
            </div>
            {%- comment -%}
              The caption-only style drops the written button from the picture tiles
              altogether - they are a link end to end already - and keeps it on a text card,
              which has no photograph to click.
            {%- endcomment -%}
            {%- assign show_cta_button = false -%}
            {%- if block.settings.button_label != blank -%}
              {%- if section.settings.cta_style != 'circle' or is_text_card -%}
                {%- assign show_cta_button = true -%}
              {%- endif -%}
            {%- endif -%}
            {%- if show_cta_button or block.settings.button_2_label != blank -%}
              <div class="signature-editorial__actions">
                {%- if show_cta_button -%}
                  <a class="signature-editorial__button" href="{{ block.settings.button_link | default: tile_link | default: '#' }}">
                    <span class="signature-editorial__button-label">{{ block.settings.button_label | escape }}</span>
                    <span class="signature-editorial__button-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M4 12h15M13 6l6 6-6 6" stroke-linecap="square"/>
                      </svg>
                    </span>
                  </a>
                {%- endif -%}
                {%- if block.settings.button_2_label != blank -%}
                  <a class="signature-editorial__link-2" href="{{ block.settings.button_2_link | default: tile_link | default: '#' }}">{{ block.settings.button_2_label | escape }}</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Signature collection grid",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "select", "id": "heading_alignment", "label": "Intro alignment", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }, { "value": "right", "label": "Right" } ], "default": "center" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "rgba(0,0,0,0)", "info": "Clear a colour to use the theme default." },
    { "type": "color", "id": "description_color", "label": "Eyebrow and description colour", "default": "rgba(0,0,0,0)" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 0, "max": 80, "step": 1, "unit": "px", "default": 0, "info": "0 keeps the theme default." },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 0, "max": 32, "step": 1, "unit": "px", "default": 0, "info": "0 keeps the theme default." },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "default": "inherit", "options": [ { "value": "inherit", "label": "Theme default" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" } ] },
    { "type": "range", "id": "heading_line_height", "label": "Heading line height", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 0, "info": "0 keeps the theme default." },
    { "type": "range", "id": "description_width", "label": "Description width", "min": 20, "max": 100, "step": 1, "unit": "%", "default": 100 },
    { "type": "range", "id": "description_tracking", "label": "Description letter spacing", "min": 0, "max": 12, "step": 1, "unit": "%", "default": 0 },
    { "type": "range", "id": "description_line_height", "label": "Description line height", "min": 0, "max": 220, "step": 5, "unit": "%", "default": 0 },
    { "type": "range", "id": "intro_gap", "label": "Space under the heading", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 22 },
    { "type": "select", "id": "heading_transform", "label": "Heading case", "options": [ { "value": "theme", "label": "Theme default" }, { "value": "uppercase", "label": "UPPERCASE" }, { "value": "none", "label": "As typed" }, { "value": "capitalize", "label": "Title Case" } ], "default": "theme" },
    { "type": "range", "id": "heading_tracking", "label": "Heading letter spacing", "min": 0, "max": 24, "step": 1, "unit": "%", "default": 0, "info": "0 keeps the theme default." },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout_mode", "label": "Layout", "default": "mosaic", "info": "Bento is a fixed five-area editorial grid: a full-height tile on the left, a text card over a tall media tile in the middle, and two unequal tiles on the right. The column settings below only apply to the mosaic.", "options": [ { "value": "mosaic", "label": "Mosaic grid" }, { "value": "bento", "label": "Editorial bento" } ] },
    { "type": "range", "id": "bento_height", "label": "Bento height", "min": 360, "max": 1000, "step": 20, "unit": "px", "default": 620, "info": "Desktop only. The five areas divide this height between them." },
    { "type": "range", "id": "bento_center_ratio", "label": "Bento middle column width", "min": 80, "max": 260, "step": 5, "unit": "%", "default": 180, "info": "Against the left column, which is always 1." },
    { "type": "range", "id": "bento_right_ratio", "label": "Bento right column width", "min": 60, "max": 200, "step": 5, "unit": "%", "default": 110 },
    { "type": "range", "id": "bento_text_rows", "label": "Bento text card height", "min": 2, "max": 8, "step": 1, "default": 4, "info": "Out of 12. The middle media tile takes what is left." },
    { "type": "range", "id": "bento_right_split", "label": "Bento right column split", "min": 3, "max": 9, "step": 1, "default": 7, "info": "Out of 12. Where the top right tile ends and the bottom right one starts." },

    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns_desktop", "label": "Columns (desktop)", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_tablet", "label": "Columns (tablet)", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 4, "step": 1, "default": 1 },
    { "type": "select", "id": "aspect_ratio", "label": "Tile shape", "options": [ { "value": "1/1", "label": "Square" }, { "value": "4/5", "label": "Portrait (4:5)" }, { "value": "3/4", "label": "Tall (3:4)" }, { "value": "5/4", "label": "Landscape (5:4)" }, { "value": "16/9", "label": "Wide (16:9)" } ], "default": "1/1" },
    { "type": "select", "id": "stacked_ratio", "label": "Tile shape when stacked", "info": "Used for the big tiles once the grid drops to one column.", "options": [ { "value": "1/1", "label": "Square" }, { "value": "4/5", "label": "Portrait (4:5)" }, { "value": "3/4", "label": "Tall (3:4)" }, { "value": "5/4", "label": "Landscape (5:4)" } ], "default": "4/5" },
    { "type": "range", "id": "gap", "label": "Gap between tiles", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "tile_padding", "label": "Inner padding", "min": 8, "max": 60, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "tile_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 0, "info": "The theme is square-cornered, so this starts at 0." },
    { "type": "checkbox", "id": "caption_rule", "label": "Hairline after the top left caption", "default": false },
    { "type": "select", "id": "caption_style", "label": "Tile caption style", "default": "label", "info": "The label is the uppercase caption the category tiles use. Editorial keeps the italic serif line. Either way the caption picks up an underline that draws in from both ends while the tile is hovered. A text card's line is a sentence, so it stays as written.", "options": [ { "value": "label", "label": "Uppercase label" }, { "value": "editorial", "label": "Editorial italic" } ] },
    { "type": "checkbox", "id": "hover_zoom", "label": "Zoom image on hover", "default": true },

    { "type": "header", "content": "Default corner captions", "info": "Used for the top corners of any tile that leaves them empty." },
    { "type": "text", "id": "default_meta_left", "label": "Top left caption", "default": "edenraine.co.uk" },
    { "type": "text", "id": "default_meta_right", "label": "Top right caption", "default": "2025" },

    { "type": "header", "content": "Default text sizes", "info": "Each tile can override these." },
    { "type": "range", "id": "display_size", "label": "Display line", "min": 16, "max": 96, "step": 1, "unit": "px", "default": 44 },
    { "type": "range", "id": "subtitle_size", "label": "Subtitle", "min": 8, "max": 48, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "script_size", "label": "Italic line", "min": 10, "max": 60, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "caption_size", "label": "Tile caption (uppercase label)", "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14, "info": "Used by the uppercase label caption style. One size for every tile, so the per-tile italic line size and the 1-up scale are both ignored." },
    { "type": "range", "id": "boxed_size", "label": "Outlined text", "min": 10, "max": 48, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "meta_size", "label": "Corner captions", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "button_size", "label": "Button text", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 10 },
    { "type": "select", "id": "cta_style", "label": "Call to action style", "default": "button", "info": "A link drops the arrow and both button colours and underlines the label instead. Caption only drops the button from the picture tiles altogether and centres the caption across the tile, which is a link end to end anyway; a text card keeps the written button either way.", "options": [ { "value": "button", "label": "Button with an arrow" }, { "value": "link", "label": "Underlined text link" }, { "value": "circle", "label": "Caption only, centred" } ] },
    { "type": "range", "id": "small_text_scale", "label": "Text size on 1-up tiles", "min": 50, "max": 100, "step": 2, "unit": "%", "default": 100, "info": "Tiles set to a bigger size keep 100%, which is what gives the grid its hierarchy." },

    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "default_image", "label": "Fallback image", "info": "Used by any tile with no image of its own." },
    { "type": "text", "id": "default_image_asset", "label": "Fallback image file name", "info": "A file in the theme's assets folder. Only used when no fallback image is picked." },

    { "type": "header", "content": "Section layout" },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "rgba(0,0,0,0)" },
    { "type": "select", "id": "width", "label": "Section width", "default": "page", "info": "Full width runs the grid to the edges of the screen; \"Side padding\" below is then the only margin.", "options": [ { "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" } ] },
    { "type": "range", "id": "page_padding", "label": "Side padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 30 },
    { "type": "select", "id": "height_mode", "label": "Section height", "default": "auto", "info": "One screen gives the grid the full height of the screen and the tiles fill it instead of holding their shape. Any intro text and the section padding sit on top of that height. Below 990px the tile shape is used instead.", "options": [ { "value": "auto", "label": "From the tile shape" }, { "value": "viewport", "label": "One screen" } ] },
    { "type": "range", "id": "viewport_height", "label": "Screen height to fill", "min": 60, "max": 100, "step": 5, "unit": "%", "default": 100, "info": "Under 100% leaves a sliver of the next section showing." },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Editorial tile",
      "settings": [
        { "type": "header", "content": "Size" },
        { "type": "select", "id": "bento_area", "label": "Bento position", "default": "auto", "info": "Only used when the section layout is set to Editorial bento. Auto fills the five areas in the order the tiles are listed.", "options": [ { "value": "auto", "label": "Auto (by order)" }, { "value": "left", "label": "Left - full height" }, { "value": "center-top", "label": "Middle top - text card" }, { "value": "center-bottom", "label": "Middle bottom - tall media" }, { "value": "right-top", "label": "Right top" }, { "value": "right-bottom", "label": "Right bottom" }, { "value": "extra", "label": "Overflow row underneath" }, { "value": "hidden", "label": "Not shown in the bento" } ] },
        { "type": "checkbox", "id": "text_card_flourish", "label": "Outlined circle in the corner", "default": false, "info": "Decoration for a text card: one thin ring bleeding off the top right corner." },
        { "type": "checkbox", "id": "text_card", "label": "Text card (no image)", "default": false, "info": "Drops the picture, the video and the overlay, and shows the text on a flat panel of the tile background colour instead." },
        { "type": "select", "id": "tile_size", "label": "Tile size", "info": "Bigger tiles need at least two columns; on one column every tile stacks the same.", "options": [ { "value": "normal", "label": "1 column x 1 row" }, { "value": "wide", "label": "2 columns x 1 row" }, { "value": "tall", "label": "1 column x 2 rows" }, { "value": "feature", "label": "Hero - 2 columns x 2 rows" } ], "default": "normal" },

        { "type": "header", "content": "Image" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_asset", "label": "Image file name (fallback)", "info": "A file already in the theme's assets folder, e.g. style-halo-hover.jpg. Only used when no image is picked." },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)", "info": "Only used when neither of the two above is set." },
        { "type": "text", "id": "image_alt", "label": "Image alt text" },
        { "type": "range", "id": "image_scale", "label": "Image zoom", "min": 100, "max": 220, "step": 5, "unit": "%", "default": 100, "info": "Zooms out from the side chosen below, which is how a centred product shot is pushed clear of the text." },
        { "type": "select", "id": "object_position", "label": "Image focus", "options": [ { "value": "center", "label": "Centre" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }, { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ], "default": "center" },
        { "type": "color", "id": "tile_background", "label": "Tile background", "default": "rgba(0,0,0,0)", "info": "Shows behind the image while it loads." },

        { "type": "header", "content": "Video" },
        { "type": "paragraph", "content": "A video takes the image's place on this tile. The image above is still worth setting: it is used as the poster frame while the video loads." },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "text", "id": "video_url", "label": "Video URL (fallback)", "info": "A direct .mp4 link, e.g. a Shopify Files URL. Only used when no video is picked above." },
        { "type": "checkbox", "id": "video_autoplay", "label": "Play automatically", "default": true, "info": "An autoplaying video is always muted; browsers block it otherwise." },
        { "type": "checkbox", "id": "video_loop", "label": "Loop", "default": true },
        { "type": "checkbox", "id": "video_muted", "label": "Mute", "default": true },
        { "type": "checkbox", "id": "video_controls", "label": "Show playback controls", "default": false, "info": "Leave off for a background video; the tile link sits over the whole tile and would swallow the controls." },

        { "type": "header", "content": "Link" },
        { "type": "product", "id": "product", "label": "Product", "info": "Fills the image and link when nothing above is set." },
        { "type": "checkbox", "id": "product_card", "label": "Show the product as a card", "default": false, "info": "Off: the product only supplies the tile's picture, and the tile keeps its headline and mosaic size. On: the tile becomes a product card with the title, price and a link." },
        { "type": "url", "id": "link", "label": "Tile link" },

        { "type": "header", "content": "Text" },
        { "type": "text", "id": "display_text", "label": "Display line", "info": "Large uppercase line, e.g. LUXURY." },
        { "type": "select", "id": "display_transform", "label": "Display line case", "options": [ { "value": "uppercase", "label": "UPPERCASE" }, { "value": "none", "label": "As typed" }, { "value": "capitalize", "label": "Title Case" } ], "default": "uppercase" },
        { "type": "range", "id": "display_tracking", "label": "Display line letter spacing", "min": -8, "max": 24, "step": 1, "unit": "%", "default": 6 },
        { "type": "text", "id": "display_italic", "label": "Display line, second line (italic)", "info": "Set below the first line, in italics, as part of the same heading." },
