{% comment %}
  FAQ band shown above the footer on every page (it lives in the footer group).
  A centred serif heading over a narrow accordion with serif questions and a
  thin plus that turns into a minus when a row is open.
{% endcomment %}

{%- style -%}
  #faq-band-{{ section.id }} {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  #faq-band-{{ section.id }} .faq-band__head {
    max-width: 72rem;
    margin: 0 auto 4rem;
    padding-inline: 2rem;
    text-align: center;
  }

  #faq-band-{{ section.id }} .faq-band__kicker {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground-rgb) / 0.65);
  }

  #faq-band-{{ section.id }} .faq-band__heading {
    margin: 1rem 0 0;
    font-family: var(--font-heading--family);
    font-size: clamp(3rem, 3.2vw, 4.2rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0;
    text-transform: none;
    text-wrap: balance;
  }

  #faq-band-{{ section.id }} .faq-band__list {
    max-width: 86rem;
    margin: 0 auto;
    padding-inline: 2rem;
  }

  #faq-band-{{ section.id }} .faq-band__item {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  #faq-band-{{ section.id }} .faq-band__item:first-child {
    border-top: 1px solid rgb(var(--color-foreground-rgb) / 0.14);
  }

  #faq-band-{{ section.id }} .faq-band__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.4rem;
    padding: 2.4rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-heading--family);
    font-size: clamp(1.9rem, 1.7vw, 2.3rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-foreground);
  }

  #faq-band-{{ section.id }} .faq-band__question::-webkit-details-marker {
    display: none;
  }

  #faq-band-{{ section.id }} .faq-band__question:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 0.4rem;
  }

  #faq-band-{{ section.id }} .faq-band__icon {
    position: relative;
    flex: none;
    width: 1.4rem;
    height: 1.4rem;
  }

  #faq-band-{{ section.id }} .faq-band__icon::before,
  #faq-band-{{ section.id }} .faq-band__icon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s ease;
  }

  #faq-band-{{ section.id }} .faq-band__icon::after {
    transform: rotate(90deg);
  }

  #faq-band-{{ section.id }} details[open] .faq-band__icon::after {
    transform: rotate(0deg);
  }

  #faq-band-{{ section.id }} .faq-band__answer {
    max-width: 68ch;
    padding-bottom: 2.6rem;
    font-family: var(--font-body--family);
    font-size: 1.55rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground-rgb) / 0.75);
  }

  #faq-band-{{ section.id }} .faq-band__answer p {
    margin: 0 0 1.2rem;
  }

  #faq-band-{{ section.id }} .faq-band__answer > :last-child {
    margin-bottom: 0;
  }

  #faq-band-{{ section.id }} .faq-band__answer strong {
    color: var(--color-foreground);
    font-weight: 600;
  }

  #faq-band-{{ section.id }} .faq-band__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #faq-band-{{ section.id }} .faq-band__pills a {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.18);
    border-radius: 999px;
    background: rgb(var(--color-background-rgb) / 1);
    color: var(--color-foreground);
    font-size: 1.4rem;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }

  #faq-band-{{ section.id }} .faq-band__pills a:hover {
    border-color: var(--color-foreground);
    color: var(--color-foreground);
  }

  #faq-band-{{ section.id }} .faq-band__foot {
    margin: 3.6rem 0 0;
    padding-inline: 2rem;
    text-align: center;
    font-family: var(--font-body--family);
    font-size: 1.5rem;
    color: rgb(var(--color-foreground-rgb) / 0.75);
  }

  #faq-band-{{ section.id }} .faq-band__foot a,
  #faq-band-{{ section.id }} .faq-band__foot a:hover {
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  @media screen and (max-width: 749px) {
    #faq-band-{{ section.id }} {
      padding-block: {{ section.settings.padding_top | times: 0.6 | round }}px {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }

    #faq-band-{{ section.id }} .faq-band__head {
      margin-bottom: 2.8rem;
    }

    #faq-band-{{ section.id }} .faq-band__question {
      padding: 1.8rem 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #faq-band-{{ section.id }} .faq-band__icon::before,
    #faq-band-{{ section.id }} .faq-band__icon::after {
      transition: none;
    }
  }
{%- endstyle -%}

<div id="faq-band-{{ section.id }}" class="faq-band color-{{ section.settings.color_scheme }} gradient">
  {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
    <div class="faq-band__head">
      {%- if section.settings.kicker != blank -%}
        <p class="faq-band__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="faq-band__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="faq-band__list">
    {%- for block in section.blocks -%}
      <details class="faq-band__item" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
        <summary class="faq-band__question">
          <span>{{ block.settings.question | escape }}</span>
          <span class="faq-band__icon" aria-hidden="true"></span>
        </summary>
        <div class="faq-band__answer">
          {%- case block.type -%}
            {%- when 'question' -%}
              {{ block.settings.answer }}
            {%- when 'links' -%}
              {%- if block.settings.intro != blank -%}
                {{ block.settings.intro }}
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="faq-band__pills" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
          {%- endcase -%}
        </div>
      </details>
    {%- endfor -%}
  </div>

  {%- if section.settings.footer_text != blank -%}
    <div class="faq-band__foot">{{ section.settings.footer_text }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "FAQ band",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Small heading",
      "default": "Questions, answered"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore the finest lab-grown diamonds"
    },
    {
      "type": "richtext",
      "id": "footer_text",
      "label": "Text under the questions",
      "default": "<p>Still have a question? <a href=\"/pages/contact\" title=\"Contact\">Talk to our team</a></p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are lab-grown diamonds real?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. They have the same chemical, physical and optical properties as mined diamonds.</p>"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    },
    {
      "type": "links",
      "name": "Links",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Heading",
          "default": "Popular searches"
        },
        {
          "type": "richtext",
          "id": "intro",
          "label": "Text above the links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Each menu item shows as a rounded link."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ band",
      "blocks": [
        { "type": "question" },
        { "type": "links" }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
