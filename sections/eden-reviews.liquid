{% liquid
  assign review_count = 0
  assign rating_total = 0
  assign rated_review_count = 0

  for block in section.blocks
    assign review_text = block.settings.review | strip
    assign review_name = block.settings.name | strip

    if review_text != blank and review_text != 'Add a real customer review here.' and review_name != 'Customer name'
      assign review_count = review_count | plus: 1
      if block.settings.stars > 0
        assign rating_total = rating_total | plus: block.settings.stars
        assign rated_review_count = rated_review_count | plus: 1
      endif
    endif
  endfor

  if rated_review_count > 0
    assign average_rating = rating_total | times: 1.0 | divided_by: rated_review_count | round: 1
  endif

  # The scroll bar under the reviews is the one the category tiles and the product
  # carousels use: a near-black fill on a 10% track, unless a colour is picked here.
  assign progress_fill = '#111111'
  assign progress_track = 'rgb(0 0 0 / 0.1)'
  if section.settings.progress_color != blank and section.settings.progress_color != 'rgba(0,0,0,0)'
    assign progress_fill = section.settings.progress_color
    assign progress_track = section.settings.progress_color | color_modify: 'alpha', 0.1
  endif
%}

{%- style -%}
  #fav-{{ section.id }} {
    display: block;
    --fav-gap: {{ section.settings.gap }}px;
    --fav-card-bg: {{ section.settings.card_background }};
    --fav-text-color: {{ section.settings.text_color }};
    --fav-star-color: {{ section.settings.star_color }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    {% if section.settings.section_background != blank and section.settings.section_background != 'rgba(0,0,0,0)' %}
      background-color: {{ section.settings.section_background }};
    {% endif %}
  }

  #fav-{{ section.id }} .fav-inner {
    max-width: {% if section.settings.width == 'page' %}var(--page-width, 160rem){% else %}none{% endif %};
    margin: 0 auto;
    padding-inline: {{ section.settings.page_padding }}px;
  }

  #fav-{{ section.id }} .fav-layout {
    display: flex;
    flex-direction: column;
    gap: 3.2rem;
  }

  #fav-{{ section.id }} .fav-summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    text-align: center;
  }

  #fav-{{ section.id }} .fav-kicker {
    margin: 0 0 1rem;
    color: {{ section.settings.kicker_color }};
    font-family: var(--font-body--family);
    font-size: 1rem;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #fav-{{ section.id }} .fav-heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-family: var(--font-heading--family);
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_tracking | divided_by: 100.0 }}em;
    line-height: 1.16;
    text-transform: {{ section.settings.heading_case }};
    text-wrap: balance;
  }

  #fav-{{ section.id }} .fav-subheading {
    margin: 1.2rem 0 0;
    max-width: 38rem;
    color: {{ section.settings.subheading_color }};
    font-family: var(--font-body--family);
    font-size: {{ section.settings.subheading_size }}px;
    line-height: 1.55;
    text-wrap: pretty;
    margin-inline: auto;
  }

  #fav-{{ section.id }} .fav-rating {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem 1.4rem;
    width: 100%;
    margin-top: 2.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid {{ section.settings.divider_color }};
  }

  #fav-{{ section.id }} .fav-score {
    margin: 0;
    color: var(--fav-text-color);
    font-family: var(--font-heading--family);
    font-size: 5.6rem;
    line-height: 0.95;
  }

  #fav-{{ section.id }} .fav-score span {
    color: {{ section.settings.score_suffix_color }};
    font-family: var(--font-body--family);
    font-size: 1.8rem;
  }

  #fav-{{ section.id }} .fav-stars {
    margin: 0;
    color: var(--fav-star-color);
    font-size: 1.7rem;
    letter-spacing: 0.12em;
    line-height: 1;
  }

  #fav-{{ section.id }} .fav-stars--placeholder { color: {{ section.settings.placeholder_color }}; }
  #fav-{{ section.id }} .fav-score--placeholder { color: {{ section.settings.placeholder_color }}; }

  #fav-{{ section.id }} .fav-count {
    margin: 0;
    color: {{ section.settings.subheading_color }};
    font-family: var(--font-body--family);
    font-size: 1.2rem;
    line-height: 1.45;
  }

  #fav-{{ section.id }} .fav-link {
    display: inline-flex;
    width: fit-content;
    margin-top: 1.8rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid currentColor;
    color: {{ section.settings.link_color }};
    font-family: var(--font-body--family);
    font-size: {{ section.settings.link_size }}px;
    letter-spacing: {{ section.settings.link_tracking | divided_by: 100.0 }}em;
    text-decoration: none;
    text-transform: uppercase;
  }

  #fav-{{ section.id }} .fav-link:hover { border-bottom-width: 2px; }
  #fav-{{ section.id }} .fav-link:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  #fav-{{ section.id }} .fav-reviews-wrap { min-width: 0; align-self: center; width: 100%; }

  #fav-{{ section.id }} .fav-carousel-controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2rem;
    margin-bottom: 1.2rem;
  }

  /* Nothing to scroll: the arrows take themselves out, so the empty row goes too. */
  #fav-{{ section.id }} .fav-carousel-controls:has(.fav-arrows[hidden]) { display: none; }

  #fav-{{ section.id }} .fav-arrows {
    display: flex;
    justify-content: flex-end;
    flex: 0 0 auto;
    gap: 1.5rem;
    min-height: {{ section.settings.arrow_size }}px;
    margin: 0;
  }

  #fav-{{ section.id }} .fav-arrows[hidden] { display: none; }

  #fav-{{ section.id }} .fav-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    padding: 0;
    border: 0;
    background: none;
    color: {{ section.settings.arrow_color }};
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #fav-{{ section.id }} .fav-arrow svg { width: 58%; height: auto; }
  #fav-{{ section.id }} .fav-arrow:disabled { opacity: 0.25; cursor: default; }
  #fav-{{ section.id }} .fav-arrow:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }

  #fav-{{ section.id }} .fav-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * var(--fav-gap)) / 4);
    gap: var(--fav-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }

  #fav-{{ section.id }} .fav-track::-webkit-scrollbar { display: none; }

  #fav-{{ section.id }} .fav-progress-row {
    display: flex;
    justify-content: flex-start;
    margin-top: 2.8rem;
  }

  #fav-{{ section.id }} .fav-progress-row[hidden] { display: none; }

  /* Same bar as the product carousels: a 3px rounded track, left aligned and capped at
     280px, with the travelled share filled in. */
  #fav-{{ section.id }} .fav-progress {
    position: relative;
    flex: 0 1 auto;
    width: 100%;
    max-width: min(280px, calc(100% - 40px));
    height: 3px;
    margin: 0;
    border-radius: 999px;
    overflow: hidden;
    background-color: {{ progress_track }};
  }

  #fav-{{ section.id }} .fav-progress-bar {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background-color: {{ progress_fill }};
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  #fav-{{ section.id }} .fav-card {
    display: flex;
    min-height: 29rem;
    flex-direction: column;
    justify-content: space-between;
    padding: 2.8rem;
    background: var(--fav-card-bg);
    color: var(--fav-text-color);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  #fav-{{ section.id }} .fav-card .fav-stars { font-size: 1.35rem; }

  #fav-{{ section.id }} .fav-quote {
    margin: 1.5rem 0 2rem;
    color: var(--fav-text-color);
    font-family: var(--font-heading--family);
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.5;
    text-wrap: pretty;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
    overflow: hidden;
  }

  #fav-{{ section.id }} .fav-name {
    margin: auto 0 0;
    color: {{ section.settings.name_color }};
    font-family: var(--font-body--family);
    font-size: 1.2rem;
    line-height: 1.4;
  }

  @media screen and (max-width: 989px) {
    #fav-{{ section.id }} .fav-layout { gap: 3rem; }
    #fav-{{ section.id }} .fav-track { grid-auto-columns: calc((100% - var(--fav-gap)) / 2); }
  }

  @media screen and (max-width: 749px) {
    #fav-{{ section.id }} { padding-block: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_bottom_mobile }}px; }
    #fav-{{ section.id }} .fav-inner { padding-inline: {{ section.settings.page_padding_mobile }}px; }
    #fav-{{ section.id }} .fav-layout { gap: 2.4rem; }
    #fav-{{ section.id }} .fav-heading { font-size: {{ section.settings.heading_size_mobile }}px; }
    #fav-{{ section.id }} .fav-rating { flex-direction: row; align-items: center; flex-wrap: wrap; gap: 0.8rem 1rem; margin-top: 1.8rem; }
    #fav-{{ section.id }} .fav-score { font-size: 3.8rem; }
    #fav-{{ section.id }} .fav-score span { font-size: 1.4rem; }
    #fav-{{ section.id }} .fav-link { margin-top: 1.2rem; }
    #fav-{{ section.id }} .fav-carousel-controls { display: none; }
    #fav-{{ section.id }} .fav-track { grid-auto-columns: 86%; }
    #fav-{{ section.id }} .fav-card { min-height: 24rem; padding: 2rem; }
    #fav-{{ section.id }} .fav-progress-row { margin-top: 1.8rem; }
    #fav-{{ section.id }} .fav-progress { flex-basis: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    #fav-{{ section.id }} .fav-track { scroll-behavior: auto; }
  }
{%- endstyle -%}

<script src="{{ 'favourites-carousel.js' | asset_url }}" defer="defer"></script>
<favourites-carousel
    id="fav-{{ section.id }}"
    class="favourites-carousel color-{{ section.settings.color_scheme }}"
    data-loop="{% if section.settings.loop_arrows %}true{% else %}false{% endif %}"
  >
    <div class="fav-inner">
      <div class="fav-layout">
        <div class="fav-summary">
          {%- if section.settings.kicker != blank -%}
            <p class="fav-kicker">{{ section.settings.kicker | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="fav-heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="fav-subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}

          <div class="fav-rating" {% if rated_review_count > 0 %}aria-label="Average rating {{ average_rating }} out of 5 from {{ rated_review_count }} displayed reviews"{% else %}aria-label="Rating summary placeholder"{% endif %}>
            {% if rated_review_count > 0 %}
              <p class="fav-score">{{ average_rating }}<span> / 5</span></p>
              <p class="fav-stars" aria-hidden="true">★★★★★</p>
              <p class="fav-count">Across {{ rated_review_count }} client {% if rated_review_count == 1 %}story{% else %}stories{% endif %}</p>
            {% else %}
              <p class="fav-score fav-score--placeholder">—<span> / 5</span></p>
              <p class="fav-stars fav-stars--placeholder" aria-hidden="true">☆☆☆☆☆</p>
              <p class="fav-count">Rating summary placeholder</p>
            {% endif %}
          </div>

          {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
            <a class="fav-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>

        <div class="fav-reviews-wrap">
          <div class="fav-carousel-controls">
            <div class="fav-arrows">
              <button type="button" class="fav-arrow fav-arrow--prev" aria-label="Previous review" disabled>
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"/></svg>
              </button>
              <button type="button" class="fav-arrow fav-arrow--next" aria-label="Next review">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m9 4 8 8-8 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="square"/></svg>
              </button>
            </div>
          </div>
          <ul class="fav-track" role="list">
            {% if review_count > 0 %}
              {%- for block in section.blocks -%}
                {%- assign review_text = block.settings.review | strip -%}
                {%- assign review_name = block.settings.name | strip -%}
                {%- if review_text != blank and review_text != 'Add a real customer review here.' and review_name != 'Customer name' -%}
                  <li class="fav-card" {{ block.shopify_attributes }}>
                    {%- if block.settings.stars > 0 -%}
                      <p class="fav-stars" aria-label="{{ block.settings.stars }} out of 5 stars">{% for i in (1..5) %}{% if i <= block.settings.stars %}★{% else %}☆{% endif %}{% endfor %}</p>
                    {%- endif -%}
                    <blockquote class="fav-quote">“{{ review_text | escape }}”</blockquote>
                    {%- if review_name != blank -%}
                      <p class="fav-name">{{ review_name | escape }}</p>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {% else %}
              {% for placeholder_review in (1..5) %}
                <li class="fav-card fav-card--placeholder">
                  <p class="fav-stars fav-stars--placeholder" aria-hidden="true">☆☆☆☆☆</p>
                  <blockquote class="fav-quote">Add an approved customer review here.</blockquote>
                  <p class="fav-name">Customer name</p>
                </li>
              {% endfor %}
            {% endif %}
          </ul>
          <div class="fav-progress-row" data-fav-progress aria-hidden="true">
            <div class="fav-progress"><div class="fav-progress-bar" data-fav-bar></div></div>
          </div>
        </div>
      </div>
    </div>
  </favourites-carousel>

{% schema %}
{
  "name": "Eden reviews",
  "class": "section-wrapper",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Editorial summary" },
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Loved by our clients" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little love, from real life." },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 60, "step": 1, "unit": "px", "default": 38 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size on mobile", "min": 22, "max": 44, "step": 1, "unit": "px", "default": 32 },
    { "type": "select", "id": "heading_weight", "label": "Heading weight", "options": [ { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" } ], "default": "400" },
    { "type": "select", "id": "heading_case", "label": "Heading case", "options": [ { "value": "uppercase", "label": "Uppercase" }, { "value": "none", "label": "As typed" } ], "default": "none" },
    { "type": "range", "id": "heading_tracking", "label": "Heading letter spacing", "min": 0, "max": 10, "step": 1, "unit": "%", "default": 0 },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#171714" },
    { "type": "text", "id": "subheading", "label": "Sub-heading (optional)", "default": "Real words from the people wearing their rings every day." },
    { "type": "range", "id": "subheading_size", "label": "Sub-heading size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "color", "id": "subheading_color", "label": "Supporting text colour", "default": "#77736d" },
    { "type": "color", "id": "kicker_color", "label": "Small label colour", "default": "#8a7d74" },
    { "type": "color", "id": "score_suffix_color", "label": "Rating suffix colour", "default": "#8a7d74" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder colour", "default": "#d9cfc7" },
    { "type": "text", "id": "link_label", "label": "Link label (optional)", "info": "Leave empty to hide the link." },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "range", "id": "link_size", "label": "Link size", "min": 10, "max": 18, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "link_tracking", "label": "Link letter spacing", "min": 0, "max": 25, "step": 1, "unit": "%", "default": 14 },
    { "type": "color", "id": "link_color", "label": "Link colour", "default": "#171714" },
    { "type": "checkbox", "id": "loop_arrows", "label": "Loop from last review to first", "default": false },
    { "type": "range", "id": "arrow_size", "label": "Arrow size", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "color", "id": "arrow_color", "label": "Arrow colour", "default": "#171714" },
    { "type": "color", "id": "progress_color", "label": "Progress bar colour (clear it to use the theme's own)", "default": "rgba(0,0,0,0)" },

    { "type": "header", "content": "Review cards" },
    { "type": "range", "id": "gap", "label": "Gap between cards", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Review text colour", "default": "#171714" },
    { "type": "range", "id": "text_size", "label": "Review text size", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "color", "id": "name_color", "label": "Customer name colour", "default": "#8a7d74" },
    { "type": "color", "id": "star_color", "label": "Star colour", "default": "#171714" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "width", "label": "Section width", "options": [ { "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" } ], "default": "full" },
    { "type": "range", "id": "page_padding", "label": "Side padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "range", "id": "page_padding_mobile", "label": "Side padding on mobile", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "color", "id": "section_background", "label": "Section background", "default": "#f4f4f0" },
    { "type": "color", "id": "divider_color", "label": "Divider colour", "default": "#dcd5ca" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding on mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding on mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "select", "id": "color_scheme", "label": "Colour scheme", "options": [ { "value": "scheme-1", "label": "Scheme 1" }, { "value": "scheme-2", "label": "Scheme 2" } ], "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "review", "label": "Review text", "info": "Use only approved customer reviews." },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 0 }
      ]
    }
  ],
  "presets": [
    { "name": "Eden reviews", "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" } ] }
  ]
}
{% endschema %}
