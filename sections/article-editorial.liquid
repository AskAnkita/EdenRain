{% comment %}
  A single article - the clean counterpart to sections/blog-editorial.liquid.

  The stock article template put a category list, a recent-articles widget and a
  placeholder graphic down the left and squeezed the writing into what was left.
  Here the article gets the page: a centred byline, a lead photo wider than the
  text, the body in a readable column, then the previous and next articles and a
  row of the other education guides.

  The body reuses .gp-content from assets/editorial-cards.css, so an article and
  a guide page read exactly the same way.
{% endcomment %}

{{ 'editorial-cards.css' | asset_url | stylesheet_tag }}
<script src="{{ 'editorial-downloads.js' | asset_url }}" defer></script>

{%- liquid
  assign stts = section.settings
  assign columns = stts.columns | default: 4

  assign columns_tablet = 2
  if columns < 2
    assign columns_tablet = columns
  endif

  comment
    Shopify gives no previous/next on the article object, so the blog's own order
    is walked once to find this article's neighbours and to collect the others for
    the "More" row. blog.articles is already newest first.
  endcomment
  comment
    The banner hero: the article's own photo unless the merchant picked another,
    and one line of copy under the title - typed in the editor, or the article's
    own excerpt cut short when nothing was typed.
  endcomment
  assign hero_image = stts.hero_image
  assign hero_asset = blank
  if hero_image == blank
    for guide_block in section.blocks
      if guide_block.settings.link != article.url
        continue
      endif

      assign hero_image = guide_block.settings.hero_image
      if hero_image == blank
        assign hero_asset = guide_block.settings.hero_image_asset | strip
      endif
      if hero_image == blank and hero_asset == blank
        assign hero_image = guide_block.settings.image
      endif
      if hero_image == blank and hero_asset == blank
        assign hero_asset = guide_block.settings.image_asset | strip
      endif
      break
    endfor
  endif
  if hero_image == blank and hero_asset == blank
    assign hero_image = article.image
  endif

  comment
    Find the opening paragraph: the first "<p>...</p>" carrying actual words,
    looked for in the first few paragraph-sized chunks rather than only at
    character nought, because a page may open on a heading, a stray wrapper or
    a picture. Only the paragraph itself is lifted - whatever sits in front of
    it is left exactly where the editor put it.
  endcomment
  assign lead_html = ''
  assign lead_words = ''
  if stts.hero_text_source == 'lift'
    assign lead_chunks = article.content | split: '</p>'
    for chunk in lead_chunks limit: 4
      assign chunk_parts = chunk | split: '<p'
      if chunk_parts.size < 2
        continue
      endif
      assign para_tail = chunk_parts | last
      assign para_html = '<p' | append: para_tail | append: '</p>'
      assign para_words = para_html | strip_html | replace: '&nbsp;', ' ' | replace: ' ', ' ' | strip
      if para_words != blank
        assign lead_html = para_html
        assign lead_words = para_words
        break
      endif
    endfor
  endif

  assign hero_text = stts.hero_text
  if hero_text == blank
    case stts.hero_text_source
      when 'lift'
        assign hero_text = lead_words
      when 'excerpt'
        assign hero_text = article.excerpt_or_content | strip_html | strip | truncatewords: 22
    endcase
  endif

  assign banner_class = 'eg-banner eg-banner--' | append: stts.hero_width
  case stts.hero_align
    when 'left'
      assign banner_class = banner_class | append: ' eg-banner--left'
    when 'bottom'
      assign banner_class = banner_class | append: ' eg-banner--bottom'
    when 'bottom-left'
      assign banner_class = banner_class | append: ' eg-banner--bottom eg-banner--left'
  endcase
  if hero_image == blank and hero_asset == blank
    assign banner_class = banner_class | append: ' eg-banner--plain'
  endif

  assign split_class = 'eg-hero-split eg-hero-split--' | append: stts.hero_width
  if stts.hero_split_flip
    assign split_class = split_class | append: ' eg-hero-split--flipped'
  endif
  if stts.hero_split_mobile == 'picture'
    assign split_class = split_class | append: ' eg-hero-split--picture-first'
  endif
  if hero_image == blank and hero_asset == blank
    assign split_class = split_class | append: ' eg-hero-split--solo'
  endif

  assign scrim_alpha = stts.hero_overlay | divided_by: 100.0
  assign wash_alpha = stts.hero_wash | divided_by: 100.0
  assign pill_alpha = stts.hero_eyebrow_opacity | divided_by: 100.0

  assign prev_article = null
  assign next_article = null
  for item in blog.articles
    if item.id == article.id
      assign found_index = forloop.index0
      break
    endif
  endfor
  if found_index != null
    if found_index > 0
      assign prev_index = found_index | minus: 1
      assign next_article = blog.articles[prev_index]
    endif
    assign later_index = found_index | plus: 1
    if later_index < blog.articles.size
      assign prev_article = blog.articles[later_index]
    endif
  endif
-%}

{%- style -%}
  #article-editorial-{{ section.id }} {
    --eg-columns-desktop: {{ columns }};
    --eg-columns-tablet: {{ columns_tablet }};
    --eg-ink: {{ stts.text_color }};
    --eg-muted: {{ stts.muted_text_color }};
    --eg-card-bg: {{ stts.card_background }};
    --eg-card-border: {{ stts.card_border_color }};
    --eg-accent: {{ stts.accent_color }};
    --eg-radius: {{ stts.card_radius }}px;
    --eg-gap: {{ stts.card_gap | divided_by: 10.0 }}rem;
    --eg-ratio: {{ stts.image_ratio }};
    --gp-more-align: {{ stts.more_heading_align | default: 'start' }};
    --gp-text-col: {{ stts.split_text_width | default: 36 }}%;
    --eg-heading-size: {{ stts.heading_size | divided_by: 10.0 }}rem;
    --eg-body-size: {{ stts.body_size | divided_by: 10.0 }}rem;
    --eg-card-title-size: {{ stts.card_title_size | divided_by: 10.0 }}rem;
    --eg-card-text-size: {{ stts.card_text_size | divided_by: 10.0 }}rem;
    --eg-banner-height: {{ stts.hero_height | divided_by: 10.0 }}rem;
    --eg-banner-height-mobile: {{ stts.hero_height_mobile | divided_by: 10.0 }}rem;
    --eg-banner-radius: {{ stts.hero_radius }}px;
    --eg-banner-ink: {{ stts.hero_text_color }};
    --eg-banner-focus: {{ stts.hero_focal }};
    --eg-banner-scrim: {{ stts.hero_overlay_color | color_modify: 'alpha', scrim_alpha }};
    --eg-banner-wash: {{ stts.hero_overlay_color | color_modify: 'alpha', wash_alpha }};
    --eg-banner-fallback: {{ stts.hero_fallback_color }};
    --eg-banner-pill-bg: {{ stts.hero_eyebrow_background | color_modify: 'alpha', pill_alpha }};
    --eg-banner-pill-ink: {{ stts.hero_eyebrow_text_color }};
    --eg-banner-btn-bg: {{ stts.hero_button_background }};
    --eg-banner-btn-ink: {{ stts.hero_button_text_color }};
    --eg-split-text: {{ stts.hero_split_ratio }}%;
    --eg-split-bg: {{ stts.hero_split_background }};
    --eg-split-ink: {{ stts.hero_text_color }};
    --eg-split-media-height: {{ stts.hero_split_media_height | divided_by: 10.0 }}rem;
    --eg-banner-heading-size: {{ stts.hero_heading_size | divided_by: 10.0 }}rem;
    --eg-banner-text-size: {{ stts.hero_text_size | divided_by: 10.0 }}rem;
    --eg-cta-bg: {{ stts.cta_background }};
    --eg-cta-ink: {{ stts.cta_text_color }};
    --eg-btn-bg: {{ stts.cta_button_background }};
    --eg-btn-ink: {{ stts.cta_button_text_color }};
    background: {{ stts.background }};
    color: {{ stts.text_color }};
    padding-block: {{ stts.padding_top }}px {{ stts.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="article-editorial-{{ section.id }}"
  class="editorial-cards article-editorial color-{{ stts.color_scheme }}"
>
  {%- comment -%}
    The eyebrow, title, line and byline are the same words whichever shape the
    header takes, so they are written once here and placed by each shape below.
  {%- endcomment -%}
  {%- capture hero_copy -%}
    {%- if stts.show_eyebrow -%}
      <a class="eg-eyebrow" href="{{ blog.url }}">{{ stts.eyebrow | default: blog.title | escape }}</a>
    {%- endif -%}

    <h1 class="eg-heading">{{ article.title | escape }}</h1>

    {%- if hero_text != blank -%}
      <p class="eg-banner__text">{{ hero_text | escape }}</p>
    {%- endif -%}

    {%- if stts.show_meta -%}
      <p class="eg-meta">
        {{ article.published_at | time_tag: '%b %d, %Y' }}
        {%- if stts.show_author and article.author != blank -%}
          <span class="eg-meta__dot" aria-hidden="true">&middot;</span>
          <span>{{ article.author | escape }}</span>
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if stts.hero_button_label != blank and stts.hero_button_link != blank -%}
      <a class="eg-banner__button eden-action eden-action--solid" href="{{ stts.hero_button_link }}">
        {{- stts.hero_button_label | escape -}}
      </a>
    {%- endif -%}
  {%- endcapture -%}

  <div class="eg-shell">
    <article>
      {%- if stts.hero_style == 'split' -%}
        {%- comment -%}
          Words one side against a flat panel, the photograph whole on the other.
          These guides are shot on white, so a title laid over the picture has to
          fight it for contrast; here it does not have to.
        {%- endcomment -%}
        <div class="{{ split_class }}">
          <div class="eg-hero-split__copy">{{ hero_copy }}</div>

          {%- if hero_image != blank -%}
            <div class="eg-hero-split__media">
              {{
                hero_image
                | image_url: width: 1800
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '600, 900, 1200, 1500, 1800',
                  sizes: '(min-width: 850px) 50vw, 100vw',
                  alt: article.title
              }}
            </div>
          {%- endif -%}
        </div>
      {%- elsif stts.hero_style == 'banner' -%}
        {%- comment -%}
          The photo is the header: it fills the banner and the title sits on it,
          so the top of the page carries the piece instead of a pill on white.
        {%- endcomment -%}
        <div class="{{ banner_class }}">
          {%- if hero_image != blank or hero_asset != blank -%}
            <div class="eg-banner__media">
              {%- if hero_image != blank -%}
                {{
                  hero_image
                  | image_url: width: 2400
                  | image_tag:
                    loading: 'eager',
                    fetchpriority: 'high',
                    widths: '600, 900, 1200, 1600, 2000, 2400',
                    sizes: '100vw',
                    alt: article.title
                }}
              {%- else -%}
                <img
                  src="{{ hero_asset | asset_img_url: '2400x' }}"
                  srcset="
                    {{ hero_asset | asset_img_url: '900x' }} 900w,
                    {{ hero_asset | asset_img_url: '1600x' }} 1600w,
                    {{ hero_asset | asset_img_url: '2400x' }} 2400w
                  "
                  sizes="100vw"
                  alt="{{ article.title | escape }}"
                  width="2400"
                  height="1350"
                  loading="eager"
                  fetchpriority="high"
                  data-ap-hero-asset
                >
              {%- endif -%}
            </div>
            <span class="eg-banner__scrim" aria-hidden="true"></span>
          {%- endif -%}

          <div class="eg-banner__inner">{{ hero_copy }}</div>
        </div>
      {%- else -%}
        <div class="ap-hero">{{ hero_copy }}</div>

        {%- if stts.show_image and hero_image != blank -%}
          <div class="ap-media">
            {{
              hero_image
              | image_url: width: 1600
              | image_tag: loading: 'eager', sizes: '(min-width: 1100px) 108rem, 100vw', alt: article.title
            }}
          </div>
        {%- endif -%}
      {%- endif -%}

      <div class="gp-content rte"{% if stts.force_downloads %} data-editorial-downloads{% endif %}>
        {%- render 'editorial-content',
          content: article.content,
          split_sections: stts.split_sections,
          scroll_tables: stts.scroll_tables,
          featured_src: hero_image.src,
          lead_html: lead_html
        -%}
      </div>
    </article>

    {%- if stts.show_prev_next -%}
      {%- if prev_article or next_article -%}
        <nav class="ap-nav" aria-label="More articles">
          {%- if prev_article -%}
            <a class="ap-nav__link ap-nav__link--prev" href="{{ prev_article.url }}">
              <span class="ap-nav__label">&larr; {{ stts.prev_label | default: 'Previous' | escape }}</span>
              <span class="ap-nav__title">{{ prev_article.title | escape }}</span>
            </a>
          {%- endif -%}
          {%- if next_article -%}
            <a class="ap-nav__link ap-nav__link--next" href="{{ next_article.url }}">
              <span class="ap-nav__label">{{ stts.next_label | default: 'Next' | escape }} &rarr;</span>
              <span class="ap-nav__title">{{ next_article.title | escape }}</span>
            </a>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}

    {%- if stts.show_more and section.blocks.size > 0 -%}
      {%- liquid
        assign current_path = article.url
        assign more_count = 0
        for block in section.blocks
          if block.settings.title == blank
            continue
          endif
          if block.settings.link == current_path
            continue
          endif
          assign more_count = more_count | plus: 1
        endfor
      -%}

      {%- if more_count > 0 -%}
        <div class="gp-more">
          {%- if stts.more_heading != blank -%}
            <h2 class="gp-more__heading">{{ stts.more_heading | escape }}</h2>
          {%- endif -%}

          <ul class="eg-grid eg-grid--flat" role="list">
            {%- for block in section.blocks -%}
              {%- liquid
                assign title = block.settings.title
                if title == blank or block.settings.link == current_path
                  continue
                endif

                assign picture = block.settings.image
                assign picture_asset = blank
                if picture == blank
                  assign picture_asset = block.settings.image_asset | strip
                endif

                assign has_media = false
                if stts.show_images
                  if picture != blank or picture_asset != blank
                    assign has_media = true
                  endif
                endif

                assign has_link = false
                if block.settings.link != blank
                  assign has_link = true
                endif
              -%}

              <li class="eg-card" {{ block.shopify_attributes }}>
                {%- if has_link -%}
                  <a class="eg-card__link eden-action-host" href="{{ block.settings.link | escape }}">
                {%- else -%}
                  <div class="eg-card__link">
                {%- endif -%}

                  {%- if has_media -%}
                    <div class="eg-card__media">
                      {%- if picture != blank -%}
                        {{
                          picture
                          | image_url: width: 900
                          | image_tag:
                            loading: 'lazy',
                            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw',
                            alt: title
                        }}
                      {%- else -%}
                        <img
                          src="{{ picture_asset | asset_img_url: '900x' }}"
                          srcset="
                            {{ picture_asset | asset_img_url: '450x' }} 450w,
                            {{ picture_asset | asset_img_url: '900x' }} 900w
                          "
                          sizes="(min-width: 990px) 25vw, (min-width: 750px) 50vw, 100vw"
                          alt="{{ title | escape }}"
                          width="900"
                          height="900"
                          loading="lazy"
                          data-ap-guide-asset
                        >
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <div class="eg-card__body">
                    <h3 class="eg-card__title">{{ title | escape }}</h3>
                    {%- if block.settings.text != blank -%}
                      <p class="eg-card__text">{{ block.settings.text | escape }}</p>
                    {%- endif -%}
                    {%- if has_link -%}
                      <span class="eg-card__cta eden-link">
                        {{- block.settings.link_label | default: 'Read the guide' | escape -}}
                        <span class="eg-card__arrow" aria-hidden="true">&rarr;</span>
                      </span>
                    {%- endif -%}
                  </div>

                {%- if has_link -%}
                  </a>
                {%- else -%}
                  </div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if stts.show_cta and stts.cta_heading != blank -%}
      <div class="eg-cta">
        <div class="eg-cta__copy">
          <p class="eg-cta__heading">{{ stts.cta_heading | escape }}</p>
          {%- if stts.cta_text != blank -%}
            <div class="eg-cta__text rte">{{ stts.cta_text }}</div>
          {%- endif -%}
        </div>
        {%- if stts.cta_button_label != blank and stts.cta_button_link != blank -%}
          <a class="eg-cta__button eden-action eden-action--outline" href="{{ stts.cta_button_link }}">
            {{- stts.cta_button_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const root = document.getElementById('article-editorial-{{ section.id }}');
    if (!root) return;
    root.querySelectorAll('img[data-ap-guide-asset]').forEach((img) => {
      img.addEventListener('error', () => img.closest('.eg-card__media')?.remove());
    });
    root.querySelectorAll('img[data-ap-hero-asset]').forEach((img) => {
      img.addEventListener('error', () => {
        img.closest('.eg-banner__media')?.remove();
        root.querySelector('.eg-banner')?.classList.add('eg-banner--plain');
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Article",
  "class": "section-wrapper",
  "settings": [
    { "type": "header", "content": "Header" },
    {
      "type": "select",
      "id": "hero_style",
      "label": "Header style",
      "options": [
        { "value": "split", "label": "Split - words one side, photo the other" },
        { "value": "banner", "label": "Banner - title over the photo" },
        { "value": "stacked", "label": "Stacked - title above the photo" }
      ],
      "default": "split",
      "info": "The banner turns the lead photo into the top of the page and puts the title in the middle of it."
    },
    { "type": "checkbox", "id": "show_eyebrow", "label": "Show the blog name above the title", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave empty to use the blog's own title." },
    { "type": "checkbox", "id": "show_meta", "label": "Show the date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show the author", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show the lead photo", "default": true, "info": "Stacked header only - the banner always shows its photo." },
    { "type": "header", "content": "Banner" },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Banner photo",
      "info": "Leave empty to use the article's own featured image."
    },
    {
      "type": "text",
      "id": "hero_text",
      "label": "One line under the title",
      "info": "Leave empty to use the start of the article."
    },
    {
      "type": "select",
      "id": "hero_text_source",
      "label": "When that is empty",
      "options": [
        { "value": "lift", "label": "Move the opening paragraph onto the photo" },
        { "value": "excerpt", "label": "Copy the opening, shortened" },
        { "value": "none", "label": "Show nothing under the title" }
      ],
      "default": "lift",
      "info": "Moving it takes the paragraph out of the body as well, so it is not read twice."
    },
    { "type": "text", "id": "hero_button_label", "label": "Button label", "info": "Leave empty for no button." },
    { "type": "url", "id": "hero_button_link", "label": "Button link" },
    { "type": "header", "content": "Split header" },
    {
      "type": "range",
      "id": "hero_split_ratio",
      "label": "The words' share",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "The rest goes to the photo, so a lower number makes the photo bigger."
    },
    { "type": "checkbox", "id": "hero_split_flip", "label": "Put the photo on the left", "default": false },
    {
      "type": "select",
      "id": "hero_split_mobile",
      "label": "On a phone, show first",
      "options": [
        { "value": "words", "label": "The words" },
        { "value": "picture", "label": "The photo" }
      ],
      "default": "words"
    },
    { "type": "color", "id": "hero_split_background", "label": "Panel colour", "default": "#22211e" },
    {
      "type": "range",
      "id": "hero_split_media_height",
      "label": "Photo height on a phone",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 340
    },
    { "type": "header", "content": "Banner and split" },
    {
      "type": "select",
      "id": "hero_width",
      "label": "Header width",
      "options": [
        { "value": "wide", "label": "Wide - inside the page" },
        { "value": "full", "label": "Full - edge to edge" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "hero_align",
      "label": "Where the words sit",
      "options": [
        { "value": "center", "label": "Middle" },
        { "value": "left", "label": "Middle left" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "hero_focal",
      "label": "Part of the photo to keep",
      "options": [
        { "value": "center", "label": "Middle" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "info": "What stays in frame when the banner crops the photo."
    },
    { "type": "range", "id": "hero_height", "label": "Banner height", "min": 280, "max": 800, "step": 10, "unit": "px", "default": 520 },
    { "type": "range", "id": "hero_height_mobile", "label": "Banner height on a phone", "min": 240, "max": 640, "step": 10, "unit": "px", "default": 400 },
    { "type": "range", "id": "hero_radius", "label": "Banner corner rounding", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "hero_heading_size", "label": "Banner title size", "min": 28, "max": 88, "step": 1, "unit": "px", "default": 56 },
    { "type": "range", "id": "hero_text_size", "label": "Banner line size", "min": 13, "max": 28, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "hero_overlay", "label": "Shade behind the words", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 45 },
    { "type": "range", "id": "hero_wash", "label": "Shade across the whole photo", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 20 },
    { "type": "color", "id": "hero_overlay_color", "label": "Shade colour", "default": "#171714" },
    { "type": "color", "id": "hero_text_color", "label": "Banner and panel text", "default": "#ffffff" },
    { "type": "color", "id": "hero_fallback_color", "label": "Banner colour with no photo", "default": "#ead9d1" },
    { "type": "color", "id": "hero_eyebrow_background", "label": "Banner pill background", "default": "#ffffff" },
