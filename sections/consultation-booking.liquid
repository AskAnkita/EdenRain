{% comment %}
  Consultation booking - the page that turns "meet a consultant" into a time in the diary.

  The shape is a chooser on one side and a diary on the other: each way to meet is a block with
  its own booking link, and picking one swaps what the diary shows. Below 990px the chooser
  stacks above the diary, which is the order it is read in anyway.

  The scheduling is the provider's (Cal.com by default, Calendly or a plain booking URL by
  setting). Availability, timezones, the calendar invitation, the video link and the reminder
  emails are all theirs; this section owns the page around them, so the booking reads as Eden
  Raine rather than as somebody's scheduling tool. assets/consultation-booking.js loads that
  embed when the section comes into view and switches it when the choice changes.

  With no link pasted into any block - the editor before the Cal.com account exists - the diary
  is replaced by the fallback panel, so the page still asks for the enquiry instead of printing
  an empty rectangle. The same panel catches a provider script a customer's browser blocks.

  A signed-in customer's name and email are handed to the embed as prefill, and a note is built
  from the query string, so /pages/book-a-consultation?piece=Aurora+solitaire from a product
  page reaches the consultant with the piece already named.

  Looks come from assets/consultation-booking.css; buttons from assets/eden-actions.css, whose
  ink is rebound here so they follow this section's own button colours.

  Every restylable setting is written onto the section element as a CSS custom property, with
  the stylesheet's own value as the fallback, so a setting left at "use the default" (a cleared
  colour, a size of 0) writes nothing at all.
{% endcomment %}

{{ 'consultation-booking.css' | asset_url | stylesheet_tag }}
{{ 'eden-actions.css' | asset_url | stylesheet_tag }}
<script src="{{ 'consultation-booking.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign transparent = 'rgba(0,0,0,0)'

  comment
    A template saved before a setting existed has no value for it, so sizes are coerced with
    'plus: 0' and treated as "keep the stylesheet default" at 0.
  endcomment
  assign eyebrow_size = section.settings.eyebrow_size | plus: 0
  assign heading_size = section.settings.heading_size | plus: 0
  assign heading_size_mobile = section.settings.heading_size_mobile | plus: 0
  assign heading_tracking = section.settings.heading_tracking | plus: 0
  assign text_size = section.settings.text_size | plus: 0
  assign measure = section.settings.text_measure | plus: 0
  assign choice_label_size = section.settings.choice_label_size | plus: 0
  assign choice_meta_size = section.settings.choice_meta_size | plus: 0
  assign choice_text_size = section.settings.choice_text_size | plus: 0
  assign icon_size = section.settings.icon_size | plus: 0
  assign notes_size = section.settings.notes_size | plus: 0
  assign button_radius = section.settings.button_radius | plus: 0
  assign content_width = section.settings.content_width | plus: 0
  assign aside_width = section.settings.aside_width | plus: 0
  assign column_gap = section.settings.column_gap | plus: 0
  assign stage_height = section.settings.stage_height | plus: 0
  assign stage_height_mobile = section.settings.stage_height_mobile | plus: 0
  assign pad_top = section.settings.padding_top | plus: 0
  assign pad_bottom = section.settings.padding_bottom | plus: 0
  assign pad_top_mobile = section.settings.padding_top_mobile | plus: 0
  assign pad_bottom_mobile = section.settings.padding_bottom_mobile | plus: 0

  assign meeting_blocks = section.blocks | where: 'type', 'meeting'

  comment
    The first block holding a link is what the diary opens on, so a "Showroom visit" block with
    no link yet does not leave the page on the fallback panel while the others are ready.
  endcomment
  assign opening_index = -1
  for block in meeting_blocks
    if opening_index == -1 and block.settings.booking_link != blank
      assign opening_index = forloop.index0
    endif
  endfor
  if opening_index == -1
    assign opening_index = 0
  endif

  assign has_any_link = false
  for block in meeting_blocks
    if block.settings.booking_link != blank
      assign has_any_link = true
      break
    endif
  endfor

  assign has_media = false
  if section.settings.media_image != blank or section.settings.media_asset != blank or section.settings.media_image_url != blank
    assign has_media = true
  endif
-%}

{%- capture section_styles -%}
  {%- if section.settings.section_background != blank and section.settings.section_background != transparent -%}--ebk-section-bg: {{ section.settings.section_background }};{%- endif -%}
  {%- if section.settings.heading_color != blank and section.settings.heading_color != transparent -%}--ebk-heading-color: {{ section.settings.heading_color }};{%- endif -%}
  {%- if section.settings.eyebrow_color != blank and section.settings.eyebrow_color != transparent -%}--ebk-eyebrow-color: {{ section.settings.eyebrow_color }};{%- endif -%}
  {%- if section.settings.text_color != blank and section.settings.text_color != transparent -%}--ebk-text-color: {{ section.settings.text_color }};{%- endif -%}
  {%- if section.settings.accent_color != blank and section.settings.accent_color != transparent -%}--ebk-accent-color: {{ section.settings.accent_color }};{%- endif -%}
  {%- if section.settings.rule_color != blank and section.settings.rule_color != transparent -%}--ebk-rule-color: {{ section.settings.rule_color }};{%- endif -%}
  {%- if section.settings.choice_background != blank and section.settings.choice_background != transparent -%}--ebk-choice-bg: {{ section.settings.choice_background }};{%- endif -%}
  {%- if section.settings.choice_background_active != blank and section.settings.choice_background_active != transparent -%}--ebk-choice-bg-active: {{ section.settings.choice_background_active }};{%- endif -%}
  {%- if section.settings.choice_text_color != blank and section.settings.choice_text_color != transparent -%}--ebk-choice-color: {{ section.settings.choice_text_color }};{%- endif -%}
  {%- if section.settings.choice_border_color != blank and section.settings.choice_border_color != transparent -%}--ebk-choice-border: {{ section.settings.choice_border_color }};{%- endif -%}
  {%- if section.settings.choice_border_active != blank and section.settings.choice_border_active != transparent -%}--ebk-choice-border-active: {{ section.settings.choice_border_active }};{%- endif -%}
  {%- if section.settings.icon_color != blank and section.settings.icon_color != transparent -%}--ebk-icon-color: {{ section.settings.icon_color }};{%- endif -%}
  {%- if section.settings.stage_background != blank and section.settings.stage_background != transparent -%}--ebk-stage-bg: {{ section.settings.stage_background }};{%- endif -%}
  {%- if section.settings.stage_border_color != blank and section.settings.stage_border_color != transparent -%}--ebk-stage-border: {{ section.settings.stage_border_color }};{%- endif -%}

  {%- comment -%}
    The buttons take their fill and their text from eden-actions.css, so a button colour is set
    by rebinding that file's two properties here. The corner is the theme's own button radius,
    rebound on this section rather than a radius of this section's own.
  {%- endcomment -%}
  {%- if section.settings.button_background != blank and section.settings.button_background != transparent -%}--eden-action-ink: {{ section.settings.button_background }};{%- endif -%}
  {%- if section.settings.button_text_color != blank and section.settings.button_text_color != transparent -%}--eden-action-on-ink: {{ section.settings.button_text_color }};{%- endif -%}
  --style-border-radius-buttons-primary: {{ button_radius }}px;

  {%- if eyebrow_size > 0 -%}--ebk-eyebrow-size: {{ eyebrow_size }}px;{%- endif -%}
  {%- if heading_size > 0 -%}--ebk-heading-size: {{ heading_size }}px;{%- endif -%}
  {%- if heading_size_mobile > 0 -%}--ebk-heading-size-mobile: {{ heading_size_mobile }}px;{%- endif -%}
  {%- if heading_tracking > 0 -%}--ebk-heading-tracking: {{ heading_tracking | divided_by: 100.0 }}em;{%- endif -%}
  {%- if section.settings.uppercase_heading -%}--ebk-heading-case: uppercase;{%- endif -%}
  {%- if text_size > 0 -%}--ebk-text-size: {{ text_size }}px;{%- endif -%}
  {%- if measure > 0 -%}--ebk-measure: {{ measure }}ch;{%- endif -%}
  {%- if choice_label_size > 0 -%}--ebk-choice-label-size: {{ choice_label_size }}px;{%- endif -%}
  {%- if choice_meta_size > 0 -%}--ebk-choice-meta-size: {{ choice_meta_size }}px;{%- endif -%}
  {%- if choice_text_size > 0 -%}--ebk-choice-text-size: {{ choice_text_size }}px;{%- endif -%}
  {%- if icon_size > 0 -%}--ebk-icon-size: {{ icon_size }}px;{%- endif -%}
  {%- if notes_size > 0 -%}--ebk-notes-size: {{ notes_size }}px;{%- endif -%}

  {%- if stage_height > 0 -%}--ebk-stage-min-height: {{ stage_height }}px;{%- endif -%}
  {%- if stage_height_mobile > 0 -%}--ebk-stage-min-height-mobile: {{ stage_height_mobile }}px;{%- endif -%}
  {%- if aside_width > 0 -%}--ebk-aside-width: {{ aside_width }}px;{%- endif -%}
  {%- if column_gap > 0 -%}--ebk-gap: {{ column_gap }}px;{%- endif -%}
  --ebk-media-ratio: {{ section.settings.media_ratio | default: '4 / 3' }};

  {%- if section.settings.full_width -%}
    --ebk-shell-max: none;
  {%- elsif content_width > 0 -%}
    --ebk-shell-max: {{ content_width }}px;
  {%- endif -%}
  {%- if section.settings.custom_padding -%}--ebk-pad-top: {{ pad_top }}px;--ebk-pad-bottom: {{ pad_bottom }}px;--ebk-pad-top-mobile: {{ pad_top_mobile }}px;--ebk-pad-bottom-mobile: {{ pad_bottom_mobile }}px;{%- endif -%}
{%- endcapture -%}

<section
  class="eden-booking eden-booking--chooser-{{ section.settings.chooser_side }}{% if section.settings.centre_intro %} eden-booking--centred{% endif %}"
  style="{{ section_styles | strip_newlines | strip }}"
  {{ section.shopify_attributes }}
>
  <div class="ebk-shell">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <header class="ebk-intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ebk-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="ebk-heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ebk-text">{{ section.settings.text }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    <consultation-booking
      class="ebk-layout"
      data-section-id="{{ section.id }}"
      data-provider="{{ section.settings.provider }}"
      {% if section.settings.provider_origin != blank %}data-origin="{{ section.settings.provider_origin | escape }}"{% endif %}
      data-layout="{{ section.settings.embed_layout }}"
      data-theme="{{ section.settings.embed_theme }}"
      data-brand-color="{{ section.settings.embed_brand_color | default: '#171714' }}"
      data-hide-details="{% if section.settings.hide_event_details %}true{% else %}false{% endif %}"
      data-lazy="{% if section.settings.lazy_load %}true{% else %}false{% endif %}"
      data-frame-title="{{ section.settings.heading | default: 'Book a consultation' | escape }}"
      {% if section.settings.prefill_customer and customer %}
        data-name="{{ customer.name | escape }}"
        data-email="{{ customer.email | escape }}"
      {% endif %}
    >
      <div class="ebk-aside">
        {%- if meeting_blocks.size > 0 -%}
          <div class="ebk-choices{% if meeting_blocks.size == 1 %} ebk-choices--single{% endif %}" role="group" aria-label="{{ section.settings.chooser_label | default: 'Ways to meet' | escape }}">
            {%- for block in meeting_blocks -%}
              {%- liquid
                assign is_open = false
                if forloop.index0 == opening_index
                  assign is_open = true
                endif

                assign has_icon_image = false
                if block.settings.icon_image != blank or block.settings.icon_asset != blank
                  assign has_icon_image = true
                endif
              -%}
              {%- capture choice_inner -%}
                {%- if has_icon_image -%}
                  <span class="ebk-choice__icon">
                    {%- render 'homepage-journey-image',
                      image: block.settings.icon_image,
                      asset: block.settings.icon_asset,
                      alt: '',
                      sizes: '48px',
                      width: 48,
                      height: 48
                    -%}
                  </span>
                {%- elsif block.settings.icon != 'none' -%}
                  <span class="ebk-choice__icon" aria-hidden="true">
                    {%- render 'icon-consultation', icon: block.settings.icon -%}
                  </span>
                {%- endif -%}
                <span class="ebk-choice__body">
                  {%- if block.settings.label != blank -%}
                    <span class="ebk-choice__label">{{ block.settings.label | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.meta != blank -%}
                    <span class="ebk-choice__meta">{{ block.settings.meta | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <span class="ebk-choice__text">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.badge != blank -%}
                    <span class="ebk-choice__badge">{{ block.settings.badge | escape }}</span>
                  {%- endif -%}
                </span>
              {%- endcapture -%}

              {%- if meeting_blocks.size == 1 -%}
                <div
                  class="ebk-choice"
                  data-booking-choice
                  data-booking-link="{{ block.settings.booking_link | escape }}"
                  {{ block.shopify_attributes }}
                >
                  {{ choice_inner }}
                </div>
              {%- else -%}
                <button
                  type="button"
                  class="ebk-choice"
                  data-booking-choice
                  data-booking-link="{{ block.settings.booking_link | escape }}"
                  aria-pressed="{% if is_open %}true{% else %}false{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{ choice_inner }}
                </button>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.settings.notes_text != blank -%}
          <div class="ebk-notes">
            {%- if section.settings.notes_heading != blank -%}
              <h2 class="ebk-notes__heading">{{ section.settings.notes_heading | escape }}</h2>
            {%- endif -%}
            <div class="ebk-notes__body">{{ section.settings.notes_text }}</div>
          </div>
        {%- endif -%}

        {%- if has_media -%}
          <figure class="ebk-aside__media">
            {%- render 'homepage-journey-image',
              image: section.settings.media_image,
              asset: section.settings.media_asset,
              image_url: section.settings.media_image_url,
              alt: section.settings.media_alt,
              placeholder: 'lifestyle-2',
              sizes: '(min-width: 990px) 360px, 100vw',
              width: 900,
              height: 675
            -%}
          </figure>
        {%- endif -%}

        {%- if section.settings.link_1_label != blank or section.settings.link_2_label != blank -%}
          <div class="ebk-aside__links">
            {%- if section.settings.link_1_label != blank -%}
              <a class="eden-link" href="{{ section.settings.link_1_url | default: '/pages/contact' }}">
                {{- section.settings.link_1_label | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.link_2_label != blank -%}
              <a class="eden-link" href="{{ section.settings.link_2_url | default: '/pages/contact' }}">
                {{- section.settings.link_2_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="ebk-stage{% unless has_any_link %} ebk-stage--fallback{% endunless %}" data-booking-stage{% unless has_any_link %} data-ready="true"{% endunless %}>
        <div class="ebk-stage__frame" data-booking-frame></div>

        <p class="ebk-stage__status">{{ section.settings.loading_text | default: 'Opening the diary' | escape }}</p>

        <div class="ebk-fallback" data-booking-fallback{% if has_any_link %} hidden{% endif %}>
          {%- if section.settings.fallback_heading != blank -%}
            <h2 class="ebk-fallback__heading">{{ section.settings.fallback_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.fallback_text != blank -%}
            <div class="ebk-fallback__text">{{ section.settings.fallback_text }}</div>
          {%- endif -%}
          {%- if section.settings.fallback_button_label != blank -%}
            <a class="eden-action eden-action--{{ section.settings.button_style }}" href="{{ section.settings.fallback_button_link | default: '/pages/contact' }}">
              {{- section.settings.fallback_button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>
    </consultation-booking>
  </div>
</section>

{% schema %}
{
  "name": "Consultation booking",
  "tag": "section",
  "class": "section-consultation-booking",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Private appointments" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Book a consultation" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Meet one to one with an Eden Raine jewellery specialist. Choose how you would like to meet, pick a time that suits you, and we will confirm it by email straight away.<\/p>" },
    { "type": "text", "id": "chooser_label", "label": "Name of the chooser for screen readers", "default": "Ways to meet" },
    { "type": "text", "id": "loading_text", "label": "Text while the diary loads", "default": "Opening the diary" },

    { "type": "header", "content": "The diary" },
    { "type": "paragraph", "content": "The appointment itself is kept by a scheduling provider. Paste the link for each way to meet into its block below - a Cal.com event link looks like cal.com\/eden-raine\/showroom-visit." },
    {
      "type": "select",
      "id": "provider",
      "label": "Provider",
      "options": [
        { "value": "cal", "label": "Cal.com" },
        { "value": "calendly", "label": "Calendly" },
        { "value": "iframe", "label": "Any other booking page (plain frame)" }
      ],
      "default": "cal",
      "info": "Cal.com and Calendly load their own embed, which resizes itself and takes the customer's details. Anything else is shown in a plain frame at the height set below."
    },
    { "type": "text", "id": "provider_origin", "label": "Self-hosted address", "info": "Only for a Cal.com instance of your own, e.g. https:\/\/book.edenraine.co.uk. Leave empty for cal.com." },
    {
      "type": "select",
      "id": "embed_layout",
      "label": "Calendar layout",
      "options": [
        { "value": "month_view", "label": "Month" },
        { "value": "week_view", "label": "Week" },
        { "value": "column_view", "label": "Columns" }
      ],
      "default": "month_view",
      "info": "Cal.com only."
    },
    {
      "type": "select",
      "id": "embed_theme",
      "label": "Diary theme",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "auto", "label": "Follow the visitor's device" }
      ],
      "default": "light"
    },
    { "type": "color", "id": "embed_brand_color", "label": "Diary accent", "default": "#171714", "info": "The colour the provider uses for the selected day and the booking button." },
    { "type": "checkbox", "id": "hide_event_details", "label": "Hide the provider's own title and duration", "default": true, "info": "They are already in the card beside the diary." },
    { "type": "checkbox", "id": "prefill_customer", "label": "Fill in a signed-in customer's name and email", "default": true },
    { "type": "checkbox", "id": "lazy_load", "label": "Load the diary when it is scrolled to", "default": true, "info": "Untick if the diary is the first thing on the page." },

    { "type": "header", "content": "Beside the chooser" },
    { "type": "text", "id": "notes_heading", "label": "Heading", "default": "What happens next" },
    { "type": "richtext", "id": "notes_text", "label": "Text", "default": "<ul><li>You will have a confirmation email with a calendar invitation within a minute.<\/li><li>For a video call we send a link; nothing to install.<\/li><li>Need to move it? Every confirmation has a reschedule link.<\/li><\/ul>" },
    { "type": "text", "id": "link_1_label", "label": "First link label", "default": "Prefer to write to us?" },
    { "type": "url", "id": "link_1_url", "label": "First link", "info": "Left empty it goes to \/pages\/contact." },
    { "type": "text", "id": "link_2_label", "label": "Second link label" },
    { "type": "url", "id": "link_2_url", "label": "Second link" },

    { "type": "header", "content": "Picture" },
    { "type": "paragraph", "content": "A picked image wins, then a file in Content > Files or assets\/, then a pasted URL. Leave all three empty for no picture." },
    { "type": "image_picker", "id": "media_image", "label": "Image" },
    { "type": "text", "id": "media_asset", "label": "File name" },
    { "type": "text", "id": "media_image_url", "label": "Image URL" },
    { "type": "text", "id": "media_alt", "label": "Alt text", "default": "Our consultation showroom" },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Picture shape",
      "options": [
        { "value": "4 / 3", "label": "Landscape (4:3)" },
        { "value": "3 / 2", "label": "Landscape (3:2)" },
        { "value": "16 / 9", "label": "Wide (16:9)" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "4 / 3"
    },

    { "type": "header", "content": "If the diary cannot be shown" },
    { "type": "paragraph", "content": "Shown in place of the diary while no booking link is set, and if a visitor's browser blocks the provider's script." },
    { "type": "text", "id": "fallback_heading", "label": "Heading", "default": "Tell us when suits you" },
    { "type": "richtext", "id": "fallback_text", "label": "Text", "default": "<p>Send us two or three times that work for you and the way you would like to meet, and we will confirm one by return.<\/p>" },
    { "type": "text", "id": "fallback_button_label", "label": "Button label", "default": "Request an appointment" },
    { "type": "url", "id": "fallback_button_link", "label": "Button link", "info": "Left empty it goes to \/pages\/contact." },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "section_background", "label": "Page background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow and small capitals", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "accent_color", "label": "Badge", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "rule_color", "label": "Dividing lines", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "choice_background", "label": "Way to meet card", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "choice_background_active", "label": "Way to meet card when chosen", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "choice_text_color", "label": "Way to meet text", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "choice_border_color", "label": "Way to meet border", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "choice_border_active", "label": "Way to meet border when chosen", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "icon_color", "label": "Icons", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "stage_background", "label": "Diary background", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "stage_border_color", "label": "Diary border", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_background", "label": "Button fill", "default": "rgba(0,0,0,0)" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "rgba(0,0,0,0)" },

    { "type": "header", "content": "Type" },
