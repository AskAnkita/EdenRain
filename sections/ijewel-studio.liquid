{% comment %}
  iJewel 3D studio - the page a "Start designing" button lands on.

  The band is the configurator: an optional heading above it, iJewel's 3D tool
  in the frame, and the reassurance lines and links under it. Which tool goes
  in the frame is decided in this order:

    1. any app block added to this section, so an app-based builder still
       takes the slot if one is ever installed.
    2. the 3D configurator, when an embed URL is set. iJewel hands one over in
       the Embedding tab of a file in iJewel Drive - either the whole <iframe>
       snippet or just its src, and this takes both. The URL looks like
       https://ijewel3d.com/<instance>/files/<file id>/embedded, or
       https://ijewel3d.com/drive/files/embedded?tag=...&scope=<folder id>.
       The file has to be public, or the frame loads empty.
       assets/ijewel-studio.js builds the frame once it is near the viewport.
    3. the enquiry card, when neither is there - the shop still takes custom
       work by email and form, so the page is useful before the tool is wired
       up and stays useful if it is ever turned off.

  The builder in the frame is somebody else's page on somebody else's domain,
  so its own branding cannot be restyled from here - a cross-origin frame takes
  none of our CSS. "Cover the builder's logo" is the way round it: a panel laid
  over the frame's top-left corner, in the frame's own background colour, with
  our mark on it. Where the vendor puts its logo is the vendor's decision and
  can move, so every edge of that panel is a setting.

  Looks come from assets/ijewel-studio.css; buttons from assets/eden-actions.css.
  The poster image reuses snippets/homepage-journey-image.liquid - picked image
  first, then a file in Content > Files or assets/, then a pasted URL.

  Every restylable setting is written onto the section element as a CSS custom
  property, with the stylesheet's own value as the fallback, so a setting left
  at "use the default" (a cleared colour, a size of 0) writes nothing at all.
{% endcomment %}

{{ 'ijewel-studio.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ijewel-studio.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign transparent = 'rgba(0,0,0,0)'

  assign heading_size = section.settings.heading_size | plus: 0
  assign eyebrow_size = section.settings.eyebrow_size | plus: 0
  assign text_size = section.settings.text_size | plus: 0
  assign note_size = section.settings.note_size | plus: 0
  assign content_width = section.settings.content_width | plus: 0
  assign pad_inline = section.settings.padding_horizontal | plus: 0
  assign pad_top = section.settings.padding_top | plus: 0
  assign pad_bottom = section.settings.padding_bottom | plus: 0

  # iJewel's Embedding tab offers the whole <iframe ...> snippet and the bare
  # URL, and pasting either into the one field should work. A snippet is cut
  # down to its src; anything else is taken as the URL it is.
  assign embed_src = section.settings.embed_url | strip

  if embed_src contains 'src='
    assign src_parts = embed_src | split: 'src=' | last | replace: "'", '"' | split: '"'
    assign embed_src = src_parts[1] | default: ''
  endif

  # Only an absolute https URL is ever printed into the frame, so a stray word
  # in the field cannot turn into a relative path on our own domain.
  unless embed_src contains 'https://'
    assign embed_src = ''
  endunless

  # Pressing the builder's own "Add to cart" posts the finished design out to
  # this page - from the builder's origin and no other, so the listener is told
  # which one to trust rather than guessing.
  assign embed_origin = ''
  if embed_src != blank
    assign embed_host = embed_src | split: '//' | last | split: '/' | first
    assign embed_origin = 'https://' | append: embed_host
  endif

  # NOTHING IS ADDED TO A CART HERE. A configured ring has no variant and no
  # price Shopify will accept, so the studio does not pretend to sell one: the
  # design is saved and sent to us to quote. The two actions, the record and
  # what happens to the builder's own button are all in assets/ijewel-design.js.
  #
  # With no support page set there is nowhere to send anybody, so that action is
  # not drawn and the builder's button falls back to saving the design.
  assign support_link = section.settings.support_link
  assign save_label = section.settings.save_label
  assign support_label = section.settings.support_label
  if support_link == blank
    assign support_label = ''
  endif

  assign intercept = section.settings.builder_button | default: 'support'
  if intercept == 'support' and support_link == blank
    assign intercept = 'save'
  endif

  assign design_flow = false
  if save_label != blank or support_label != blank or intercept != 'none'
    assign design_flow = true
  endif

  # The buttons on the price panel are the same two actions, so a page that
  # carries them in the frame does not want the row repeated under it. The
  # row is what a page without a panel still has, so it stays on by default.
  assign show_actions = true
  unless section.settings.show_actions
    assign show_actions = false
  endunless

  # WHAT A SAVED DESIGN PUTS IN THE CART.
  #
  # A configured ring has no variant of its own: /cart/add.js takes a variant
  # id and will not be told a price. So a line can only be charged against a
  # product that already exists - a bespoke deposit, a design fee, a made to
  # order placeholder - and everything the shopper chose rides on that line as
  # properties, which is what the cart page and the order both read.
  #
  # With no product picked nothing is added and the studio behaves exactly as
  # it did: the design is saved to this browser and sent to us. That is the
  # safe default, because the wrong product here charges the wrong money.
  assign cart_variant = ''
  if section.settings.cart_product != blank
    assign cart_variant = section.settings.cart_product.selected_or_first_available_variant.id
  endif
  assign cart_on_save = false
  if cart_variant != blank and section.settings.cart_on_save
    assign cart_on_save = true
  endif

  assign app_blocks = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_blocks = app_blocks | plus: 1
    endif
  endfor

  assign poster_set = false
  if section.settings.poster_image != blank or section.settings.poster_image_asset != blank or section.settings.poster_image_url != blank
    assign poster_set = true
  endif

  assign notes = section.settings.notes | split: '|'

  assign brand_top = section.settings.brand_top | plus: 0
  assign brand_left = section.settings.brand_left | plus: 0
  assign brand_width = section.settings.brand_width | plus: 0
  assign brand_height = section.settings.brand_height | plus: 0
  assign brand_logo_width = section.settings.brand_logo_width | plus: 0
  assign brand_top_mobile = section.settings.brand_top_mobile | plus: 0
  assign brand_top_mobile_vw = section.settings.brand_top_mobile_vw | plus: 0
  assign brand_left_mobile = section.settings.brand_left_mobile | plus: 0
  assign brand_width_mobile = section.settings.brand_width_mobile | plus: 0
  assign brand_height_mobile = section.settings.brand_height_mobile | plus: 0
  assign brand_logo_width_mobile = section.settings.brand_logo_width_mobile | plus: 0
  assign brand_pad = section.settings.brand_pad | plus: 0
  assign brand_pad_mobile = section.settings.brand_pad_mobile | plus: 0
  assign brand_feather = section.settings.brand_feather | plus: 0
  assign brand_feather_mobile = section.settings.brand_feather_mobile | plus: 0
  assign brand_text_size = section.settings.brand_text_size | plus: 0

  assign splash_hold = section.settings.splash_hold | plus: 0 | times: 1000
  assign splash_logo_width = section.settings.splash_logo_width | plus: 0
  assign splash_logo_width_mobile = section.settings.splash_logo_width_mobile | plus: 0
  assign splash_stage_width = section.settings.splash_stage_width | plus: 0
  assign splash_stage_height = section.settings.splash_stage_height | plus: 0
  assign splash_stage_width_mobile = section.settings.splash_stage_width_mobile | plus: 0
  assign splash_stage_height_mobile = section.settings.splash_stage_height_mobile | plus: 0

  assign brand_plate_where = section.settings.brand_plate_where | default: 'always'
  if section.settings.brand_background == blank
    assign brand_plate_where = 'never'
  endif

  assign brand_bare_class = ''
  case brand_plate_where
    when 'never'
      assign brand_bare_class = ' ijw-brand--bare'
    when 'mobile'
      assign brand_bare_class = ' ijw-brand--bare-desktop'
    when 'desktop'
      assign brand_bare_class = ' ijw-brand--bare-mobile'
  endcase

  assign brand_justify = 'flex-start'
  if section.settings.brand_alignment == 'center'
    assign brand_justify = 'center'
  endif

  assign price_bottom = section.settings.price_bottom | plus: 0
  assign price_right = section.settings.price_right | plus: 0
  assign price_width = section.settings.price_width | plus: 0
  assign price_height = section.settings.price_height | plus: 0
  assign price_pad = section.settings.price_pad | plus: 0
  assign price_feather = section.settings.price_feather | plus: 0
  assign price_bottom_mobile = section.settings.price_bottom_mobile | plus: 0
  assign price_right_mobile = section.settings.price_right_mobile | plus: 0
  assign price_width_mobile = section.settings.price_width_mobile | plus: 0
  assign price_height_mobile = section.settings.price_height_mobile | plus: 0
  assign price_pad_mobile = section.settings.price_pad_mobile | plus: 0
  assign price_feather_mobile = section.settings.price_feather_mobile | plus: 0
  assign price_text_size = section.settings.price_text_size | plus: 0
  assign price_note_size = section.settings.price_note_size | plus: 0

  assign price_justify = 'flex-start'
  assign price_align = 'left'
  if section.settings.price_alignment == 'center'
    assign price_justify = 'center'
    assign price_align = 'center'
  elsif section.settings.price_alignment == 'right'
    assign price_justify = 'flex-end'
    assign price_align = 'right'
  endif

  assign price_anchor = section.settings.price_anchor | default: 'bottom-right'
  assign price_classes = ''
  if price_anchor contains 'left'
    assign price_classes = price_classes | append: ' ijw-price--left'
  endif
  if price_anchor contains 'top'
    assign price_classes = price_classes | append: ' ijw-price--top'
  endif
  if section.settings.price_background == blank or section.settings.price_background == transparent
    assign price_classes = price_classes | append: ' ijw-price--bare'
  endif
  if section.settings.price_hide_mobile
    assign price_classes = price_classes | append: ' ijw-price--desktop'
  endif

  # Covering the builder's Add to cart. The button is on iJewel's own page
  # inside a cross-origin frame, so it cannot be relabelled or deleted from out
  # here - but the panel already covering their price can be grown down over
  # it, and a panel that takes pointer events is a button nobody can press.
  # Prices are not finished, so the panel's own two buttons - save the design,
  # ask us what it costs - are what a shopper presses instead of their Add to
  # cart. The panel grows DOWNWARDS from the price line by
  # the two numbers below, and the shipped pair reach the frame's foot - which
  # is where iJewel anchors the button on a desktop and on a phone alike.
  assign price_cart_height = section.settings.price_cart_height | plus: 0
  assign price_cart_height_mobile = section.settings.price_cart_height_mobile | plus: 0
  if section.settings.price_cover_cart
    assign price_height = price_height | plus: price_cart_height
    assign price_height_mobile = price_height_mobile | plus: price_cart_height_mobile
    unless price_anchor contains 'top'
      assign price_bottom = price_bottom | minus: price_cart_height
      assign price_bottom_mobile = price_bottom_mobile | minus: price_cart_height_mobile
      if price_bottom < 0
        assign price_bottom = 0
      endif
      if price_bottom_mobile < 0
        assign price_bottom_mobile = 0
      endif
    endunless
  endif

  # The panel is no longer a line floating in white: it is the foot of the
  # rail, built the way the rest of the shop builds one. A hairline across the
  # top so it reads as a section of their card rather than a patch stuck on it,
  # a line about price if the merchant wants one, and WHERE THEIR ADD TO CART
  # WAS, the two things this page can actually do.
  #
  # It used to be one button - "Enquire about this design" - under a line
  # reading "Contact us for price". That is a page telling somebody what it
  # cannot do. The two buttons below are the same pair as the row under the
  # frame, named by the same data attributes, so assets/ijewel-design.js wires
  # all of them without knowing where any one of them sits: save the design,
  # or ask us what it costs. Both are real eden-actions, so they fill on hover
  # with every other CTA in the shop and take the theme's button shape, and
  # the ones that are links are links underneath, so they still work with
  # JavaScript off and when the bridge never answers.
  #
  # An action that cannot work here falls back rather than drawing a dead
  # button: saving needs a builder in the frame, support needs a support page,
  # and a link button with nowhere to go is not drawn at all.
  assign price_saves = false
  if design_flow and embed_src != blank
    assign price_saves = true
  endif

  assign price_one_label = section.settings.price_cta_label | strip
  assign price_one_style = section.settings.price_cta_style | default: 'solid'
  assign price_one_action = section.settings.price_cta_action | default: 'save'
  assign price_one_link = section.settings.price_cta_link | default: section.settings.price_link
  if price_one_action == 'save' and price_saves == false
    assign price_one_action = 'support'
  endif
  if price_one_action == 'support' and support_link == blank
    assign price_one_action = 'link'
  endif
  if price_one_action == 'support'
    assign price_one_link = support_link
  endif
  if price_one_action == 'link' and price_one_link == blank
    assign price_one_label = ''
  endif

  assign price_two_label = section.settings.price_cta2_label | strip
  assign price_two_style = section.settings.price_cta2_style | default: 'outline'
  assign price_two_action = section.settings.price_cta2_action | default: 'support'
  assign price_two_link = section.settings.price_cta2_link | default: section.settings.price_link
  if price_two_action == 'save' and price_saves == false
    assign price_two_action = 'support'
  endif
  if price_two_action == 'support' and support_link == blank
    assign price_two_action = 'link'
  endif
  if price_two_action == 'support'
    assign price_two_link = support_link
  endif
  if price_two_action == 'link' and price_two_link == blank
    assign price_two_label = ''
  endif

  # Two buttons that would do the identical thing are one button twice. The
  # second stands down rather than the first, so the merchant's primary action
  # is the one that survives.
  if price_two_label != blank and price_one_label != blank and price_two_action == price_one_action and price_two_link == price_one_link
    assign price_two_label = ''
  endif

  # THE PRICE LINE ITSELF. "Contact us for price" is a sentence that asks to be
  # pressed, and until now it only became a link when the panel had no buttons
  # under it - so on the shipped panel, which has one, it was dead text telling
  # somebody to contact us without saying how.
  #
  # "support" is not an ordinary link. assets/ijewel-design.js catches the click
  # on anything carrying data-design-support, reads the ring off the builder
  # over the bridge, saves it, and only then goes to the support page with the
  # reference, the summary and the state key on the URL - so the page that
  # opens already knows which ring was being asked about and can draw it. The
  # href is the support page either way, so the line still works as a plain
  # link with the script dead, the bridge silent or the design unreadable: the
  # enquiry form on that page takes an enquiry with no design attached.
  #
  # The same fallback chain as the buttons above: no support page set means
  # there is nowhere to carry the ring to, so it stands down to the plain link,
  # and a plain link with nowhere to go is not a link at all.
  assign price_text_action = section.settings.price_text_action | default: 'support'
  assign price_text_link = section.settings.price_link
  if price_text_action == 'support' and support_link == blank
    assign price_text_action = 'link'
  endif
  if price_text_action == 'support'
    assign price_text_link = support_link
  endif
  if price_text_link == blank
    assign price_text_action = 'none'
  endif

  assign price_buttons = 0
  if price_one_label != blank
    assign price_buttons = price_buttons | plus: 1
  endif
  if price_two_label != blank
    assign price_buttons = price_buttons | plus: 1
  endif
  if price_buttons > 0
    assign price_classes = price_classes | append: ' ijw-price--cta'
  endif
  if price_buttons > 1
    assign price_classes = price_classes | append: ' ijw-price--duo'
  endif
  if section.settings.price_rule
    assign price_classes = price_classes | append: ' ijw-price--ruled'
  endif

  assign price_pad_y = section.settings.price_pad_y | plus: 0
  assign price_pad_y_mobile = section.settings.price_pad_y_mobile | plus: 0
  assign price_label_size = section.settings.price_label_size | plus: 0

  # Where the lines sit in the panel. A panel grown over the button is tall
  # enough that the middle of it is a choice rather than the only place a line
  # can go.
  assign price_valign = 'center'
  if section.settings.price_valign == 'top'
    assign price_valign = 'flex-start'
  elsif section.settings.price_valign == 'bottom'
    assign price_valign = 'flex-end'
  endif
-%}

{%- comment -%}
  The mark on the patch: a picked image first, then a file in Content > Files or
  assets/ by name, then a pasted URL. With none of the three set the wordmark is
  typed out instead, so the panel is never an empty white box.
{%- endcomment -%}
{%- capture brand_src -%}
  {%- if section.settings.brand_image != blank -%}
    {{- section.settings.brand_image | image_url: width: 720 -}}
  {%- elsif section.settings.brand_image_asset != blank -%}
    {%- render 'image-source', file: section.settings.brand_image_asset, width: 720 -%}
  {%- elsif section.settings.brand_image_url != blank -%}
    {{- section.settings.brand_image_url -}}
  {%- endif -%}
{%- endcapture -%}
{%- assign brand_src = brand_src | strip -%}

{%- comment -%}
  width and height on the <img> are only a ratio hint - the stylesheet sets the
  width and leaves the height automatic. The real numbers come from the picked
  image, or from the file when it is one of the shop's own in Content > Files;
  the literal pair is the shipped default's own size, so a file named by hand
  that lives in assets/ still reserves roughly the right box.
{%- endcomment -%}
{%- liquid
  assign brand_drop = section.settings.brand_image
  if brand_drop == blank and section.settings.brand_image_asset != blank
    assign brand_drop = images[section.settings.brand_image_asset]
  endif
  assign brand_img_width = brand_drop.width | default: 1250
  assign brand_img_height = brand_drop.height | default: 620
-%}

{%- comment -%}
  The mark on the loading cover. The builder shows its own splash while its
  scene downloads, and that splash is inside the frame where nothing of ours
  can reach it - so the cover stays up over the whole stage for a moment after
  the frame reports it has loaded, then fades.
{%- endcomment -%}
{%- capture splash_src -%}
  {%- if section.settings.splash_image != blank -%}
    {{- section.settings.splash_image | image_url: width: 720 -}}
  {%- elsif section.settings.splash_image_asset != blank -%}
    {%- render 'image-source', file: section.settings.splash_image_asset, width: 720 -%}
  {%- elsif section.settings.splash_image_url != blank -%}
    {{- section.settings.splash_image_url -}}
  {%- endif -%}
{%- endcapture -%}
{%- assign splash_src = splash_src | strip -%}

{%- liquid
  assign splash_drop = section.settings.splash_image
  if splash_drop == blank and section.settings.splash_image_asset != blank
    assign splash_drop = images[section.settings.splash_image_asset]
  endif
  assign splash_img_width = splash_drop.width | default: 1188
  assign splash_img_height = splash_drop.height | default: 158
-%}

{%- capture section_styles -%}
  {%- if section.settings.section_background != blank and section.settings.section_background != transparent -%}--ijw-section-bg: {{ section.settings.section_background }};{%- endif -%}
  {%- if section.settings.heading_color != blank and section.settings.heading_color != transparent -%}--ijw-heading-color: {{ section.settings.heading_color }};{%- endif -%}
  {%- if section.settings.eyebrow_color != blank and section.settings.eyebrow_color != transparent -%}--ijw-eyebrow-color: {{ section.settings.eyebrow_color }};{%- endif -%}
  {%- if section.settings.text_color != blank and section.settings.text_color != transparent -%}--ijw-text-color: {{ section.settings.text_color }};{%- endif -%}
  {%- if section.settings.note_color != blank and section.settings.note_color != transparent -%}--ijw-note-color: {{ section.settings.note_color }};{%- endif -%}
  {%- if section.settings.frame_background != blank and section.settings.frame_background != transparent -%}--ijw-frame-bg: {{ section.settings.frame_background }};{%- endif -%}
  {%- if section.settings.frame_border != blank and section.settings.frame_border != transparent -%}--ijw-frame-border: {{ section.settings.frame_border }};{%- endif -%}
  {%- if section.settings.button_background != blank and section.settings.button_background != transparent -%}--ijw-button-bg: {{ section.settings.button_background }};{%- endif -%}
  {%- if section.settings.button_text_color != blank and section.settings.button_text_color != transparent -%}--ijw-button-ink: {{ section.settings.button_text_color }};{%- endif -%}
  {%- if heading_size > 0 -%}--ijw-heading-size: {{ heading_size }}px;{%- endif -%}
  {%- if eyebrow_size > 0 -%}--ijw-eyebrow-size: {{ eyebrow_size }}px;{%- endif -%}
  {%- if text_size > 0 -%}--ijw-text-size: {{ text_size }}px;{%- endif -%}
  {%- if note_size > 0 -%}--ijw-note-size: {{ note_size }}px;{%- endif -%}
  --ijw-crop-left: {{ section.settings.frame_crop_left | default: 0 }}px;
  --ijw-crop-left-mobile: {{ section.settings.frame_crop_left_mobile | default: 0 }}px;
  --ijw-crop-top: {{ section.settings.frame_crop_top | default: 0 }}px;
  --ijw-crop-top-mobile: {{ section.settings.frame_crop_top_mobile | default: 0 }}px;
  --ijw-frame-height: {{ section.settings.frame_height }}px;
  --ijw-frame-height-mobile: {{ section.settings.frame_height_mobile }}px;
  --ijw-boost-mobile: {{ section.settings.frame_boost_mobile | default: 0 }}px;
  {%- if content_width > 0 and section.settings.full_width == false -%}--ijw-shell-max: {{ content_width }}px;{%- endif -%}
  {%- if section.settings.brand_cover -%}
    {%- if section.settings.brand_background != blank and section.settings.brand_background != transparent -%}--ijw-brand-bg: {{ section.settings.brand_background }};{%- endif -%}
    {%- if section.settings.brand_text_color != blank and section.settings.brand_text_color != transparent -%}--ijw-brand-ink: {{ section.settings.brand_text_color }};{%- endif -%}
    --ijw-brand-top: {{ brand_top }}px;
    --ijw-brand-left: {{ brand_left }}px;
    --ijw-brand-width: {{ brand_width }}px;
    --ijw-brand-height: {{ brand_height }}px;
    --ijw-brand-logo-width: {{ brand_logo_width }}px;
    {%- if brand_top_mobile_vw > 0 -%}--ijw-brand-top-mobile: {{ brand_top_mobile_vw }}vw;{%- else -%}--ijw-brand-top-mobile: {{ brand_top_mobile }}px;{%- endif -%}
    --ijw-brand-left-mobile: {{ brand_left_mobile }}px;
    --ijw-brand-width-mobile: {{ brand_width_mobile }}px;
    --ijw-brand-height-mobile: {{ brand_height_mobile }}px;
    --ijw-brand-logo-width-mobile: {{ brand_logo_width_mobile }}px;
    --ijw-brand-pad: {{ brand_pad }}px;
    --ijw-brand-pad-mobile: {{ brand_pad_mobile }}px;
    --ijw-brand-feather: {{ brand_feather }}px;
    --ijw-brand-feather-mobile: {{ brand_feather_mobile }}px;
    --ijw-brand-justify: {{ brand_justify }};
    {%- if brand_text_size > 0 -%}--ijw-brand-text-size: {{ brand_text_size }}px;{%- endif -%}
  {%- endif -%}
  {%- if section.settings.price_cover -%}
    {%- if section.settings.price_background != blank and section.settings.price_background != transparent -%}--ijw-price-bg: {{ section.settings.price_background }};{%- endif -%}
    {%- if section.settings.price_text_color != blank and section.settings.price_text_color != transparent -%}--ijw-price-ink: {{ section.settings.price_text_color }};{%- endif -%}
    {%- if section.settings.price_note_color != blank and section.settings.price_note_color != transparent -%}--ijw-price-note-ink: {{ section.settings.price_note_color }};{%- endif -%}
    --ijw-price-bottom: {{ price_bottom }}px;
    --ijw-price-right: {{ price_right }}px;
    --ijw-price-width: {{ price_width }}px;
    --ijw-price-height: {{ price_height }}px;
    --ijw-price-pad: {{ price_pad }}px;
    --ijw-price-feather: {{ price_feather }}px;
    --ijw-price-bottom-mobile: {{ price_bottom_mobile }}px;
    --ijw-price-right-mobile: {{ price_right_mobile }}px;
    --ijw-price-width-mobile: {{ price_width_mobile }}px;
    --ijw-price-height-mobile: {{ price_height_mobile }}px;
    --ijw-price-pad-mobile: {{ price_pad_mobile }}px;
    --ijw-price-feather-mobile: {{ price_feather_mobile }}px;
    --ijw-price-justify: {{ price_justify }};
    --ijw-price-align: {{ price_align }};
    --ijw-price-valign: {{ price_valign }};
    --ijw-price-pad-y: {{ price_pad_y }}px;
    --ijw-price-pad-y-mobile: {{ price_pad_y_mobile }}px;
    {%- if section.settings.price_rule_color != blank and section.settings.price_rule_color != transparent -%}--ijw-price-rule: {{ section.settings.price_rule_color }};{%- endif -%}
    {%- if price_label_size > 0 -%}--ijw-price-label-size: {{ price_label_size }}px;{%- endif -%}
    {%- if price_text_size > 0 -%}--ijw-price-text-size: {{ price_text_size }}px;{%- endif -%}
    {%- if price_note_size > 0 -%}--ijw-price-note-size: {{ price_note_size }}px;{%- endif -%}
  {%- endif -%}
  {%- if section.settings.splash_cover -%}
    {%- if section.settings.splash_background != blank and section.settings.splash_background != transparent -%}--ijw-splash-bg: {{ section.settings.splash_background }};{%- endif -%}
    {%- if section.settings.progress_color != blank and section.settings.progress_color != transparent -%}--ijw-progress-color: {{ section.settings.progress_color }};{%- endif -%}
    {%- if section.settings.progress_track_color != blank and section.settings.progress_track_color != transparent -%}--ijw-progress-track: {{ section.settings.progress_track_color }};{%- endif -%}
    {%- if splash_logo_width > 0 -%}--ijw-splash-logo-width: {{ splash_logo_width }}px;{%- endif -%}
    {%- if splash_logo_width_mobile > 0 -%}--ijw-splash-logo-width-mobile: {{ splash_logo_width_mobile }}px;{%- endif -%}
    {%- if splash_stage_width > 0 -%}--ijw-splash-stage-width: {{ splash_stage_width }}%;{%- endif -%}
    {%- if splash_stage_height > 0 -%}--ijw-splash-stage-height: {{ splash_stage_height }}%;{%- endif -%}
    {%- if splash_stage_width_mobile > 0 -%}--ijw-splash-stage-width-mobile: {{ splash_stage_width_mobile }}%;{%- endif -%}
    {%- if splash_stage_height_mobile > 0 -%}--ijw-splash-stage-height-mobile: {{ splash_stage_height_mobile }}%;{%- endif -%}
  {%- endif -%}
  {%- if pad_inline > 0 -%}--ijw-pad-inline: {{ pad_inline }}px;{%- endif -%}
  {%- if section.settings.custom_padding -%}--ijw-pad-top: {{ pad_top }}px;--ijw-pad-bottom: {{ pad_bottom }}px;{%- endif -%}
{%- endcapture -%}

<section
  class="ijewel-studio{% if section.settings.full_width %} ijewel-studio--wide{% endif %}{% if section.settings.fill_screen %} ijewel-studio--fullscreen{% endif %}{% if section.settings.hide_toolbar_mobile %} ijewel-studio--notoolbar{% endif %}{% if section.settings.hide_announcement_mobile %} ijewel-studio--noannounce{% endif %}{% if section.settings.hide_header_mobile %} ijewel-studio--noheader{% endif %}"
  style="{{ section_styles }}"
>
  <div class="ijw-shell">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.intro != blank -%}
      <div class="ijw-head{% if section.settings.alignment == 'left' %} ijw-head--left{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ijw-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          {%- if section.settings.heading_is_h1 -%}
            <h1 class="ijw-title">{{ section.settings.heading | escape }}</h1>
          {%- else -%}
            <h2 class="ijw-title">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="ijw-text">{{ section.settings.intro }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ijw-frame">
      {%- if app_blocks > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            <div class="ijw-app" {{ block.shopify_attributes }}>{% render block %}</div>
          {%- endif -%}
        {%- endfor -%}

      {%- elsif embed_src != blank -%}
        <ijewel-studio
          data-src="{{ embed_src | escape }}"
          data-guided-mobile="{{ section.settings.guided_mobile }}"
          data-guided-document="{{ 'ijewel-guided-document.js' | asset_url }}"
          data-title="{{ section.settings.embed_title | default: 'Design your own jewellery' | escape }}"
          data-price-note="{% if section.settings.price_cover %}{{ section.settings.price_text | escape | default: ' ' }}{% endif %}"
          data-lazy="{% if section.settings.lazy_load %}true{% else %}false{% endif %}"
          data-hold="{% if section.settings.splash_cover %}{{ splash_hold }}{% else %}0{% endif %}"
          data-origin="{{ embed_origin | escape }}"
          data-wait-ready="{% if section.settings.splash_cover and section.settings.splash_wait_ready %}true{% else %}false{% endif %}"
        >
          <noscript>
            <iframe
              src="{{ embed_src | escape }}"
              title="{{ section.settings.embed_title | default: 'Design your own jewellery' | escape }}"
              allow="autoplay; camera; fullscreen; xr-spatial-tracking; web-share"
              allowfullscreen
            ></iframe>
          </noscript>
        </ijewel-studio>

        <div class="ijw-poster{% if section.settings.splash_cover %} ijw-poster--cover{% endif %}">
          {%- if poster_set -%}
            <div class="ijw-poster__image">
              {%- render 'homepage-journey-image',
                image: section.settings.poster_image,
                asset: section.settings.poster_image_asset,
                image_url: section.settings.poster_image_url,
                alt: section.settings.poster_image_alt,
                placeholder: 'product-1',
                sizes: '100vw',
                width: 1600,
                height: 1200
              -%}
            </div>
          {%- endif -%}
          {%- if section.settings.splash_cover and splash_src != blank -%}
            <img
              class="ijw-poster__mark"
              src="{{ splash_src }}"
              alt="{{ section.settings.brand_text | default: shop.name | escape }}"
              width="{{ splash_img_width }}"
              height="{{ splash_img_height }}"
              loading="eager"
            >
          {%- endif -%}

          {%- if section.settings.splash_cover and section.settings.show_progress -%}
            <div class="ijw-poster__progress" role="progressbar" aria-label="Loading the designer" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              <span class="ijw-poster__progress-bar"></span>
            </div>
          {%- endif -%}

          {%- if section.settings.loading_label != blank -%}
            <p class="ijw-poster__label">{{ section.settings.loading_label | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.brand_cover -%}
          <div class="ijw-brand{% if section.settings.brand_hide_mobile %} ijw-brand--desktop{% endif %}{{ brand_bare_class }}{% if section.settings.brand_anchor == 'bottom' %} ijw-brand--bottom{% endif %}">
            {%- if brand_src != blank -%}
              <img
                class="ijw-brand__image"
                src="{{ brand_src }}"
                alt="{{ section.settings.brand_text | default: shop.name | escape }}"
                width="{{ brand_img_width }}"
                height="{{ brand_img_height }}"
                loading="eager"
              >
            {%- else -%}
              <span class="ijw-brand__text">{{ section.settings.brand_text | default: shop.name | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%}
          The same trick over the builder's price line. Their figures come from
          a rate card that is not ours, so the number is covered and the line we
          stand behind is put in its place.

          With "Cover the builder's Add to cart" on - it ships on - the panel
          reaches on down over their button too, and because the panel takes
          pointer events the press never lands. That is deliberate: a price we
          cannot stand behind has no add-to-cart under it. The panel's own two
          buttons are what is pressed instead - save the design, or ask us what
          it costs - and both of them reach us.

          On a phone running the guided steps the price is replaced at its
          source instead - that document is ours - so this panel is hidden there
          by the stylesheet.
        {%- endcomment -%}
        {%- if section.settings.price_cover -%}
          <div class="ijw-price{{ price_classes }}">
            {%- if section.settings.price_rule -%}
              <span class="ijw-price__rule" aria-hidden="true"></span>
            {%- endif -%}
            {%- if section.settings.price_eyebrow != blank -%}
              <span class="ijw-price__label">{{ section.settings.price_eyebrow | escape }}</span>
            {%- endif -%}
            {%- if section.settings.price_text != blank -%}
              {%- if price_text_action == 'support' -%}
                <a class="ijw-price__text" href="{{ price_text_link }}" data-design-support>{{ section.settings.price_text | escape }}</a>
              {%- elsif price_text_action == 'link' -%}
                <a class="ijw-price__text" href="{{ price_text_link }}">{{ section.settings.price_text | escape }}</a>
              {%- else -%}
                <span class="ijw-price__text">{{ section.settings.price_text | escape }}</span>
              {%- endif -%}
            {%- endif -%}
            {%- if section.settings.price_note != blank -%}
              <span class="ijw-price__note">{{ section.settings.price_note | escape }}</span>
            {%- endif -%}
            {%- comment -%}
              The two actions, standing where iJewel's Add to cart is. A save
              is a real <button> - it goes nowhere, it reads the ring off the
              builder - and the other two kinds are real links, so they work
              before the script has run and can be opened in a new tab.
            {%- endcomment -%}
            {%- if price_buttons > 0 -%}
              <div class="ijw-price__actions">
                {%- if price_one_label != blank -%}
                  {%- if price_one_action == 'save' -%}
                    <button class="ijw-price__cta eden-action eden-action--{{ price_one_style }}" type="button" data-design-save>
                      {{- price_one_label | escape -}}
                    </button>
                  {%- elsif price_one_action == 'support' -%}
                    <a class="ijw-price__cta eden-action eden-action--{{ price_one_style }}" href="{{ price_one_link }}" data-design-support>
                      {{- price_one_label | escape -}}
                    </a>
                  {%- else -%}
                    <a class="ijw-price__cta eden-action eden-action--{{ price_one_style }}" href="{{ price_one_link }}">
                      {{- price_one_label | escape -}}
                    </a>
                  {%- endif -%}
                {%- endif -%}
                {%- if price_two_label != blank -%}
                  {%- if price_two_action == 'save' -%}
                    <button class="ijw-price__cta eden-action eden-action--{{ price_two_style }}" type="button" data-design-save>
                      {{- price_two_label | escape -}}
                    </button>
                  {%- elsif price_two_action == 'support' -%}
                    <a class="ijw-price__cta eden-action eden-action--{{ price_two_style }}" href="{{ price_two_link }}" data-design-support>
                      {{- price_two_label | escape -}}
                    </a>
                  {%- else -%}
                    <a class="ijw-price__cta eden-action eden-action--{{ price_two_style }}" href="{{ price_two_link }}">
                      {{- price_two_label | escape -}}
                    </a>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- else -%}
        <div class="ijw-fallback">
          {%- if section.settings.fallback_heading != blank -%}
            <h2>{{ section.settings.fallback_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.fallback_text != blank -%}
            <div class="ijw-text">{{ section.settings.fallback_text }}</div>
          {%- endif -%}
          {%- if section.settings.fallback_label != blank -%}
            <div class="ijw-actions">
              <a class="eden-action eden-action--solid" href="{{ section.settings.fallback_link | default: '#' }}">
                {{- section.settings.fallback_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%}
      Save design / Contact support - what this page does instead of an
      add-to-cart. The element is outside the frame because it draws something:
      the two buttons, the line they speak through, and the panel that opens
      with the saved design's reference and the link that reopens the ring.

      It is also the listener for the builder's own Add to cart. That button is
      on iJewel's page inside a cross-origin frame, so it cannot be relabelled
      or removed from out here - but it posts the finished design out and then
      waits, so what the press MEANS is ours to decide. "What their button
      does" below decides it. Nothing is ever added to a cart.

      Only drawn with a builder in the frame: the enquiry card below has its own
      button, and a saved design needs a builder to have made one.
    {%- endcomment -%}
    {%- if design_flow and embed_src != blank -%}
      {{ 'ijewel-design.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'eden-design-store.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'ijewel-design.js' | asset_url }}" defer="defer"></script>
      <ijewel-design
        data-origin="{{ embed_origin | escape }}"
        data-embed="{{ embed_src | escape }}"
        data-studio="{{ request.path }}"
        data-support="{{ support_link }}"
        data-frame="ijewel-studio iframe"
        data-prefix="{{ section.settings.reference_prefix | default: 'ER' | escape }}"
        data-intercept="{{ intercept }}"
        data-title="{{ section.settings.embed_title | escape }}"
        data-currency="{{ cart.currency.iso_code }}"
        data-axis-names="{{ section.settings.axis_names | escape }}"
        data-saving-text="{{ section.settings.saving_text | default: 'Saving your design' | escape }}"
        data-wait-text="{{ section.settings.wait_text | default: 'Tap the ring to start the designer, then save your design.' | escape }}"
        data-fail-text="{{ section.settings.fail_text | default: 'We could not read the design just now. Contact support and we will pick it up with you.' | escape }}"
        data-saved-text="{{ section.settings.saved_text | default: 'Design saved' | escape }}"
        data-reopen-label="{{ section.settings.list_reopen_label | default: 'Reopen' | escape }}"
        data-ask-label="{{ section.settings.ask_label | default: 'Contact support' | escape }}"
        data-remove-label="{{ section.settings.remove_label | default: 'Remove' | escape }}"
        {% if cart_on_save %}data-cart-variant="{{ cart_variant }}"{% endif %}
        data-cart-add="{{ routes.cart_add_url }}"
        data-cart-url="{{ routes.cart_url }}"
        data-cart-go="{% if section.settings.cart_go %}true{% else %}false{% endif %}"
        data-cart-price="{% if section.settings.cart_price_visible %}shown{% else %}hidden{% endif %}"
        data-cart-text="{{ section.settings.cart_text | default: 'Design saved and added to your bag' | escape }}"
        data-cart-fail-text="{{ section.settings.cart_fail_text | default: 'Your design is saved. We could not put it in your bag just now - contact support and we will pick it up with you.' | escape }}"
        data-cart-link-label="{{ section.settings.cart_link_label | default: 'View your saved designs' | escape }}"
      >
        <div class="ijd-actions"{% unless show_actions %} hidden{% endunless %}>
          {%- if save_label != blank -%}
            <button class="eden-action eden-action--solid" type="button" data-design-save>
              {{- save_label | escape -}}
            </button>
          {%- endif -%}
          {%- comment -%}
            A real link, so it works before the script has run, works if the
            script never runs, and can be opened in a new tab. The element takes
            the click only to get the design saved and its reference onto the
            URL first; the support page takes an enquiry either way.
          {%- endcomment -%}
          {%- if support_label != blank -%}
            <a class="eden-action eden-action--outline" href="{{ support_link }}" data-design-support>
              {{- support_label | escape -}}
            </a>
          {%- endif -%}
        </div>

        <p class="ijd-status" data-design-status role="status" aria-live="polite" hidden></p>

        <div class="ijd-panel" data-design-panel hidden>
          {%- if section.settings.panel_title != blank -%}
            <p class="ijd-panel__title">{{ section.settings.panel_title | escape }}</p>
          {%- endif -%}
          <p class="ijd-panel__reference">
            {{ section.settings.reference_lead | default: 'Your reference is' | escape }}
            <strong data-design-reference></strong>{{ section.settings.reference_tail | default: '. Quote it when you talk to us.' | escape }}
          </p>
          <dl class="ijd-specs" data-design-specs hidden></dl>
          <p class="ijd-panel__links">
            <a class="eden-link" data-design-reopen hidden>{{ section.settings.reopen_label | default: 'Reopen this design' | escape }}</a>
            {%- comment -%}
              Only shown once the line is actually in the cart - a link to an
              empty bag is worse than no link.
            {%- endcomment -%}
            <a class="eden-link" href="{{ routes.cart_url }}" data-design-cart hidden>{{ section.settings.cart_link_label | default: 'View your saved designs' | escape }}</a>
            {%- if support_label != blank -%}
              <a class="eden-link" href="{{ support_link }}" data-design-go>{{ section.settings.ask_label | default: 'Contact support' | escape }}</a>
            {%- endif -%}
          </p>
          <p class="ijd-panel__unstored" data-design-unstored hidden>
            {{ section.settings.unstored_text | default: 'This browser will not keep your design, so use the link above or send it to us now.' | escape }}
          </p>
        </div>

        {%- if section.settings.show_saved -%}
          <div class="ijd-saved" data-design-saved hidden>
            {%- if section.settings.saved_title != blank -%}
              <h3 class="ijd-saved__title">{{ section.settings.saved_title | escape }}</h3>
            {%- endif -%}
            <ul class="ijd-saved__list" data-design-list></ul>
          </div>
        {%- endif -%}
      </ijewel-design>
    {%- endif -%}

    {%- if notes.size > 0 -%}
      <ul class="ijw-notes">
        {%- for note in notes -%}
          {%- assign note_text = note | strip -%}
          {%- if note_text != blank -%}
            <li class="ijw-note">{{ note_text | escape }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
      <div class="ijw-actions">
        {%- if section.settings.primary_label != blank -%}
          <a
            class="eden-action eden-action--{{ section.settings.primary_style }}"
            href="{{ section.settings.primary_link | default: '#' }}"
            {% if section.settings.primary_new_tab %}target="_blank" rel="noopener"{% endif %}
          >
            {{- section.settings.primary_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a
            class="eden-action eden-action--{{ section.settings.secondary_style }}"
            href="{{ section.settings.secondary_link | default: '#' }}"
          >
            {{- section.settings.secondary_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.aside != blank -%}
      <p class="ijw-aside">{{ section.settings.aside }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "3D design studio",
  "tag": "section",
  "class": "section-ijewel-studio",
  "settings": [
    { "type": "header", "content": "The 3D designer", "info": "Paste the embed your builder gives you. Pencil: the share or embed link for the builder. iJewel: open the file in iJewel Drive, go to Embedding, and copy what it gives you - the file must be public or the frame loads empty." },
    { "type": "textarea", "id": "embed_url", "label": "Embed URL or iframe code", "info": "Paste either the bare URL or the whole <iframe> snippet - the src is taken out of it either way. Leave empty to show the enquiry card instead. An app block added to this section wins over whatever is here." },
    { "type": "checkbox", "id": "guided_mobile", "label": "Guided mobile design steps", "default": false, "info": "Uses the bundled demo project with Diamond, Setting, Metal and Review steps. Finish with a bespoke enquiry; Shopify checkout is not connected." },
    { "type": "text", "id": "embed_title", "label": "Frame title for screen readers", "default": "Design your own jewellery" },
    { "type": "checkbox", "id": "lazy_load", "label": "Load the designer when it scrolls into view", "default": true, "info": "Untick to load it with the page. A 3D scene is a heavy first load." },
    { "type": "checkbox", "id": "fill_screen", "label": "Fill the screen", "default": false, "info": "The designer takes the whole window below the header, with no border, padding or wash. The two frame heights below are ignored - on a phone use \"Extra frame height\" instead." },
    { "type": "checkbox", "id": "hide_toolbar_mobile", "label": "Hide the phone toolbar on this page", "default": true, "info": "The builder has its own add-to-cart bar across the bottom. Leaving the theme's toolbar under it stacks two bars and two cart buttons, and costs the builder the height. Untick to keep the toolbar." },
    { "type": "checkbox", "id": "hide_announcement_mobile", "label": "Hide the announcement bar on this page", "default": false, "info": "Gives the builder back the bar's height, which is worth roughly one more row of choices on a phone. The bar still shows on every other page." },
    { "type": "checkbox", "id": "hide_header_mobile", "label": "Hide the header on a phone, on this page", "default": false, "info": "The 3D ring is about a third of the frame's height, so the frame's height is what makes the ring bigger - and on a phone the header row is the last of it going spare. The header still shows on every other page, and on this one from a tablet up. Note it takes the menu and the cart with it on a phone: the section's brand cover stands in for the logo." },
    { "type": "range", "id": "frame_boost_mobile", "label": "Extra frame height (mobile)", "min": 0, "max": 400, "step": 20, "unit": "px", "default": 0, "info": "With \"Fill the screen\" on, height added on top of the window. It makes the ring bigger, but it pushes the builder's own add-to-cart bar below the fold, and a touch over the frame scrolls the builder rather than the page - so what goes below is hard to reach. Raise it a little at a time and check add-to-cart on a phone." },
    { "type": "range", "id": "frame_height", "label": "Frame height (desktop)", "min": 400, "max": 1400, "step": 20, "unit": "px", "default": 760 },
    { "type": "range", "id": "frame_height_mobile", "label": "Frame height (mobile)", "min": 320, "max": 1200, "step": 20, "unit": "px", "default": 560 },
    { "type": "text", "id": "loading_label", "label": "Line shown while it loads", "info": "Optional words under the progress bar. Leave empty to show the bar alone.", "default": "Loading the designer" },

    { "type": "header", "content": "Saving a design", "info": "Save writes the design to this browser and shows a quotable reference; Contact support carries that reference to the support page, where the whole design sits above a contact form. The record holds every choice, the builder's price and the key that reopens the identical 3D ring. A saved design can also be put in the cart - see \"Add the design to the cart\" below, which needs a product to charge it against." },
    { "type": "url", "id": "support_link", "label": "Support page", "info": "The page with the \"Design support\" section on it. Leave empty and the Contact support button is not drawn and the builder's own button only saves." },
    { "type": "text", "id": "save_label", "label": "Save button label", "default": "Save this design" },
    { "type": "text", "id": "support_label", "label": "Support button label", "default": "Contact support" },
    { "type": "checkbox", "id": "show_actions", "label": "Show the buttons under the frame", "default": true, "info": "Untick where the price panel inside the frame already carries the same two buttons, so the page does not offer them twice. The saved design's panel, its reference and the list of saved designs are unaffected - only the row of buttons is hidden." },
    { "type": "select", "id": "builder_button", "label": "What their button does", "default": "support", "info": "The builder's own Add to cart is on iJewel's page inside the frame, so it cannot be relabelled or removed from here - but pressing it posts the design out to us and then waits, so what it means is still yours to set. It never adds anything to a cart. While the price cover below reaches over that button, as it ships, it cannot be pressed on a desktop at all - this is then only the guided mobile steps, where the frame crops the button out anyway.", "options": [
      { "value": "support", "label": "Save the design and go to support" },
      { "value": "save", "label": "Save the design and stay here" },
      { "value": "none", "label": "Nothing - leave it to the builder" }
    ] },
    { "type": "text", "id": "reference_prefix", "label": "Reference prefix", "default": "ER", "info": "The front of the reference a shopper quotes - ER-K3F9T2. Letters and digits only." },
    { "type": "checkbox", "id": "show_saved", "label": "List the designs saved on this device", "default": false, "info": "The list that used to sit at the foot of this page. It lives on the cart page now - add the \"Saved designs\" section there - because the bottom of the studio is the one place nobody looks once they have finished designing. Turning this back on puts the list in BOTH places. Saved designs live in this browser only; they do not follow anyone to another device, which is why the support email is the copy you work from." },
    { "type": "text", "id": "saved_title", "label": "List heading", "default": "Your saved designs" },
    { "type": "textarea", "id": "axis_names", "label": "Names for the builder's options", "info": "The builder names its own axes in slugs - shankMetal, headGem - and those go on the record unless they are named here. One per line, as slug = name, e.g. gem = Stone. Anything not listed is tidied up from the slug." },

    { "type": "header", "content": "Add the design to the cart", "info": "A configured ring has no variant of its own and Shopify will not be told a price, so a line can only be charged against a product that already exists - a bespoke deposit, a design fee, a made-to-order placeholder. Pick that product and a saved design is added to the cart with every choice, the reference, the builder's figure and the key that reopens it written onto the line. Pick nothing and nothing is added: the design is only saved and sent to you." },
    { "type": "product", "id": "cart_product", "label": "Product the line is charged against", "info": "Its own price is what the shopper pays, so it must be the amount you mean to take at this point - not the ring. Leave empty to add nothing to the cart." },
    { "type": "checkbox", "id": "cart_on_save", "label": "Add the design to the cart when it is saved", "default": true, "info": "Only does anything once a product is picked above." },
    { "type": "checkbox", "id": "cart_go", "label": "Go to the cart page after saving", "default": true, "info": "The saved designs are listed on the cart page, so that is where a save ends up: the design is written down, the cart is asked for its line, and the shopper lands on the list with it on. It goes there whether or not a line was added - a design with no stand-in product behind it is still saved and still listed. Off, they stay in the studio with the saved panel and a link to their bag. Nothing navigates in the theme editor either way." },
    { "type": "checkbox", "id": "cart_price_visible", "label": "Show the builder's price on the line", "default": false, "info": "Off, iJewel's figure still travels on the order but underscored, so it is out of the shopper's sight in their cart - which is right while the panel above is covering that same figure in the frame. Turn it on only once the prices in the builder are yours." },
    { "type": "text", "id": "cart_text", "label": "Said when it is added", "default": "Design saved and added to your bag" },
    { "type": "text", "id": "cart_fail_text", "label": "Said when the cart refuses it", "default": "Your design is saved. We could not put it in your bag just now - contact support and we will pick it up with you.", "info": "A deleted, unpublished or sold-out product is the usual reason. The design itself is saved either way." },
    { "type": "text", "id": "cart_link_label", "label": "Link to the cart page", "default": "View your saved designs", "info": "Shown on the saved panel after every save, not only when a line was added - the cart page is where the saved designs are listed. Add the \"Saved designs\" section there if it is not on it already." },

    { "type": "header", "content": "Saving a design: the wording", "info": "What the page says while it reads the design, once it has one, and when it cannot. A design is read by asking the builder across the frame, so there is a moment of waiting and there are ways for it to fail." },
    { "type": "text", "id": "panel_title", "label": "Panel heading", "default": "Your design is saved" },
    { "type": "text", "id": "reference_lead", "label": "Before the reference", "default": "Your reference is" },
    { "type": "text", "id": "reference_tail", "label": "After the reference", "default": ". Quote it when you talk to us." },
    { "type": "text", "id": "reopen_label", "label": "Reopen link label", "default": "Reopen this design" },
    { "type": "text", "id": "ask_label", "label": "Support link label", "default": "Contact support" },
    { "type": "text", "id": "remove_label", "label": "Remove link label", "default": "Remove" },
    { "type": "text", "id": "list_reopen_label", "label": "Reopen label in the saved list", "default": "Reopen", "info": "Shorter than the one on the panel: in the list it sits beside two other links in a narrow card." },
    { "type": "text", "id": "saving_text", "label": "While it is being read", "default": "Saving your design" },
    { "type": "text", "id": "saved_text", "label": "Saved, with no panel", "default": "Design saved", "info": "Only used if the panel above is turned off by clearing its heading." },
    { "type": "text", "id": "wait_text", "label": "Before the designer is running", "default": "Tap the ring to start the designer, then save your design.", "info": "The builder cannot be asked anything until its 3D scene is going, and the scene waits to be tapped. A press before that is answered with this." },
    { "type": "text", "id": "fail_text", "label": "If the design cannot be read", "default": "We could not read the design just now. Contact support and we will pick it up with you." },
    { "type": "text", "id": "unstored_text", "label": "If the browser will not keep it", "default": "This browser will not keep your design, so use the link above or send it to us now.", "info": "Private browsing and blocked site data both refuse the write. The design is still on screen and the reopen link still works." },

    { "type": "header", "content": "Cover the builder's loading screen", "info": "The builder shows its own splash while its scene downloads, inside the frame where our CSS cannot reach it. This holds our own cover over the stage - the part of the frame the piece is drawn in - for a moment after the frame has loaded, then fades it out. It deliberately leaves the builder's own panel showing, so the page never looks empty while it loads. Lengthen the hold if their splash flashes up at the end of it; widen the cover if it shows at the edges." },
    { "type": "checkbox", "id": "splash_cover", "label": "Cover the builder's loading screen", "default": true },
    { "type": "checkbox", "id": "splash_wait_ready", "label": "Hold the cover until the designer is ready", "default": false, "info": "The builder's page arrives quickly but its 3D scene waits to be tapped, so uncovering when the frame loads shows the builder's own poster, play button and logo. With this on the cover waits for the builder to say it is running, and it takes no clicks, so the tap goes straight through. The hold below still applies after that signal: the builder reports ready while it is still drawing the ring. Falls back after 45 seconds." },
    { "type": "range", "id": "splash_hold", "label": "Hold the cover after the frame loads", "min": 0, "max": 20, "step": 1, "unit": "s", "default": 6, "info": "Counted from whichever signal the box above selects. The scene needs a few seconds after that signal before the ring is on screen, so 0 uncovers the builder's own loading screen." },
    { "type": "color", "id": "splash_background", "label": "Cover colour", "default": "#ffffff" },
    { "type": "checkbox", "id": "show_progress", "label": "Show a progress bar on the cover", "default": true, "info": "Fills as the builder loads: the page arriving, the builder starting, then the hold below." },
    { "type": "color", "id": "progress_color", "label": "Progress bar colour", "default": "#1a1a1a" },
    { "type": "color", "id": "progress_track_color", "label": "Progress bar track colour", "default": "#e6e6e6" },
    { "type": "image_picker", "id": "splash_image", "label": "Mark on the cover" },
    { "type": "text", "id": "splash_image_asset", "label": "Or a file name", "info": "A file in Content > Files or in the theme's assets folder.", "default": "eden-raine-logo.png" },
    { "type": "text", "id": "splash_image_url", "label": "Or an image URL" },
    { "type": "range", "id": "splash_logo_width", "label": "Mark width (desktop)", "min": 80, "max": 600, "step": 10, "unit": "px", "default": 240 },
    { "type": "range", "id": "splash_logo_width_mobile", "label": "Mark width (mobile)", "min": 60, "max": 400, "step": 10, "unit": "px", "default": 150 },
    { "type": "range", "id": "splash_stage_width", "label": "Cover width (desktop)", "min": 10, "max": 100, "step": 2, "unit": "%", "default": 66, "info": "How much of the frame's width the stage takes, before the builder's own panel starts." },
    { "type": "range", "id": "splash_stage_height", "label": "Cover height (desktop)", "min": 10, "max": 100, "step": 2, "unit": "%", "default": 100 },
    { "type": "range", "id": "splash_stage_width_mobile", "label": "Cover width (mobile)", "min": 10, "max": 100, "step": 2, "unit": "%", "default": 100 },
    { "type": "range", "id": "splash_stage_height_mobile", "label": "Cover height (mobile)", "min": 10, "max": 100, "step": 2, "unit": "%", "default": 34 },

    { "type": "header", "content": "Cover the builder's logo", "info": "The builder is a page on the vendor's own domain, so its branding cannot be restyled from here. This lays a panel over the frame's top-left corner and puts our own mark on it. Match the panel colour to the builder's background, then nudge the size until the vendor's logo is gone." },
    { "type": "checkbox", "id": "brand_cover", "label": "Cover the builder's logo", "default": true },
    { "type": "text", "id": "brand_text", "label": "Wordmark", "default": "Eden Raine", "info": "Used when none of the three image fields below is filled in, and as the image's alt text." },
    { "type": "image_picker", "id": "brand_image", "label": "Logo image" },
    { "type": "text", "id": "brand_image_asset", "label": "Or a file name", "info": "A file in Content > Files or in the theme's assets folder, e.g. eden-raine-monogram.png.", "default": "eden-raine-monogram.png" },
    { "type": "text", "id": "brand_image_url", "label": "Or an image URL" },
    { "type": "select", "id": "brand_plate_where", "label": "Paint a panel behind the mark", "options": [ { "value": "always", "label": "Desktop and mobile" }, { "value": "mobile", "label": "Mobile only" }, { "value": "desktop", "label": "Desktop only" }, { "value": "never", "label": "Never - let the mark float" } ], "default": "always", "info": "The panel is what hides the builder's own logo. Where the frame is cropped instead (below), the panel is not needed and the mark can float on the render." },
    { "type": "select", "id": "brand_anchor", "label": "Mark sits at the", "options": [ { "value": "top", "label": "Top of the frame" }, { "value": "bottom", "label": "Bottom of the frame" } ], "default": "top" },
    { "type": "color", "id": "brand_background", "label": "Panel colour", "default": "#ffffff" },
    { "type": "color", "id": "brand_text_color", "label": "Wordmark colour" },
    { "type": "select", "id": "brand_alignment", "label": "Mark sits", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centred" } ], "default": "left" },
    { "type": "range", "id": "brand_pad", "label": "Inset from the panel edge (desktop)", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "brand_pad_mobile", "label": "Inset from the panel edge (mobile)", "min": 0, "max": 64, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "frame_crop_left", "label": "Crop the frame's left edge (desktop)", "min": 0, "max": 400, "step": 10, "unit": "px", "default": 0, "info": "Pulls the iframe left and widens it by the same amount, so the builder's own logo falls outside the frame instead of being covered up. The ring sits that much further left, so take only what the logo needs - about 220px." },
    { "type": "range", "id": "frame_crop_left_mobile", "label": "Crop the frame's left edge (mobile)", "min": 0, "max": 400, "step": 10, "unit": "px", "default": 0, "info": "Usually 0: the builder stacks its options full width on a phone, so cropping the left cuts the option labels off too." },
    { "type": "range", "id": "frame_crop_top", "label": "Crop the frame's top edge (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0, "info": "Pulls the iframe up and makes it taller by the same amount, so a bar across the top of the builder falls outside the frame. iJewel's Drive view (a /view link rather than /embedded) carries a 64px bar with their logo, a report flag and a Sign in button - cropping it takes the buttons with it, where covering it would leave them clickable." },
    { "type": "range", "id": "frame_crop_top_mobile", "label": "Crop the frame's top edge (mobile)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 0, "info": "The same bar is shorter on a phone. Check it at phone width before trusting the desktop number." },
    { "type": "range", "id": "brand_feather", "label": "Soften the panel edge (desktop)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48, "info": "How far the right and bottom edges fade out, so the ring behind the panel is not cut off by a straight line. 0 keeps a hard rectangle." },
    { "type": "range", "id": "brand_feather_mobile", "label": "Soften the panel edge (mobile)", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "brand_text_size", "label": "Wordmark size", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 0, "info": "0 keeps the stylesheet's size." },
    { "type": "range", "id": "brand_top", "label": "Panel from the frame's edge (desktop)", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "brand_left", "label": "Panel from the left (desktop)", "min": 0, "max": 320, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "brand_width", "label": "Panel width (desktop)", "min": 80, "max": 600, "step": 10, "unit": "px", "default": 220, "info": "Only as big as the builder's own logo - on a desktop that is about 172x61px, inset 34px from the frame's top-left corner." },
    { "type": "range", "id": "brand_height", "label": "Panel height (desktop)", "min": 40, "max": 280, "step": 4, "unit": "px", "default": 104 },
    { "type": "range", "id": "brand_logo_width", "label": "Logo width (desktop)", "min": 60, "max": 480, "step": 10, "unit": "px", "default": 60 },
    { "type": "checkbox", "id": "brand_hide_mobile", "label": "Hide the panel on mobile", "default": false },
    { "type": "range", "id": "brand_top_mobile", "label": "Panel from the frame's edge (mobile)", "min": 0, "max": 400, "step": 4, "unit": "px", "default": 0, "info": "On a phone the builder stacks its 3D stage above its own controls and puts its logo in the bottom-left corner of that stage - a long way down from the frame's top edge, and further down on a taller phone. Measured on the current embed it sits between 220px and 290px down, so a panel from about 204px covers it on every size." },
    { "type": "range", "id": "brand_top_mobile_vw", "label": "...or track the stage (mobile)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 0, "info": "Measured as a share of the frame's width, and it wins over the setting above when it is not 0. The builder sizes its 3D stage from the frame's width - about 74% of it - and drops its logo into that stage's bottom-left corner, so on a taller phone the logo is further down the screen while a fixed offset in pixels stays put. 61% puts the panel over the logo on every phone size measured. Only right while the section is full width." },
    { "type": "range", "id": "brand_left_mobile", "label": "Panel from the left (mobile)", "min": 0, "max": 320, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "brand_width_mobile", "label": "Panel width (mobile)", "min": 80, "max": 600, "step": 10, "unit": "px", "default": 120, "info": "Only as big as the builder's own logo - on the current embed that is a mark of about 26px square near the left edge. A wider panel eats into the ring." },
    { "type": "range", "id": "brand_height_mobile", "label": "Panel height (mobile)", "min": 40, "max": 280, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "brand_logo_width_mobile", "label": "Logo width (mobile)", "min": 20, "max": 480, "step": 10, "unit": "px", "default": 40, "info": "The mark only has to read, not fill the panel - it sits where the builder's own logo was." },

    { "type": "header", "content": "Cover the builder's price and Add to cart", "info": "The builder costs the ring from its own rate card and prints the figure above its Add to cart. Until those rates are the shop's own, that number is not a quote we can stand behind - and neither it nor the button can be switched off from here, because the builder is the vendor's own page in a frame. This lays a panel over the price line and the button under it, and writes our own line on it. Nudge the offsets until both are gone, on a desktop and on a phone." },
    { "type": "checkbox", "id": "price_cover", "label": "Cover the builder's price", "default": true, "info": "The panel waits for the builder to say it is on screen before it fades up, so it never floats over the loading poster. A builder that does not speak iJewel's bridge never says it, and its price is then left showing." },
    { "type": "checkbox", "id": "price_cover_cart", "label": "Cover the builder's Add to cart too", "default": true, "info": "Grows the panel on down over their button, so the line above is the only thing the frame offers on price. The panel swallows the click, so the button cannot be pressed - but it is a cover, not a delete: a keyboard tab inside the frame can still reach it. Turn this off only once prices are real, and set \"What their button does\" below at the same time." },
    { "type": "text", "id": "price_text", "label": "Line shown instead", "default": "Contact us for price", "info": "Stands where the builder prints its own figure, so the panel answers the question the covered number asked. Leave empty to show nothing at all - the panel still covers the figure." },
    { "type": "text", "id": "price_note", "label": "Second line", "info": "Smaller, under the first. Leave empty to hide it - it ships empty, because one plain line in place of a price and a button is enough." },
    { "type": "text", "id": "price_eyebrow", "label": "Small line above", "default": "Your design", "info": "Sits where iJewel labels its total, in the shop's small caps. Leave empty to hide it." },
    { "type": "checkbox", "id": "price_rule", "label": "Hairline across the top of the panel", "default": true, "info": "Draws the panel as the foot of their rail rather than a patch laid over it. Match their own dividers with the colour below." },
    { "type": "text", "id": "price_cta_label", "label": "First button", "default": "Save this design", "info": "Stands where iJewel's Add to cart is - a real button in the shop's own style, filling on hover with every other CTA. The price line above answers the price; this answers what the shopper can do about it. Leave it empty for a line of text on its own, and the first line then carries the link instead." },
    { "type": "select", "id": "price_cta_action", "label": "What the first button does", "options": [ { "value": "save", "label": "Save the design" }, { "value": "support", "label": "Carry the design to support" }, { "value": "link", "label": "Go to the link below" } ], "default": "save", "info": "Saving reads the live ring off the builder, writes down every choice with a quotable reference, and - when a product is picked under \"Add the design to the cart\" below - puts it in the cart with all of it on the line. Carrying it to support does the same read and then takes the shopper to the support page with the design above the enquiry form. Either one falls back to the link when it cannot work on this page." },
    { "type": "url", "id": "price_cta_link", "label": "First button goes to", "info": "Used when the button is set to go to a link. Falls back to the link on the first line, and with neither set the button is not drawn." },
    { "type": "select", "id": "price_cta_style", "label": "First button style", "options": [ { "value": "solid", "label": "Filled" }, { "value": "outline", "label": "Outlined" } ], "default": "solid" },
    { "type": "text", "id": "price_cta2_label", "label": "Second button", "info": "Stands beside the first, sharing the panel's width. Ships empty: one button under the price line is what the panel is for, and two of them in a 460px rail crowd it." },
    { "type": "select", "id": "price_cta2_action", "label": "What the second button does", "options": [ { "value": "support", "label": "Carry the design to support" }, { "value": "save", "label": "Save the design" }, { "value": "link", "label": "Go to the link below" } ], "default": "support" },
    { "type": "url", "id": "price_cta2_link", "label": "Second button goes to", "info": "Used when the button is set to go to a link." },
    { "type": "select", "id": "price_cta2_style", "label": "Second button style", "options": [ { "value": "outline", "label": "Outlined" }, { "value": "solid", "label": "Filled" } ], "default": "outline" },
    { "type": "color", "id": "price_rule_color", "label": "Hairline colour" },
    { "type": "url", "id": "price_link", "label": "Link on the first line", "info": "Leave empty for plain text. A link makes the line clickable where the builder's price used to be - the contact page or the enquiry form." },
    { "type": "select", "id": "price_text_action", "label": "What the first line does", "options": [ { "value": "support", "label": "Ask us about this design" }, { "value": "link", "label": "Go to the link above" }, { "value": "none", "label": "Nothing - plain text" } ], "default": "support", "info": "\"Ask us about this design\" saves the ring first and opens the Support page below with it attached, so the enquiry arrives knowing what was on screen. It ignores the link above and falls back to it when no support page is set." },
    { "type": "select", "id": "price_anchor", "label": "The price sits in the frame's", "options": [ { "value": "bottom-right", "label": "Bottom right" }, { "value": "bottom-left", "label": "Bottom left" }, { "value": "top-right", "label": "Top right" }, { "value": "top-left", "label": "Top left" } ], "default": "bottom-right", "info": "Which corner the offsets below are measured from. iJewel draws its price at the foot of the option rail, on the right." },
    { "type": "color", "id": "price_background", "label": "Panel colour", "default": "#ffffff", "info": "Match the builder's own panel. Clear it and the line floats on the builder's panel with the figure still showing behind." },
    { "type": "color", "id": "price_text_color", "label": "First line colour" },
    { "type": "color", "id": "price_note_color", "label": "Second line colour" },
    { "type": "select", "id": "price_alignment", "label": "Lines sit", "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Centred" }, { "value": "right", "label": "Right" } ], "default": "left" },
    { "type": "select", "id": "price_valign", "label": "Lines sit (up and down)", "options": [ { "value": "top", "label": "At the top of the panel" }, { "value": "center", "label": "In the middle" }, { "value": "bottom", "label": "At the foot" } ], "default": "center", "info": "A panel grown over Add to cart is tall, so this says whether the line stays up where the price was, sits in the middle of the block, or drops to where the button was." },
    { "type": "range", "id": "price_text_size", "label": "First line size", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 0, "info": "0 keeps the stylesheet's size." },
    { "type": "range", "id": "price_note_size", "label": "Second line size", "min": 0, "max": 28, "step": 1, "unit": "px", "default": 0, "info": "0 keeps the stylesheet's size." },
    { "type": "range", "id": "price_label_size", "label": "Small line size", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 0, "info": "0 keeps the stylesheet's size." },
    { "type": "range", "id": "price_bottom", "label": "Panel from the top or bottom (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 86, "info": "Measured from the corner chosen above. The shipped number puts the top of the panel over iJewel's price line on a full-screen desktop frame; what is below it down to the frame's foot is their Add to cart, which the reach below covers." },
    { "type": "range", "id": "price_right", "label": "Panel from the side (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 30, "info": "The panel has to clear the inside of iJewel's card on both sides, or a sliver of their own price row shows down one edge of it. Measured at 1512px wide: their card is inset 29px and about 463px across." },
    { "type": "range", "id": "price_width", "label": "Panel width (desktop)", "min": 80, "max": 700, "step": 10, "unit": "px", "default": 460, "info": "iJewel's option rail is about 463px wide, inset 29px from the frame's right edge, and the rail is anchored to that edge however wide the window is. Narrower than the rail leaves their own row showing beside ours." },
    { "type": "range", "id": "price_height", "label": "Panel height (desktop)", "min": 24, "max": 200, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "price_cart_height", "label": "Reach on down over Add to cart (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 86, "info": "Only used when the box above is ticked. Added to the panel's height and taken off its distance from the foot, so the shipped 86px - the same as the offset above - takes the panel from the price line to the bottom edge of the frame, covering their button whole." },
    { "type": "range", "id": "price_pad", "label": "Inset from the panel's sides (desktop)", "min": 0, "max": 96, "step": 2, "unit": "px", "default": 18, "info": "Line it up with the inner margin of iJewel's own rail, so our lines start where theirs do." },
    { "type": "range", "id": "price_pad_y", "label": "Inset from the panel's top and foot (desktop)", "min": 0, "max": 96, "step": 2, "unit": "px", "default": 18 },
