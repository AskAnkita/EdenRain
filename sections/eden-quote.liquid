{% comment %}
  Eden quote: one centred line of serif text between two hairlines.
  A quiet pause between the busier sections.

  The line now sits over a full-bleed background image. With no image picked
  the section falls back to gifting-banner-background.jpg in assets/, the same
  cream flat-lay the gifting banner used.

  The theme lays every section out on a three-column grid - margin, page width,
  margin - and drops the section's content in the middle column. "force-full-width"
  is the theme's own hook for spanning all three (assets/base.css), so "Full width"
  runs the image to the edges of the screen and only "Side padding" holds the text
  off them.
{% endcomment %}

{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: image

  assign object_position = section.settings.image_position
  if section.settings.image_position == 'focal' and image != blank
    assign object_position = image.presentation.focal_point
  endif
-%}

{%- style -%}
  #eden-quote-{{ section.id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: {{ section.settings.desktop_height }}px;
    background-color: {{ section.settings.background }};
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
    padding-inline: {{ section.settings.side_padding }}px;
  }
  #eden-quote-{{ section.id }} .eq-media,
  #eden-quote-{{ section.id }} .eq-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  #eden-quote-{{ section.id }} .eq-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ object_position }};
  }
  #eden-quote-{{ section.id }} .eq-overlay {
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  #eden-quote-{{ section.id }} .eq-inner {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.inner_width }}px;
    margin: 0 auto;
    text-align: center;
    border-top: 1px solid {{ section.settings.rule_color }};
    border-bottom: 1px solid {{ section.settings.rule_color }};
    padding-block: 24px;
  }
  #eden-quote-{{ section.id }} .eq-quote {
    margin: 0;
    font-family: {{ settings.heading_font.family }}, serif;
    font-size: {{ section.settings.quote_size }}px;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0.5px;
    color: {{ section.settings.text_color }};
  }
  #eden-quote-{{ section.id }} .eq-attribution {
    margin: 24px 0 0;
    font-family: {{ settings.body_font.family }}, sans-serif;
    font-size: {{ section.settings.attribution_size }}px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.attribution_color }};
  }
  @media screen and (max-width: 749px) {
    #eden-quote-{{ section.id }} { min-height: {{ section.settings.mobile_height }}px; }
    #eden-quote-{{ section.id }} .eq-inner { padding-block: 20px; }
    #eden-quote-{{ section.id }} .eq-quote { text-wrap: balance; }
  }
{%- endstyle -%}

<div id="eden-quote-{{ section.id }}" class="eden-quote{% if section.settings.width == 'full' %} force-full-width{% endif %}">
  {%- if image != blank -%}
    <div class="eq-media" aria-hidden="true">
      <picture>
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1100 }} 1100w
            "
            sizes="100vw"
          >
        {%- endif -%}
        {{
          image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            widths: '750, 1100, 1500, 1800, 2200, 2400',
            sizes: '100vw',
            alt: ''
        }}
      </picture>
    </div>
  {%- else -%}
    <div class="eq-media" aria-hidden="true">
      <img
        src="{% render 'image-source', file: 'gifting-banner-background.jpg', width: 2042 %}"
        alt=""
        loading="lazy"
        width="2042"
        height="770"
      >
    </div>
  {%- endif -%}

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="eq-overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="eq-inner">
    <p class="eq-quote">{{ section.settings.quote | escape }}</p>
    {%- if section.settings.attribution != blank -%}
      <p class="eq-attribution">{{ section.settings.attribution | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Eden quote",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "width", "label": "Section width", "default": "full", "info": "Full width runs the background image to the edges of the screen; \"Side padding\" is then the only margin on the text.", "options": [ { "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" } ] },
    { "type": "range", "id": "side_padding", "label": "Side padding", "min": 0, "max": 80, "step": 2, "unit": "px", "default": 30 },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image" },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "focal", "label": "Use focal point" },
        { "value": "center top", "label": "Top" },
        { "value": "center center", "label": "Centre" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "focal"
    },
    { "type": "color", "id": "overlay_color", "label": "Overlay colour", "default": "#ffffff" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 10 },
    { "type": "color", "id": "background", "label": "Fallback background", "default": "#ffffff" },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 240, "max": 900, "step": 20, "unit": "px", "default": 460 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 200, "max": 800, "step": 20, "unit": "px", "default": 420 },
    { "type": "header", "content": "Text" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Made to be worn, and loved, for a lifetime." },
    { "type": "text", "id": "attribution", "label": "Attribution (optional)", "default": "Eden Raine" },
    { "type": "range", "id": "quote_size", "label": "Quote size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "attribution_size", "label": "Attribution size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "inner_width", "label": "Text width", "min": 480, "max": 1200, "step": 20, "unit": "px", "default": 880 },
    { "type": "color", "id": "text_color", "label": "Quote colour", "default": "#000000" },
    { "type": "color", "id": "rule_color", "label": "Hairline colour", "default": "#d9cfc7" },
    { "type": "color", "id": "attribution_color", "label": "Attribution colour", "default": "#8a7d74" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "Eden quote" } ]
}
{% endschema %}
