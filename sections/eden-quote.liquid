{%- liquid
  assign gifting_collection = section.settings.collection | default: collections['best-sellers']
-%}

{%- style -%}
  #eden-quote-{{ section.id }} {
    position: relative;
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(24px, 4vw, 64px);
    width: 100%;
    min-height: clamp(400px, 37vw, 560px);
    margin-block: 0 !important;
    padding: 54px clamp(28px, 6vw, 96px);
    overflow: hidden;
    isolation: isolate;
  }

  #eden-quote-{{ section.id }} .gifting-banner__background {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #eden-quote-{{ section.id }} .gifting-banner__heading {
    max-width: 440px;
    margin: 0;
    color: #171310;
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(25px, 2.5vw, 40px);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  #eden-quote-{{ section.id }} .gifting-banner__products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 1.5vw, 22px);
    align-self: end;
    margin: 110px 0 0;
    padding: 0;
    list-style: none;
  }

  #eden-quote-{{ section.id }} .gifting-banner__product {
    min-width: 0;
    background: rgba(255, 255, 255, 0.92);
    text-align: center;
  }

  #eden-quote-{{ section.id }} .gifting-banner__product-link {
    display: block;
    padding: 12px 12px 14px;
    color: inherit;
    text-decoration: none;
  }

  #eden-quote-{{ section.id }} .gifting-banner__product-image-wrap {
    display: grid;
    aspect-ratio: 1 / 0.82;
    place-items: center;
    overflow: hidden;
    background: #fff;
  }

  #eden-quote-{{ section.id }} .gifting-banner__product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #eden-quote-{{ section.id }} .gifting-banner__product-title {
    display: -webkit-box;
    min-height: 2.6em;
    margin: 10px 0 4px;
    overflow: hidden;
    font-family: var(--font-body--family, sans-serif);
    font-size: 12px;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  #eden-quote-{{ section.id }} .gifting-banner__product-price {
    margin: 0;
    font-family: var(--font-body--family, sans-serif);
    font-size: 12px;
    line-height: 1.3;
  }

  #eden-quote-{{ section.id }} + .section { margin-block-start: 0 !important; }

  @media screen and (max-width: 749px) {
    #eden-quote-{{ section.id }} {
      display: block;
      min-height: 0;
      padding: 0 16px 24px;
      overflow: hidden;
      background: #fff;
    }

    #eden-quote-{{ section.id }} .gifting-banner__background {
      position: relative;
      inset: auto;
      width: calc(100% + 32px);
      max-width: none;
      height: auto;
      margin-inline: -16px;
      object-fit: contain;
    }

    #eden-quote-{{ section.id }} .gifting-banner__heading {
      position: absolute;
      top: 10%;
      left: 7%;
      width: 44%;
      font-size: clamp(16px, 5vw, 23px);
      letter-spacing: 0.025em;
    }

    #eden-quote-{{ section.id }} .gifting-banner__products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      margin: 14px 0 0;
    }

    #eden-quote-{{ section.id }} .gifting-banner__product-link { padding: 8px; }
    #eden-quote-{{ section.id }} .gifting-banner__product-title,
    #eden-quote-{{ section.id }} .gifting-banner__product-price { font-size: 11px; }
  }
{%- endstyle -%}

<section id="eden-quote-{{ section.id }}" class="eden-quote force-full-width">
  <img
    class="gifting-banner__background"
    src="{% render 'image-source', file: 'gifting-perfect-gift.png', width: 2042 %}"
    srcset="
      {% render 'image-source', file: 'gifting-perfect-gift.png', width: 750 %} 750w,
      {% render 'image-source', file: 'gifting-perfect-gift.png', width: 1100 %} 1100w,
      {% render 'image-source', file: 'gifting-perfect-gift.png', width: 1600 %} 1600w,
      {% render 'image-source', file: 'gifting-perfect-gift.png', width: 2042 %} 2042w
    "
    sizes="100vw"
    alt=""
    loading="lazy"
    width="851"
    height="315"
  >

  <h2 class="gifting-banner__heading">Find the perfect gift</h2>

  {%- if gifting_collection != blank and gifting_collection.products_count > 0 -%}
    <ul class="gifting-banner__products" aria-label="Featured gifts">
      {%- for product in gifting_collection.products limit: 3 -%}
        <li class="gifting-banner__product">
          <a class="gifting-banner__product-link" href="{{ product.url }}">
            <span class="gifting-banner__product-image-wrap">
              {%- if product.featured_image != blank -%}
                <img
                  class="gifting-banner__product-image"
                  src="{{ product.featured_image | image_url: width: 700 }}"
                  srcset="{{ product.featured_image | image_url: width: 350 }} 350w, {{ product.featured_image | image_url: width: 700 }} 700w"
                  sizes="(max-width: 749px) 45vw, 22vw"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="700"
                  height="574"
                >
              {%- endif -%}
            </span>
            <span class="gifting-banner__product-title">{{ product.title | escape }}</span>
            <span class="gifting-banner__product-price">{{ product.price | money }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Gifting banner",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Products to feature" }
  ],
  "presets": [{ "name": "Gifting banner" }]
}
{% endschema %}
