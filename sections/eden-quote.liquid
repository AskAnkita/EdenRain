{%- liquid
  assign gifting_ring_image = section.settings.ring_photo
  assign gifting_box_image = section.settings.box_photo

  if gifting_ring_image != blank
    assign gifting_ring_src = gifting_ring_image | image_url: width: 900
  else
    capture gifting_ring_src
      render 'image-source', file: 'gifting-floating-ring.png', width: 900
    endcapture
  endif

  if gifting_box_image != blank
    assign gifting_box_src = gifting_box_image | image_url: width: 900
  else
    capture gifting_box_src
      render 'image-source', file: 'gifting-gift-box-blush.png', width: 900
    endcapture
  endif
-%}

{%- style -%}
  #eden-quote-{{ section.id }} {
    position: relative;
    display: grid;
    min-height: {{ section.settings.desktop_height }}px;
    place-items: center;
    overflow: hidden;
    margin-block: 0 !important;
    padding: 0 30px;
    background: linear-gradient(120deg, #ffffff 0%, #fdfcfb 56%, #f8f5f1 100%);
    color: {{ section.settings.text_color }};
  }
  #eden-quote-{{ section.id }} .eq-art {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  #eden-quote-{{ section.id }} .eq-art img {
    position: absolute;
    display: block;
    height: auto;
    object-fit: contain;
  }
  #eden-quote-{{ section.id }} .eq-ring { top: 3%; left: 4%; width: clamp(150px, 20vw, 330px); }
  #eden-quote-{{ section.id }} .eq-box { right: 4%; bottom: -2%; width: clamp(180px, 23vw, 350px); }
  #eden-quote-{{ section.id }} .eq-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: {{ section.settings.inner_width }}px;
    margin: 0 auto;
    padding: 26px 18px 24px;
    border-top: 1px solid {{ section.settings.rule_color }};
    border-bottom: 1px solid {{ section.settings.rule_color }};
    text-align: center;
  }
  #eden-quote-{{ section.id }} .eq-quote {
    margin: 0;
    font-family: {{ settings.heading_font.family }}, serif;
    font-size: {{ section.settings.quote_size }}px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0.3px;
    color: {{ section.settings.text_color }};
    text-wrap: balance;
  }
  #eden-quote-{{ section.id }} .eq-attribution {
    margin: 24px 0 0;
    font-family: {{ settings.body_font.family }}, sans-serif;
    font-size: {{ section.settings.attribution_size }}px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: {{ section.settings.attribution_color }};
  }
  #eden-quote-{{ section.id }} + .section { margin-block-start: 0 !important; }
  @media screen and (max-width: 749px) {
    #eden-quote-{{ section.id }} {
      min-height: {{ section.settings.mobile_height }}px;
      padding: 0 18px;
    }
    #eden-quote-{{ section.id }} .eq-inner { padding: 22px 12px; }
    #eden-quote-{{ section.id }} .eq-quote { font-size: clamp(30px, 8vw, 40px); }
    #eden-quote-{{ section.id }} .eq-attribution { margin-top: 17px; font-size: 9px; }
    #eden-quote-{{ section.id }} .eq-ring { top: 0; left: -4%; width: 35vw; }
    #eden-quote-{{ section.id }} .eq-box { right: -5%; bottom: -1%; width: 36vw; }
  }
{%- endstyle -%}

<section id="eden-quote-{{ section.id }}" class="eden-quote{% if section.settings.width == 'full' %} force-full-width{% endif %}">
  <div class="eq-art" aria-hidden="true">
    <img class="eq-ring" src="{{ gifting_ring_src | strip }}" alt="" loading="lazy" width="900" height="900">
    <img class="eq-box" src="{{ gifting_box_src | strip }}" alt="" loading="lazy" width="900" height="900">
  </div>

  <div class="eq-inner">
    <h2 class="eq-quote">{{ section.settings.quote | escape }}</h2>
    {%- if section.settings.attribution != blank -%}
      <p class="eq-attribution">{{ section.settings.attribution | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gifting moment",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "select", "id": "width", "label": "Section width", "default": "full", "options": [ { "value": "page", "label": "Page width" }, { "value": "full", "label": "Full width" } ] },
    { "type": "image_picker", "id": "ring_photo", "label": "Ring photo (optional)" },
    { "type": "image_picker", "id": "box_photo", "label": "Gift box photo (optional)" },
    { "type": "range", "id": "desktop_height", "label": "Desktop height", "min": 300, "max": 760, "step": 20, "unit": "px", "default": 360 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 320, "max": 720, "step": 20, "unit": "px", "default": 320 },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#191614" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "Made to be worn, and loved, for a lifetime." },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "Eden Raine" },
    { "type": "range", "id": "quote_size", "label": "Quote size", "min": 24, "max": 48, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "attribution_size", "label": "Attribution size", "min": 9, "max": 20, "step": 1, "unit": "px", "default": 11 },
    { "type": "range", "id": "inner_width", "label": "Text width", "min": 480, "max": 1200, "step": 20, "unit": "px", "default": 1000 },
    { "type": "color", "id": "rule_color", "label": "Hairline colour", "default": "#d9cfc7" },
    { "type": "color", "id": "attribution_color", "label": "Attribution colour", "default": "#8a7d74" }
  ],
  "presets": [ { "name": "Gifting moment" } ]
}
{% endschema %}
