# Copy this file to .env and fill it in. .env is git-ignored and never uploaded to Shopify.
# Store domain, without https://
SHOPIFY_STORE_DOMAIN=jewelery2-2.myshopify.com
# Admin API access token from your dev app (starts with shpat_). Keep it secret.
SHOPIFY_ADMIN_TOKEN=
# Admin API version (YYYY-MM)
SHOPIFY_API_VERSION=2026-07
