# Copy this file to .env and fill it in. .env is git-ignored and never uploaded to Shopify.
# Store domain, without https://
SHOPIFY_STORE_DOMAIN=jewelery2-2.myshopify.com

# Dev Dashboard app credentials (Settings > Client credentials). Keep the secret private.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Or, instead of the two above: an Admin API access token (starts with shpat_)
SHOPIFY_ADMIN_TOKEN=

# Admin API version (YYYY-MM)
SHOPIFY_API_VERSION=2026-07
